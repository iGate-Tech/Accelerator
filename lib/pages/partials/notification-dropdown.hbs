{{#if notifications}}
  {{#each notifications}}
    <div class="relative {{#unless is_read}}bg-accent/50{{/unless}} rounded-sm">
      <a href="#" class="flex cursor-default select-none items-start rounded-sm px-3 py-3 text-sm outline-none transition-colors hover:bg-primary/10 hover:text-primary-900" onclick="markAsRead('{{id}}')">
        <div class="flex-shrink-0 mr-3 mt-0.5">
          {{#if (eq type "vote_received")}}
            <div class="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center">
              {{{icon "star" class="h-4 w-4 text-yellow-600"}}}
            </div>
          {{else if (eq type "reward_earned")}}
            <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
              {{{icon "coins" class="h-4 w-4 text-green-600"}}}
            </div>
          {{else if (eq type "idea_shared")}}
            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              {{{icon "share" class="h-4 w-4 text-blue-600"}}}
            </div>
          {{else}}
            <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
              {{{icon "bell" class="h-4 w-4 text-gray-600"}}}
            </div>
          {{/if}}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-foreground leading-5 {{#if is_read}}text-muted-foreground{{/if}}">{{truncate message 80}}</p>
          <p class="text-xs text-muted-foreground mt-1">{{moment created_at format="MMM D, h:mm A"}}</p>
        </div>
        {{#unless is_read}}
          <div class="flex-shrink-0 ml-2">
            <div class="w-2 h-2 bg-primary rounded-full"></div>
          </div>
        {{/unless}}
      </a>
    </div>
  {{/each}}
  <div class="border-t border-border mt-2 pt-2">
    <a href="/notification" class="flex items-center justify-center w-full px-3 py-2 text-sm font-medium text-primary hover:text-primary-foreground hover:bg-primary rounded-md transition-colors">
      {{{icon "arrow-right" class="mr-2 h-4 w-4"}}}
      View All Notifications
    </a>
  </div>
{{else}}
  <div class="px-3 py-6 text-center">
    <div class="w-12 h-12 bg-muted rounded-full flex items-center justify-center mx-auto mb-3">
      {{{icon "bell-off" class="h-6 w-6 text-muted-foreground"}}}
    </div>
    <p class="text-sm text-muted-foreground">No new notifications</p>
  </div>
{{/if}}