   <button id="lang-toggle" class="absolute top-4 {{#if (eq lng 'ar')}}right-4{{else}}left-4{{/if}} text-foreground hover:text-muted-foreground transition-colors z-10 px-2 py-1 text-sm font-medium flex items-center">
     {{{icon 'languages' class='h-4 w-4 mr-1'}}}
     <span id="lang-text">EN</span>
   </button>
   <button id="theme-toggle" class="absolute top-4 {{#if (eq lng 'ar')}}left-4{{else}}right-4{{/if}} text-foreground hover:text-muted-foreground transition-colors z-10">
    {{{icon 'sun' class='h-6 w-6' id='sun-icon'}}}
    {{{icon 'moon' class='h-6 w-6 hidden' id='moon-icon'}}}
  </button>
  <div class="w-full min-h-screen flex flex-col items-center justify-center px-4" >
     <img src="/images/accelerator_logo.svg" alt="Accelerator Logo" class="w-32 sm:w-40 my-6 sm:my-10" />
   <div class="flex items-center">
     <div class="flex flex-col items-center justify-center h-full gap-6 w-full max-w-[400px] mx-auto bg-card shadow-primary rounded-lg p-4 sm:p-6 border border-input">
      <div class="grid gap-2 text-center">
         <h1 class="text-3xl font-bold text-foreground text-glow text-center">{{t 'auth.signup.title'}}</h1>
         <p class="text-balance text-muted-foreground">
           {{t 'auth.signup.description'}}
         </p>
      </div>

      <form action="/auth/signup" method="post" class="grid gap-4 text-center">

        <div class="grid gap-2 text-left">
           <label
             class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
             for="firstName">
             {{t 'auth.signup.first_name_label'}}
           </label>
           <input type="text" name="firstName"
             class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
             id="firstName" placeholder="{{t 'auth.signup.first_name_placeholder'}}" required="" />
        </div>

        <div class="grid gap-2 text-left">
           <label
             class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
             for="lastName">
             {{t 'auth.signup.last_name_label'}}
           </label>
           <input type="text" name="lastName"
             class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
             id="lastName" placeholder="{{t 'auth.signup.last_name_placeholder'}}" required="" />
        </div>

        <div class="grid gap-2 text-left">
           <label
             class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
             for="email">
             {{t 'auth.signup.email_label'}}
           </label>
           <input type="email" name="email"
             class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
             id="email" placeholder="{{t 'auth.signup.email_placeholder'}}" required="" />
        </div>

         <div class="grid gap-2 text-left">
            <label
              class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              for="password">
              {{t 'auth.signup.password_label'}}
            </label>
             <input type="password" name="password"
               class="flex h-9 w-full rounded-md border border-input/80 bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
               id="password" placeholder="{{t 'auth.signup.password_placeholder'}}" required="" />
         </div>

        <div class="flex items-center space-x-2">
          <div class="relative">
            <input class="h-4 w-4 appearance-none rounded-full border border-input/80 checked:bg-primary checked:border-primary peer" id="terms" name="terms" type="checkbox" required />
 {{{icon 'check' class='absolute inset-0 w-4 h-4 text-foreground scale-75 peer-checked:block hidden' size='24'}}}
          </div>
           <label
             class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
             for="terms">
             {{t 'auth.signup.terms_agree'}}
             <a href="/terms" class="text-primary hover:text-primary-600 focus:outline-none monotone-logo">{{t 'auth.terms.title'}}</a>
           </label>
        </div>

         <div class="w-full">
           <button type="submit" class="shiny-cta text-center bg-card w-full sm:w-[200px] mx-auto"
             style="padding: 0.5rem 1rem; margin: 0 auto;">
              {{t 'auth.signup.sign_up_button'}}
           </button>
         </div>

      </form>

      <div class="mt-4 text-center text-sm text-muted-foreground">
         {{t 'auth.signup.have_account'}}
         <a class="underline text-muted-foreground hover:text-foreground focus:outline-none monotone-logo"
           href="/auth/login">{{t 'auth.signup.login'}}</a>
       </div>

      </div>
    </div>
   <div class="mb-[200px]"></div>
  </div>

<script>
function toggleTheme() {
  const html = document.documentElement;
  html.classList.toggle('dark');
  const isDark = html.classList.contains('dark');
  localStorage.setItem('theme', isDark ? 'dark' : 'light');
  updateThemeIcon();
}

function updateThemeIcon() {
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');
  const isDark = document.documentElement.classList.contains('dark');
  sunIcon.classList.toggle('hidden', isDark);
  moonIcon.classList.toggle('hidden', !isDark);
}

function toggleLanguage() {
  const currentLng = document.documentElement.lang || 'en';
  const newLng = currentLng === 'ar' ? 'en' : 'ar';
  document.cookie = `i18next=${newLng}; path=/; max-age=31536000`;
  window.location.reload();
}

function updateLangText() {
  const currentLng = document.documentElement.lang || 'en';
  document.getElementById('lang-text').textContent = currentLng.toUpperCase();
}

document.addEventListener('DOMContentLoaded', () => {
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  }
  updateThemeIcon();
  updateLangText();
  document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
  document.getElementById('lang-toggle').addEventListener('click', toggleLanguage);
});
</script>
  </div>
