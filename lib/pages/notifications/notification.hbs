<main id="notification-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            {{t 'notifications.title'}}
          </h1>
          <p class="text-lg text-muted-foreground">
            {{t 'notifications.description'}}
          </p>
        </div>
          <div class="flex items-center gap-2">
             <button id="mark-all-read-btn" class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
               {{t 'notifications.mark_all_read'}}
             </button>
             <button id="delete-all-read-btn" class="btn btn-outline btn-destructive px-3 py-1.5 rounded-full" onclick="deleteAllRead()">
               {{t 'notifications.delete_all_read'}}
             </button>
             <button id="delete-all-unread-btn" class="btn btn-outline btn-destructive px-3 py-1.5 rounded-full" onclick="deleteAllUnread()">
               {{t 'notifications.delete_all_unread'}}
             </button>
          </div>
      </div>

       <!-- Notification List -->
       <div id="notifications-list" class="space-y-4">
         {{#if notifications}}
           {{#each notifications}}
             <div class="bg-card rounded-lg border border-border p-4 {{#unless is_read}}bg-accent{{/unless}}">
               <div class="flex items-start gap-3">
                 <div class="flex-shrink-0">
                    {{#if (eq type "vote_received")}}
                     {{{icon "star" class="w-5 h-5 text-yellow-500"}}}
                    {{else if (eq type "reward_earned")}}
                     {{{icon "coins" class="w-5 h-5 text-green-500"}}}
                    {{else if (eq type "idea_shared")}}
                     {{{icon "share" class="w-5 h-5 text-blue-500"}}}
                    {{else}}
                     {{{icon "bell" class="w-5 h-5 text-gray-500"}}}
                    {{/if}}
                 </div>
                 <div class="flex-1 min-w-0">
                   <p class="text-sm text-foreground">{{message}}</p>
                   <p class="text-xs text-muted-foreground mt-1">{{moment created_at format="MMM D, YYYY h:mm A"}}</p>
                 </div>
                  {{#unless is_read}}
                     <button class="btn btn-sm btn-ghost text-muted-foreground hover:text-primary" onclick="markAsRead('{{id}}')">
                       {{t 'notifications.mark_as_read'}}
                     </button>
                  {{/unless}}
                  <button
                    class="btn btn-sm btn-ghost text-muted-foreground hover:text-destructive"
                    hx-delete="/api/notifications/{{id}}"
                    hx-target="closest .bg-card"
                    hx-swap="outerHTML"
                    hx-confirm="Are you sure you want to delete this notification?"
                    hx-on:htmx:response-error="showToast('Failed to delete notification', 'error')"
                  >
                    {{t 'notifications.delete'}}
                  </button>
               </div>
             </div>
           {{/each}}
         {{else}}
           <div class="text-center py-8">
             <div class="inline-flex items-center gap-2 text-muted-foreground">
               {{{icon "bell-off" class="w-4 h-4"}}}
                {{t 'notifications.no_notifications'}}
             </div>
           </div>
         {{/if}}
       </div>

      <!-- Load More -->
       <div class="text-center py-4">
          <button class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
            {{t 'notifications.load_more'}}
          </button>
       </div>
     </div>
   </div>

</main>

<script>
async function markAsRead(notificationId) {
  try {
    const response = await fetch(`/api/notifications/${notificationId}/read`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
    });
    if (response.ok) {
      // Reload the page to update the list
      window.location.reload();
    } else {
      showToast('Failed to mark as read', 'error');
    }
  } catch (error) {
    console.error('Mark as read error:', error);
    showToast('Failed to mark as read', 'error');
  }
}

async function deleteAllRead() {
  if (!confirm('Are you sure you want to delete all read notifications?')) return;
  try {
    const response = await fetch('/api/notifications/delete-read', {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      },
    });
    if (response.ok) {
      window.location.reload();
    } else {
      showToast('Failed to delete read notifications', 'error');
    }
  } catch (error) {
    console.error('Delete all read error:', error);
    showToast('Failed to delete read notifications', 'error');
  }
}

async function deleteAllUnread() {
  if (!confirm('Are you sure you want to delete all unread notifications?')) return;
  try {
    const response = await fetch('/api/notifications/delete-unread', {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      },
    });
    if (response.ok) {
      window.location.reload();
    } else {
      showToast('Failed to delete unread notifications', 'error');
    }
  } catch (error) {
    console.error('Delete all unread error:', error);
    showToast('Failed to delete unread notifications', 'error');
  }
}
</script>