<script>
  function toggleGridMenu() {
    const dropdown = document.getElementById('grid-dropdown');
    if (dropdown) {
      dropdown.classList.toggle('opacity-0');
      dropdown.classList.toggle('invisible');
      dropdown.classList.toggle('hidden');
    }
  }

  function toggleUserMenu() {
    const dropdown = document.getElementById('admin-user-dropdown');
    if (dropdown) {
      dropdown.classList.toggle('opacity-0');
      dropdown.classList.toggle('invisible');
      dropdown.classList.toggle('hidden');
    }
  }

  // Close dropdowns when clicking outside
  document.addEventListener('click', function (event) {
    const gridMenu = document.getElementById('grid-menu');
    const gridDropdown = document.getElementById('grid-dropdown');
    const userMenu = document.getElementById('admin-user-menu');
    const userDropdown = document.getElementById('admin-user-dropdown');

    if (gridMenu && !gridMenu.contains(event.target)) {
      gridDropdown?.classList.add('opacity-0', 'invisible', 'hidden');
    }

    if (userMenu && !userMenu.contains(event.target)) {
      userDropdown?.classList.add('opacity-0', 'invisible', 'hidden');
    }
  });

  function toggleTheme() {
    const html = document.documentElement;
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeIcon(isDark);
  }

  function updateThemeIcon(isDark) {
    const lightIcon = document.getElementById('theme-icon-light');
    const darkIcon = document.getElementById('theme-icon-dark');
    if (lightIcon && darkIcon) {
      if (isDark) {
        lightIcon.classList.add('hidden');
        darkIcon.classList.remove('hidden');
      } else {
        darkIcon.classList.add('hidden');
        lightIcon.classList.remove('hidden');
      }
    }
  }
  // Load credit balance function
  window.loadNavCreditBalance = async function () {
    try {
      const response = await fetch('/api/credits', {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
        },
        credentials: 'same-origin'
      });

      if (response.ok) {
        const data = await response.json();
        const creditElement = document.getElementById('nav-credit-balance');
        if (creditElement) {
          creditElement.textContent = `${data.balance} Credits`;
        }
      } else if (response.status === 401) {
        // User not authenticated, hide credits or show login
        const creditElement = document.getElementById('nav-credit-balance');
        if (creditElement) {
          creditElement.style.display = 'none';
        }
      }
    } catch (error) {
      console.error('Error loading credit balance:', error);
    }
  };



  // Load notification indicator
  window.loadNotificationIndicator = async function () {
    try {
      const response = await fetch('/api/notifications/unread-count', {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
        },
        credentials: 'same-origin'
      });

       if (response.ok) {
         const data = await response.json();
         const indicator = document.getElementById('nav-notification-indicator');
         if (indicator) {
           if (data.count > 0) {
             indicator.classList.remove('hidden');
           } else {
             indicator.classList.add('hidden');
           }
         }
       }
    } catch (error) {
      console.error('Error loading notification count:', error);
    }
  };

  function switchLanguage(lang) {
    // Set the language in localStorage
    localStorage.setItem('language', lang);

    // Update button styles
    const enBtn = document.getElementById('lang-en');
    const arBtn = document.getElementById('lang-ar');
    if (lang === 'en') {
      enBtn.classList.remove('bg-muted', 'text-muted-foreground', 'hover:bg-primary', 'hover:text-primary-foreground');
      enBtn.classList.add('bg-primary', 'text-primary-foreground');
      arBtn.classList.remove('bg-primary', 'text-primary-foreground');
      arBtn.classList.add('bg-muted', 'text-muted-foreground', 'hover:bg-primary', 'hover:text-primary-foreground');
    } else {
      arBtn.classList.remove('bg-muted', 'text-muted-foreground', 'hover:bg-primary', 'hover:text-primary-foreground');
      arBtn.classList.add('bg-primary', 'text-primary-foreground');
      enBtn.classList.remove('bg-primary', 'text-primary-foreground');
      enBtn.classList.add('bg-muted', 'text-muted-foreground', 'hover:bg-primary', 'hover:text-primary-foreground');
    }

    // Here you would implement the actual language switching logic
    // For example, reload the page or update content dynamically
    console.log('Language switched to:', lang);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const savedTheme =
      localStorage.getItem('theme'); const systemPrefersDark =
        window.matchMedia('(prefers-color-scheme: dark)').matches; const theme =
          savedTheme || (systemPrefersDark ? 'dark' : 'light'); const isDark = theme ===
            'dark'; if (isDark) { document.documentElement.classList.add('dark'); }
    updateThemeIcon(isDark);

    // Load saved language and update buttons
    const savedLang = localStorage.getItem('language') || 'en';
    switchLanguage(savedLang);

    // Load credit balance on page load
    loadNavCreditBalance();
    // Load notification indicator on page load
    loadNotificationIndicator();
  });
</script>