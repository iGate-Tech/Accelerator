# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# AI API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Configuration (optional - using PGLite by default)
# DATABASE_URL=postgresql://username:password@localhost:5432/accelerator

# SSL Configuration (for production)
# SSL_KEY_PATH=/path/to/ssl/key.pem
# SSL_CERT_PATH=/path/to/ssl/cert.pem

# Docker Configuration
DOCKER_ENV=false

# Analytics (optional)
# GA_TRACKING_ID=GA-XXXXXXXXXX

# Error Monitoring (optional - requires @sentry/browser package)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project



# File Storage (AWS S3 or Cloudinary)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_S3_BUCKET=your_bucket_name
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Payment (Stripe - keep mocked for now)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Auth (Supabase - keep mocked for now)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key

