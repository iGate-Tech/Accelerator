{{!-- Metric Card Component --}}
<div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
  <div class="flex items-center justify-between px-3 py-1">
    <div class="flex flex-col gap-1">
      <h3 class="text-sm font-medium text-muted-foreground">{{title}}</h3>
      <p class="text-2xl font-semibold text-foreground">{{value}}</p>
    </div>
    <div>
      <div class="bg-{{bgColor}}/20 rounded-lg">
        <div class="w-10 h-10 bg-{{bgColor}}/20 rounded-lg relative">
          <div class="flex items-center justify-center w-9 h-9 bg-{{bgColor}} rounded-lg absolute top-0.5 left-0.5">
            {{{icon icon class='w-4 h-4 text-primary-foreground' size='16'}}}
          </div>
        </div>
      </div>
    </div>
  </div>
  {{#if change}}
  <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
    {{{icon 'trending-up' class='w-5 h-4' size='16'}}}
    <span class="text-success">{{change}}</span>
    {{../t 'dashboard-dashboard.since_last_month' lng=../lng}}
  </p>
  {{/if}}
</div>