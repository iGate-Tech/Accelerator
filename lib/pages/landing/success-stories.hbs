<section id="success-stories"
   class="overflow-hidden flex flex-col px-6 md:px-8 lg:px-12 z-10 bg-background/80 w-full border-white/5 border-t pt-32 pb-32 relative backdrop-blur-xl items-center">
  <!-- Subtle Background Grid -->
  <div
    class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:100px_200px] [mask-image:radial-gradient(ellipse_at_top,black_40%,transparent_100%)] pointer-events-none">
  </div>

  <div class="max-w-7xl w-full relative z-10">
    <!-- Header Group -->
    <div class="flex flex-col gap-8 mb-16 max-w-5xl" data-aos="fade-up">
       <span class="text-xs font-mono text-white/40 uppercase tracking-[0.2em] font-medium pl-1 flex items-center gap-2">
         <span class="w-1 h-1 bg-brand-purple rounded-full shadow-[0_0_10px_rgba(158,40,181,0.8)]"></span>
         (t "landing.success_stories.badge")
       </span>

       <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif font-medium tracking-tight text-white leading-[1.1] mb-6">
         (t "landing.success_stories.title_stories")
         <span class="text-white opacity-90">(t "landing.success_stories.title_from")</span>
       </h2>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 gap-x-12 gap-y-12 items-end" style="">
      <!-- Visual / Portrait Block -->
      <div class="lg:col-span-4 relative group" data-aos="fade-up" data-aos-delay="100" style="">
        <div
          class="relative w-full aspect-[3.5/4] rounded-[24px] overflow-hidden border border-white/10 bg-white/[0.02]">
          <!-- Image -->
          <img
            src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/346c8983-c047-4169-902a-df1305819be6_800w.jpg"
            alt="Trader Profile"
            class="w-full h-full object-cover grayscale mix-blend-luminosity opacity-60 group-hover:opacity-80 group-hover:scale-105 transition-all duration-700 ease-out" />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-transparent via-transparent to-transparent opacity-80">
          </div>

          <!-- Decorative UI Elements on Image -->
          <div
            class="absolute top-5 left-5 right-5 flex justify-between items-center opacity-0 group-hover:opacity-100 transition-opacity duration-500">
            <div class="flex gap-1.5">
              <div class="w-1 h-1 bg-white/40 rounded-full"></div>
              <div class="w-1 h-1 bg-white/40 rounded-full"></div>
            </div>
            <div class="px-2 py-0.5 rounded border border-white/10 bg-black/20 backdrop-blur-md">
               <span class="text-[9px] font-mono text-brand-purple tracking-wider">(t "landing.success_stories.live")</span>
            </div>
          </div>
        </div>

        <!-- Glow Effect behind image -->
      </div>

      <!-- Testimony &amp; Actions Block -->
      <div class="lg:col-span-8 flex flex-col justify-end h-full relative" data-aos="fade-up" data-aos-delay="200">
        <!-- Quote -->
        <blockquote class="mb-12 relative">
          <!-- Stylized Quote Icon -->
          {{{icon 'quote' class='absolute -top-6 -left-8 w-6 h-6 text-white/10'}}}

           <p class="text-xl md:text-2xl lg:text-3xl text-white/80 font-light leading-relaxed tracking-tight">
             "(t "landing.success_stories.quote")"
           </p>
        </blockquote>

        <!-- Author -->
        <div class="mb-12 flex items-center gap-4">
          <div class="h-px w-8 bg-brand-purple/30"></div>
           <span class="text-white/60 text-sm font-medium">(t "landing.success_stories.author")</span>
        </div>

        <!-- Bottom Row: Stat &amp; CTA -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-t border-white/5 pt-8">
          <!-- Metric Pill -->
          <div
            class="inline-flex items-center gap-3 px-4 py-2.5 rounded-full border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] transition-colors group cursor-default">
             <span
               class="text-[10px] md:text-xs text-white/50 font-mono uppercase tracking-wide group-hover:text-white/70 transition-colors">
               (t "landing.success_stories.startups_launched")
               <span class="text-brand-purple">(t "landing.success_stories.percentage")</span> (t "landing.success_stories.since_inception")
             </span>
            {{{icon 'arrow-up-right' class='text-brand-purple transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform w-3 h-3'}}}
          </div>

          <!-- CTA Button -->
          <button class="shiny-cta group !px-7 !py-3">
             <span class="text-sm font-medium">(t "landing.success_stories.start_building")</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>