{
  "name": "Accelerator",
  "version": "1.0.0",
  "description": "AI-powered startup accelerator tool using SolidJS for state management and OpenAI for simulations",
  "repository": "https://github.com/iGate-Tech/Accelerator.git",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "concurrently \"vite\" \"nodemon server.js\"",
    "dev:vite": "vite",
    "dev:server": "nodemon server.js",
    "build": "vite build",
    "preview": "vite preview",
    "push": "git add . && git commit -m 'Update' && git push --all origin",
    "docker:dev": "docker compose -f docker/docker-compose.yml --env-file docker/.env.development up",
    "docker:dev:build": "docker compose -f docker/docker-compose.yml --env-file docker/.env.development up --build",
    "docker:staging": "docker compose -f docker/docker-compose.yml --env-file docker/.env.staging up",
    "docker:staging:build": "docker compose -f docker/docker-compose.yml --env-file docker/.env.staging up --build -d",
    "docker:prod": "docker compose -f docker/docker-compose.yml --env-file docker/.env.production up -d",
    "docker:prod:build": "docker compose -f docker/docker-compose.yml --env-file docker/.env.production up --build -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "generate-prd": "node scripts/generate-prd.js",
    "update-prd": "node scripts/update-prd.js",
    "update-progress": "node scripts/update-progress.js",
    "setup-ralph": "mkdir -p archive && cp PRD.md PRD.md.backup 2>/dev/null || echo 'No PRD.md to backup'",
    "ralph": "echo 'Run opencode with ralph agent for autonomous loop'",
    "lint": "eslint src/ server.js --ext .js,.jsx || echo 'ESLint not configured yet'",
    "typecheck": "echo 'Typecheck skipped - project uses JavaScript'",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@solidjs/router": "^0.15.4",
    "animate.css": "^4.1.1",
    "body-parser": "^2.2.1",
    "daisyui": "^5.5.14",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-sort": "^3.4.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^17.0.1",
    "openai": "^6.15.0",
    "pg": "^8.16.3",
    "solid-js": "^1.9.10",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "jsdom": "^27.4.0",
    "nodemon": "^3.1.11",
    "playwright": "^1.57.0",
    "postcss-preset-env": "^10.6.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17"
  }
}
