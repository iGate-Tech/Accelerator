<!DOCTYPE html>
 <html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if title}}{{title}}{{else}}ACC Agent{{/if}}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Electrolize&display=swap" rel="stylesheet">
        <link href="/output.css" rel="stylesheet">
       <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
       <script src="https://unpkg.com/htmx.org@1.9.10"></script>
</head>
    <body class="bg-base-100 text-base-content min-h-screen m-0">
        {{> navbar}}

          <div class="flex w-full">
         {{> sidebar rawData}}
          <div  class="w-full h-[calc(100vh-5rem)] overflow-y-auto">
               {{{body}}}
         </div>
         </div>
           <script src="/js/pglite.js?v=8"></script>
           <script src="/js/theme.js?v=8"></script>
           <script src="/js/language.js?v=8"></script>
            <script type="module" src="/js/sidebar.js?v=8"></script>
            <script src="/js/app.js?v=8"></script>
          <script>
              lucide.createIcons();
          </script>
          <script>
              // Active nav
              const navLinks = document.querySelectorAll('.nav-link');
              navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (window.location.pathname === href) {
                  link.classList.add('opacity-100', 'text-base-content');
                  link.parentElement.querySelector('.nav-bar').classList.add('opacity-100');
                }
              });
          </script>
  </body>
</html>