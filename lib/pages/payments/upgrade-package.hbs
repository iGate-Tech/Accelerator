<div class="p-20">
    <div class="grid gap-1  mb-12">
        <h1 class="font-heading text-3xl font-semibold text-foreground">
            {{t 'upgrade-package.title'}}
        </h1>
        <p class="text-lg text-muted-foreground">
            {{t 'upgrade-package.description'}}
        </p>
     </div>

     <div id="alert-container" class="w-full max-w-md mx-auto mb-4"></div>

     <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {{#each packages}}
        <div class="rounded-md bg-card px-6 py-5 text-card-foreground border-2 {{#if (eq type "student")}}border-primary relative{{else}}border-input/80{{/if}}">
            {{#if (eq type "student")}}
            <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                <span class="bg-primary text-primary-foreground text-xs px-3 py-1 rounded-md">{{t 'upgrade-package.most_popular'}}</span>
            </div>
            {{/if}}
            <div class="text-center mb-4">
                <h3 class="text-lg font-semibold text-foreground">{{name}}</h3>
                <p class="text-2xl font-bold text-foreground">
                    ${{divide price_monthly 100}}
                    <span class="text-sm font-normal text-muted-foreground">
                        {{t 'upgrade-package.month'}}
                    </span>
                </p>
            </div>
            <ul class="space-y-2 mb-6">
                {{#if (eq type "free")}}
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.vote_public'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.view_community'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{credits_monthly}} {{t 'upgrade-package.voting_rewards'}}
                    </li>
                {{else if (eq type "student")}}
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.create_manage'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.complete_models'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.generate_reports'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{credits_monthly}} {{t 'upgrade-package.ai_features'}}
                    </li>
                {{else if (eq type "enterprise")}}
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.all_student'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.portfolio_grouping'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.advanced_analytics'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{t 'upgrade-package.team_collaboration'}}
                    </li>
                    <li class="flex items-center gap-2 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-600'}}}
                        {{credits_monthly}} {{t 'upgrade-package.ai_features'}}
                    </li>
                {{/if}}
            </ul>
             <form method="POST" action="/upgrade-package" hx-post="/upgrade-package" hx-target="body" hx-swap="beforeend" hx-on:htmx:before-request="clearAlerts(); showLoading()" hx-on:htmx:after-swap="hideLoading()">
                <input type="hidden" name="package_type" value="{{type}}">
                {{#if (eq ../currentPackage type)}}
                    <button type="button" class="w-full px-4 py-2 bg-muted text-muted-foreground cursor-not-allowed rounded-md" disabled>
                        {{t 'upgrade-package.current_plan'}}
                    </button>
                {{else}}
                    <button type="submit" class="w-full {{#if (eq type "student")}}bg-primary text-primary-foreground hover:bg-primary/90{{else}}border border-input/80 text-foreground hover:bg-muted{{/if}} px-4 py-2 rounded-md transition-colors">
                        {{#if (eq type "free")}}{{t 'upgrade-package.select_free'}}{{else}}{{t 'upgrade-package.upgrade_to'}} {{name}}{{/if}}
                    </button>
                {{/if}}
            </form>
        </div>
        {{/each}}
     </div>

     <!-- Loading Screen -->
     <div id="auth-loading-screen" class="fixed inset-0 bg-background flex items-center justify-center z-50 hidden">
       <div class="text-center">
         <svg class="animate-spin h-16 w-16 sm:h-20 sm:w-20 md:h-24 md:w-24 mx-auto" viewBox="0 0 24 24">
           <defs>
             <linearGradient id="spinner-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
               <stop offset="0%" stop-color="#9e28b5"/>
               <stop offset="25%" stop-color="#00a7e0"/>
               <stop offset="50%" stop-color="#6cd14d"/>
               <stop offset="75%" stop-color="#ffc600"/>
               <stop offset="100%" stop-color="#9e28b5"/>
             </linearGradient>
           </defs>
           <circle cx="12" cy="12" r="10" stroke="url(#spinner-gradient)" stroke-width="2" fill="none"/>
         </svg>
          <h2 class="text-xl font-semibold text-foreground mt-4 mb-2">{{t 'loading.upgrade_package_title'}}</h2>
          <p class="text-muted-foreground">{{t 'loading.upgrade_package_description'}}</p>
       </div>
     </div>

     <script>
     function clearAlerts() {
         const alerts = document.querySelectorAll('.alert');
         alerts.forEach(alert => alert.remove());
     }

     // Auto-hide alerts after 5 seconds
     function setupAlertAutoHide() {
         setTimeout(() => {
           const alerts = document.querySelectorAll('.alert-auto-hide');
           alerts.forEach(alert => alert.remove());
         }, 5000);
     }

       // Setup auto-hide for alerts added via HTMX
       document.addEventListener('htmx:afterSwap', (event) => {
         if (event.detail.target === document.body) {
           setupAlertAutoHide();
         }
       });

       function showLoading() {
         document.getElementById('auth-loading-screen').classList.remove('hidden');
       }

       function hideLoading() {
         document.getElementById('auth-loading-screen').classList.add('hidden');
       }
     </script>

 </div>