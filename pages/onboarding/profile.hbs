<div class="min-h-screen bg-base-100 flex items-center justify-center px-4">
  <div class="max-w-md w-full">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-foreground mb-2">Complete Your Profile</h1>
      <p class="text-muted-foreground">Tell us a bit about yourself</p>
    </div>

    <form class="space-y-6" action="/api/user/profile" method="POST">
      <div>
        <label for="name" class="block text-sm font-medium text-foreground mb-2">Full Name</label>
        <input type="text" id="name" name="name" required class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
      </div>

      <div>
        <label for="company" class="block text-sm font-medium text-foreground mb-2">Company (Optional)</label>
        <input type="text" id="company" name="company" class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
      </div>

      <div>
        <label for="role" class="block text-sm font-medium text-foreground mb-2">Your Role</label>
        <select id="role" name="role" required class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="">Select your role</option>
          <option value="entrepreneur">Entrepreneur</option>
          <option value="founder">Founder</option>
          <option value="developer">Developer</option>
          <option value="designer">Designer</option>
          <option value="investor">Investor</option>
          <option value="consultant">Consultant</option>
          <option value="student">Student</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div>
        <label for="experience" class="block text-sm font-medium text-foreground mb-2">Experience Level</label>
        <select id="experience" name="experience" required class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="">Select experience level</option>
          <option value="beginner">Beginner - New to entrepreneurship</option>
          <option value="intermediate">Intermediate - Some experience</option>
          <option value="advanced">Advanced - Multiple ventures</option>
          <option value="expert">Expert - Serial entrepreneur</option>
        </select>
      </div>

      <div>
        <label for="goals" class="block text-sm font-medium text-foreground mb-2">What are your main goals?</label>
        <textarea id="goals" name="goals" rows="3" placeholder="e.g., Launch my first product, raise funding, build a team..." class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
      </div>

      <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-primary-foreground py-3 px-4 rounded-md font-medium transition">
        Complete Profile
      </button>
    </form>

    <div class="text-center mt-4">
      <a href="/onboarding/tutorial" class="text-sm text-muted-foreground hover:text-primary">Skip for now</a>
    </div>
  </div>
</div>