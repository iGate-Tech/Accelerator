{{> progress-bar activeStep=activeStep ideaId=ideaId}}

{{> model-header title=pageTitle description= (t "models.team.overview")
ratingStars="★★★★★" ratingValue="5.0" voteCount="0 votes" category=ideaCategory tags=ideaTags}}

{{> model-progress data='[
  {
    "id": "team-overview",
    "fullLabel": "1. Team Overview",
    "shortLabel": "1.",
    "position": 0
  },
  {
    "id": "team-roles-responsibilities",
    "fullLabel": "2. Team Roles & Responsibilities",
    "shortLabel": "2.",
    "position": 25
  },
  {
    "id": "skills-matrix",
    "fullLabel": "3. Skills Matrix",
    "shortLabel": "3.",
    "position": 50
  },
  {
    "id": "hiring-plan",
    "fullLabel": "4. Hiring Plan",
    "shortLabel": "4.",
    "position": 75
  },
  {
    "id": "compensation-equity",
    "fullLabel": "5. Compensation & Equity",
    "shortLabel": "5.",
    "position": 100
  }
]'}}

<main class="flex flex-col mx-auto items-center justify-center">
    <div class="sections-container">
        <!-- Team Overview Section -->
        <div id="team-overview" class="section mb-6">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Team Overview</h2>
            <p class="text-muted-foreground mb-6">Assess your current team composition.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="team-overview-q1" step="1" question="How many founders are in your team?" placeholder="This section counts your founders. Include all co-founders in the founding team. AI can help with founder dynamics. Use this section for team foundation. Chat with AI to understand founder roles or get team structure advice."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="team-overview-q2" step="2" question="How many employees do you have?" placeholder="This section counts your employees. Exclude founders from this count. AI can help with staffing needs. Use this section for headcount planning. Chat with AI to understand team sizing or get growth recommendations."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
                     <div class="flex-1">
                          {{> question-block id="team-overview-q3" step="3" question="What is your team structure?" placeholder="This section describes team organization. Specify hierarchical, flat, or other structures. AI can suggest optimal structures. Use this section for organizational design. Chat with AI to learn team structures or get design recommendations."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">4</div>
                     <div class="flex-1">
                          {{> question-block id="team-overview-q4" step="4" question="How ready is your team to execute?" placeholder="This section assesses team readiness. Rate low to high ability to execute business plans. AI can help identify gaps. Use this section for capability evaluation. Chat with AI to understand team readiness or get improvement suggestions."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">5</div>
                     <div class="flex-1">
                          {{> question-block id="team-overview-q5" step="5" question="What is your working model?" placeholder="This section defines working arrangements. Specify office, remote, or hybrid models. AI can help with work model decisions. Use this section for operational setup. Chat with AI to understand work models or get productivity advice."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="(t "models.team.section_completed")" buttonText="(t "models.team.move_next")"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Roles & Responsibilities Section -->
        <div id="team-roles-responsibilities" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Team Roles & Responsibilities</h2>
            <p class="text-muted-foreground mb-6">Define roles and duties.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="team-roles-responsibilities-q1" step="6" question="Define key team roles and responsibilities." placeholder="This section defines team roles. List key positions and their main responsibilities. AI can suggest role structures. Use this section for job descriptions. Chat with AI to understand team roles or get role definition help."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="team-roles-responsibilities-q2" step="7" question="List key roles and their responsibilities." placeholder="This section details role responsibilities. Provide comprehensive duties for each position. AI can help refine descriptions. Use this section for accountability. Chat with AI to improve role definitions or get responsibility clarification."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="(t "models.team.section_completed")" buttonText="(t "models.team.move_next")"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Skills Matrix Section -->
        <div id="skills-matrix" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Skills Matrix</h2>
            <p class="text-muted-foreground mb-6">Evaluate team competencies.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="skills-matrix-q1" step="8" question="Assess your team's skills." placeholder="This section evaluates team skills. Map technical, soft, and business skills across team members. AI can help create skill matrices. Use this section for capability assessment. Chat with AI to understand skills assessment or get matrix creation help."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="(t "models.team.section_completed")" buttonText="(t "models.team.move_next")"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Hiring Plan Section -->
        <div id="hiring-plan" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Hiring Plan</h2>
            <p class="text-muted-foreground mb-6">Plan future recruitment.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="hiring-plan-q1" step="9" question="What is your hiring plan?" placeholder="This section outlines hiring strategy. Plan recruitment based on skill gaps and growth needs. AI can suggest hiring timelines. Use this section for talent acquisition. Chat with AI to learn hiring strategies or get plan development help."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="(t "models.team.section_completed")" buttonText="(t "models.team.move_next")"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Compensation & Equity Section -->
        <div id="compensation-equity" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Compensation & Equity</h2>
            <p class="text-muted-foreground mb-6">Design pay and ownership structure.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="compensation-equity-q1" step="10" question="Describe your compensation and equity structure." placeholder="This section designs compensation. Include salaries, equity bands, and overall structure. AI can recommend fair ranges. Use this section for competitive pay. Chat with AI to understand compensation or get equity structure advice."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="(t "models.team.complete_team")" buttonText="(t "models.team.complete_team_button")"}}
                    </div>
                </div>
            </div>
        </div>
     </div>
</main>

<div class=" h-[300px]"></div>

