<main id="notification-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Notifications
          </h1>
          <p class="text-lg text-muted-foreground">
            Stay updated with the latest alerts and messages
          </p>
        </div>
      <div class="flex items-center gap-2">
            <button id="mark-all-read-btn" class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
              Mark All as Read
            </button>
         </div>
      </div>

      <!-- Notification List -->
      <div id="notifications-list" class="space-y-4">
        <div id="loading-notifications" class="text-center py-8">
          <div class="inline-flex items-center gap-2 text-muted-foreground">
            {{{icon "loader" class="animate-spin w-4 h-4"}}}
            Loading notifications...
          </div>
        </div>
      </div>

      <!-- Load More -->
       <div class="text-center py-4">
         <button class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
           Load More Notifications
         </button>
       </div>
    </div>
  </div>

</main>