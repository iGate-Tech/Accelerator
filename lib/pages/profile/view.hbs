<main class="overflow-y-auto bg-background min-h-[calc(100vh-4rem)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8">
      <div class="space-y-8">

        <!-- Header -->
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-foreground">{{profileUser.name}}'s Profile</h1>
            <p class="text-muted-foreground mt-2">Member since {{formatDate profileUser.created_at}}</p>
          </div>
          {{#if isOwnProfile}}
          <a href="/settings" class="px-4 py-2 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors">
            Edit Profile
          </a>
          {{/if}}
        </div>

        <!-- Profile Information -->
        <div class="bg-card rounded-lg border border-border shadow-sm p-6">
          <div class="flex flex-col sm:flex-row gap-6">
            <!-- Avatar Section -->
            <div class="flex flex-col items-center sm:items-start">
              <img src="{{#if profileUser.avatar_url}}{{profileUser.avatar_url}}{{else}}/images/avatar.png{{/if}}" class="h-32 w-32 rounded-full object-cover border-4 border-primary/20" alt="Profile Avatar">
            </div>

            <!-- Profile Details -->
            <div class="flex-1 space-y-4">
              <div>
                <label class="block text-sm font-medium text-foreground mb-1">Full Name</label>
                <p class="text-foreground text-lg">{{profileUser.name}}</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-foreground mb-1">Bio</label>
                <p class="text-foreground">{{profileUser.bio}}{{#unless profileUser.bio}}<span class="text-muted-foreground">No bio added yet</span>{{/unless}}</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-foreground mb-1">Location</label>
                <p class="text-foreground">{{profileUser.location}}{{#unless profileUser.location}}<span class="text-muted-foreground">No location set</span>{{/unless}}</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-foreground mb-1">Package</label>
                <p class="text-foreground">{{profileUser.packageName}}{{#unless profileUser.packageName}}<span class="text-muted-foreground">Free Plan</span>{{/unless}}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Statistics -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-card rounded-lg border border-border shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-2 bg-blue-100 rounded-lg">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-muted-foreground">Public Ideas</p>
                <p class="text-2xl font-bold text-foreground">{{stats.ideas.total}}</p>
              </div>
            </div>
          </div>

          <div class="bg-card rounded-lg border border-border shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-2 bg-green-100 rounded-lg">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-muted-foreground">Completed Ideas</p>
                <p class="text-2xl font-bold text-foreground">{{stats.ideas.completed}}</p>
              </div>
            </div>
          </div>

          <div class="bg-card rounded-lg border border-border shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-2 bg-yellow-100 rounded-lg">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-muted-foreground">Average Rating</p>
                <p class="text-2xl font-bold text-foreground">{{stats.ideas.averageRating}}★</p>
              </div>
            </div>
          </div>

          <div class="bg-card rounded-lg border border-border shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-2 bg-purple-100 rounded-lg">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-muted-foreground">Completion Rate</p>
                <p class="text-2xl font-bold text-foreground">{{stats.ideas.completionRate}}%</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Public Ideas -->
        {{#if publicIdeas.length}}
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-6">
            <h2 class="text-xl font-semibold text-foreground mb-4">Public Ideas</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {{#each publicIdeas}}
              <div class="border border-border rounded-lg p-4 hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between mb-2">
                  <h3 class="font-semibold text-foreground truncate">{{title}}</h3>
                  <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded">{{category}}</span>
                </div>
                {{#if description}}
                <p class="text-sm text-muted-foreground mb-3 line-clamp-2">{{description}}</p>
                {{/if}}
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                  <span>Completion: {{completion_percentage}}%</span>
                  {{#if rating}}
                  <span class="flex items-center">
                    {{{icon 'star' class='w-3 h-3 text-yellow-500 mr-1'}}}
                    {{rating}}
                  </span>
                  {{/if}}
                </div>
                <div class="mt-3">
                  <a href="/models/idea?ideaId={{id}}" class="text-primary hover:underline text-sm">
                    View Idea →
                  </a>
                </div>
              </div>
              {{/each}}
            </div>
          </div>
        </div>
        {{/if}}

        <!-- Recent Activity -->
        {{#if stats.activity.length}}
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-6">
            <h2 class="text-xl font-semibold text-foreground mb-4">Recent Activity</h2>
            <div class="space-y-4">
              {{#each stats.activity}}
                <div class="flex items-start gap-3 p-3 rounded-lg bg-muted/30">
                  <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
                    {{#if (eq action_type "idea_created")}}
                      {{{icon 'lightbulb' class='w-4 h-4 text-primary'}}}
                    {{else if (eq action_type "vote_cast")}}
                      {{{icon 'star' class='w-4 h-4 text-yellow-500'}}}
                    {{else if (eq action_type "model_completed")}}
                      {{{icon 'check-circle' class='w-4 h-4 text-green-500'}}}
                    {{else if (eq action_type "profile_updated")}}
                      {{{icon 'user' class='w-4 h-4 text-blue-500'}}}
                    {{else}}
                      {{{icon 'activity' class='w-4 h-4 text-gray-500'}}}
                    {{/if}}
                  </div>
                  <div class="flex-1">
                    <p class="text-sm text-foreground">
                      {{#if (eq action_type "idea_created")}}
                        Created a new idea
                      {{else if (eq action_type "vote_cast")}}
                        Cast a vote on an idea
                      {{else if (eq action_type "model_completed")}}
                        Completed a business model
                      {{else if (eq action_type "profile_updated")}}
                        Updated profile information
                      {{else}}
                        {{action_type}}
                      {{/if}}
                    </p>
                    <p class="text-xs text-muted-foreground">{{formatDate created_at}}</p>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        </div>
        {{/if}}

      </div>
    </div>
  </main>
</div>