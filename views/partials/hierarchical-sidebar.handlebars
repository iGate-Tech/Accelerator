<!-- Hierarchical Sidebar -->
  <div class="sidebar relative w-[400px] bg-base-100 rounded-2xl p-3 shadow-sm border border-base-200 h-[85vh] overflow-y-auto">
  <!-- Tabs -->
  <div class="tabs tabs-box mb-3">
    <input type="radio" name="sidebar_tabs" class="tab" aria-label="Make" checked />
    <input type="radio" name="sidebar_tabs" class="tab" aria-label="Edit" />
    <input type="radio" name="sidebar_tabs" class="tab" aria-label="Reports" />
    <button class="btn btn-ghost btn-sm ml-auto" popovertarget="root_popover" onclick="event.stopPropagation()">
      <i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i>
    </button>
    <ul class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm" popover id="root_popover">
      <li><a onclick="addSubToRoot()">Add sub</a></li>
      <li><a onclick="addLeafToRoot()">Add leaf</a></li>
    </ul>
  </div>

   <ul class="menu  w-full">
     {{#each this}}
     <li>
       {{> hierarchical-node node=.}}
     </li>
     {{/each}}
   </ul>
</div>