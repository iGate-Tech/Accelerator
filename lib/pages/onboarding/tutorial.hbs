<div class="w-full min-h-screen flex flex-col lg:flex-row items-center justify-center">
  <div class="flex items-center">
    <div class="flex flex-col items-center justify-center h-full gap-6 w-full max-w-6xl mx-auto px-6">

      <!-- Header Section -->
      <div class="grid gap-2 text-center mb-8">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-primary to-secondary rounded-2xl mb-6 shadow-lg">
{{{icon 'book-open' class="w-10 h-10 text-primary-foreground"}}}
        </div>
        <h1 class="text-4xl font-bold bg-gradient-to-r from-foreground via-primary to-secondary bg-clip-text text-transparent">
          Welcome to Accelerator!
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl">
          Let's take a quick tour of your startup journey platform. We'll show you everything you need to know to get started.
        </p>
      </div>

      <!-- Progress Section -->
      <div class="w-full max-w-2xl mb-8">
        <div class="flex justify-between items-center mb-4">
          <span class="text-sm font-medium text-muted-foreground">Tutorial Progress</span>
          <span class="text-sm font-medium text-muted-foreground" id="progress-text">1 of 5 steps</span>
        </div>
        <div class="w-full bg-muted rounded-full h-3 mb-6">
          <div class="bg-gradient-to-r from-primary to-secondary h-3 rounded-full transition-all duration-500" id="progress-bar" style="width: 20%"></div>
        </div>

        <!-- Step Indicators -->
        <div class="flex justify-center space-x-3">
          <div class="w-3 h-3 bg-primary rounded-full transition-all duration-300" data-step="1"></div>
          <div class="w-3 h-3 bg-muted rounded-full transition-all duration-300" data-step="2"></div>
          <div class="w-3 h-3 bg-muted rounded-full transition-all duration-300" data-step="3"></div>
          <div class="w-3 h-3 bg-muted rounded-full transition-all duration-300" data-step="4"></div>
          <div class="w-3 h-3 bg-muted rounded-full transition-all duration-300" data-step="5"></div>
        </div>
      </div>

      <!-- Tutorial Content Container -->
      <div class="bg-card/95 backdrop-blur-sm rounded-3xl shadow-2xl border border-border/50 p-8 md:p-12 w-full max-w-4xl min-h-[500px] transition-all duration-500" id="tutorial-step">
        <!-- Step content will be loaded here by JavaScript -->
        <div class="text-center py-12">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 rounded-2xl mb-6">
{{{icon 'book-open' class="w-8 h-8 text-primary"}}}
          </div>
          <p class="text-muted-foreground">Loading tutorial...</p>
        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="flex justify-between items-center w-full max-w-4xl mt-8">
        <button id="prev-step" class="px-8 py-3 border border-border text-foreground hover:bg-muted rounded-xl transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-transparent flex items-center space-x-2">
{{{icon 'chevron-left' class="w-4 h-4"}}}
          <span>Previous</span>
        </button>

        <div class="text-center">
          <div class="text-sm text-muted-foreground mb-2">Step <span id="current-step">1</span> of <span id="total-steps">5</span></div>
        </div>

        <button id="next-step" class="px-8 py-3 bg-primary text-primary-foreground hover:bg-primary/90 rounded-xl transition-colors flex items-center space-x-2 shadow-lg">
          <span>Next</span>
{{{icon 'chevron-right' class="w-4 h-4"}}}
        </button>
      </div>

      <!-- Completion Section (Hidden by default) -->
      <div class="bg-card/95 backdrop-blur-sm rounded-3xl shadow-2xl border border-border/50 p-8 md:p-12 w-full max-w-4xl hidden" id="tutorial-complete">
        <!-- Background decoration -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-full -mr-16 -mt-16"></div>
        <div class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-br from-accent/20 to-primary/20 rounded-full -ml-12 -mb-12"></div>

        <div class="relative text-center">
          <div class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-br from-emerald-600 to-teal-600 rounded-3xl mb-8 shadow-xl">
{{{icon 'check' class="w-12 h-12 text-white"}}}
          </div>

          <h2 class="text-4xl font-bold bg-gradient-to-r from-foreground via-primary to-secondary bg-clip-text text-transparent mb-6">
            Tutorial Complete!
          </h2>

          <p class="text-xl text-muted-foreground mb-10 max-w-2xl mx-auto leading-relaxed">
            Congratulations! You've completed the Accelerator tutorial. You're now ready to start building amazing startups.
            Remember, you can always revisit this tutorial from your settings.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <div class="text-center">
              <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
{{{icon 'lightbulb' class="w-8 h-8 text-white"}}}
              </div>
              <h3 class="font-semibold text-foreground mb-2">Create Ideas</h3>
              <p class="text-sm text-muted-foreground">Start with your first startup concept</p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
{{{icon 'users' class="w-8 h-8 text-white"}}}
              </div>
              <h3 class="font-semibold text-foreground mb-2">Get Feedback</h3>
              <p class="text-sm text-muted-foreground">Share and validate with community</p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
{{{icon 'building' class="w-8 h-8 text-white"}}}
              </div>
              <h3 class="font-semibold text-foreground mb-2">Build Models</h3>
              <p class="text-sm text-muted-foreground">Create comprehensive business plans</p>
            </div>
          </div>

          <form method="POST" action="/onboarding/tutorial">
            <input type="hidden" name="_csrf" value="{{{csrf}}}" />
            <button type="submit" class="w-full bg-gradient-to-r from-primary via-secondary to-accent hover:from-primary/90 hover:via-secondary/90 hover:to-accent/90 text-primary-foreground font-bold py-5 px-8 rounded-2xl transition-all duration-300 transform hover:scale-105 shadow-2xl hover:shadow-3xl flex items-center justify-center space-x-3 text-lg">
              <span>Let's Build Something Amazing!</span>
{{{icon 'trending-up' class="w-6 h-6"}}}
            </button>
          </form>

          <p class="text-sm text-muted-foreground mt-6">
            Need help? Visit our <a href="#" class="text-primary hover:text-primary/80 font-medium transition-colors">help center</a> or contact <a href="#" class="text-primary hover:text-primary/80 font-medium transition-colors">support</a>.
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const tutorialStep = document.getElementById('tutorial-step');
      const progressBar = document.getElementById('progress-bar');
      const progressText = document.getElementById('progress-text');
      const currentStepSpan = document.getElementById('current-step');
      const totalStepsSpan = document.getElementById('total-steps');
      const prevButton = document.getElementById('prev-step');
      const nextButton = document.getElementById('next-step');
      const stepIndicators = document.querySelectorAll('[data-step]');
      const tutorialComplete = document.getElementById('tutorial-complete');

      let currentStep = 1;
      const totalSteps = 5;

      // Tutorial step content
      const steps = [
        {
          title: "Welcome to Accelerator",
          content: `
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-primary to-secondary rounded-3xl mb-8 shadow-lg">
                {{{icon 'book-open' class="w-10 h-10 text-primary-foreground"}}}
              </div>
              <h2 class="text-3xl font-bold text-foreground mb-6">Your Startup Journey Begins</h2>
              <p class="text-lg text-muted-foreground mb-8 max-w-2xl mx-auto leading-relaxed">
                Welcome to Accelerator, your AI-powered platform for turning ideas into successful startups.
                We're excited to guide you through everything you need to know to get started.
              </p>
              <div class="bg-primary/10 border border-primary/20 rounded-2xl p-6 max-w-md mx-auto">
                <h3 class="font-semibold text-foreground mb-3">What you'll learn:</h3>
                <ul class="text-muted-foreground space-y-2 text-left">
                  <li class="flex items-center space-x-2">
{{{icon 'check' class="w-4 h-4 text-primary"}}}
                    <span>Creating and managing ideas</span>
                  </li>
                  <li class="flex items-center space-x-2">
{{{icon 'check' class="w-4 h-4 text-primary"}}}
                    <span>Getting community feedback</span>
                  </li>
                  <li class="flex items-center space-x-2">
{{{icon 'check' class="w-4 h-4 text-primary"}}}
                    <span>Building business models</span>
                  </li>
                </ul>
              </div>
            </div>
          `
        },
        {
          title: "Your Dashboard",
          content: `
            <div class="flex flex-col lg:flex-row items-start gap-8">
              <div class="flex-shrink-0">
                <div class="w-16 h-16 bg-gradient-to-br from-primary to-primary/80 rounded-2xl flex items-center justify-center shadow-lg">
                  <span class="text-primary-foreground font-bold text-2xl">2</span>
                </div>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-4 mb-6">
                  <h3 class="text-3xl font-bold bg-gradient-to-r from-primary-700 to-primary bg-clip-text text-transparent">Your Dashboard</h3>
                  <div class="h-px bg-gradient-to-r from-primary/50 to-transparent flex-1"></div>
                </div>
                <p class="text-muted-foreground text-xl mb-8 leading-relaxed">
                  Your central hub for tracking progress, managing ideas, and monitoring your startup journey.
                  Here you'll see your credit balance, idea completion status, and recent activity.
                </p>
                <div class="bg-gradient-to-r from-primary/10 to-secondary/10 border border-primary/20 rounded-2xl p-6">
                  <h4 class="font-bold text-foreground mb-4 flex items-center">
{{{icon 'info' class="w-5 h-5 mr-2 text-primary"}}}
                    What you'll find:
                  </h4>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex items-center space-x-3">
                      <div class="w-8 h-8 bg-blue-500/10 rounded-full flex items-center justify-center">
{{{icon 'dollar-sign' class="w-4 h-4 text-blue-600 dark:text-blue-400"}}}
                      </div>
                      <span class="text-muted-foreground font-medium">Credit balance & usage</span>
                    </div>
                    <div class="flex items-center space-x-3">
                      <div class="w-8 h-8 bg-green-500/10 rounded-full flex items-center justify-center">
{{{icon 'bar-chart-2' class="w-4 h-4 text-green-600 dark:text-green-400"}}}
                      </div>
                      <span class="text-muted-foreground font-medium">Idea progress tracking</span>
                    </div>
                    <div class="flex items-center space-x-3">
                      <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
{{{icon 'clock' class="w-4 h-4 text-primary"}}}
                      </div>
                      <span class="text-muted-foreground font-medium">Recent activity feed</span>
                    </div>
                    <div class="flex items-center space-x-3">
                      <div class="w-8 h-8 bg-amber-500/10 rounded-full flex items-center justify-center">
{{{icon 'plus' class="w-4 h-4 text-amber-600 dark:text-amber-400"}}}
                      </div>
                      <span class="text-muted-foreground font-medium">Quick idea creation</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-shrink-0">
                <div class="w-40 h-32 bg-gradient-to-br from-primary/10 to-secondary/10 rounded-2xl flex items-center justify-center shadow-lg">
{{{icon 'building' class="w-16 h-16 text-primary"}}}
                </div>
              </div>
            </div>
          `
        },
        {
          title: "Creating Ideas",
          content: `
            <div class="flex items-start gap-6">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center">
                  <span class="text-white font-bold text-lg">3</span>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-foreground mb-3">Creating Ideas</h3>
                <p class="text-muted-foreground text-lg mb-4">
                  Start your entrepreneurial journey by creating your first startup idea. You can either write your own concept
                  or let our AI generate creative suggestions for you.
                </p>
                <div class="bg-green-500/10 border border-green-500/20 rounded-lg p-4">
                  <h4 class="font-semibold text-foreground mb-2">How to get started:</h4>
                  <ul class="text-muted-foreground space-y-1">
                    <li>• Click "Create New Idea" from your dashboard</li>
                    <li>• Try "Random Idea Generator" for inspiration</li>
                    <li>• Set your idea to public for community voting</li>
                    <li>• Use AI assistance to refine your concept</li>
                  </ul>
                </div>
              </div>
              <div class="flex-shrink-0">
                <div class="w-32 h-24 bg-green-100 rounded-lg flex items-center justify-center">
{{{icon 'lightbulb' class="w-12 h-12 text-green-600"}}}
                </div>
              </div>
            </div>
          `
        },
        {
          title: "Getting Feedback",
          content: `
            <div class="flex items-start gap-6">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center">
                  <span class="text-white font-bold text-lg">4</span>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-foreground mb-3">Getting Feedback</h3>
                <p class="text-muted-foreground text-lg mb-4">
                  Share your ideas with the Accelerator community to get valuable feedback and validation.
                  Community voting helps you understand market interest.
                </p>
                <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-4">
                  <h4 class="font-semibold text-foreground mb-2">Community benefits:</h4>
                  <ul class="text-muted-foreground space-y-1">
                    <li>• Get honest feedback from entrepreneurs</li>
                    <li>• Validate your idea before investing time</li>
                    <li>• Earn credits through community engagement</li>
                    <li>• Network with like-minded creators</li>
                  </ul>
                </div>
              </div>
              <div class="flex-shrink-0">
                <div class="w-32 h-24 bg-blue-100 rounded-lg flex items-center justify-center">
{{{icon 'users' class="w-12 h-12 text-blue-600"}}}
                </div>
              </div>
            </div>
          `
        },
        {
          title: "Next Steps",
          content: `
            <div class="text-center">
              <div class="w-20 h-20 bg-gradient-to-br from-primary to-secondary rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
{{{icon 'trending-up' class="w-10 h-10 text-primary-foreground"}}}
              </div>
              <h3 class="text-2xl font-bold text-foreground mb-4">You're Ready to Start!</h3>
              <p class="text-muted-foreground text-lg mb-6 max-w-2xl mx-auto">
                You've learned the basics of using Accelerator. Now it's time to put your knowledge into action
                and start building your startup idea.
              </p>
              <div class="bg-primary/10 border border-primary/20 rounded-lg p-4 max-w-md mx-auto">
                <h4 class="font-semibold text-foreground mb-2">What to do next:</h4>
                <ul class="text-muted-foreground space-y-1 text-left">
                  <li>• Create your first idea</li>
                  <li>• Explore the community</li>
                  <li>• Try building a business model</li>
                  <li>• Share your progress</li>
                </ul>
              </div>
            </div>
          `
        }
      ];

      function updateStep() {
        // Update progress
        const progressPercent = (currentStep / totalSteps) * 100;
        progressBar.style.width = progressPercent + '%';
        currentStepSpan.textContent = currentStep;
        progressText.textContent = `${currentStep} of ${totalSteps} steps`;

        // Update step indicators
        stepIndicators.forEach((indicator, index) => {
          if (index + 1 === currentStep) {
            indicator.classList.remove('bg-muted');
            indicator.classList.add('bg-primary');
          } else {
            indicator.classList.remove('bg-primary');
            indicator.classList.add('bg-muted');
          }
        });

        // Update navigation buttons
        prevButton.disabled = currentStep === 1;
        if (currentStep === totalSteps) {
          nextButton.innerHTML = `
            Complete Tutorial
{{{icon 'check' class="w-4 h-4 ml-2 inline"}}}
          `;
        } else {
          nextButton.innerHTML = `
            Next
{{{icon 'chevron-right' class="w-4 h-4 ml-2 inline"}}}
          `;
        }

        // Load step content
        tutorialStep.innerHTML = steps[currentStep - 1].content;
      }

      function nextStep() {
        if (currentStep < totalSteps) {
          currentStep++;
          updateStep();
        } else {
          // Complete tutorial
          tutorialStep.classList.add('hidden');
          document.querySelector('.flex.justify-between.items-center').classList.add('hidden');
          tutorialComplete.classList.remove('hidden');
        }
      }

      function prevStep() {
        if (currentStep > 1) {
          currentStep--;
          updateStep();
        }
      }

      // Event listeners
      nextButton.addEventListener('click', nextStep);
      prevButton.addEventListener('click', prevStep);

      // Initialize first step
      updateStep();
    });
  </script>
</div>