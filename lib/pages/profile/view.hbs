<!-- Profile View Page -->
<main class="flex-1 overflow-auto bg-background">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Profile Header -->
    <div class="bg-card rounded-lg border border-border shadow-sm p-6 mb-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <!-- Avatar -->
        <div class="flex-shrink-0">
          <img src="{{cond profile.avatar_url profile.avatar_url '/images/avatar.png'}}"
               alt="{{profile.name}}'s avatar"
               class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border-2 border-border"
               onerror="this.src='/images/avatar.png'">
        </div>

        <!-- Profile Info -->
        <div class="flex-1 min-w-0">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
            <h1 class="text-2xl sm:text-3xl font-bold text-foreground truncate">{{profile.name}}</h1>
            {{#if isOwnProfile}}
            <a href="/settings" class="btn btn-outline btn-sm whitespace-nowrap">
              {{{icon 'settings' class='w-4 h-4 mr-2'}}}
              {{t 'profile.edit_profile'}}
            </a>
            {{/if}}
          </div>

          {{#if profile.role}}
          <p class="text-muted-foreground mb-2 capitalize">{{profile.role}}</p>
          {{/if}}

          {{#if (and profile.preferences profile.preferences.bio)}}
          <p class="text-foreground mb-3">{{profile.preferences.bio}}</p>
          {{/if}}

          <!-- Contact Info -->
          <div class="flex flex-wrap gap-4 text-sm text-muted-foreground">
            {{#if (and profile.preferences profile.preferences.location)}}
            <div class="flex items-center gap-1">
              {{{icon 'map-pin' class='w-4 h-4'}}}
              <span>{{profile.preferences.location}}</span>
            </div>
            {{/if}}
            {{#if (and profile.preferences profile.preferences.website)}}
            <div class="flex items-center gap-1">
              {{{icon 'globe' class='w-4 h-4'}}}
              <a href="{{profile.preferences.website}}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                {{profile.preferences.website}}
              </a>
            </div>
            {{/if}}
            <div class="flex items-center gap-1">
              {{{icon 'package' class='w-4 h-4'}}}
              <span>{{profileUser.packageName}}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <!-- Total Ideas -->
      <div class="bg-card rounded-lg border border-border p-4 text-card-foreground shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex flex-col gap-1">
            <h3 class="text-sm font-medium text-muted-foreground">{{t 'home.overview.total_ideas'}}</h3>
            <p class="text-2xl font-semibold text-foreground">{{stats.ideas.total}}</p>
          </div>
          <div class="bg-primary/20 rounded-lg p-2">
            <div class="w-8 h-8 bg-primary/20 rounded-lg relative flex items-center justify-center">
              {{{icon 'lightbulb' class='w-5 h-5 text-primary'}}}
            </div>
          </div>
        </div>
      </div>

      <!-- Completion Rate -->
      <div class="bg-card rounded-lg border border-border p-4 text-card-foreground shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex flex-col gap-1">
            <h3 class="text-sm font-medium text-muted-foreground">{{t 'home.overview.completion_rate'}}</h3>
            <p class="text-2xl font-semibold text-foreground">{{stats.ideas.completionRate}}%</p>
          </div>
          <div class="bg-success/20 rounded-lg p-2">
            <div class="w-8 h-8 bg-success/20 rounded-lg relative flex items-center justify-center">
              {{{icon 'check-circle' class='w-5 h-5 text-success'}}}
            </div>
          </div>
        </div>
      </div>

      <!-- Average Rating -->
      <div class="bg-card rounded-lg border border-border p-4 text-card-foreground shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex flex-col gap-1">
            <h3 class="text-sm font-medium text-muted-foreground">{{t 'profile.average_rating'}}</h3>
            <p class="text-2xl font-semibold text-foreground">{{stats.ideas.averageRating}}</p>
          </div>
          <div class="bg-warning/20 rounded-lg p-2">
            <div class="w-8 h-8 bg-warning/20 rounded-lg relative flex items-center justify-center">
              {{{icon 'star' class='w-5 h-5 text-warning'}}}
            </div>
          </div>
        </div>
      </div>


    </div>

    <!-- Public Ideas Section -->
    {{#if publicIdeas.length}}
    <div class="bg-card rounded-lg border border-border shadow-sm mb-6">
      <div class="p-6 border-b border-border">
        <h2 class="text-xl font-semibold text-foreground">{{t 'profile.public_ideas'}}</h2>
        <p class="text-sm text-muted-foreground mt-1">{{t 'profile.public_ideas_subtitle'}}</p>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each publicIdeas}}
          <div class="bg-muted/50 rounded-lg p-4 border border-border hover:border-primary/50 transition-colors">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <h3 class="font-medium text-foreground truncate mb-2">{{this.title}}</h3>
                {{#if this.description}}
                <p class="text-sm text-muted-foreground line-clamp-2 mb-3">{{this.description}}</p>
                {{/if}}
                <div class="flex items-center gap-4 text-xs text-muted-foreground">
                  {{#if this.category}}
                  <span class="bg-primary/10 text-primary px-2 py-1 rounded">{{this.category}}</span>
                  {{/if}}
                  {{#if this.created_at}}
                  <span>{{formatDate this.created_at}}</span>
                  {{/if}}
                </div>
              </div>
              <a href="/ideas/{{this.id}}" class="btn btn-ghost btn-sm p-2">
                {{{icon 'arrow-right' class='w-4 h-4'}}}
              </a>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
    {{/if}}





    <!-- Empty State -->
    {{#unless publicIdeas.length}}
    <div class="text-center py-12">
      <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
        {{{icon 'user' class='w-8 h-8 text-muted-foreground'}}}
      </div>
      <h3 class="text-lg font-medium text-foreground mb-2">{{t 'profile.no_activity_title'}}</h3>
      <p class="text-muted-foreground">{{t 'profile.no_activity_subtitle'}}</p>
    </div>
    {{/unless}}
  </div>
</main>