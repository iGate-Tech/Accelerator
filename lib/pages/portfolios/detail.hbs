<main id="portfolio-detail-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <!-- Header Section -->
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center">
              {{{icon 'folder' class='w-6 h-6 text-primary' size='24'}}}
            </div>
            <div>
              <h1 class="font-heading text-3xl font-semibold text-foreground">
                {{portfolio.name}}
              </h1>
               <p class="text-lg text-muted-foreground w-full break-words">
                 {{#if portfolio.description}}{{portfolio.description}}{{else}}Organize and track your business ideas{{/if}}
               </p>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          {{#if portfolio.canEdit}}
          <button class="btn btn-outline" onclick="openInviteModal()">
            {{{icon 'user-plus' class='w-4 h-4 mr-2' size='16'}}}
            Invite Member
          </button>
          <a href="/portfolios/{{portfolio.id}}/ideas" class="btn btn-primary">
            {{{icon 'plus' class='w-4 h-4 mr-2' size='16'}}}
            {{t 'portfolios.portfolios.add_ideas'}}
          </a>
          {{/if}}
        </div>
      </div>

      <!-- Portfolio Stats -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Total Ideas</h3>
              <p class="text-2xl font-semibold text-foreground">{{portfolio.stats.totalIdeas}}</p>
            </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">
                    {{{icon 'lightbulb' class='w-4 h-4 text-primary-foreground' size='16'}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Completed</h3>
              <p class="text-2xl font-semibold text-foreground">{{portfolio.stats.completedIdeas}}</p>
            </div>
            <div>
              <div class="bg-success/20 rounded-lg">
                <div class="w-10 h-10 bg-success/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">
{{{icon 'check-circle' class='w-4 h-4 text-success-foreground' size='16'}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Avg Completion</h3>
              <p class="text-2xl font-semibold text-foreground">{{portfolio.stats.averageCompletion}}%</p>
            </div>
            <div>
              <div class="bg-warning/20 rounded-lg">
                <div class="w-10 h-10 bg-warning/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-warning rounded-lg absolute top-0.5 left-0.5">
                    {{{icon 'trending-up' class='w-4 h-4 text-warning-foreground' size='16'}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Team Members</h3>
              <p class="text-2xl font-semibold text-foreground">{{portfolio.stats.totalMembers}}</p>
            </div>
            <div>
              <div class="bg-info/20 rounded-lg">
                <div class="w-10 h-10 bg-info/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-info rounded-lg absolute top-0.5 left-0.5">
                    {{{icon 'users' class='w-4 h-4 text-info-foreground' size='16'}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Ideas Grid -->
      <div class="bg-card rounded-lg border border-border p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-semibold text-foreground">Portfolio Ideas</h2>
          {{#if portfolio.canEdit}}
          <a href="/portfolios/{{portfolio.id}}/ideas" class="btn btn-outline btn-sm">
{{{icon 'plus' class='w-4 h-4 mr-1' size='14'}}}
            Add Ideas
          </a>
          {{/if}}
        </div>

        {{#if portfolio.ideas}}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {{#each portfolio.ideas}}
          <div class="bg-muted/30 rounded-lg p-4 hover:bg-muted/50 transition-colors">
            <div class="flex items-start justify-between mb-3">
              <div class="flex-1">
                <h3 class="font-medium text-foreground mb-1 line-clamp-2">{{title}}</h3>
                <p class="text-sm text-muted-foreground">{{category}}</p>
              </div>
              {{#if ../portfolio.canEdit}}
              <button class="btn btn-ghost btn-sm text-destructive hover:text-destructive ml-2" onclick="removeIdeaFromPortfolio('{{id}}')" title="Remove from portfolio">
                {{{icon 'x' class='w-4 h-4' size='14'}}}
              </button>
              {{/if}}
            </div>

            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Completion</span>
                <span class="text-foreground font-medium">{{completion_percentage}}%</span>
              </div>
              <div class="w-full bg-muted rounded-full h-2">
                <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: {{completion_percentage}}%"></div>
              </div>

              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Status</span>
                <span class="px-2 py-1 rounded-full text-xs font-medium
                  {{#eq overall_status "completed"}}bg-success/20 text-success
                  {{else if (eq overall_status "in_progress"}}bg-warning/20 text-warning
                  {{else}}bg-muted text-muted-foreground{{/eq}}">{{overall_status}}</span>
              </div>

              {{#if rating}}
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Rating</span>
                <div class="flex items-center gap-1">
                  <span class="text-foreground font-medium">{{rating}}</span>
{{{icon 'star' class='w-3 h-3 fill-yellow text-yellow' size='12'}}}
                </div>
              </div>
              {{/if}}
            </div>

            <div class="mt-4 pt-3 border-t border-border">
              <a href="/models/idea?ideaId={{id}}" class="btn btn-outline btn-sm w-full">
                View Details
              </a>
            </div>
          </div>
          {{/each}}
        </div>
        {{else}}
        <!-- Empty State -->
        <div class="text-center py-12">
          <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
{{{icon 'lightbulb' class='text-muted-foreground' size='24'}}}
          </div>
          <h3 class="text-lg font-medium text-foreground mb-2">No ideas in this portfolio yet</h3>
          <p class="text-muted-foreground mb-6">Add your first idea to start organizing your business concepts</p>
          <a href="/portfolios/{{portfolio.id}}/ideas" class="btn btn-primary">
{{{icon 'plus' class='w-4 h-4 mr-2' size='16'}}}
            Add Your First Idea
          </a>
        </div>
        {{/if}}
      </div>

      <!-- Team Members Section -->
      {{#if portfolio.members}}
      <div class="bg-card rounded-lg border border-border p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-semibold text-foreground">Team Members</h2>
          {{#if portfolio.canEdit}}
          <button class="btn btn-outline btn-sm" onclick="openInviteModal()">
{{{icon 'user-plus' class='w-4 h-4 mr-1' size='14'}}}
            Invite Member
          </button>
          {{/if}}
        </div>

         <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
           {{#each portfolio.members}}
           <div class="flex items-center gap-3 p-3 rounded-lg border border-border">
             <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
               {{#if avatar}}
                 <img src="{{avatar}}" alt="{{name}}" class="w-full h-full rounded-full object-cover">
               {{else}}
                 <span class="text-sm font-medium text-primary">{{#if name}}{{name.charAt 0}}{{else}}?{{/if}}</span>
               {{/if}}
             </div>
             <div class="flex-1">
               <p class="font-medium text-foreground">{{name}}</p>
               {{#if ../portfolio.isOwner}}
               <select class="text-sm border border-border rounded px-2 py-1 bg-background" onchange="changeMemberRole('{{user_id}}', this.value)">
                 <option value="viewer" {{#eq role "viewer"}}selected{{/eq}}>Viewer</option>
                 <option value="editor" {{#eq role "editor"}}selected{{/eq}}>Editor</option>
               </select>
               {{else}}
               <p class="text-sm text-muted-foreground capitalize">{{role}}</p>
               {{/if}}
             </div>
             {{#if ../portfolio.isOwner}}
             <button class="btn btn-ghost btn-sm text-destructive hover:text-destructive" onclick="removeMember('{{user_id}}')" title="Remove member">
{{{icon 'user-minus' class='w-4 h-4' size='14'}}}
             </button>
             {{/if}}
           </div>
           {{/each}}
         </div>
      </div>
      {{/if}}

    </div>
  </div>
</main>

<!-- Invite Member Modal -->
<div id="invite-member-modal" class="fixed inset-0 bg-black/50 hidden z-50" style="display: none;">
  <div class="flex items-center justify-center w-full min-h-screen p-4">
     <div class="bg-card rounded-lg border border-border p-6 max-w-md mx-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-foreground">Invite Team Member</h3>
        <button class="btn btn-ghost btn-sm" onclick="closeInviteModal()">
{{{icon 'x' class='w-4 h-4' size='14'}}}
        </button>
      </div>

      <form id="invite-member-form" onsubmit="inviteMember(event)">
        <div class="space-y-4">
          <div>
            <label for="member-email" class="block text-sm font-medium text-foreground mb-1">Email Address</label>
            <input type="email" id="member-email" name="email" required class="input input-bordered w-full" placeholder="colleague@example.com">
          </div>

          <div>
            <label for="member-role" class="block text-sm font-medium text-foreground mb-1">Role</label>
            <select id="member-role" name="role" class="select w-full">
              <option value="viewer">Viewer - Can view portfolio and ideas</option>
              <option value="editor">Editor - Can view and add/remove ideas</option>
            </select>
          </div>

          <div class="flex gap-3 pt-4">
            <button type="button" class="btn btn-outline flex-1" onclick="closeInviteModal()">Cancel</button>
            <button type="submit" class="btn btn-primary flex-1">Send Invitation</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

