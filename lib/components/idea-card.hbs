
<!-- Idea Card Component - Beautiful, Interactive, Mobile-Friendly -->
<div class="idea-card group relative w-full bg-gradient-to-br from-card via-card/95 to-card/90 backdrop-blur-sm border border-border/50 rounded-xl shadow-sm hover:shadow-xl hover:shadow-primary/10 transition-all duration-500 ease-out overflow-hidden"
     data-id="{{id}}"
     data-status="{{overall_status}}"
     data-category="{{category}}"
     data-favorite="{{is_favorite}}"
     data-rating="{{rating}}">

  <!-- Card Header -->
  <div class="p-4 sm:p-6 pb-3">
    <!-- Top Actions Row -->
    <div class="flex items-start justify-between mb-3">
      <!-- Category Badge -->
      {{#if category}}
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary/10 text-primary border border-primary/20">
        {{{icon 'tag' class='w-3 h-3 mr-1'}}}
        {{category}}
      </span>
      {{else}}
      <div></div>
      {{/if}}

      <!-- Quick Actions -->
      <div class="flex items-center gap-1">
        {{#if ../user}}
        <!-- Favorite Button -->
        <button
          class="favorite-btn group/btn p-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-950/50 text-muted-foreground hover:text-red-500 transition-all duration-300 touch-manipulation active:scale-95"
          data-favorite-id="{{id}}"
          title="Toggle Favorite"
          aria-label="Toggle favorite">
          {{{icon 'heart' class='w-5 h-5 {{#if is_favorite}}fill-current text-red-500{{else}}group-hover/btn:scale-110{{/if}} transition-all duration-300'}}}
        </button>
        {{/if}}

        <!-- Expand/Collapse Button -->
        <button
          class="expand-btn p-2 rounded-lg hover:bg-primary/10 text-muted-foreground hover:text-primary transition-all duration-300 touch-manipulation active:scale-95"
          onclick="toggleCardDetails(this.closest('.idea-card'))"
          title="Toggle Details"
          aria-label="Toggle card details">
          {{{icon 'chevron-down' class='w-5 h-5 transition-transform duration-300 ease-out'}}}
        </button>
      </div>
    </div>

    <!-- Title & Author -->
    <div class="space-y-2">
      <h3 class="font-semibold text-lg text-foreground leading-tight line-clamp-2 hover:text-primary transition-colors cursor-pointer"
          onclick="window.location.href='/idea/{{id}}'">
        {{title}}
      </h3>

      {{#if profiles}}
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <img src="{{cond profiles.avatar_url profiles.avatar_url '/images/avatar.png'}}"
             alt="{{profiles.name}} avatar"
             class="w-6 h-6 rounded-full ring-2 ring-background">
        <span>by {{profiles.name}}</span>
      </div>
      {{/if}}
    </div>
  </div>

  <!-- Rating Section -->
  <div class="px-4 sm:px-6 pb-4">
    <div class="flex items-center justify-between">
      <!-- Star Rating Display -->
      <div class="flex items-center gap-1">
        {{#each (range 1 5)}}
        {{{icon 'star' class=(concat 'w-4 h-4 ' (cond (gt ../rating this) 'fill-yellow-400 text-yellow-400' 'text-muted-foreground/60')) stroke='currentColor'}}}
        {{/each}}
        <span class="ml-2 text-sm text-muted-foreground font-medium">{{rating}}/5</span>
      </div>

      <!-- Interactive Rating (for logged-in users) -->
      {{#if ../user}}
      <div class="star-rating flex items-center gap-0.5" data-idea-id="{{id}}">
        {{#each (range 1 5)}}
        <button
          class="star-btn p-1 rounded hover:bg-yellow-50 dark:hover:bg-yellow-950/50 text-muted-foreground hover:text-yellow-500 transition-all duration-200 touch-manipulation active:scale-110"
          data-rating="{{this}}"
          title="Rate {{this}} star{{#if (gt this 1)}}s{{/if}}"
          aria-label="Rate {{this}} stars">
          {{{icon 'star' class='w-4 h-4 hover:scale-110 transition-transform'}}}
        </button>
        {{/each}}
      </div>
      {{/if}}
    </div>
  </div>

  <!-- Expandable Content -->
  <div class="card-details max-h-0 overflow-hidden transition-all duration-500 ease-out bg-gradient-to-b from-card/50 to-card/30">
    <div class="p-4 sm:p-6 space-y-4">
      <!-- Description -->
      {{#if description}}
      <div class="prose prose-sm max-w-none text-foreground/90">
        <div class="text-sm leading-relaxed">
          {{markdown description}}
        </div>
      </div>
      {{/if}}

      <!-- Tags -->
      {{#if tags}}
      <div class="flex flex-wrap gap-2">
        {{#each tags}}
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-secondary/80 text-secondary-foreground border border-secondary/40 hover:bg-secondary transition-colors">
          {{{icon 'hash' class='w-3 h-3 mr-1'}}}
          {{this}}
        </span>
        {{/each}}
      </div>
      {{/if}}

      <!-- Status & Metadata -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        {{#if overall_status}}
        <span class="inline-flex items-center px-2.5 py-1 rounded-full font-medium {{cond (eq overall_status 'draft') 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200' (cond (eq overall_status 'in_progress') 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200' (cond (eq overall_status 'completed') 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' (cond (eq overall_status 'reported') 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200' 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200')))}}">
          {{{icon (cond (eq overall_status 'draft') 'file-text' (cond (eq overall_status 'in_progress') 'loader' (cond (eq overall_status 'completed') 'check-circle' (cond (eq overall_status 'reported') 'flag' 'archive')))))}}
          <span class="ml-1 capitalize">{{overall_status}}</span>
        </span>
        {{/if}}

        {{#if privacy}}
        <span class="inline-flex items-center px-2.5 py-1 rounded-full font-medium
                     {{#eq privacy 'public'}}bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200{{/eq}}
                     {{#eq privacy 'private'}}bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200{{/eq}}">
          {{#eq privacy 'public'}}{{icon 'globe'}}{{/eq}}
          {{#eq privacy 'private'}}{{icon 'lock'}}{{/eq}}
          <span class="ml-1">{{privacy}}</span>
        </span>
        {{/if}}
      </div>

      <!-- Progress Bar -->
      {{#if completion_percentage}}
      <div class="space-y-2">
        <div class="flex justify-between text-xs text-muted-foreground">
          <span>Progress</span>
          <span>{{completion_percentage}}%</span>
        </div>
        <div class="w-full bg-muted rounded-full h-2 overflow-hidden">
          <div class="bg-gradient-to-r from-primary to-primary/80 h-full rounded-full transition-all duration-1000 ease-out"
               style="width: {{completion_percentage}}%"></div>
        </div>
      </div>
      {{/if}}

      <!-- Timestamps -->
      <div class="flex items-center justify-between text-xs text-muted-foreground border-t border-border/50 pt-3">
        <span class="flex items-center gap-1">
          {{{icon 'calendar' class='w-3 h-3'}}}
          Created: {{created_at_formatted}}
        </span>
        {{#if updated_at_formatted}}
        <span class="flex items-center gap-1">
          {{{icon 'refresh-cw' class='w-3 h-3'}}}
          Updated: {{updated_at_formatted}}
        </span>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- Action Buttons Footer -->
  <div class="px-4 sm:px-6 pb-4">
    <div class="flex items-center justify-between">
      <!-- Primary Actions -->
      <div class="flex items-center gap-2">
        <!-- View Full Details -->
        <button
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-all duration-300 touch-manipulation active:scale-95 font-medium text-sm"
          onclick="window.location.href='/idea/{{id}}'"
          aria-label="View full details">
          {{{icon 'eye' class='w-4 h-4'}}}
          <span class="hidden sm:inline">View Details</span>
        </button>

        {{#if ../user}}
        <!-- Populate New Idea -->
        <button
          class="populate-btn inline-flex items-center gap-2 px-3 py-2 bg-secondary text-secondary-foreground rounded-lg hover:bg-secondary/80 transition-all duration-300 touch-manipulation active:scale-95"
          data-populate-id="{{id}}"
          title="Use as template for new idea"
          aria-label="Create new idea from this template">
          {{{icon 'copy' class='w-4 h-4'}}}
          <span class="hidden sm:inline">Use Template</span>
        </button>
        {{/if}}
      </div>

      <!-- Secondary Actions -->
      <div class="flex items-center gap-1">
        {{#if ../user}}
        <!-- Share (for private ideas) -->
        {{#if (eq privacy 'private')}}
        <button
          class="share-btn p-2 rounded-lg hover:bg-green-50 dark:hover:bg-green-950/50 text-muted-foreground hover:text-green-600 transition-all duration-300 touch-manipulation active:scale-95"
          onclick="shareIdea(this)"
          data-id="{{id}}"
          title="Share private idea"
          aria-label="Share private idea">
          {{{icon 'share-2' class='w-4 h-4'}}}
        </button>
        {{/if}}

        <!-- Team Management (Enterprise) -->
        {{#if (eq ../user.package_type 'enterprise')}}
        <button
          class="team-btn p-2 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-950/50 text-muted-foreground hover:text-blue-600 transition-all duration-300 touch-manipulation active:scale-95"
          onclick="openTeamModal(this)"
          data-id="{{id}}"
          title="Manage team access"
          aria-label="Manage team access">
          {{{icon 'users' class='w-4 h-4'}}}
        </button>
        {{/if}}

        <!-- Unpublish -->
        <button
          class="unpublish-btn p-2 rounded-lg hover:bg-orange-50 dark:hover:bg-orange-950/50 text-muted-foreground hover:text-orange-600 transition-all duration-300 touch-manipulation active:scale-95"
          title="Unpublish idea"
          aria-label="Unpublish idea">
          {{{icon 'eye-off' class='w-4 h-4'}}}
        </button>

        <!-- Archive -->
        <button
          class="archive-btn p-2 rounded-lg hover:bg-purple-50 dark:hover:bg-purple-950/50 text-muted-foreground hover:text-purple-600 transition-all duration-300 touch-manipulation active:scale-95"
          title="Archive idea"
          aria-label="Archive idea">
          {{{icon 'archive' class='w-4 h-4'}}}
        </button>

        <!-- Delete (Owner Only) -->
        {{#if is_owner}}
        <button
          class="delete-btn p-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-950/50 text-muted-foreground hover:text-red-600 transition-all duration-300 touch-manipulation active:scale-95"
          hx-delete="/api/ideas/{{id}}"
          hx-confirm="Are you sure you want to permanently delete this idea? This action cannot be undone."
          hx-target="closest .idea-card"
          hx-swap="outerHTML"
          hx-on:htmx:response-error="showToast('Failed to delete idea. Please try again.', 'error')"
          title="Delete idea"
          aria-label="Delete idea permanently">
          {{{icon 'trash-2' class='w-4 h-4'}}}
        </button>
        {{/if}}
        {{/if}}
      </div>
    </div>
  </div>
</div>
