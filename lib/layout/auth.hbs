<html lang="{{lng}}" dir="{{#if (eq lng 'ar')}}rtl{{else}}ltr{{/if}}">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <link rel="icon" href="/images/favicon.svg" />
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <link rel="stylesheet" href="/css/output.css" />
  <style>
    .htmx-request {
      opacity: 0.8;
    }

    .htmx-request .loading {
      display: inline;
    }

    .loading {
      display: none;
    }

    .htmx-settling {
      opacity: 1;
    }

    #login-spinner {
      display: none;
    }

    #global-loading {
      display: none;
    }

    .htmx-request #global-loading {
      display: block;
    }

    .logo-path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: move-360 1s linear infinite;
    }

    @keyframes move-360 {
      to {
        stroke-dashoffset: -500;
      }
    }
  </style>
  {{#if styles}}{{styles}}{{/if}}
</head>

  <body class="{{bodyClass}}
      bg-background pb-8">

  <!-- Language and Theme Switchers -->
  <button id="lang-toggle" class="fixed top-4 {{#if (eq lng 'ar')}}right-4{{else}}left-4{{/if}} z-50 text-foreground hover:text-muted-foreground transition-colors px-3 py-2 text-sm font-medium flex items-center bg-background/80 backdrop-blur-sm rounded-lg border border-border shadow-sm">
    {{{icon 'languages' class='h-4 w-4 mr-2'}}}
    <span id="lang-text">EN</span>
  </button>
  <button id="theme-toggle" class="fixed top-4 {{#if (eq lng 'ar')}}left-4{{else}}right-4{{/if}} z-50 text-foreground hover:text-muted-foreground transition-colors p-2 bg-background/80 backdrop-blur-sm rounded-lg border border-border shadow-sm">
    {{{icon 'sun' class='h-5 w-5' id='theme-icon-light'}}}
    {{{icon 'moon' class='h-5 w-5 hidden' id='theme-icon-dark'}}}
  </button>

  {{{body}}}

   {{#if scripts}}{{scripts}}{{/if}}
   <script>
     // Set document direction based on language
     const urlParams = new URLSearchParams(window.location.search);
     const lang = urlParams.get('lng') || 'en';
     document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
     document.documentElement.lang = lang;
   </script>
   {{#if scripts}}{{scripts}}{{/if}}
     <script>
       function showLoadingFor8Seconds() {
         const loading = document.getElementById('global-loading');
         loading.style.display = 'block';
         setTimeout(() => {
           loading.style.display = 'none';
         }, 8000);
       }
     </script>



   <div id="global-loading">
     {{> loading}}
   </div>
</body>
</html>