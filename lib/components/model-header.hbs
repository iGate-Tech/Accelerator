<div class="w-[900px] mx-auto">
    <div class="px-6 py-8">
        <div class="flex flex-col items-center text-center">
            <!-- Title Section -->
            <div class="text-center">
                <h1 class="text-4xl font-bold text-foreground mb-2">{{{title}}}</h1>
                           <div class="flex items-center justify-between gap-4 mb-4">
                        {{#if category}}
                              <span class="inline-flex items-center px-2 py-1 bg-info/5 text-info border border-info/20 text-xs rounded-full">Category: {{category}}</span>
                        {{/if}}
                     <div class="flex items-center gap-2">
                         <div class="flex items-center gap-1">
                             <span id="rating-stars" class="text-yellow-400 text-lg">{{ratingStars}}</span>
                             <span id="rating-value" class="text-sm text-muted-foreground">{{ratingValue}}</span>
                         </div>
                         <span class="text-muted-foreground">•</span>
                         <span id="vote-count" class="text-xs text-muted-foreground">{{voteCount}}</span>
                     </div>
                </div>
                {{#if tags}}
                    <div class="flex flex-wrap gap-1 justify-center mb-4">
                          {{#each tags}}
                               <span class="inline-flex items-center px-2 py-1 bg-primary/5 text-primary border border-primary/20 text-xs rounded-full">{{this}}</span>
                          {{/each}}
                    </div>
                {{/if}}
                <p class="text-muted-foreground text-lg mb-2">{{description}}</p>

     
                  <div class="mt-4 h-1 bg-primary w-24 mx-auto rounded-full mb-4"></div>
            </div>
              


        </div>
    </div>

</div>