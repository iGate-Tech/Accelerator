                       <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                       <div class="flex-1">
                            {{> question-block id="product-section-q1" step="1" question=(i18n "models.business.core_function") placeholder=(i18n "models.business.core_function_help")}}
                       </div>
                   </div>
