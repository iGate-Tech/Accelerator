<div class="flex flex-col ">
    <!-- Header -->
    <header class="w-full flex flex-col items-center gap-2 mb-2">
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-sans font-light text-foreground mb-6 sm:mb-10">
              Hi <span class="text-primary">{{firstName user.profile.name}}</span>, {{t 'ideas.new.question'}}
          </h1>
    </header>

    <!-- Form / Input area -->
    <style>
        .new-project-form {
            box-shadow: 0 0 70px 55px rgba(186, 104, 200, 0.15);
        }

        .new-project-form:hover {
            animation: rainbow-shadow 20s infinite linear;
        }

        @keyframes rainbow-shadow {
            0% {
                box-shadow: 0 0 70px 55px rgba(255, 0, 0, 0.15);
            }

            2.5% {
                box-shadow: 0 0 70px 55px rgba(255, 32, 0, 0.15);
            }

            5% {
                box-shadow: 0 0 70px 55px rgba(255, 64, 0, 0.15);
            }

            7.5% {
                box-shadow: 0 0 70px 55px rgba(255, 96, 0, 0.15);
            }

            10% {
                box-shadow: 0 0 70px 55px rgba(255, 128, 0, 0.15);
            }

            12.5% {
                box-shadow: 0 0 70px 55px rgba(255, 160, 0, 0.15);
            }

            15% {
                box-shadow: 0 0 70px 55px rgba(255, 192, 0, 0.15);
            }

            17.5% {
                box-shadow: 0 0 70px 55px rgba(255, 224, 0, 0.15);
            }

            20% {
                box-shadow: 0 0 70px 55px rgba(255, 255, 0, 0.15);
            }

            22.5% {
                box-shadow: 0 0 70px 55px rgba(224, 255, 0, 0.15);
            }

            25% {
                box-shadow: 0 0 70px 55px rgba(192, 255, 0, 0.15);
            }

            27.5% {
                box-shadow: 0 0 70px 55px rgba(160, 255, 0, 0.15);
            }

            30% {
                box-shadow: 0 0 70px 55px rgba(128, 255, 0, 0.15);
            }

            32.5% {
                box-shadow: 0 0 70px 55px rgba(96, 255, 0, 0.15);
            }

            35% {
                box-shadow: 0 0 70px 55px rgba(64, 255, 0, 0.15);
            }

            37.5% {
                box-shadow: 0 0 70px 55px rgba(32, 255, 0, 0.15);
            }

            40% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 0, 0.15);
            }

            42.5% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 32, 0.15);
            }

            45% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 64, 0.15);
            }

            47.5% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 96, 0.15);
            }

            50% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 128, 0.15);
            }

            52.5% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 160, 0.15);
            }

            55% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 192, 0.15);
            }

            57.5% {
                box-shadow: 0 0 70px 55px rgba(0, 224, 255, 0.15);
            }

            60% {
                box-shadow: 0 0 70px 55px rgba(0, 192, 255, 0.15);
            }

            62.5% {
                box-shadow: 0 0 70px 55px rgba(0, 160, 255, 0.15);
            }

            65% {
                box-shadow: 0 0 70px 55px rgba(0, 128, 255, 0.15);
            }

            67.5% {
                box-shadow: 0 0 70px 55px rgba(0, 96, 255, 0.15);
            }

            70% {
                box-shadow: 0 0 70px 55px rgba(0, 64, 255, 0.15);
            }

            72.5% {
                box-shadow: 0 0 70px 55px rgba(0, 32, 255, 0.15);
            }

            75% {
                box-shadow: 0 0 70px 55px rgba(0, 0, 255, 0.15);
            }

            77.5% {
                box-shadow: 0 0 70px 55px rgba(32, 0, 255, 0.15);
            }

            80% {
                box-shadow: 0 0 70px 55px rgba(64, 0, 255, 0.15);
            }

            82.5% {
                box-shadow: 0 0 70px 55px rgba(96, 0, 255, 0.15);
            }

            85% {
                box-shadow: 0 0 70px 55px rgba(128, 0, 255, 0.15);
            }

            87.5% {
                box-shadow: 0 0 70px 55px rgba(160, 0, 255, 0.15);
            }

            90% {
                box-shadow: 0 0 70px 55px rgba(192, 0, 255, 0.15);
            }

            92.5% {
                box-shadow: 0 0 70px 55px rgba(224, 0, 255, 0.15);
            }

            95% {
                box-shadow: 0 0 70px 55px rgba(255, 0, 224, 0.15);
            }

            97.5% {
                box-shadow: 0 0 70px 55px rgba(255, 0, 192, 0.15);
            }

            100% {
                box-shadow: 0 0 70px 55px rgba(255, 0, 0, 0.15);
            }
        }

        /* Markdown content styling */
        .markdown-content p {
            margin-bottom: 1rem;
            line-height: 1.6;
        }
        .markdown-content h1, .markdown-content h2, .markdown-content h3 {
            font-weight: bold;
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }
        .markdown-content h1 { font-size: 1.5em; }
        .markdown-content h2 { font-size: 1.25em; }
        .markdown-content h3 { font-size: 1.1em; }
        .markdown-content ul, .markdown-content ol {
            margin-bottom: 1rem;
            padding-left: 1.5rem;
        }
        .markdown-content li {
            margin-bottom: 0.25rem;
        }
        .markdown-content blockquote {
            border-left: 4px solid #ccc;
            padding-left: 1rem;
            margin-bottom: 1rem;
            font-style: italic;
        }
        .markdown-content code {
            background-color: #f4f4f4;
            padding: 0.2em 0.4em;
            border-radius: 3px;
            font-family: monospace;
        }
        .markdown-content pre {
            background-color: #f4f4f4;
            padding: 1rem;
            border-radius: 3px;
            overflow-x: auto;
            margin-bottom: 1rem;
        }
        .markdown-content pre code {
            background-color: transparent;
            padding: 0;
        }
    </style>
    <form id="new-project-form" class="flex m-auto max-w-[750px] w-full flex-col gap-1" method="post"
        action="/new-idea">
        <!-- CSRF Token (Important for security) -->
        <input type="hidden" name="_csrf" value="">
        <input type="hidden" name="privacy" id="privacy-hidden" value="public">

        <div class="flex flex-col w-full">
            <div class="">
                <div
                    class="new-project-form flex flex-col gap-2 rounded-2xl relative py-2 border border-border bg-background shadow-sm">
                    <!-- Title wrapper -->
                    <div class="pl-4 pr-2">
                        <div class="flex flex-wrap gap-1">
                            <span
                                class="inline-flex items-center gap-1 px-2 py-1 bg-muted text-muted-foreground border border-border text-xs rounded-full focus:outline-none focus:bg-accent">
                                 <i contenteditable="true" id="title" class="text-foreground">{{t 'ideas.new.untitled'}}</i>
                                {{{icon 'square-pen' class='w-3 h-3' size='12'}}}
                            </span>
                            <span
                                class="inline-flex items-center gap-1 px-2 py-1 bg-muted text-muted-foreground border border-border text-xs rounded-full focus:outline-none focus:bg-accent">
                                 <i contenteditable="true" id="category">{{t 'ideas.new.category'}}</i>
                                {{{icon 'square-pen' class='w-3 h-3' size='12'}}}
                            </span>
                        </div>
                    </div>

                    <!-- Description wrapper -->
                    <div class=" pl-4 pr-2 relative">
                        <label for="assistant-prompt" class="sr-only">Describe your
                            project requirements</label>
                        <div id="assistant-prompt-display" class="w-full rounded-md border border-input bg-background px-3 py-2 text-base text-foreground min-h-[2.5rem] cursor-pointer overflow-visible markdown-content" style="display: none;"></div>
                         <textarea id="assistant-prompt" name="prompt"
                              placeholder="{{t 'ideas.new.describe_requirements'}}"
                             aria-label="Describe your project requirements" aria-describedby="prompt-help char-counter"
                             class="flex w-full rounded-md border-0 bg-transparent p-0 pt-[1px] text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0"
                             required=""
                                                           style="min-height: 2.5rem; resize: none; overflow: hidden;"></textarea>
                        <p id="prompt-help" class="sr-only">Enter your project
                            description or requirements</p>
                    </div>

                    <!-- Tags wrapper -->
                    <div class="pl-4 pr-2">
                        <div id="tagslist" class="flex flex-wrap gap-1">

                             <!-- Add more -->
                             <span id="addOneTag" class="inline-flex items-center gap-1 px-2 py-0.5
                       bg-success/5
                       text-success
                        border border-success/40 cursor-pointer
                     text-xs rounded-full">

  {{{icon 'plus' class='w-3 h-3' size='12'}}}
                                  {{t 'ideas.new.add_more'}}
                             </span>

                             <!-- Remove all -->
                             <span id="removeAllTags" class="inline-flex items-center gap-1 px-2 py-0.5
                       bg-destructive/10
                       text-destructive
                        border border-destructive/40
                      text-xs rounded-full cursor-pointer" style="display: none;">

  {{{icon 'trash' class='w-3 h-3' size='12'}}}
                                  {{t 'ideas.new.remove_all'}}
                             </span>

                        </div>
                    </div>


                    <!-- Privacy setting -->
                    <div class="px-3 pb-2">
                        <div class="flex items-center gap-3">
                             <label class="text-xs text-muted-foreground">{{t 'ideas.new.visibility'}}</label>
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-muted-foreground" id="privacy-label">{{t 'ideas.new.public'}}</span>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="privacy-toggle" class="sr-only peer">
                                    <div class="w-9 h-5 bg-muted-foreground/20 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- toolbar -->
                    <div class="px-3 flex gap-2 items-center">
                        <div class="flex gap-2 items-center flex-shrink-0">
                            <!-- Generate title with AI -->
                            <button type="button" aria-label="Generate title with AI" title="Generate title with AI"
                                class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

 {{{icon 'type' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">{{t 'ideas.new.generate_title_ai'}}</span>
                            </button>

                            <!-- Add category with AI -->
                            <button type="button" aria-label="Add category with AI" title="Add category with AI"
                                class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

 {{{icon 'folder' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">{{t 'ideas.new.add_category_ai'}}</span>
                            </button>

                            <!-- Improve with AI -->
                            <button type="button" aria-label="Improve with AI" title="Improve with AI"
                                class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

 {{{icon 'lightbulb' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">{{t 'ideas.new.improve_description_ai'}}</span>
                            </button>

                            <!-- Add tags with AI -->
                            <button type="button" aria-label="Add tags with AI" title="Add tags with AI"
                                class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

 {{{icon 'tag' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">{{t 'ideas.new.add_tags_ai'}}</span>
                            </button>

                            <!-- Auto fill with AI -->
                            <button type="button" aria-label="Auto fill with AI" title="Auto fill with AI"
                                class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

 {{{icon 'wand-sparkles' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">{{t 'ideas.new.auto_fill_ai'}}</span>
                            </button>

                            <!-- Generate random idea -->
                            <button type="button" aria-label="Generate random idea" title="Generate random idea"
                                class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

 {{{icon 'shuffle' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">{{t 'ideas.new.random_idea_ai'}}</span>
                            </button>

                            <!-- Reset form -->
                            <button type="button" aria-label="Reset form" title="Reset form"
                                class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

 {{{icon 'rotate-ccw' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">{{t 'ideas.new.reset_form'}}</span>
                            </button>
                        </div>

                        <!-- Submit button on the right -->
                        <div class="min-w-0 flex gap-2 ml-auto flex-shrink items-center">
                             <span id="char-counter" class="text-xs text-red-500/60 mr-2" aria-live="polite">{{t 'ideas.new.characters'}}</span>
                            <button type="submit" aria-label="Create project" title="Create project"
                                class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

 {{{icon 'plus' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">{{t 'ideas.new.create_project'}}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

