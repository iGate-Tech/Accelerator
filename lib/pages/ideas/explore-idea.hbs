<div class="p-4 sm:p-6 md:p-8 lg:p-20">
    <div class="grid gap-1 mb-8 sm:mb-12">
        <h1 class="font-heading text-2xl sm:text-3xl font-semibold text-foreground">
            {{t 'ideas.explore.title' lng=lng}}
        </h1>
        <p class="text-base sm:text-lg text-muted-foreground">
            {{t 'ideas.explore.description' lng=lng}}
        </p>
    </div>

    <!-- Search and Filter Controls -->
    <div class="bg-card rounded-lg p-4 sm:p-6 mb-6 sm:mb-8 border border-border">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Search Input -->
            <div class="sm:col-span-2">
                <label for="search-input" class="block text-sm font-medium text-foreground mb-2">{{t 'ideas.explore.search' lng=lng}}</label>
                 <div class="relative">
                      <input type="text" id="search-input" placeholder="{{t 'ideas.explore.search_placeholder' lng=lng}}"
                            value="{{search}}"
                            class="w-full pl-10 pr-4 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary text-base">
                     {{{icon 'search' class='absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground'}}}
                 </div>
            </div>

            <!-- Category Filter -->
            <div>
                 <label for="category-filter" class="block text-sm font-medium text-foreground mb-2">{{t 'ideas.explore.category' lng=lng}}</label>
                <select id="category-filter" class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary text-base">
                      <option value="" {{#if (eq category '')}}selected{{/if}}>{{t 'ideas.explore.all_categories' lng=lng}}</option>
                     {{#each categories}}
                     <option value="{{this}}" {{#if (eq category this)}}selected{{/if}}>{{this}}</option>
                     {{/each}}
                 </select>
            </div>

            <!-- Sort Options -->
            <div>
                 <label for="sort-select" class="block text-sm font-medium text-foreground mb-2">{{t 'ideas.explore.sort_by' lng=lng}}</label>
                <select id="sort-select" class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary text-base">
                      <option value="newest" {{#if (eq sort 'newest')}}selected{{/if}}>{{t 'ideas.explore.newest_first' lng=lng}}</option>
                      <option value="oldest" {{#if (eq sort 'oldest')}}selected{{/if}}>{{t 'ideas.explore.oldest_first' lng=lng}}</option>
                      <option value="rating" {{#if (eq sort 'rating')}}selected{{/if}}>{{t 'ideas.explore.highest_rated' lng=lng}}</option>
                      <option value="title" {{#if (eq sort 'title')}}selected{{/if}}>{{t 'ideas.explore.title_az' lng=lng}}</option>
                 </select>
            </div>
        </div>
    </div>

    <!-- Ideas Grid Section -->
    <div id="ideas-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#each ideas}}
        {{> idea-card .}}
        {{/each}}
    </div>

     <!-- No Results Message -->
     <div id="no-results" class="{{#if hasIdeas}}hidden{{/if}} text-center py-8 sm:py-12">
        <div class="inline-flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 bg-muted rounded-2xl mb-4 sm:mb-6">
            {{{icon 'search-x' class='w-6 h-6 sm:w-8 sm:h-8 text-muted-foreground'}}}
        </div>
         <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">{{t 'ideas.explore.no_ideas_found' lng=lng}}</h3>
         <p class="text-sm sm:text-base text-muted-foreground">{{t 'ideas.explore.try_adjusting_search' lng=lng}}</p>
    </div>
 </div>

<script src="/js/explore-idea.js"></script>
<script>window.ideasData = {{{ideasJson}}}</script>

