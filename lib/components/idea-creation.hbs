<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
 // Populate form from populateIdeaJson if available
 if (typeof populateIdeaJson !== 'undefined' && populateIdeaJson !== "null") {
     try {
         const data = JSON.parse(populateIdeaJson.replace(/\\'/g, "'").replace(/\\u003c/g, "<").replace(/\\u003e/g, ">"));
         if (data.description) document.getElementById('assistant-prompt').value = data.description;
     } catch (e) {
         console.error('Error populating form:', e);
     }
 }

 // Handle buttons
 document.addEventListener('click', async (e) => {
     // Improve with AI button
     if (e.target.closest('button[aria-label="Improve with AI"]')) {
         e.preventDefault();
         const textarea = document.getElementById('assistant-prompt');
         const description = textarea.value.trim();

         if (!description) {
             alert('Please enter a description first');
             return;
         }

         // Show loading state
         const button = e.target.closest('button');
         const originalText = button.innerHTML;
         button.innerHTML = 'Improving...';
         button.disabled = true;

         try {
             // Call improve description API
             const response = await fetch('/api/ai/improve/idea/description', {
                 method: 'POST',
                 headers: {
                     'Content-Type': 'application/json',
                 },
                 body: JSON.stringify({ description }),
             });

             if (response.ok) {
                 const result = await response.json();
                 if (result.success) {
                     // Show improved version
                     const displayDiv = document.getElementById('assistant-prompt-display');
                     displayDiv.innerHTML = marked.parse(result.improved_description);
                     displayDiv.style.display = 'block';
                     textarea.style.display = 'none';
                 } else {
                     alert('Failed to improve description: ' + (result.error || 'Unknown error'));
                 }
             } else {
                 alert('Failed to improve description');
             }
         } catch (error) {
             console.error('Error improving description:', error);
             alert('Error improving description');
         } finally {
             button.innerHTML = originalText;
             button.disabled = false;
         }
     }

     // Reset form button
     if (e.target.closest('button[aria-label="Reset form"]')) {
         e.preventDefault();
         const textarea = document.getElementById('assistant-prompt');
         const displayDiv = document.getElementById('assistant-prompt-display');

         // Reset to original state
         textarea.value = '';
         textarea.style.display = 'block';
         displayDiv.style.display = 'none';
         displayDiv.innerHTML = '';
     }
 });
 </script>


