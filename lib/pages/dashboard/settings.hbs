<script>
// Section management - accordion style
function toggleSection(section) {
  const contentId = section + '-content';
  const contentEl = document.getElementById(contentId);
  const button = document.querySelector(`[data-section="${section}"]`);
  const chevron = button ? button.querySelector('.chevron-icon') : null;

  if (!contentEl) return;

  // Close all other sections first
  const allSections = ['profile', 'password', 'notifications', 'about'];
  allSections.forEach(s => {
    if (s !== section) {
      const otherContent = document.getElementById(s + '-content');
      const otherButton = document.querySelector(`[data-section="${s}"]`);
      const otherChevron = otherButton ? otherButton.querySelector('.chevron-icon') : null;

      if (otherContent && !otherContent.classList.contains('hidden')) {
        otherContent.style.maxHeight = otherContent.scrollHeight + 'px';
        setTimeout(() => {
          otherContent.style.maxHeight = '0px';
          setTimeout(() => {
            otherContent.classList.add('hidden');
            otherContent.style.maxHeight = '';
          }, 200);
        }, 10);

        // Reset chevron for other sections
        if (otherChevron) {
          otherChevron.style.transform = 'rotate(0deg)';
        }
      }
    }
  });

  // Toggle the clicked section
  const isOpen = !contentEl.classList.contains('hidden');

  if (isOpen) {
    // Close the section
    contentEl.style.maxHeight = contentEl.scrollHeight + 'px';
    setTimeout(() => {
      contentEl.style.maxHeight = '0px';
      setTimeout(() => {
        contentEl.classList.add('hidden');
        contentEl.style.maxHeight = '';
      }, 200);
    }, 10);
    if (chevron) chevron.style.transform = 'rotate(0deg)';
  } else {
    // Open the section
    contentEl.classList.remove('hidden');
    contentEl.style.maxHeight = '0px';
    setTimeout(() => {
      contentEl.style.maxHeight = contentEl.scrollHeight + 'px';
      setTimeout(() => {
        contentEl.style.maxHeight = '';
      }, 200);
    }, 10);
    if (chevron) chevron.style.transform = 'rotate(90deg)';
  }
}

// Theme management
function updateThemeStatus() {
  const isDark = document.documentElement.classList.contains('dark');
  const statusEl = document.getElementById('theme-status');
  const indicator = document.getElementById('theme-toggle-indicator');

  if (statusEl) {
    statusEl.textContent = isDark ? 'Dark mode' : 'Light mode';
  }

  // Toggle theme icons
  const lightIcon = document.getElementById('theme-icon-light');
  const darkIcon = document.getElementById('theme-icon-dark');
  if (lightIcon && darkIcon) {
    if (isDark) {
      lightIcon.classList.add('hidden');
      darkIcon.classList.remove('hidden');
      if (indicator) indicator.style.transform = 'translateX(22px)';
    } else {
      darkIcon.classList.add('hidden');
      lightIcon.classList.remove('hidden');
      if (indicator) indicator.style.transform = 'translateX(1px)';
    }
  }
}

// Define toggleTheme
window.toggleTheme = function() {
  const currentTheme = localStorage.getItem('theme') || 'light';
  const newTheme = currentTheme === 'light' ? 'dark' : 'light';

  // Update UI immediately for responsiveness
  document.documentElement.classList.toggle('dark');
  updateThemeStatus();

  // Send to server
  fetch('/settings/theme', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ theme: newTheme })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      showToast('Theme updated successfully', 'success');
    } else {
      showToast('Failed to save theme preference', 'error');
      // Revert on error
      document.documentElement.classList.toggle('dark');
      updateThemeStatus();
    }
  })
  .catch(error => {
    console.error('Theme update error:', error);
    showToast('Failed to save theme preference', 'error');
    // Revert on error
    document.documentElement.classList.toggle('dark');
    updateThemeStatus();
  });
};

// Initialize theme on load
document.addEventListener('DOMContentLoaded', function() {
  const savedTheme = '{{settings.theme}}';
  if (savedTheme === 'dark') {
    document.documentElement.classList.add('dark');
  }
  updateThemeStatus();
});

// Language management
function normalizeLanguage(lang) {
  return lang === 'ar' ? 'ar' : 'en';
}

function switchLanguage() {
  const currentLang = '{{settings.language}}' || 'en';
  const newLang = currentLang === 'en' ? 'ar' : 'en';

  // Update display immediately
  updateLangDisplay(newLang);

  // Send to server
  fetch('/settings/language', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ language: newLang })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      showToast(newLang === 'ar' ? 'تم تغيير اللغة إلى العربية' : 'Language changed to English', 'success');
    } else {
      showToast('Failed to save language preference', 'error');
      // Revert on error
      updateLangDisplay(currentLang);
    }
  })
  .catch(error => {
    console.error('Language update error:', error);
    showToast('Failed to save language preference', 'error');
    // Revert on error
    updateLangDisplay(currentLang);
  });
}

function updateLangDisplay(lang) {
  const langDisplay = document.getElementById('lang-display');
  if (langDisplay) {
    const currentLang = lang || normalizeLanguage('{{settings.language}}' || 'en');
    langDisplay.textContent = currentLang === 'ar' ? 'العربية' : 'English';
  }
}

// Avatar preview
function previewAvatar(input) {
  if (input.files && input.files[0]) {
    const file = input.files[0];
    if (file.size > 5 * 1024 * 1024) {
      showToast('File size must be less than 5MB', 'error');
      return;
    }
    const reader = new FileReader();
    reader.onload = function(e) {
      const preview = document.getElementById('avatar-preview');
      if (preview) {
        preview.src = e.target.result;
      }
    };
    reader.readAsDataURL(file);
  }
}

// Password form validation
function validatePasswordForm() {
  const currentPassword = document.getElementById('current-password').value;
  const newPassword = document.getElementById('new-password').value;
  const confirmPassword = document.getElementById('confirm-password').value;

  if (!currentPassword || !newPassword || !confirmPassword) {
    showToast('All password fields are required', 'error');
    return false;
  }

  if (newPassword !== confirmPassword) {
    showToast('New passwords do not match', 'error');
    return false;
  }

  if (newPassword.length < 8) {
    showToast('Password must be at least 8 characters long', 'error');
    return false;
  }

  return true;
}

// Profile form validation
function validateProfileForm() {
  const name = document.getElementById('name').value;
  const email = document.getElementById('email')?.value;

  if (!name.trim()) {
    showToast('Name is required', 'error');
    return false;
  }

  if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    showToast('Please enter a valid email address', 'error');
    return false;
  }

  return true;
}

// Logout confirmation
function showLogoutConfirm() {
  if (confirm('Are you sure you want to sign out?')) {
    // Create and submit logout form
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/auth/logout';

    // Add CSRF token if available
    const csrfToken = document.querySelector('input[name="_csrf"]');
    if (csrfToken) {
      const csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = '_csrf';
      csrfInput.value = csrfToken.value;
      form.appendChild(csrfInput);
    }

    document.body.appendChild(form);
    form.submit();
  }
}

// Toast notification (simple implementation)
function showToast(message, type = 'info') {
  // Create toast element
  const toast = document.createElement('div');
  toast.className = `fixed bottom-4 left-4 right-4 z-50 bg-card border border-border rounded-xl px-4 py-3 shadow-lg transform translate-y-full transition-transform duration-300`;
  toast.innerHTML = `
    <div class="flex items-center gap-3">
      <div class="w-5 h-5 ${type === 'error' ? 'text-red-500' : 'text-green-500'}">
        ${type === 'error' ? '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>' : '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>'}
      </div>
      <p class="text-sm text-foreground">${message}</p>
    </div>
  `;

  document.body.appendChild(toast);

  // Show toast
  setTimeout(() => {
    toast.classList.remove('translate-y-full');
  }, 100);

  // Hide toast after 3 seconds
  setTimeout(() => {
    toast.classList.add('translate-y-full');
    setTimeout(() => {
      document.body.removeChild(toast);
    }, 300);
  }, 3000);
}

// Initialize on load
