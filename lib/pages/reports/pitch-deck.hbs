<div class="min-h-screen bg-gradient-to-br from-purple-50 to-pink-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-4 mb-6">
        <div class="w-16 h-16 bg-purple-600 rounded-2xl flex items-center justify-center">
          {{{ icon 'presentation' class='w-8 h-8 text-white' }}}
        </div>
        <div>
           <h1 class="text-4xl font-bold text-gray-900">{{t 'pitch-deck.title'}}</h1>
           <p class="text-xl text-gray-600 mt-2">{{t 'pitch-deck.subtitle'}}</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-8 max-w-2xl mx-auto">
        <div class="text-center mb-6">
          <h2 class="text-2xl font-semibold text-gray-900 mb-2">{{t 'pitch-deck.generate_title'}}</h2>
           <p class="text-gray-600">{{t 'pitch-deck.description'}}</p>
        </div>

        {{#if userIdeas.length}}
        <form method="post" action="/reports/pitch-deck" class="space-y-6">
          <input type="hidden" name="_csrf" value="{{csrf}}" />

          <div>
             <label for="ideaId" class="block text-sm font-medium text-gray-700 mb-2">
               {{t 'pitch-deck.select_idea'}} *
             </label>
            <select id="ideaId" name="ideaId" required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
               <option value="">{{t 'pitch-deck.select_placeholder'}}</option>
              {{#each userIdeas}}
              <option value="{{id}}">{{title}} {{#if completion_percentage}}({{completion_percentage}}% complete){{/if}}</option>
              {{/each}}
            </select>
          </div>

          <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
            <div class="flex items-start">
              <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center mr-3 mt-0.5">
                {{{ icon 'presentation' class='w-4 h-4 text-purple-600' }}}
              </div>
              <div>
                 <h4 class="text-sm font-semibold text-purple-900 mb-1">{{t 'pitch-deck.whats_included'}}</h4>
                 <ul class="text-sm text-purple-800 space-y-1">
                   <li>• {{t 'pitch-deck.included1'}}</li>
                   <li>• {{t 'pitch-deck.included2'}}</li>
                   <li>• {{t 'pitch-deck.included3'}}</li>
                   <li>• {{t 'pitch-deck.included4'}}</li>
                   <li>• {{t 'pitch-deck.included5'}}</li>
                 </ul>
              </div>
            </div>
          </div>

          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <div class="flex items-center">
              <div class="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center mr-3">
                {{{ icon 'zap' class='w-4 h-4 text-yellow-600' }}}
              </div>
              <div>
                 <h4 class="text-sm font-semibold text-yellow-900">{{t 'pitch-deck.cost_credits'}}</h4>
                 <p class="text-sm text-yellow-800">{{t 'pitch-deck.current_balance'}}: <span class="font-semibold">{{userCredits}} credits</span></p>
              </div>
            </div>
          </div>

          <div class="flex gap-4">
            <button type="submit"
              class="flex-1 bg-purple-600 hover:bg-purple-700 text-white font-semibold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
              {{#if (lt userCredits 50)}}disabled{{/if}}>
               <span>{{t 'pitch-deck.generate_button'}}</span>
              {{#if (gte userCredits 50)}}
                {{{ icon 'sparkles' class='w-5 h-5' }}}
              {{/if}}
            </button>
          </div>
        </form>
        {{else}}
        <div class="text-center py-8">
          <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            {{{ icon 'lightbulb' class='w-8 h-8 text-gray-400' }}}
          </div>
           <h3 class="text-lg font-medium text-gray-900 mb-2">{{t 'pitch-deck.no_ideas_title'}}</h3>
           <p class="text-gray-600 mb-6">{{t 'pitch-deck.no_ideas_description'}}</p>
           <a href="/new-idea" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors inline-flex items-center space-x-2">
             {{{ icon 'plus' class='w-4 h-4' }}}
             <span>{{t 'pitch-deck.create_first_idea'}}</span>
           </a>
        </div>
        {{/if}}
      </div>
    </div>

    <!-- Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'target' class='w-6 h-6 text-blue-600' }}}
        </div>
         <h3 class="text-lg font-semibold text-gray-900 mb-2">{{t 'pitch-deck.features_investor_ready'}}</h3>
         <p class="text-gray-600 text-sm">{{t 'pitch-deck.features_investor_ready_desc'}}</p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'trending-up' class='w-6 h-6 text-green-600' }}}
        </div>
         <h3 class="text-lg font-semibold text-gray-900 mb-2">{{t 'pitch-deck.features_data_driven'}}</h3>
         <p class="text-gray-600 text-sm">{{t 'pitch-deck.features_data_driven_desc'}}</p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'users' class='w-6 h-6 text-orange-600' }}}
        </div>
         <h3 class="text-lg font-semibold text-gray-900 mb-2">{{t 'pitch-deck.features_storytelling'}}</h3>
         <p class="text-gray-600 text-sm">{{t 'pitch-deck.features_storytelling_desc'}}</p>
      </div>
    </div>

  </div>
</div>