<!DOCTYPE html>
<html lang="{{lng}}" dir="{{#if (eq lng 'ar')}}rtl{{else}}ltr{{/if}}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="icon" href="/images/favicon.svg">
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&amp;amp;family=Newsreader:ital,opsz,wght@1,6..72,300;1,6..72,400&amp;amp;display=swap"
        rel="stylesheet"/>
    <!-- Iconify -->
     <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
     <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <link rel="stylesheet" href="/css/output.css">
    <style>


        .htmx-request {
            opacity: 0.8;
        }

        .htmx-request .loading {
            display: inline;
        }

        .loading {
            display: none;
        }

        .htmx-settling {
            opacity: 1;
        }
    </style>
    {{#if styles}}{{styles}}{{/if}}

    <script>
    function showLogoutConfirm() {
      document.getElementById('logout-confirm-modal').classList.remove('hidden');
    }

    function hideLogoutConfirm() {
      document.getElementById('logout-confirm-modal').classList.add('hidden');
    }

    function logout() {
      hideLogoutConfirm();
      document.getElementById('logout-loading-screen').classList.remove('hidden');
      fetch('/auth/logout', { method: 'POST' }).then(() => {
        setTimeout(() => window.location.href = '/', 8000);
      });
    }

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
      const notificationDropdown = document.getElementById('notification-dropdown');
      const notificationButton = document.getElementById('notification-menu').querySelector('button');
      if (!notificationDropdown.classList.contains('hidden') && !notificationDropdown.contains(event.target) && !notificationButton.contains(event.target)) {
        notificationDropdown.classList.add('opacity-0', 'invisible', 'hidden');
      }

      const gridDropdown = document.getElementById('grid-dropdown');
      const gridButton = document.getElementById('grid-menu').querySelector('button');
      if (!gridDropdown.classList.contains('hidden') && !gridDropdown.contains(event.target) && !gridButton.contains(event.target)) {
        gridDropdown.classList.add('opacity-0', 'invisible', 'hidden');
      }

      const userDropdown = document.getElementById('admin-user-dropdown');
      const userButton = document.getElementById('admin-user-menu-button');
      if (!userDropdown.classList.contains('hidden') && !userDropdown.contains(event.target) && !userButton.contains(event.target)) {
        userDropdown.classList.add('opacity-0', 'invisible', 'hidden');
      }
    });

    // Mobile portfolio search functions are now defined in main layout
    document.addEventListener('DOMContentLoaded', function() {
      const mobileSearchInput = document.getElementById('mobile-project-search');
      if (mobileSearchInput) {
        mobileSearchInput.addEventListener('input', function() {
          const query = this.value;
          filterMobileProjects(query);
          const clearBtn = document.getElementById('mobile-project-search-clear');
          if (query) {
            clearBtn.style.opacity = '1';
          } else {
            clearBtn.style.opacity = '0';
          }
        });
      }

      const desktopSearchInput = document.getElementById('project-search');
      if (desktopSearchInput) {
        desktopSearchInput.addEventListener('input', function() {
          const query = this.value;
          filterProjects(query);
          const clearBtn = document.getElementById('project-search-clear');
          if (query) {
            clearBtn.style.display = 'block';
            clearBtn.style.opacity = '1';
          } else {
            clearBtn.style.display = 'none';
            clearBtn.style.opacity = '0';
          }
        });
      }
    });

    // Desktop portfolio search
    function clearProjectSearch() {
      const input = document.getElementById('project-search');
      input.value = '';
      filterProjects('');
      const clearBtn = document.getElementById('project-search-clear');
      clearBtn.style.display = 'none';
      clearBtn.style.opacity = '0';
    }

    function filterProjects(query) {
      const items = document.querySelectorAll('#sidebar ul li');
      items.forEach(item => {
        const text = item.textContent.toLowerCase();
        if (text.includes(query.toLowerCase())) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    }

    // Toggle mobile portfolio list
    function toggleMobilePortfolio(event) {
      const container = document.getElementById('mobile-portfolio-list-container');
      if (container) {
        container.classList.toggle('hidden');
        const chevron = event.target.closest('button').querySelector('.chevron');
        if (chevron) {
          chevron.classList.toggle('rotate-180');
        }
      }
    }
    </script>
</head>

<body class="{{bodyClass}} bg-base-100 min-h-screen" data-logged-in="{{#if user}}true{{else}}false{{/if}}">
      {{#if scripts}}{{scripts}}{{/if}}

      <script>
          // Enhanced toast system is now loaded

          // Global function for populating new-idea form from existing ideas
          window.redirectToPopulate = function (ideaId) {
              window.location.href = `/new-idea?populate=${ideaId}`;
          };

// Toggle function for card details
             function toggleCardDetails(card) {
                 const details = card.querySelector('.expandable-content');
                 const expandBtn = card.querySelector('.expand-btn');
                 const chevron = expandBtn ? expandBtn.querySelector('svg') : null;

                 if (details) {
                     if (details.classList.contains('expanded')) {
                         // Collapse
                         details.classList.remove('expanded');
                         details.style.maxHeight = '0px';
                         if (chevron) {
                             chevron.style.transform = 'rotate(0deg)';
                         }
                     } else {
                         // Expand
                         details.classList.add('expanded');
                         // Force reflow to get correct scrollHeight
                         details.style.maxHeight = '0px';
                         const scrollHeight = details.scrollHeight;
                         details.style.maxHeight = scrollHeight + 'px';
                         if (chevron) {
                             chevron.style.transform = 'rotate(180deg)';
                         }
                     }
                 }
             }

            // Toggle favorite status
            async function toggleFavorite(id, button) {
                try {
                    const response = await fetch(`/api/ideas/${id}/favorite`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    });
                    if (response.ok) {
                        const data = await response.json();
                        const isFavorite = data.is_favorite;

                        // If on favorites page and unfavoriting, remove the card
                        const isFavoritesPage = window.location.pathname === '/favorites';
                        if (isFavoritesPage && !isFavorite) {
                            const card = button.closest('.idea-card');
                            if (card) {
                                card.remove();
                                // Check if no cards left, show empty state
                                const cardsContainer = card.parentElement;
                                if (cardsContainer && cardsContainer.children.length === 0) {
                                    location.reload(); // Reload to show empty state
                                }
                            }
                        } else {
                            // Update button appearance for non-favorites pages
                            const icon = button.querySelector('span, svg, i, [class*="iconify"]');
                            if (icon) {
                                if (isFavorite) {
                                    icon.classList.add('fill-current', 'text-red-500');
                                } else {
                                    icon.classList.remove('fill-current', 'text-red-500');
                                }
                            }
                            // Update data-favorite attribute on card
                            const card = button.closest('.idea-card');
                            if (card) {
                                card.setAttribute('data-favorite', isFavorite);
                            }
                        }

                        showToast(data.message || (isFavorite ? 'Idea favorited' : 'Idea unfavorited'), 'success');
                    } else {
                        showToast('Failed to toggle favorite', 'error');
                    }
                } catch (error) {
                    console.error('Toggle favorite error:', error);
                    showToast('Failed to toggle favorite', 'error');
                }
            }

// Placeholder functions for missing features
function openTeamModal(button) {
  const id = button.dataset.id;
  showToast('Team management feature coming soon', 'info');
}

function shareIdea(button) {
  const id = button.dataset.id;
  const url = `${window.location.origin}/idea/${id}`;
  navigator.clipboard.writeText(url).then(() => {
    showToast('Link copied to clipboard', 'success');
  }).catch(() => {
    showToast('Failed to copy link', 'error');
  });
}

function goToIdea(button) {
  const id = button.dataset.id;
  window.location.href = `/models/idea?id=${id}`;
}

            // Event delegation for populate buttons
            document.addEventListener('click', function(e) {
                const button = e.target.closest('.populate-btn, [data-populate-id]');
                if (button) {
                    e.preventDefault();
                    e.stopPropagation();
                    const id = button.dataset.populateId;
                    redirectToPopulate(id);
                }
            });

            // Event delegation for favorite buttons
            document.addEventListener('click', function(e) {
                const button = e.target.closest('.favorite-btn');
                if (button) {
                    e.preventDefault();
                    e.stopPropagation();
                    const id = button.dataset.favoriteId;
                    toggleFavorite(id, button);
                }
            });

            // Event delegation for star rating buttons
            document.addEventListener('click', function(e) {
                const starBtn = e.target.closest('.star-btn');
                if (starBtn) {
                    e.preventDefault();
                    e.stopPropagation();
                    const rating = starBtn.dataset.rating;
                    const ideaId = starBtn.closest('.star-rating').dataset.ideaId;
                    console.log('Rating clicked:', ideaId, rating);
                    rateIdea(ideaId, rating, starBtn);
                }
            });

            // Event delegation for unpublish buttons
            document.addEventListener('click', function(e) {
                const button = e.target.closest('.unpublish-btn');
                if (button) {
                    e.preventDefault();
                    e.stopPropagation();
                    const id = button.closest('.cursor-pointer').dataset.id;
                    unpublishIdea(id);
                }
            });

             // Event delegation for archive buttons
             document.addEventListener('click', function(e) {
                 const button = e.target.closest('.archive-btn');
                 if (button) {
                     e.preventDefault();
                     e.stopPropagation();
                     const id = button.closest('.cursor-pointer').dataset.id;
                     archiveIdea(id);
                 }
             });

             // Event delegation for status update buttons (from expandable section)
             document.addEventListener('click', function(e) {
                 const button = e.target.closest('button[onclick*="updateIdeaStatus"]');
                 if (button) {
                     e.preventDefault();
                     e.stopPropagation();
                     const onclick = button.getAttribute('onclick');
                     // Extract id and status from onclick="updateIdeaStatus(this, 'id', 'status')"
                     const match = onclick.match(/updateIdeaStatus\(this,\s*'([^']+)',\s*'([^']+)'\)/);
                     if (match) {
                         const id = match[1];
                         const status = match[2];
                         updateIdeaStatus(button, id, status);
                     }
                 }
             });

             // Event delegation for privacy update buttons
             document.addEventListener('click', function(e) {
                 const button = e.target.closest('button[onclick*="updateIdeaPrivacy"]');
                 if (button) {
                     e.preventDefault();
                     e.stopPropagation();
                     const onclick = button.getAttribute('onclick');
                     // Extract from onclick="updateIdeaPrivacy(this, 'id', 'privacy')"
                     const match = onclick.match(/updateIdeaPrivacy\(this,\s*'([^']+)',\s*'([^']+)'\)/);
                     if (match) {
                         const id = match[1];
                         const privacy = match[2];
                         updateIdeaPrivacy(button, id, privacy);
                     }
                 }
             });

            // Archive idea function
             async function archiveIdea(id) {
                 if (!confirm('Are you sure you want to archive this idea?')) return;
                 try {
                     const response = await fetch(`/api/ideas/${id}`, {
                         method: 'PUT',
                         headers: {
                             'Content-Type': 'application/json',
                         },
                         body: JSON.stringify({ overall_status: 'archived' })
                     });
                     if (response.ok) {
                         showToast('Idea archived successfully', 'success');
                         window.location.reload();
                     } else {
                         showToast('Failed to archive idea', 'error');
                     }
                 } catch (error) {
                     console.error('Archive error:', error);
                     showToast('Failed to archive idea', 'error');
                 }
             }

             // Unpublish idea function
             async function unpublishIdea(id) {
                 if (!confirm('Are you sure you want to unpublish this idea? It will become private.')) return;
                 try {
                     const response = await fetch(`/api/ideas/${id}`, {
                         method: 'PUT',
                         headers: {
                             'Content-Type': 'application/json',
                         },
                         body: JSON.stringify({ privacy: 'private' })
                     });
                     if (response.ok) {
                         showToast('Idea unpublished successfully', 'success');
                         window.location.reload();
                     } else {
                         showToast('Failed to unpublish idea', 'error');
                     }
                 } catch (error) {
                     console.error('Unpublish error:', error);
                     showToast('Failed to unpublish idea', 'error');
                 }
             }

            // Rate idea function
            async function rateIdea(ideaId, rating, clickedStar) {
                try {
                    const response = await fetch(`/api/votes`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ idea_id: ideaId, rating: parseInt(rating) }),
                    });
                    if (response.ok) {
                        const data = await response.json();
                        // Update the star display
                        updateStarDisplay(clickedStar.closest('.star-rating'), rating);
                        showToast('Rating submitted successfully', 'success');
                    } else {
                        const error = await response.json();
                        showToast(error.error || 'Failed to submit rating', 'error');
                    }
                } catch (error) {
                    console.error('Rate idea error:', error);
                    showToast('Failed to submit rating', 'error');
                }
            }

             // Update star display
             function updateStarDisplay(starRating, rating) {
                 const stars = starRating.querySelectorAll('.star-btn');
                 stars.forEach((star, index) => {
                     const starIcon = star.querySelector('svg');
                     if (index < rating) {
                         starIcon.classList.add('fill-current', 'text-yellow-400');
                         starIcon.classList.remove('text-muted-foreground');
                     } else {
                         starIcon.classList.remove('fill-current', 'text-yellow-400');
                         starIcon.classList.add('text-muted-foreground');
                     }
                 });
                 // Update data-rating on card
                 const card = starRating.closest('.cursor-pointer');
                 if (card) {
                     card.setAttribute('data-rating', rating);
                 }
             }

             // Update idea status function
             async function updateIdeaStatus(button, ideaId, newStatus) {
                 try {
                     const response = await fetch(`/api/ideas/${ideaId}`, {
                         method: 'PUT',
                         headers: {
                             'Content-Type': 'application/json',
                         },
                         body: JSON.stringify({ overall_status: newStatus })
                     });
                     if (response.ok) {
                         showToast(`Status updated to ${newStatus.replace('_', ' ')}`, 'success');
                         // Update the card's data-status attribute
                         const card = button.closest('.idea-card');
                         if (card) {
                             card.setAttribute('data-status', newStatus);
                             // Update status badge
                             const statusBadge = card.querySelector('.status-badge');
                             if (statusBadge) {
                                 statusBadge.textContent = newStatus.replace('_', ' ');
                                 statusBadge.className = `status-badge status-${newStatus}`;
                             }
                         }
                     } else {
                         showToast('Failed to update status', 'error');
                     }
                 } catch (error) {
                     console.error('Error updating status:', error);
                     showToast('Failed to update status', 'error');
                 }
             }

             // Update idea privacy function
             async function updateIdeaPrivacy(button, ideaId, newPrivacy) {
                 try {
                     const response = await fetch(`/api/ideas/${ideaId}`, {
                         method: 'PUT',
                         headers: {
                             'Content-Type': 'application/json',
                         },
                         body: JSON.stringify({ privacy: newPrivacy })
                     });
                     if (response.ok) {
                         showToast(`Idea is now ${newPrivacy}`, 'success');
                         location.reload();
                     } else {
                         showToast('Failed to update privacy', 'error');
                     }
                 } catch (error) {
                     console.error('Error updating privacy:', error);
                     showToast('Failed to update privacy', 'error');
                 }
             }
        </script>





    {{> nav lng=lng user=user projects=projects activeNav=activeNav unreadCount=unreadCount}}

    <main class="main-content">
        {{{body}}}
    </main>


</body>

</html>