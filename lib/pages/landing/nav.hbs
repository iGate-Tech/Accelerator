<!-- Navigation: Pill Shaped & Floating -->
<nav
  class="fixed -translate-x-1/2 flex transition-all duration-300 hover:border-white/20 dark:hover:border-white/20 bg-gradient-to-br from-gray-50 to-white dark:from-white/10 dark:to-white/0 w-full lg:w-fit max-w-[90vw] z-50 rounded-full ring-gray-200 dark:ring-white/10 ring-1 pt-1.5 pr-1.5 pb-1.5 pl-4 top-6 left-1/2 shadow-2xl backdrop-blur-xl items-center justify-between">
  <!-- Logo Area -->
  <div class="flex gap-2.5 items-center mr-8">
    <div class="relative flex items-center justify-center">
      <!-- Subtle glow behind logo -->
      <svg width="48" height="48" viewBox="0 0 33 36" fill="none" xmlns="http://www.w3.org/2000/svg"
        class="w-[48px] h-[48px]" aria-hidden="true" role="img">
        <path
          d="M31.6035 7.28044C31.1951 7.03803 30.7235 7.06833 30.3421 7.35872L26.4519 10.3182C25.9036 10.7348 25.5764 11.4317 25.5764 12.1868V21.1636C25.5764 24.2695 23.7757 26.9638 21.1966 27.7138L6.895 31.8726V14.5099C6.895 11.7171 8.5129 9.29549 10.8326 8.62128L31.4004 2.64179C31.9126 2.4928 32.2714 1.9701 32.2714 1.37165C32.2714 1.01561 32.1405 0.672189 31.9149 0.424727C31.687 0.177265 31.3823 0.0510083 31.0777 0.0611088L27.8352 0.177265C26.7972 0.215142 25.7615 0.3818 24.7551 0.674714L7.27635 5.75527C3.11314 6.9648 0.206787 11.2853 0.206787 16.2598V32.8423C0.206787 33.7033 0.716752 34.4508 1.44785 34.6629L5.68553 35.8876C5.8164 35.9255 5.95405 35.9457 6.09169 35.9457C6.22934 35.9457 6.36698 35.9255 6.49786 35.8876L24.8792 30.5444C29.2342 29.2793 32.2759 24.7594 32.2759 19.5526V8.52785C32.2759 8.00263 32.0209 7.52538 31.6103 7.28297L31.6035 7.28044Z"
          fill="currentColor" />
      </svg>
    </div>
    <span class="font-sans font-medium text-base tracking-tight text-gray-900 dark:text-white">Accelerator</span>
  </div>

  <!-- Links (Hidden on small screens) -->
  <div class="hidden md:flex items-center gap-6 mr-8">
     <a href="#hero" class="text-xs font-medium text-gray-600 dark:text-white/50 hover:text-gray-900 dark:hover:text-white transition-colors">{{i18n "landing.nav.home"}}</a>
     <a href="#features" class="text-xs font-medium text-gray-600 dark:text-white/50 hover:text-gray-900 dark:hover:text-white transition-colors">{{i18n "landing.nav.features"}}</a>
     <a href="#pricing" class="text-xs font-medium text-gray-600 dark:text-white/50 hover:text-gray-900 dark:hover:text-white transition-colors">{{i18n "landing.nav.pricing"}}</a>
  </div>

<!-- Theme Toggle -->
    <button id="theme-toggle" class="hidden md:flex items-center gap-1 mr-4 px-2 py-1 text-xs font-medium rounded-md bg-gray-200 dark:bg-white/50 text-gray-900 dark:text-white hover:bg-gray-300 dark:hover:bg-white hover:text-gray-900 dark:hover:text-black" onclick="toggleTheme()">
     <span id="theme-icon-light" class="hidden">{{{icon "sun" class="h-4 w-4"}}}</span>
     <span id="theme-icon-dark">{{{icon "moon" class="h-4 w-4"}}}</span>
     <span id="theme-text">Dark</span>
   </button>

    <!-- Language Switcher -->
     <button id="lang-switcher" class="hidden md:flex items-center gap-1 mr-4 px-2 py-1 text-xs font-medium rounded-md bg-gray-200 dark:bg-white/50 text-gray-900 dark:text-white hover:bg-gray-300 dark:hover:bg-white hover:text-gray-900 dark:hover:text-black" onclick="switchLanguage()">
      {{{icon "languages" class="h-4 w-4"}}}
      <span id="lang-text">{{#if (eq lng 'ar')}}AR{{else}}EN{{/if}}</span>
    </button>

  <!-- Action Buttons -->
  <div class="flex gap-2">

    <a href="/auth/login"
      class="flex gap-2 hover:bg-brand-purple transition-colors group text-xs font-semibold text-gray-900 dark:text-black bg-gray-50 dark:bg-white rounded-full pt-2 pr-4 pb-2 pl-4 gap-x-2 gap-y-2 items-center flex-none">
       {{i18n "landing.nav.start_building"}}
      {{{icon "arrow-right" size="1em" class="group-hover:translate-x-0.5 transition-transform"}}}
    </a>
  </div>
</nav>

<script>
   function toggleTheme() {
     const html = document.documentElement;
     html.classList.toggle('dark');
     const isDark = html.classList.contains('dark');
     localStorage.setItem('theme', isDark ? 'dark' : 'light');
     updateThemeToggle(isDark);
   }

   function updateThemeToggle(isDark) {
     const lightIcon = document.getElementById('theme-icon-light');
     const darkIcon = document.getElementById('theme-icon-dark');
     const text = document.getElementById('theme-text');

     if (lightIcon && darkIcon && text) {
       if (isDark) {
         lightIcon.classList.remove('hidden');
         darkIcon.classList.add('hidden');
         text.textContent = 'Light';
       } else {
         darkIcon.classList.remove('hidden');
         lightIcon.classList.add('hidden');
         text.textContent = 'Dark';
       }
     }
   }

  async function switchLanguage() {
    const currentLang = localStorage.getItem('language') || 'en';
    const newLang = currentLang === 'en' ? 'ar' : 'en';
    localStorage.setItem('language', newLang);
    updateLangSwitcher(newLang);

    // Reload the page with the new language prefix
    window.location.href = `/${newLang}`;
  }

   function updateLangSwitcher(lang) {
     const textSpan = document.getElementById('lang-text');
     if (textSpan) {
       textSpan.textContent = lang.toUpperCase();
     }
   }

    // Load saved theme and language on page load
    document.addEventListener('DOMContentLoaded', () => {
      const savedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
      const isDark = theme === 'dark';

      if (isDark) {
        document.documentElement.classList.add('dark');
      }

      updateThemeToggle(isDark);
       updateLangSwitcher('{{lng}}');
    });
 </script>