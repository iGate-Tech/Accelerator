{
  "name": "Accelerator",
  "version": "1.0.0",
  "description": "AI-powered startup accelerator tool using XState for state management and OpenAI for simulations",
  "repository": "https://github.com/iGate-Tech/Accelerator.git",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "concurrently \"vite\" \"node server.js\"",
    "dev:vite": "vite",
    "dev:server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "push": "git add . && git commit -m 'Update' && git push",
    "test": "vitest",
    "lint": "echo 'No linter configured yet - add ESLint or similar'",
    "generate-ssl": "./scripts/generate-ssl.sh",
    "backup:create": "node scripts/backup-db.js create",
    "backup:list": "node scripts/backup-db.js list",
    "validate-translations": "node validate-translations.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@solidjs/router": "^0.15.4",
    "animate.css": "^4.1.1",
    "body-parser": "^2.2.1",
    "daisyui": "^5.5.14",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-sort": "^3.4.1",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "lucide": "^0.562.0",
    "marked": "^17.0.1",
    "openai": "^6.15.0",
    "pg": "^8.16.3",
    "solid-js": "^1.9.10",
    "tailwindcss": "^3.4.19",
    "tailwindcss-rtl": "^0.9.0",
    "uuid": "^13.0.0",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "jsdom": "^27.4.0",
    "nodemon": "^3.1.11",
    "postcss-preset-env": "^10.6.0",
    "tailwindcss": "^4.1.18",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  }
}
