<!-- Idea Detail Page - Clean, Modern Redesign -->
<main class="min-h-screen bg-background">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Back Button -->
    <div class="mb-6">
      <a href="/explore-idea" class="inline-flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors">
        {{{icon 'arrow-left' class='w-4 h-4'}}}
        <span>Back to Ideas</span>
      </a>
    </div>

    <!-- Main Idea Card -->
    <div class="bg-card border border-border rounded-2xl p-6 md:p-8 shadow-sm">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- Left Column: Content -->
        <div class="flex-1 space-y-6">

          <!-- Title and Description -->
          <div class="space-y-4">
            <h1 class="text-3xl md:text-4xl font-bold text-foreground leading-tight">{{idea.title}}</h1>
            {{#if idea.description}}
            <div class="prose prose-lg max-w-none text-muted-foreground">
              {{{markdown idea.description}}}
            </div>
            {{/if}}
          </div>

          <!-- Creator Info -->
          <div class="flex items-center gap-3 p-4 bg-muted/50 rounded-xl">
            <img src="{{cond idea.profiles.avatar_url idea.profiles.avatar_url '/images/avatar.png'}}"
                 alt="{{idea.profiles.name}} avatar"
                 class="w-10 h-10 rounded-full ring-2 ring-background">
            <div>
              <p class="text-sm text-muted-foreground">Created by</p>
              <p class="font-semibold text-foreground">{{idea.profiles.name}}</p>
            </div>
          </div>

          <!-- Tags -->
          {{#if idea.tags}}
          <div class="flex flex-wrap gap-2">
            {{#each idea.tags}}
            <span class="px-3 py-1 bg-secondary text-secondary-foreground rounded-full text-sm">
              {{{icon 'tag' class='w-3 h-3 mr-1'}}}
              {{this}}
            </span>
            {{/each}}
          </div>
          {{/if}}

        </div>

        <!-- Right Column: Metadata and Actions -->
        <div class="lg:w-80 space-y-6">

          <!-- Rating Display -->
          <div class="bg-muted/50 rounded-xl p-4">
            <h3 class="font-semibold text-foreground mb-3">Rating</h3>
            {{#if idea.rating}}
            <div class="flex items-center gap-2 mb-2">
              <div class="flex gap-0.5">
                {{#each (range 1 5)}}
                {{{icon 'star' class='w-4 h-4 {{#if (gte ../idea.rating this)}}fill-amber-400 text-amber-400{{else}}text-muted-foreground/40{{/if}}'}}}
                {{/each}}
              </div>
              <span class="font-bold text-lg">{{idea.rating}}/5</span>
            </div>
            {{#if idea.voteStats.total}}
            <p class="text-sm text-muted-foreground">{{idea.voteStats.total}} votes</p>
            {{/if}}
            {{else}}
            <p class="text-muted-foreground">Not rated yet</p>
            {{/if}}
          </div>

          <!-- Metadata -->
          <div class="space-y-3">
            {{#if idea.category}}
            <div class="flex justify-between items-center py-2 border-b border-border/50">
              <span class="text-sm text-muted-foreground">Category</span>
              <span class="font-medium">{{idea.category}}</span>
            </div>
            {{/if}}
            <div class="flex justify-between items-center py-2 border-b border-border/50">
              <span class="text-sm text-muted-foreground">Status</span>
              <span class="px-2 py-1 rounded-full text-xs font-medium
                           {{#if (eq idea.overall_status 'completed')}}bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300
                           {{else if (eq idea.overall_status 'in_progress')}}bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300
                           {{else}}bg-muted text-muted-foreground{{/if}}">
                {{idea.overall_status}}
              </span>
            </div>
            {{#if idea.completion_percentage}}
            <div class="flex justify-between items-center py-2 border-b border-border/50">
              <span class="text-sm text-muted-foreground">Progress</span>
              <span class="font-medium">{{idea.completion_percentage}}%</span>
            </div>
            {{/if}}
            <div class="flex justify-between items-center py-2">
              <span class="text-sm text-muted-foreground">Created</span>
              <span class="font-medium">{{idea.created_at_formatted}}</span>
            </div>
          </div>

          <!-- Actions -->
          <div class="space-y-3">
            {{#if (eq idea.user_id user.id)}}
            <!-- Owner Actions -->
            <a href="/models/idea?ideaId={{idea.id}}" class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-primary text-primary-foreground rounded-xl hover:bg-primary/90 transition-colors font-medium">
              {{{icon 'edit' class='w-4 h-4'}}}
              <span>Continue Editing</span>
            </a>
            <button hx-delete="/api/ideas/{{idea.id}}"
                    hx-confirm="Are you sure you want to delete this idea? This action cannot be undone."
                    hx-swap="none"
                    hx-on:htmx:after-request="window.location.href='/explore-idea'"
                    hx-on:htmx:response-error="showToast('Failed to delete idea. Please try again.', 'error')"
                    class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-red-600 text-white rounded-xl hover:bg-red-700 transition-colors font-medium">
              {{{icon 'trash-2' class='w-4 h-4'}}}
              <span>Delete Idea</span>
            </button>
            {{else}}
            <!-- Public Actions -->
            <div class="text-center p-4 bg-primary/5 border border-primary/20 rounded-xl">
              <p class="text-primary font-medium">This is a public idea</p>
            </div>
            {{/if}}

            {{#if (not user)}}
            <div class="text-center p-4 bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-800 rounded-xl">
              <p class="text-green-800 dark:text-green-300 font-medium">Join the community to rate ideas</p>
            </div>
            {{/if}}
          </div>

        </div>

      </div>
    </div>

    <!-- Voting Section -->
    {{#if (and user (not (eq idea.user_id user.id)))}}
    <div class="mt-8 bg-card border border-border rounded-2xl p-6 md:p-8 shadow-sm">
      <h2 class="text-2xl font-bold text-foreground text-center mb-6">Share Your Feedback</h2>

      <form id="vote-form" class="max-w-md mx-auto space-y-6" method="post" action="/api/votes">
        <input type="hidden" name="ideaId" value="{{idea.id}}" />

        <div>
          <label class="block text-center font-medium text-foreground mb-4">
            How would you rate this idea?
          </label>
          <div class="flex justify-center gap-3 mb-4">
            {{#each (range 1 5)}}
            <label class="cursor-pointer">
              <input type="radio" name="rating" value="{{this}}" class="sr-only peer" />
              <div class="w-12 h-12 rounded-full border-2 border-border peer-checked:border-amber-400 peer-checked:bg-amber-50 dark:peer-checked:bg-amber-950/30 flex items-center justify-center hover:border-amber-300 transition-colors">
                <span class="font-semibold text-foreground peer-checked:text-amber-600">{{this}}</span>
              </div>
            </label>
            {{/each}}
          </div>
          <div class="flex justify-between text-sm text-muted-foreground">
            <span>Poor</span>
            <span>Excellent</span>
          </div>
        </div>

        <button type="submit" id="submit-vote-btn"
                class="w-full bg-primary hover:bg-primary/90 text-primary-foreground font-semibold py-3 px-6 rounded-xl transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
          <span>Submit Rating</span>
          {{{icon 'check' class='w-4 h-4'}}}
        </button>
      </form>

      <div id="vote-result" class="mt-6 text-center hidden">
        <div class="bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-800 rounded-xl p-4">
          {{{icon 'check-circle' class='w-8 h-8 text-green-600 dark:text-green-400 mx-auto mb-2'}}}
          <h3 class="font-semibold text-green-900 dark:text-green-100 mb-1">Vote Submitted!</h3>
          <p class="text-green-800 dark:text-green-200">Thank you for your feedback</p>
        </div>
      </div>
    </div>
    {{else if (eq idea.user_id user.id)}}
    <!-- Owner View -->
    <div class="mt-8 bg-card border border-border rounded-2xl p-6 md:p-8 shadow-sm text-center">
      <h2 class="text-2xl font-bold text-foreground mb-4">Your Idea</h2>
      <p class="text-muted-foreground mb-6">This is your own idea. Check your portfolios to see how it's performing.</p>
      <a href="/portfolios" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-xl hover:bg-primary/90 transition-colors font-medium">
        {{{icon 'folder' class='w-4 h-4'}}}
        <span>Go to Portfolios</span>
      </a>
    </div>
    {{/if}}

  </div>
</main>

