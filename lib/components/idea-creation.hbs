            }

            40% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 0, 0.15);
            }

            42.5% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 32, 0.15);
            }

            45% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 64, 0.15);
            }

            47.5% {
                box-shadow: 0 0 70px 55px rgba(0, 255, 96, 0.15);
            }

            50% {
