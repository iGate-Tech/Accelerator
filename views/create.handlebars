{{!< main}}
    <div class="max-w-4xl lg:max-w-6xl mx-auto">
        <div class="bg-base-100 rounded-xl shadow-lg border border-base-200 p-10 lg:p-12">
            <div class="lg:flex lg:space-x-12">
                <div class="lg:w-1/3 mb-8 lg:mb-0">
                    <h1 class="text-3xl lg:text-4xl font-bold text-base-content mb-6">Create New Idea</h1>
                    <div class="space-y-4">
                        <div>
                            <p class="text-base-content/70 text-base">Step {{index}} of {{total}}</p>
                            <div class="badge badge-neutral">{{question.model}} - {{question.section}}</div>
                        </div>
                        <progress class="progress progress-primary w-full h-4" value="{{index}}" max="{{total}}"></progress>
                    </div>
                </div>
                <div class="lg:w-2/3">
                    <div class="mb-8">
                        <h2 class="text-2xl font-semibold text-base-content mb-4">{{question.question}}</h2>
                    </div>

            {{#if (gt index 0)}}
            <form action="/prev" method="post" class="inline-block mr-4">
                <button type="submit" class="btn btn-outline btn-sm hover:btn-outline transition-colors">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Save Draft
                </button>
            </form>
            {{/if}}

            <form id="create-form" action="/next" method="post">
                    <div class="form-control mb-8">
                        <label class="label">
                            <span class="label-text font-medium text-lg">Your Answer</span>
                        </label>
                        <div class="relative">
                            <div id="markdown-preview" class="p-4 bg-base-50 border border-base-200 rounded-lg text-base leading-relaxed cursor-pointer hover:bg-base-100 transition-colors" style="min-height: 150px;"></div>
                            <div id="edit-mode" class="hidden">
                                <textarea name="answer" id="answer-input" class="w-full p-4 border border-base-300 rounded-lg resize-none focus:outline-none focus:ring-2 focus:ring-primary text-base" placeholder="Type your answer here..." style="min-height: 150px;">{{currentAnswer}}</textarea>
                                <button type="button" id="show-preview-btn" class="btn btn-sm btn-outline mt-3">Show Preview</button>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4 text-sm text-base-content/60">
                        <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                        AI uses full context from your previous answers for personalized, concise responses.
                    </div>

                    <div class="flex gap-4 flex-wrap justify-center lg:justify-start">
                        <button type="button" class="btn btn-primary btn-sm hover:btn-primary transition-colors" onclick="fillWithAI('{{question.prompt}}')" title="Ctrl+F">
                            <i data-lucide="wand" class="w-4 h-4"></i>
                            Fill with AI
                        </button>

                        <button type="button" class="btn btn-secondary btn-sm hover:btn-secondary transition-colors" onclick="improveWithAI('{{question.question}}', '{{question.prompt}}')" title="Ctrl+I">
                            <i data-lucide="zap" class="w-4 h-4"></i>
                            Improve with AI
                        </button>

                        <button type="submit" class="btn btn-success btn-sm hover:btn-success transition-colors" title="Ctrl+Enter">
                            <i data-lucide="send" class="w-4 h-4"></i>
                            Submit
                        </button>
                    </div>
            </form>

            <div class="mt-10 pt-8 border-t border-base-300">
                <a href="/" class="btn btn-ghost btn-sm hover:btn-ghost transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Back to Ideas
                </a>
            </div>
        </div>
    </div>

<script>
    // Load marked for client-side Markdown rendering
    if (typeof marked === 'undefined') {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/marked/marked.min.js';
        script.onload = initMarkdown;
        document.head.appendChild(script);
    } else {
        initMarkdown();
    }

    function initMarkdown() {
        const textarea = document.getElementById('answer-input');
        const preview = document.getElementById('markdown-preview');

        if (!textarea || !preview) return;

        function updatePreview() {
            const text = textarea.value;
            try {
                preview.innerHTML = marked.parse(text);
            } catch (e) {
                console.error('Markdown error:', e);
                preview.innerHTML = '<em>Markdown rendering error</em>';
            }
        }

        function autoResize() {
            textarea.style.overflow = 'hidden';
            textarea.style.height = 'auto';
            textarea.style.height = Math.max(textarea.scrollHeight, 100) + 'px';
        }

        function showPreview() {
            preview.classList.remove('hidden');
            textarea.classList.add('hidden');
        }

        function showTextarea() {
            document.getElementById('edit-mode').classList.remove('hidden');
            preview.classList.add('hidden');
            textarea.focus();
        }

        function showPreview() {
            preview.classList.remove('hidden');
            document.getElementById('edit-mode').classList.add('hidden');
            updatePreview();
        }

        window.updatePreview = updatePreview;
        window.autoResize = autoResize;

        preview.addEventListener('click', showTextarea);
        document.getElementById('show-preview-btn').addEventListener('click', showPreview);

        textarea.addEventListener('input', function() {
            updatePreview();
            autoResize();
        });

        // Initial setup
        updatePreview();
        autoResize();
        showPreview();
    }
</script>

<script>
async function fillWithAI(prompt) {
    const response = await fetch('/ai-fill', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ prompt })
    });
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let result = '';
    const textarea = document.getElementById('answer-input');
    const preview = document.getElementById('markdown-preview');
    while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        result += decoder.decode(value, { stream: true });
        textarea.value = result;
        // Update preview in real-time
        if (window.updatePreview) window.updatePreview();
        if (window.autoResize) window.autoResize();
    }
    textarea.value = result; // final
    textarea.dispatchEvent(new Event('input'));
}

async function improveWithAI(question, prompt) {
    const answer = document.getElementById('answer-input').value;
    const response = await fetch('/improve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ question, prompt, answer })
    });
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let result = '';
    const textarea = document.getElementById('answer-input');
    const preview = document.getElementById('markdown-preview');
    while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        result += decoder.decode(value, { stream: true });
        textarea.value = result;
        // Update preview in real-time
        if (window.updatePreview) window.updatePreview();
        if (window.autoResize) window.autoResize();
    }
    textarea.value = result; // final
    textarea.dispatchEvent(new Event('input'));
}

// Keyboard shortcuts
document.addEventListener('keydown', function(e) {
    if (e.ctrlKey || e.metaKey) {
        switch(e.key) {
            case 'f':
            case 'F':
                e.preventDefault();
                fillWithAI('{{question.prompt}}');
                break;
            case 'i':
            case 'I':
                e.preventDefault();
                improveWithAI('{{question.question}}', '{{question.prompt}}');
                break;
            case 'Enter':
                e.preventDefault();
                document.getElementById('create-form').submit();
                break;
        }
    }
});
</script>