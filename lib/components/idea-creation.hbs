<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    // Wait for marked to load
    window.waitForMarked = function(callback) {
        if (typeof marked !== 'undefined') {
            callback();
        } else {
            setTimeout(() => window.waitForMarked(callback), 100);
        }
    }

    window.populateIdea = JSON.parse('{{{populateIdeaJson}}}');

</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        // Initialize form elements
        const form = document.getElementById('new-project-form');
        const titleSpan = document.getElementById('title');
        const categorySpan = document.getElementById('category'); // Second contenteditable
        const descriptionTextarea = document.getElementById('assistant-prompt');
        const tagsContainer = document.getElementById('tagslist');
        const submitButton = document.querySelector('button[type="submit"]');

        // Auto-expand textarea
        function autoExpandTextarea() {
            descriptionTextarea.style.height = 'auto';
            descriptionTextarea.style.height = descriptionTextarea.scrollHeight + 'px';
        }

        // Character counter
        function updateCharCounter() {
            const length = descriptionTextarea.value.length;
            const counter = document.getElementById('char-counter');
            counter.textContent = `Characters: ${length} / 2000`;
            if (length < 100 || length > 2000) {
                counter.className = 'text-xs text-red-500/60 mr-2';
            } else {
                counter.className = 'text-xs text-green-500/60 mr-2';
            }
            autoExpandTextarea();
        }

        // Initialize textarea height
        descriptionTextarea.style.minHeight = '2.5rem'; // Match the rows="2" initial height
        descriptionTextarea.style.resize = 'none'; // Prevent manual resizing
        descriptionTextarea.style.overflow = 'hidden'; // Hide scrollbar

        descriptionTextarea.addEventListener('input', updateCharCounter);
        updateCharCounter();

        // Ensure textarea height is adjusted for pre-filled content
        setTimeout(() => {
            autoExpandTextarea();
        }, 0);

        // Toast helper - now defined below

        const addOneTagBtn = document.getElementById('addOneTag');
        if (addOneTagBtn) {
            addOneTagBtn.addEventListener('click', function (e) {
                const tagSpan = document.createElement('span');
                tagSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-muted text-muted-foreground border border-muted text-xs rounded-full tag-lskjsdb';
                tagSpan.innerHTML = `<span contenteditable="true">Click and type to edit</span> <button class="text-muted-foreground hover:text-destructive p-0">×</button>`;
                const addMoreBtn = tagsContainer.querySelector('[class*="bg-success/5"]');
                if (addMoreBtn) {
                    addMoreBtn.after(tagSpan);
                }
                tagSpan.querySelector('button').addEventListener('click', function () {
                    tagSpan.remove();
                    showToastMessage('Tag removed', 'success');
                    updateRemoveAllVisibility();
                });
                showToastMessage('Tag added successfully', 'success');
                updateRemoveAllVisibility();
            });
        }

        const removeAllTagsBtn = document.getElementById('removeAllTags');
        removeAllTagsBtn.style.display = 'none';

        function updateRemoveAllVisibility() {
            const tagCount = document.querySelectorAll('.tag-lskjsdb').length;
            removeAllTagsBtn.style.display = tagCount > 1 ? 'inline-flex' : 'none';
        }

        removeAllTagsBtn.addEventListener('click', function (e) {
            removeAllTags();
        });

        // Tag management functions
        function addTag(tagText) {

            if (typeof tagText === 'object') {
                tagText = tagText.name || tagText.value || tagText.toString();
            }
            if (!tagText || !tagText.trim()) {

                return;
            }
            const tagSpan = document.createElement('span');
            tagSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-muted text-muted-foreground border border-muted text-xs rounded-full tag-lskjsdb';
            tagSpan.innerHTML = `<span contenteditable="true">${tagText}</span> <button class="text-muted-foreground hover:text-destructive p-0">×</button>`;
            const addMoreBtn = tagsContainer.querySelector('[class*="bg-success/5"]');

            if (addMoreBtn) {
                addMoreBtn.after(tagSpan);

            } else {

            }
            tagSpan.querySelector('button').addEventListener('click', function () {
                tagSpan.remove();
                showToastMessage('Tag removed', 'success');
                updateRemoveAllVisibility();
            });
            updateRemoveAllVisibility();
        }

        function addTagsFromArray(tagsArray) {
            if (Array.isArray(tagsArray)) {
                tagsArray.forEach(tag => addTag(tag));
            }
        }

        function removeAllTags() {
            const tagElements = document.querySelectorAll('.tag-lskjsdb');
            const count = tagElements.length;
            if (count === 0) {
                showToastMessage('No tags to remove', 'warning');
            } else {
                tagElements.forEach(tag => tag.remove());
                showToastMessage(`${count} tags removed`, 'success');
                updateRemoveAllVisibility();
            }
        }

        // Populate form fields if populateIdea exists

        if (window.populateIdea) {


            // Populate title
            if (window.populateIdea.title) {
                titleSpan.innerHTML = window.populateIdea.title;
            }

            // Populate category
            if (window.populateIdea.category) {
                categorySpan.innerHTML = window.populateIdea.category;
            }

            // Populate description
            if (window.populateIdea.description) {
                descriptionTextarea.value = window.populateIdea.description;
                updateCharCounter();
            }

            // Populate tags
            if (window.populateIdea.tags && Array.isArray(window.populateIdea.tags)) {
                window.populateIdea.tags.forEach(tag => {

                    addTag(tag);
                });
            }
        } else {

        }

        // Add click-to-edit functionality for the description field
        waitForMarked(() => {
            const displayDivEdit = document.getElementById('assistant-prompt-display');
            displayDivEdit.addEventListener('click', function() {
                if (this.style.display === 'block') {
                    // Switch to edit mode
                    this.style.display = 'none';
                    descriptionTextarea.style.display = 'block';
                    descriptionTextarea.focus();
                    autoExpandTextarea();
                }
            });

            descriptionTextarea.addEventListener('blur', function() {
                // Switch back to display mode when losing focus
                const content = this.value;
                this.dataset.originalContent = content;
                const processedContent = content.replace(/\n/g, '\n\n');
                displayDivEdit.innerHTML = marked.parse(processedContent, { breaks: true });
                displayDivEdit.style.display = 'block';
                this.style.display = 'none';
            });
        });

        // AI button handlers
        waitForMarked(() => {
        async function callAIApi(endpoint, data) {
            try {
                const response = await fetch(`/api/ai/${endpoint}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                return await response.json();
            } catch (error) {
                console.error('AI API error:', error);
                return { error: 'Network error' };
            }
        }

        // Enhanced toast function that waits for toast system
        function showToastMessage(message, type) {
            // Try multiple ways to show toast
            if (typeof window.showToast === 'function') {
                return window.showToast(message, type);
            } else if (typeof window.showSuccessToast === 'function' && type === 'success') {
                return window.showSuccessToast('Success', message);
            } else if (typeof window.showErrorToast === 'function' && type === 'error') {
                return window.showErrorToast('Error', message);
            } else if (typeof window.showWarningToast === 'function' && type === 'warning') {
                return window.showWarningToast('Warning', message);
            } else if (typeof window.showInfoToast === 'function' && type === 'info') {
                return window.showInfoToast('Info', message);
            } else {
                // Fallback: try to find toast container and create simple toast
                const container = document.getElementById('toast-container');
                if (container) {
                    const toast = document.createElement('div');
                    toast.className = `toast toast-${type} p-4 rounded-lg border shadow-lg max-w-sm bg-card text-card-foreground border-border`;
                    toast.textContent = message;
                    container.appendChild(toast);
                    setTimeout(() => toast.remove(), 5000);
                }
            }
        }

        // Helper function to set button loading state
        function setButtonLoading(button, loading) {
            if (!button) return;

            const icon = button.querySelector('svg');
            const textSpan = button.querySelector('span');

            if (loading) {
                button.disabled = true;
                button.classList.add('cursor-not-allowed', 'bg-warning/20', 'border-warning/50');

                // Replace icon with loading spinner
                if (icon) {
                    icon.outerHTML = `{{{icon 'loader' class='w-4 h-4 animate-spin text-warning' size='16'}}}`;
                }

                // Show processing text
                if (textSpan) {
                    textSpan.textContent = 'Processing...';
                    textSpan.classList.remove('hidden', 'group-hover:inline');
                    textSpan.classList.add('inline', 'text-warning');
                }
            } else {
                button.disabled = false;
                button.classList.remove('cursor-not-allowed', 'bg-warning/20', 'border-warning/50');

                // Restore original icon
                const spinner = button.querySelector('.animate-spin');
                if (spinner) {
                    const ariaLabel = button.getAttribute('aria-label');
                    let originalIcon = '';

                    if (ariaLabel.includes('title')) {
                        originalIcon = `{{{icon 'type' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('category')) {
                        originalIcon = `{{{icon 'folder' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('Improve')) {
                        originalIcon = `{{{icon 'lightbulb' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('tags')) {
                        originalIcon = `{{{icon 'tag' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('Auto fill')) {
                        originalIcon = `{{{icon 'wand-sparkles' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('random')) {
                        originalIcon = `{{{icon 'shuffle' class='w-4 h-4' size='16'}}}`;
                    }

                    spinner.outerHTML = originalIcon;
                }

                // Reset text to original state and restore hover behavior
                if (textSpan) {
                    // Reset to original text based on button type
                    const ariaLabel = button.getAttribute('aria-label');
                    if (ariaLabel.includes('title')) {
                        textSpan.textContent = 'Generate Title with AI';
                    } else if (ariaLabel.includes('category')) {
                        textSpan.textContent = 'Add Category with AI';
                    } else if (ariaLabel.includes('Improve')) {
                        textSpan.textContent = 'Improve Description with AI';
                    } else if (ariaLabel.includes('tags')) {
                        textSpan.textContent = 'Add Tags with AI';
                    } else if (ariaLabel.includes('Auto fill')) {
                        textSpan.textContent = 'Auto Fill with AI';
                    } else if (ariaLabel.includes('random')) {
                        textSpan.textContent = 'Random Idea with AI';
                    }

                    // Restore original classes for hover behavior
                    textSpan.classList.remove('inline', 'text-warning');
                    textSpan.classList.add('hidden', 'group-hover:inline');
                }
            }
        }


        // Generate random idea
        const randomIdeaBtn = document.querySelector('[aria-label="Generate random idea"]');
        randomIdeaBtn.addEventListener('click', async function (e) {
            e.preventDefault();

