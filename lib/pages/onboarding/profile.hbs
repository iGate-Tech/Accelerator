 <div class="min-h-screen bg-gradient-to-br from-base-100 via-success/10 to-info/10">
  <div class="relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 20% 80%, color-mix(in oklab, hsl(var(--color-emerald-500)), transparent 95%) 2px, transparent 2px), radial-gradient(circle at 80% 20%, color-mix(in oklab, hsl(var(--color-blue-500)), transparent 95%) 2px, transparent 2px); background-size: 40px 40px;"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
         <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-success to-info rounded-2xl mb-8 shadow-lg">
{{{icon 'user' class="w-10 h-10 text-white"}}}
        </div>
         <h1 class="text-5xl font-bold bg-gradient-to-r from-foreground via-success to-info bg-clip-text text-transparent mb-6">
          Complete Your Profile
        </h1>
         <p class="text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
          Help us personalize your experience by sharing a bit about yourself. This information helps us provide better recommendations and features.
        </p>
      </div>

      <!-- Progress Indicator -->
      <div class="flex justify-center mb-12">
        <div class="flex items-center space-x-4">
          <div class="flex items-center">
             <div class="w-10 h-10 bg-success rounded-full flex items-center justify-center text-success-content font-bold">1</div>
             <span class="ml-3 text-success font-semibold">Account</span>
          </div>
           <div class="w-16 h-0.5 bg-success/50"></div>
           <div class="flex items-center">
             <div class="w-10 h-10 bg-success rounded-full flex items-center justify-center text-success-content font-bold">2</div>
             <span class="ml-3 text-success font-semibold">Profile</span>
           </div>
           <div class="w-16 h-0.5 bg-muted"></div>
           <div class="flex items-center">
             <div class="w-10 h-10 bg-muted rounded-full flex items-center justify-center text-muted-foreground font-bold">3</div>
             <span class="ml-3 text-muted-foreground">Complete</span>
           </div>
        </div>
      </div>

      <!-- Form -->
       <div class="bg-card rounded-3xl shadow-2xl p-8 md:p-12">
        <form method="post" action="/onboarding/profile" class="space-y-8">
          <input type="hidden" name="_csrf" value="{{csrf}}" />

          <!-- Display Name -->
          <div class="space-y-4">
             <div class="flex items-center space-x-3">
               <div class="w-8 h-8 bg-success/10 rounded-full flex items-center justify-center">
{{{icon 'user' class="w-4 h-4 text-success"}}}
               </div>
               <h3 class="text-xl font-semibold text-foreground">Personal Information</h3>
             </div>

            <div class="ml-11">
               <label for="name" class="block text-sm font-medium text-foreground mb-2">
                 Display Name <span class="text-error">*</span>
               </label>
               <input type="text" id="name" name="name" value="{{profile.name}}"
                 class="w-full px-4 py-3 border border-input rounded-xl focus:ring-2 focus:ring-success focus:border-success transition-all duration-200 bg-muted focus:bg-base-100"
                 placeholder="How you'd like to be known on Accelerator" required />
               <p class="text-sm text-muted-foreground mt-1">This will be visible to other community members</p>
            </div>
          </div>

          <!-- Role -->
          <div class="space-y-4">
             <div class="flex items-center space-x-3">
               <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
{{{icon 'briefcase' class="w-4 h-4 text-primary"}}}
               </div>
               <h3 class="text-xl font-semibold text-foreground">Professional Background</h3>
             </div>

            <div class="ml-11">
               <label for="role" class="block text-sm font-medium text-foreground mb-2">
                 Your Role
               </label>
               <select id="role" name="role"
                 class="w-full px-4 py-3 border border-input rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all duration-200 bg-muted focus:bg-base-100">
                <option value="">Select your role (optional)</option>
                <option value="founder" {{#if (eq profile.role "founder"}}selected{{/if}}>🏢 Founder/Entrepreneur</option>
                <option value="student" {{#if (eq profile.role "student"}}selected{{/if}}>🎓 Student</option>
                <option value="developer" {{#if (eq profile.role "developer"}}selected{{/if}}>💻 Developer</option>
                <option value="designer" {{#if (eq profile.role "designer"}}selected{{/if}}>🎨 Designer</option>
                <option value="marketer" {{#if (eq profile.role "marketer"}}selected{{/if}}>📈 Marketer</option>
                <option value="investor" {{#if (eq profile.role "investor"}}selected{{/if}}>💰 Investor</option>
                <option value="consultant" {{#if (eq profile.role "consultant"}}selected{{/if}}>🎯 Consultant</option>
                <option value="other" {{#if (eq profile.role "other"}}selected{{/if}}>🤔 Other</option>
              </select>
            </div>
          </div>

          <!-- Bio -->
          <div class="space-y-4">
             <div class="flex items-center space-x-3">
               <div class="w-8 h-8 bg-secondary/10 rounded-full flex items-center justify-center">
{{{icon 'edit-3' class="w-4 h-4 text-secondary"}}}
               </div>
               <h3 class="text-xl font-semibold text-foreground">About You</h3>
             </div>

            <div class="ml-11">
               <label for="bio" class="block text-sm font-medium text-foreground mb-2">
                 Bio
               </label>
               <textarea id="bio" name="bio" rows="4"
                 class="w-full px-4 py-3 border border-input rounded-xl focus:ring-2 focus:ring-secondary focus:border-secondary transition-all duration-200 bg-muted focus:bg-base-100 resize-none"
                 placeholder="Tell us about your background, interests, and what you're passionate about...">{{#if profile.preferences}}{{profile.preferences.bio}}{{/if}}</textarea>
               <p class="text-sm text-muted-foreground mt-1">Share your story to connect with like-minded entrepreneurs</p>
            </div>
          </div>

          <!-- Location & Website -->
          <div class="space-y-4">
             <div class="flex items-center space-x-3">
               <div class="w-8 h-8 bg-warning/10 rounded-full flex items-center justify-center">
{{{icon 'map-pin' class="w-4 h-4 text-warning"}}}
               </div>
               <h3 class="text-xl font-semibold text-foreground">Contact & Location</h3>
             </div>

            <div class="ml-11 grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                 <label for="location" class="block text-sm font-medium text-foreground mb-2">
                   Location
                 </label>
                 <input type="text" id="location" name="location" value="{{#if profile.preferences}}{{profile.preferences.location}}{{/if}}"
                   class="w-full px-4 py-3 border border-input rounded-xl focus:ring-2 focus:ring-warning focus:border-warning transition-all duration-200 bg-muted focus:bg-base-100"
                   placeholder="City, Country" />
              </div>

              <div>
                 <label for="website" class="block text-sm font-medium text-foreground mb-2">
                   Website
                 </label>
                 <input type="url" id="website" name="website" value="{{#if profile.preferences}}{{profile.preferences.website}}{{/if}}"
                   class="w-full px-4 py-3 border border-input rounded-xl focus:ring-2 focus:ring-warning focus:border-warning transition-all duration-200 bg-muted focus:bg-base-100"
                   placeholder="https://yourwebsite.com" />
              </div>
            </div>
          </div>

          <!-- Info Box -->
           <div class="bg-gradient-to-r from-success/10 to-info/10 border border-success/20 rounded-2xl p-6">
             <div class="flex items-start">
               <div class="w-10 h-10 bg-success/10 rounded-xl flex items-center justify-center mr-4 flex-shrink-0">
{{{icon 'info' class="w-5 h-5 text-success"}}}
               </div>
               <div>
                 <h4 class="text-lg font-semibold text-foreground mb-2">What's Next?</h4>
                 <p class="text-muted-foreground leading-relaxed">
                  After completing your profile, you'll unlock the full potential of Accelerator. Start creating ideas,
                  connect with the community, and build your startup journey. You can always update these details later in your settings.
                </p>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-6">
             <button type="submit"
               class="w-full bg-gradient-to-r from-success to-info hover:from-success/90 hover:to-info/90 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center justify-center space-x-3">
              <span>Complete Profile Setup</span>
{{{icon 'trending-up' class="w-5 h-5"}}}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>