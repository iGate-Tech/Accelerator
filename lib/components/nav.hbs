<nav class="bg-base-100 text-foreground px-2 sm:px-4 border-b border-input flex items-center justify-between min-h-12">
  <div class="flex items-center gap-2 sm:gap-4">
    <div class="h-6 w-6 ml-1 mr-4 sm:mr-6 text-primary"><img src="/images/favicon.svg" class="h-full w-full" /></div>

     <div class="hidden md:flex items-center gap-2 sm:gap-4">
       <div class="flex flex-col items-center justify-center group">
         <div class="border-t-4 border-primary w-6 rounded-md{{#if (eq activeNav 'projects')}} opacity-100{{else}} opacity-0 group-hover:opacity-100{{/if}}"></div>
          <a href="/new-idea"
            class="text-{{#if (eq activeNav 'projects')}}primary{{else}}muted-foreground group-hover:text-foreground hover:text-foreground{{/if}} text-sm leading-[2.7]">
            <span class="nav-text">{{t 'nav.projects'}}</span>
         </a>
       </div>
       <div class="flex flex-col items-center justify-center group">
         <div class="border-t-4 border-primary w-6 rounded-md{{#if (eq activeNav 'dashboard')}} opacity-100{{else}} opacity-0 group-hover:opacity-100{{/if}}"></div>
          <a href="/dashboard"
            class="text-{{#if (eq activeNav 'dashboard')}}primary{{else}}muted-foreground group-hover:text-foreground hover:text-foreground{{/if}} text-sm leading-[2.7]">
            <span class="nav-text">{{t 'nav.dashboard'}}</span>
         </a>
       </div>
       {{#if (eq user.profile.package_type "enterprise")}}
       <div id="nav-portfolio-item" class="flex flex-col items-center justify-center group">
         <div class="border-t-4 border-primary w-6 rounded-md{{#if (eq activeNav 'portfolios')}} opacity-100{{else}} opacity-0 group-hover:opacity-100{{/if}}"></div>
          <a href="/portfolios"
            class="text-{{#if (eq activeNav 'portfolios')}}primary{{else}}muted-foreground group-hover:text-foreground hover:text-foreground{{/if}} text-sm leading-[2.7]">
            <span class="nav-text">{{t 'nav.portfolio'}}</span>
         </a>
       </div>
       {{/if}}
       <div class="flex flex-col items-center justify-center group">
         <div class="border-t-4 border-primary w-6 rounded-md{{#if (eq activeNav 'voting')}} opacity-100{{else}} opacity-0 group-hover:opacity-100{{/if}}"></div>
          <a href="/voting-reward"
            class="text-{{#if (eq activeNav 'voting')}}primary{{else}}muted-foreground group-hover:text-foreground hover:text-foreground{{/if}} text-sm leading-[2.7] focus:outline-none">
            <span class="nav-text">{{t 'nav.voting_rewards'}}</span>
         </a>
       </div>
    </div>
  </div>
  <div class="flex items-center">
     <div class="h-12 w-px bg-border"></div>
     <!-- Credit Balance -->
    <div class="hidden md:flex items-center gap-2 px-3 py-2 ml-4">

      {{{icon 'coins' class='w-5 h-5 text-primary' size='16'}}}

        <span id="nav-credit-balance" class="text-sm">{{user.profile.credit_balance}} {{t 'nav.credits'}}</span>
    </div>

    <!-- Theme Toggle Button -->
    <button id="theme-toggle"
      class="ml-4 self-center w-6 h-6 text-muted-foreground hover:text-primary rounded-full cursor-pointer border-0"
      onclick="toggleTheme()">
      <span id="theme-icon-light">{{{icon "sun" class="h-5 w-5"}}}</span>
      <span id="theme-icon-dark" class="hidden">{{{icon
        "moon"
        class="h-5 w-5"
        }}}</span>
    </button>

    <!-- Language Switcher -->
    <button id="lang-switcher" class="flex items-center gap-1 ml-4 px-2 py-1 text-xs rounded-md bg-muted text-muted-foreground hover:bg-primary hover:text-primary-foreground" onclick="switchLanguage()">
      {{{icon "languages" class="h-4 w-4"}}}
       <span id="lang-text">{{#if (eq lng 'ar')}}AR{{else}}EN{{/if}}</span>
    </button>

    <!-- Notification Menu -->
    <div class="relative self-center" id="notification-menu">
      <button onclick="toggleNotificationMenu()"
        class="ml-4 text-muted-foreground hover:text-primary rounded-full p-2 cursor-pointer border-0 relative">

        {{{icon 'bell' class='w-4 h-4' size='16'}}}
        <span id="nav-notification-indicator" class="absolute -top-1 -right-1 h-2 w-2 bg-red-500 rounded-full{{#unless unreadCount}} hidden{{/unless}}"></span>

      </button>

      <!-- Notification Dropdown -->
       <div
         class="absolute {{#if (eq lng 'ar')}}left-0{{else}}right-0{{/if}} mt-2 w-[350px] bg-popover backdrop-blur-sm border border-input/80 rounded-lg shadow-xl z-30 transition-all duration-200 opacity-0 invisible hidden"
         id="notification-dropdown">
        <div class="p-1">
          <div class="px-2 py-1 text-sm text-muted-foreground">{{t 'nav.notifications'}}</div>
          <div class="bg-border -mx-1 my-1 h-px"></div>
          {{#if notifications}}
            <div class="space-y-1">
            {{#each notifications}}
              <div class="relative {{#unless is_read}}bg-primary/5{{/unless}} rounded-sm">
                <a href="#" class="flex cursor-default select-none items-start rounded-sm px-3 py-3 text-sm outline-none transition-colors hover:bg-primary/10" onclick="markAsRead('{{id}}')">
                  <div class="flex-shrink-0 mr-3 mt-0.5">
                    {{#if (eq type "vote_received")}}
                      <div class="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center">
                        {{{icon "star" class="h-4 w-4 text-yellow-600"}}}
                      </div>
                    {{else if (eq type "reward_earned")}}
                      <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                        {{{icon "coins" class="h-4 w-4 text-green-600"}}}
                      </div>
                    {{else if (eq type "idea_shared")}}
                      <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                        {{{icon "share" class="h-4 w-4 text-blue-600"}}}
                      </div>
                    {{else}}
                      <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
                        {{{icon "bell" class="h-4 w-4 text-gray-600"}}}
                      </div>
                    {{/if}}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm text-foreground leading-5 {{#if is_read}}text-muted-foreground{{/if}}">{{truncate message 80}}</p>
                    <p class="text-xs text-muted-foreground mt-1">{{moment created_at format="MMM D, h:mm A"}}</p>
                  </div>
                  {{#unless is_read}}
                    <div class="flex-shrink-0 ml-2">
                      <div class="w-2 h-2 bg-primary rounded-full"></div>
                    </div>
                  {{/unless}}
                </a>
              </div>
            {{/each}}
            </div>
            <div class="border-t border-border mt-2 pt-2">
               <a href="/notifications" class="flex items-center justify-center w-full px-3 py-2 text-sm text-primary hover:text-primary-foreground hover:bg-primary rounded-md transition-colors">
                  {{{icon "arrow-right" class="mr-2 h-4 w-4"}}}
                  {{t 'nav.view_all_notifications'}}
               </a>
            </div>
           {{else}}
             <div class="px-3 py-6 text-center">
               <div class="w-12 h-12 bg-muted rounded-full flex items-center justify-center mx-auto mb-3">
                 {{{icon "bell-off" class="h-6 w-6 text-muted-foreground"}}}
               </div>
               <p class="text-sm text-muted-foreground">{{t 'nav.no_notifications'}}</p>
             </div>
           {{/if}}
        </div>
      </div>
    </div>

    <!-- Grid Menu -->
    <div class="relative self-center" id="grid-menu">
      <button onclick="toggleGridMenu()"
        class="ml-4 text-muted-foreground hover:text-primary rounded-full p-2 cursor-pointer border-0">

        {{{icon 'grip' class='w-4 h-4' size='16'}}}

      </button>

      <!-- Grid Dropdown -->
       <div
         class="absolute {{#if (eq lng 'ar')}}left-0{{else}}right-0{{/if}} mt-2 w-[200px] bg-popover backdrop-blur-sm border border-input/80 rounded-md shadow-xl z-30 transition-all duration-200 opacity-0 invisible hidden"
         id="grid-dropdown">
        <div class="p-1">
          <div class="px-2 py-1 text-sm text-muted-foreground">{{t 'nav.quick_access'}}</div>
          <div class="bg-border -mx-1 my-1 h-px"></div>
          <div role="group" class="p-1">
             <a href="/dashboard"
               class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

               <div class="flex flex-col">
                   <span class="flex">{{{icon 'layout-dashboard' class='mr-2 h-4 w-4' size='16'}}} {{t 'nav.dashboard'}}</span>
                  <span class="text-xs text-muted-foreground">{{t 'nav.dashboard_desc'}}</span>
               </div>
             </a>
              <div class="bg-border -mx-1 my-1 h-px"></div>
              <a href="/new-idea"
                class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

                <div class="flex flex-col">
                   <span class="flex">{{{icon 'plus' class='mr-2 h-4 w-4' size='16'}}} {{t 'nav.new_idea'}}</span>
                   <span class="text-xs text-muted-foreground">{{t 'nav.new_idea_desc'}}</span>
                </div>
              </a>
              <div class="bg-border -mx-1 my-1 h-px"></div>
               <a href="/explore-idea"
                 class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

                <div class="flex flex-col">
                   <span class="flex">{{{icon 'search' class='mr-2 h-4 w-4' size='16'}}} {{t 'nav.explore_ideas'}}</span>
                   <span class="text-xs text-muted-foreground">{{t 'nav.explore_ideas_desc'}}</span>
                </div>
              </a>
              {{#if (eq user.profile.package_type "enterprise")}}
              <div class="bg-border -mx-1 my-1 h-px"></div>
              <a id="grid-portfolio-link" href="/portfolios"
                class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

                <div class="flex flex-col">
                   <span class="flex">{{{icon 'archive' class='mr-2 h-4 w-4' size='16'}}} {{t 'nav.portfolios'}}</span>
                   <span class="text-xs text-muted-foreground">{{t 'nav.portfolios_desc'}}</span>
                </div>
              </a>
              {{/if}}
            <div class="bg-border -mx-1 my-1 h-px"></div>
             <a href="/models/business"
               class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

               <div class="flex flex-col">
                   <span class="flex">{{{icon 'briefcase' class='mr-2 h-4 w-4' size='16'}}} {{t 'nav.business_models'}}</span>
                  <span class="text-xs text-muted-foreground">{{t 'nav.business_models_desc'}}</span>
               </div>
             </a>
             <div class="bg-border -mx-1 my-1 h-px"></div>
             <a href="/user-activity"
               class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

               <div class="flex flex-col">
                   <span class="flex">{{{icon 'activity' class='mr-2 h-4 w-4' size='16'}}} {{t 'nav.activity'}}</span>
                  <span class="text-xs text-muted-foreground">{{t 'nav.activity_desc'}}</span>
               </div>
             </a>
             <div class="bg-border -mx-1 my-1 h-px"></div>
           </div>
        </div>
      </div>
    </div>
    <!-- User Menu -->
    <div class="relative self-center" id="admin-user-menu">
      <button onclick="toggleUserMenu()"
        class="flex items-center gap-3 h-10 px-3 rounded-md transition-all duration-200 hover:text-primary cursor-pointer border-0"
        id="admin-user-menu-button">
        <img src="/images/avatar.png" class="h-6 w-6 rounded-full object-cover shrink-0 user-avatar" alt="User Avatar">


      </button>

      <!-- User Dropdown -->
       <div
         class="absolute {{#if (eq lng 'ar')}}left-0{{else}}right-0{{/if}} mt-2 w-64 bg-base-100 border border-input rounded-md shadow-lg z-30 transition-all duration-200 opacity-0 invisible hidden"
         id="admin-user-dropdown">
        <div class="p-2">

            <!-- User profile section -->
            <a href="/settings"
     class="w-full mb-2 relative flex cursor-default select-none items-center gap-3 rounded-sm px-3 py-3 text-sm text-left outline-none transition-colors bg-primary-50 hover:bg-primary-100 hover:text-primary-900">
     <div class="flex-1 min-w-0">
         <div class="flex items-center justify-between mb-1">
              <span class="truncate user-name text-foreground">{{user.profile.name}}</span>
             {{{icon 'settings' class='h-4 w-4 text-muted-foreground shrink-0' size='16'}}}
         </div>
         <div class="truncate text-xs text-muted-foreground user-email mb-1">{{user.email}}</div>
         <div class="text-xs text-muted-foreground">
             <span class="nav-current-plan-name">{{capitalize user.profile.package_type}} {{t 'nav.plan'}}</span>
         </div>
     </div>
 </a>






          <!-- Upgrade Package -->
          <a href="/upgrade-package"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "arrow-up-circle" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.upgrade_package'}}
          </a>

          <!-- Buy Credits -->
          <a href="/buy-credits"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "coins" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.buy_credits'}}
          </a>

          <!-- Billing -->
          <a href="/billing"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "credit-card" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.billing'}}
          </a>

          <!-- Add Payment Method -->
          <a href="/add-payment-method"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "plus-circle" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.add_payment_method'}}
            </a>

            <!-- User Activity -->
          <a href="/user-activity"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "activity" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.user_activity'}}
          </a>

          <!-- Separator -->
          <div class="border-t border-input -mx-1 my-1"></div>




          <!-- Log out item -->
          <a hx-post="/auth/logout"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors text-error hover:bg-error/10">

 {{{icon 'log-out' class='h-4 w-4 shrink-0' size='16'}}}

             {{t 'nav.logout'}}
          </a>


        </div>
      </div>
    </div>
  </div>
</nav>



