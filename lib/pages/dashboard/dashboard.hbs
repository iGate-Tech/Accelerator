<main id="dashboard-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
           <h1 class="font-heading text-3xl font-semibold text-foreground">
             {{t 'dashboard.overview.title'}}
           </h1>
           <p class="text-lg text-muted-foreground">
             {{t 'dashboard.overview.description'}}
           </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="btn btn-primary">

             {{{icon 'plus' class='' size='16'}}}

             {{t 'dashboard.overview.new_project'}}
          </button>
        </div>
       </div>

       <!-- Toast Examples -->
       <div class="grid w-full max-w-xl items-start gap-4">
         {{> toast type="default" icon="circle-check" title="Success! Your changes have been saved" description="This is an alert with icon, title and description."}}
         {{> toast type="default" icon="popcorn" title="This Alert has a title and an icon. No description."}}
         {{> toast type="destructive" icon="circle-alert" title="Unable to process your payment." description="Please verify your billing information and try again." listItems=(array "Check your card details" "Ensure sufficient funds" "Verify billing address"}}
       </div>

       <!-- Key Metrics Grid -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5 xl:grid-cols-5">
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
                <h3 class="text-sm font-medium text-muted-foreground">{{t 'dashboard.overview.total_ideas'}}</h3>
                <p class="text-2xl font-semibold text-foreground">{{stats.ideas.total}}</p>
             </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'folder-open' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

             <span class="text-success">+2</span>
             {{t 'dashboard.overview.since_last_month'}}
          </p>
        </div>
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
                <h3 class="text-sm font-medium text-muted-foreground">{{t 'dashboard.overview.completed_ideas'}}</h3>
                <p class="text-2xl font-semibold text-foreground">{{stats.ideas.completed}}</p>
             </div>
            <div>
              <div class="bg-secondary/20 rounded-lg">
                <div class="w-10 h-10 bg-secondary/20 rounded-lg relative">
                  <div
                    class="flex items-center justify-center w-9 h-9 bg-secondary rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'lightbulb' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

             <span class="text-success">+8</span>
             {{t 'dashboard.overview.since_last_month'}}
          </p>
        </div>
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
                <h3 class="text-sm font-medium text-muted-foreground">{{t 'dashboard.overview.credit_balance'}}</h3>
                <p class="text-2xl font-semibold text-foreground">{{stats.credits.currentBalance}}</p>
             </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'users' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

             <span class="text-success">+3</span>
             {{t 'dashboard.overview.since_last_month'}}
          </p>
        </div>
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
                <h3 class="text-sm font-medium text-muted-foreground">{{t 'dashboard.overview.completion_rate'}}</h3>
                <p class="text-2xl font-semibold text-foreground">{{stats.ideas.completionRate}}%</p>
             </div>
            <div>
              <div class="bg-success/20 rounded-lg">
                <div class="w-10 h-10 bg-success/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'dollar-sign' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

             <span class="text-success">+25%</span>
             {{t 'dashboard.overview.since_last_month'}}
          </p>
        </div>
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
                <h3 class="text-sm font-medium text-muted-foreground">{{t 'dashboard.overview.average_rating'}}</h3>
                <p class="text-2xl font-semibold text-foreground">{{stats.ideas.averageRating}}★</p>
             </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'trending-up' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
<p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

             <span class="text-success">+15%</span>
             {{t 'dashboard.overview.since_last_month'}}
          </p>
        </div>
      </div>

        <!-- Main Content Grid -->
         <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Recent Activity -->
          <div>
            <div class="bg-card rounded-lg border border-border p-6">
              <div class="flex items-center justify-between mb-4">
                 <h2 class="text-xl font-semibold text-foreground">{{t 'dashboard.overview.recent_activity'}}</h2>
                 <a href="/user-activity" class="btn btn-ghost text-sm">
                   {{t 'dashboard.overview.view_all'}}
                   {{{icon 'arrow-right' class='' size='14'}}}
                 </a>
              </div>
              <div class="space-y-4">
                {{#if stats.activity.length}}
                  {{#each stats.activity}}
                  <div class="flex items-start gap-3 p-3 rounded-lg bg-muted/30">
                    <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
                      {{#if (eq action_type "idea_created"}}
{{{icon 'lightbulb' class='w-4 h-4 text-primary'}}}
                      {{else if (eq action_type "vote_cast"}}
{{{icon 'star' class='w-4 h-4 text-yellow-500'}}}
                      {{else if (eq action_type "model_completed"}}
{{{icon 'check-circle' class='w-4 h-4 text-green-500'}}}
                      {{else}}
{{{icon 'book-open' class='w-4 h-4 text-blue-500'}}}
                      {{/if}}
                    </div>
                    <div class="flex-1">
                      <p class="text-sm text-foreground">
                         {{#if (eq action_type "idea_created"}}
                           {{t 'dashboard.overview.activity_created_idea'}}
                         {{else if (eq action_type "vote_cast"}}
                           {{t 'dashboard.overview.activity_cast_vote'}}
                         {{else if (eq action_type "model_completed"}}
                           {{t 'dashboard.overview.activity_completed_model'}}
                         {{else if (eq action_type "model_section_updated"}}
                           {{t 'dashboard.overview.activity_updated_section'}}
                         {{else if (eq action_type "package_selected"}}
                           {{t 'dashboard.overview.activity_selected_package'}}
                         {{else if (eq action_type "profile_completed"}}
                           {{t 'dashboard.overview.activity_completed_profile'}}
                         {{else}}
                           {{action_type}}
                         {{/if}}
                      </p>
                      <p class="text-xs text-muted-foreground">{{formatDate created_at}}</p>
                    </div>
                  </div>
                  {{/each}}
                {{else}}
                  <div class="text-center py-8">
                    <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
{{{icon 'activity' class='text-muted-foreground' size='24'}}}
                    </div>
                     <h3 class="text-lg font-medium text-foreground mb-2">{{t 'dashboard.overview.no_activity'}}</h3>
                     <p class="text-muted-foreground mb-4">{{t 'dashboard.overview.start_creating'}}</p>
                     <a href="/new-idea" class="btn btn-primary">{{t 'dashboard.overview.create_first_idea'}}</a>
                  </div>
                {{/if}}
              </div>
            </div>
          </div>



          <!-- Credit Balance and Additional Sections -->
          <div class="space-y-6">
            <!-- Credit Balance -->
            <div class="bg-card rounded-lg border border-border p-6">
               <div class="flex items-center justify-between mb-4">
                 <h2 class="text-xl font-semibold text-foreground">{{t 'dashboard.overview.credit_balance'}}</h2>
                 <a href="/buy-credits" class="btn btn-ghost text-sm">
                   {{t 'dashboard.overview.buy_credits'}}
                   {{{icon 'arrow-right' class='' size='14'}}}
                 </a>
               </div>
              <div class="text-center">
                <div class="text-3xl font-bold text-primary mb-2">{{stats.credits.currentBalance}}</div>
                 <p class="text-sm text-muted-foreground mb-4">{{t 'dashboard.overview.available_credits'}}</p>
                <div class="grid grid-cols-2 gap-4 text-sm">
                  <div>
                     <span class="text-muted-foreground">{{t 'dashboard.overview.earned_30d'}}</span>
                     <div class="font-semibold text-green-600">+{{stats.credits.earned30d}}</div>
                   </div>
                   <div>
                     <span class="text-muted-foreground">{{t 'dashboard.overview.spent_30d'}}</span>
                     <div class="font-semibold text-red-600">-{{stats.credits.spent30d}}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Model Progress -->
          <div class="bg-card rounded-lg border border-border p-6">
             <h2 class="text-xl font-semibold text-foreground mb-4">{{t 'dashboard.overview.model_progress'}}</h2>
            <div class="space-y-4">
              {{#each stats.models}}
                <div class="flex items-center justify-between">
                  <span class="text-sm font-medium text-foreground capitalize">{{@key}} Model</span>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">{{completed}}/{{total}}</span>
                    <div class="w-16 h-2 bg-muted rounded-full overflow-hidden">
                      <div class="h-full bg-primary rounded-full" style="width: {{#if (gt total 0)}}{{math (divide completed total) 100}}%{{else}}0%{{/if}}"></div>
                    </div>
                  </div>
                </div>
              {{/each}}
              {{#if (eq (len stats.models) 0)}}
                <p class="text-sm text-muted-foreground text-center py-4">No model progress yet</p>
              {{/if}}
            </div>

          </div>
            <!-- Quick Stats -->
            <div class="bg-card rounded-lg border border-border p-6">
               <h2 class="text-xl font-semibold text-foreground mb-4">{{t 'dashboard.overview.quick_stats'}}</h2>
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                   <span class="text-sm text-muted-foreground">{{t 'dashboard.overview.ideas_created'}}</span>
                   <span class="text-sm font-medium text-foreground">{{stats.ideas.total}}</span>
                 </div>
                 <div class="flex items-center justify-between">
                   <span class="text-sm text-muted-foreground">{{t 'dashboard.overview.votes_given'}}</span>
                   <span class="text-sm font-medium text-foreground">{{stats.votes.totalGiven}}</span>
                 </div>
                 <div class="flex items-center justify-between">
                   <span class="text-sm text-muted-foreground">{{t 'dashboard.overview.completion_rate'}}</span>
                   <span class="text-sm font-medium text-foreground">{{stats.ideas.completionRate}}%</span>
                 </div>
                 <div class="flex items-center justify-between">
                   <span class="text-sm text-muted-foreground">{{t 'dashboard.overview.avg_rating'}}</span>
                   <span class="text-sm font-medium text-foreground">{{stats.ideas.averageRating}}★</span>
                </div>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="bg-card rounded-lg border border-border p-6">
               <h2 class="text-xl font-semibold text-foreground mb-4">{{t 'dashboard.overview.quick_actions'}}</h2>
              <div class="grid grid-cols-1 gap-3">
                <a href="/new-idea" class="btn btn-outline w-full justify-start">
                   {{{icon 'plus' class='' size='14'}}}
                   {{t 'dashboard.overview.create_new_idea'}}
                 </a>
                 <a href="/explore-ideas" class="btn btn-outline w-full justify-start">
                   {{{icon 'search' class='' size='14'}}}
                   {{t 'dashboard.overview.explore_ideas'}}
                 </a>

                {{#if (eq user.package_type 'enterprise')}}
                <a href="/portfolios" class="btn btn-outline w-full justify-start">
                   {{{icon 'archive' class='' size='14'}}}
                   {{t 'dashboard.overview.manage_portfolios'}}
                 </a>
                 <a href="/settings" class="btn btn-outline w-full justify-start">
                   {{{icon 'settings' class='' size='14'}}}
                   {{t 'dashboard.overview.settings'}}
                </a>
              </div>
            </div>
        </div>
      </div>

       <!-- Enterprise/Corporate Specific Sections -->
     </div>
   </div>
 </main>

