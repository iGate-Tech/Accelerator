 <div class="min-h-screen bg-gradient-to-br from-base-100 via-success/10 to-info/10">
  <div class="relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 20% 80%, color-mix(in oklab, hsl(var(--color-emerald-500)), transparent 95%) 2px, transparent 2px), radial-gradient(circle at 80% 20%, color-mix(in oklab, hsl(var(--color-blue-500)), transparent 95%) 2px, transparent 2px); background-size: 40px 40px;"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Header -->
       <div class="text-center mb-8 sm:mb-12">
          <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-gradient-to-br from-success to-info rounded-2xl mb-6 sm:mb-8 shadow-lg">
 {{{icon 'user' class="w-8 h-8 sm:w-10 sm:h-10 text-white"}}}
         </div>
           <h1 class="text-3xl sm:text-5xl font-bold text-foreground mb-4 sm:mb-6">
            {{t 'profile.title'}}
          </h1>
           <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed px-4">
            {{t 'profile.subtitle'}}
          </p>
       </div>

        <!-- Progress Indicator -->
        <div class="flex justify-center mb-6 sm:mb-8 lg:mb-12">
          <div class="flex items-center space-x-1 sm:space-x-2 lg:space-x-4 overflow-x-auto px-4 sm:px-0">
            <div class="flex items-center flex-shrink-0">
               <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-success rounded-full flex items-center justify-center text-success-content font-bold text-xs sm:text-sm lg:text-base">1</div>
               <span class="ml-1 sm:ml-2 lg:ml-3 text-success font-semibold text-xs sm:text-sm lg:text-base whitespace-nowrap">Account</span>
            </div>
             <div class="w-4 sm:w-8 lg:w-16 h-0.5 bg-success/50 flex-shrink-0"></div>
             <div class="flex items-center flex-shrink-0">
               <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-success rounded-full flex items-center justify-center text-success-content font-bold text-xs sm:text-sm lg:text-base">2</div>
               <span class="ml-1 sm:ml-2 lg:ml-3 text-success font-semibold text-xs sm:text-sm lg:text-base whitespace-nowrap">Profile</span>
             </div>
             <div class="w-4 sm:w-8 lg:w-16 h-0.5 bg-muted flex-shrink-0"></div>
             <div class="flex items-center flex-shrink-0">
               <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-muted rounded-full flex items-center justify-center text-muted-foreground font-bold text-xs sm:text-sm lg:text-base">3</div>
               <span class="ml-1 sm:ml-2 lg:ml-3 text-muted-foreground text-xs sm:text-sm lg:text-base whitespace-nowrap">Complete</span>
             </div>
          </div>
        </div>

       <!-- Form -->
        <div class="bg-card rounded-3xl shadow-2xl p-6 sm:p-8 md:p-12">
         <form method="post" action="/onboarding/profile" class="space-y-6 sm:space-y-8">
          <input type="hidden" name="_csrf" value="{{csrf}}" />

             <!-- Display Name -->
             <div class="space-y-4 sm:space-y-6">
                 <h3 class="text-lg sm:text-xl lg:text-2xl font-semibold text-foreground">{{t 'profile.personal_info'}}</h3>

              <div class="pl-4 sm:pl-6 lg:pl-8">
                 <label for="name" class="block text-sm sm:text-base font-medium text-foreground mb-2">
                   {{t 'profile.display_name'}} <span class="text-error">*</span>
                 </label>
                 <input type="text" id="name" name="name" value="{{profile.name}}"
                   class="w-full px-3 sm:px-4 py-3 sm:py-4 border border-input rounded-lg sm:rounded-xl focus:ring-2 focus:ring-success focus:border-success transition-all duration-200 bg-background focus:bg-background text-sm sm:text-base"
                   placeholder="How you'd like to be known on Accelerator" required />
                <p class="text-xs sm:text-sm text-muted-foreground mt-1">This will be visible to other community members</p>
             </div>
           </div>

             <!-- Role -->
             <div class="space-y-4 sm:space-y-6">
                 <h3 class="text-lg sm:text-xl lg:text-2xl font-semibold text-foreground">{{t 'profile.professional_background'}}</h3>

              <div class="pl-4 sm:pl-6 lg:pl-8">
                  <label for="role" class="block text-sm sm:text-base font-medium text-foreground mb-2">
                    {{t 'profile.your_role'}}
                  </label>
                 <select id="role" name="role"
                   class="w-full px-3 sm:px-4 py-3 sm:py-4 border border-input rounded-lg sm:rounded-xl focus:ring-2 focus:ring-primary focus:border-primary transition-all duration-200 bg-background focus:bg-background text-sm sm:text-base">
                 <option value="">Select your role (optional)</option>
                 <option value="founder" {{#if (eq profile.role "founder") }}selected{{/if}}>🏢 Founder/Entrepreneur</option>
                 <option value="student" {{#if (eq profile.role "student") }}selected{{/if}}>🎓 Student</option>
                 <option value="developer" {{#if (eq profile.role "developer") }}selected{{/if}}>💻 Developer</option>
                 <option value="designer" {{#if (eq profile.role "designer") }}selected{{/if}}>🎨 Designer</option>
                 <option value="marketer" {{#if (eq profile.role "marketer") }}selected{{/if}}>📈 Marketer</option>
                 <option value="investor" {{#if (eq profile.role "investor") }}selected{{/if}}>💰 Investor</option>
                 <option value="consultant" {{#if (eq profile.role "consultant") }}selected{{/if}}>🎯 Consultant</option>
                 <option value="other" {{#if (eq profile.role "other") }}selected{{/if}}>🤔 Other</option>
               </select>
             </div>
           </div>

             <!-- Bio -->
             <div class="space-y-4 sm:space-y-6">
                 <h3 class="text-lg sm:text-xl lg:text-2xl font-semibold text-foreground">{{t 'profile.about_you'}}</h3>

              <div class="pl-4 sm:pl-6 lg:pl-8">
                  <label for="bio" class="block text-sm sm:text-base font-medium text-foreground mb-2">
                    {{t 'profile.bio'}}
                  </label>
                 <textarea id="bio" name="bio" rows="4"
                   class="w-full px-3 sm:px-4 py-3 sm:py-4 border border-input rounded-lg sm:rounded-xl focus:ring-2 focus:ring-secondary focus:border-secondary transition-all duration-200 bg-background focus:bg-background resize-none text-sm sm:text-base"
                  placeholder="Tell us about your background, interests, and what you're passionate about...">{{#if profile.preferences}}{{profile.preferences.bio}}{{/if}}</textarea>
                <p class="text-xs sm:text-sm text-muted-foreground mt-1">Share your story to connect with like-minded entrepreneurs</p>
             </div>
           </div>

            <!-- Location & Website -->
             <div class="space-y-4 sm:space-y-6">
                 <h3 class="text-lg sm:text-xl lg:text-2xl font-semibold text-foreground">{{t 'profile.contact_location'}}</h3>

              <div class="pl-4 sm:pl-6 lg:pl-8 grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
               <div>
                   <label for="location" class="block text-sm sm:text-base font-medium text-foreground mb-2">
                     {{t 'profile.location'}}
                   </label>
                   <input type="text" id="location" name="location" value="{{#if profile.preferences}}{{profile.preferences.location}}{{/if}}"
                     class="w-full px-3 sm:px-4 py-3 sm:py-4 border border-input rounded-lg sm:rounded-xl focus:ring-2 focus:ring-warning focus:border-warning transition-all duration-200 bg-background focus:bg-background text-sm sm:text-base"
                     placeholder="City, Country" />
               </div>

               <div>
                   <label for="website" class="block text-sm sm:text-base font-medium text-foreground mb-2">
                     {{t 'profile.website'}}
                   </label>
                   <input type="url" id="website" name="website" value="{{#if profile.preferences}}{{profile.preferences.website}}{{/if}}"
                     class="w-full px-3 sm:px-4 py-3 sm:py-4 border border-input rounded-lg sm:rounded-xl focus:ring-2 focus:ring-warning focus:border-warning transition-all duration-200 bg-background focus:bg-background text-sm sm:text-base"
                     placeholder="https://yourwebsite.com" />
               </div>
             </div>
           </div>

            <!-- Info Box -->
             <div class="bg-gradient-to-r from-success/10 to-info/10 border border-success/20 rounded-lg sm:rounded-2xl p-4 sm:p-6">
               <div class="flex items-start">
                 <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-success/10 rounded-lg sm:rounded-xl flex items-center justify-center mr-2 sm:mr-3 lg:mr-4 flex-shrink-0">
                   {{{icon 'info' class="w-3 h-3 sm:w-4 sm:h-4 lg:w-5 lg:h-5 text-success"}}}
                 </div>
                 <div>
                   <h4 class="text-sm sm:text-base lg:text-lg font-semibold text-foreground mb-2">What's Next?</h4>
                   <p class="text-xs sm:text-sm lg:text-base text-muted-foreground leading-relaxed">
                    After completing your profile, you'll unlock the full potential of Accelerator. Start creating ideas,
                    connect with the community, and build your startup journey. You can always update these details later in your settings.
                  </p>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-4 sm:pt-6 lg:pt-8">
               <button type="submit"
                 class="w-full bg-gradient-to-r from-success to-info hover:from-success/90 hover:to-info/90 text-white font-bold py-3 sm:py-4 lg:py-5 px-4 sm:px-6 lg:px-8 rounded-xl sm:rounded-2xl transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98] shadow-lg hover:shadow-xl flex items-center justify-center space-x-2 sm:space-x-3 text-sm sm:text-base lg:text-lg">
                 <span>{{t 'profile.complete_profile_setup'}}</span>
                 {{{icon 'trending-up' class="w-4 h-4 sm:w-5 sm:h-5"}}}
              </button>
            </div>
        </form>
      </div>
    </div>
  </div>
</div>