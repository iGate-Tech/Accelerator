<div class="min-h-screen bg-gradient-to-br from-green-50 to-teal-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-4 mb-6">
        <div class="w-16 h-16 bg-green-600 rounded-2xl flex items-center justify-center">
          {{{ icon 'calculator' class='w-8 h-8 text-white' }}}
        </div>
        <div>
          <h1 class="text-4xl font-bold text-gray-900">Valuation Report Generator</h1>
          <p class="text-xl text-gray-600 mt-2">Professional startup valuation analysis with AI</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-8 max-w-2xl mx-auto">
        <div class="text-center mb-6">
          <h2 class="text-2xl font-semibold text-gray-900 mb-2">Generate Your Valuation Report</h2>
          <p class="text-gray-600">Get professional startup valuation with multiple methodologies</p>
        </div>

        {{#if userIdeas.length}}
        <form method="post" action="/reports/valuation" class="space-y-6">
          <input type="hidden" name="_csrf" value="{{csrf}}" />

          <div>
            <label for="ideaId" class="block text-sm font-medium text-gray-700 mb-2">
              Select Idea *
            </label>
            <select id="ideaId" name="ideaId" required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all">
              <option value="">Choose an idea to generate valuation for...</option>
              {{#each userIdeas}}
              <option value="{{id}}">{{title}} {{#if completion_percentage}}({{completion_percentage}}% complete){{/if}}</option>
              {{/each}}
            </select>
          </div>

          <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-start">
              <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-0.5">
                {{{ icon 'dollar-sign' class='w-4 h-4 text-green-600' }}}
              </div>
              <div>
                <h4 class="text-sm font-semibold text-green-900 mb-1">Valuation Methodologies</h4>
                <ul class="text-sm text-green-800 space-y-1">
                  <li>• Comparable company analysis</li>
                  <li>• Discounted cash flow (DCF)</li>
                  <li>• Market size & opportunity assessment</li>
                  <li>• Risk-adjusted valuation ranges</li>
                  <li>• Investment readiness evaluation</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <div class="flex items-center">
              <div class="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center mr-3">
                {{{ icon 'zap' class='w-4 h-4 text-yellow-600' }}}
              </div>
              <div>
                <h4 class="text-sm font-semibold text-yellow-900">Cost: 50 Credits</h4>
                <p class="text-sm text-yellow-800">Your current balance: <span class="font-semibold">{{userCredits}} credits</span></p>
              </div>
            </div>
          </div>

          <div class="flex gap-4">
            <button type="submit"
              class="flex-1 bg-green-600 hover:bg-green-700 text-white font-semibold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
              {{#if (lt userCredits 50)}}disabled{{/if}}>
              <span>Generate Valuation Report</span>
              {{#if (gte userCredits 50)}}
                {{{ icon 'calculator' class='w-5 h-5' }}}
              {{/if}}
            </button>
          </div>
        </form>
        {{else}}
        <div class="text-center py-8">
          <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            {{{ icon 'lightbulb' class='w-8 h-8 text-gray-400' }}}
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No Ideas Available</h3>
          <p class="text-gray-600 mb-6">Create your first idea to generate valuation reports</p>
          <a href="/new-idea" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors inline-flex items-center space-x-2">
            {{{ icon 'plus' class='w-4 h-4' }}}
            <span>Create Your First Idea</span>
          </a>
        </div>
        {{/if}}
      </div>
    </div>

    <!-- Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'trending-up' class='w-6 h-6 text-blue-600' }}}
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Multiple Methods</h3>
        <p class="text-gray-600 text-sm">Comprehensive analysis using various valuation approaches</p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'shield' class='w-6 h-6 text-purple-600' }}}
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Investment Ready</h3>
        <p class="text-gray-600 text-sm">Professional reports suitable for investors and stakeholders</p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'bar-chart-3' class='w-6 h-6 text-orange-600' }}}
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Data-Driven</h3>
        <p class="text-gray-600 text-sm">Evidence-based valuations with clear assumptions and methodology</p>
      </div>
    </div>

  </div>
</div>