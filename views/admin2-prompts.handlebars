{{!< main}}
    <div class="flex flex-col gap-8 mx-auto my-10">
        <ul class="steps w-full text-xs">
          {{#each uniqueModels}}
            <li class="step {{#if @first}}step-primary{{/if}}" onclick="showModel('{{this}}')">{{this}}</li>
          {{/each}}
        </ul>
        <ul class="steps w-full text-xs" id="section-steps">
          <!-- Populated by JS -->
        </ul>
        <div id="back-button" class="flex mx-auto   gap-8 text-xs">
            <a href="#" class="inline-flex  items-center gap-2 text-base-content/60 hover:text-base-content transition-colors" title="Back">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                <span>Back</span>
            </a>
            <div class="flex gap-4">
                <a href="/admin2/export/json?admin=1" class="inline-flex items-center gap-2 text-base-content/60 hover:text-base-content transition-colors" title="Export JSON" download="prompts.json">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7,10 12,15 17,10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                    <span>Export JSON</span>
                </a>
                <a href="/admin2/export/csv?admin=1" class="inline-flex items-center gap-2 text-base-content/60 hover:text-base-content transition-colors" title="Export CSV" download="prompts.csv">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7,10 12,15 17,10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                    <span>Export CSV</span>
                </a>
                <a href="/" class="inline-flex items-center gap-2 text-base-content/60 hover:text-base-content transition-colors" title="Back to Ideas">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9,22 9,12 15,12 15,22"></polyline></svg>
                    <span>Back to Ideas</span>
                </a>
            </div>
           
        </div>
    </div>


    <form action="/admin2/prompts?admin=1" method="post" class="space-y-8">
        {{#each grouped}}
             <div data-model="{{@key}}" class="model-content " style="display: {{#if @first}}block{{else}}none{{/if}};">
                 <h2 class="text-3xl font-bold text-base-content mb-6">{{@key}}</h2>
                 {{#each this}}
                     <div class="mb-8 last:mb-0 section-item" data-section="{{@key}}">
                          <h3 class="text-2xl font-semibold text-base-content mb-4 border-b border-base-300 pb-2">{{@key}}</h3>
                           <ul class="relative w-full text-xs">
                              {{#each this}}
                                  <li class="flex items-start gap-4 mb-6 last:mb-0">
                                         <div id="indicator-{{id}}" class="flex flex-col items-center flex-shrink-0">
                                           <div class="w-8 h-8 rounded-full bg-base-300 text-base-content flex items-center justify-center text-sm font-bold">{{localIndex}}</div>
                                           {{#unless @last}}<div class="w-0.5 bg-base-300 segment" style="height: 3rem; margin-top: 0.5rem;"></div>{{/unless}}
                                         </div>
                                         <div class="flex-1">
                                         <label class="block text-lg font-medium text-base-content mb-2 cursor-pointer" onclick="toggleCard('{{id}}')">{{globalIndex}}. {{localIndex}}. {{question}}</label>
                                             <div id="card-{{id}}" class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 border border-base-200 hover:border-primary/30 rounded-lg overflow-hidden relative p-4 hidden">
                                               <!-- Description wrapper -->
                                               <div class=" pl-4 pr-2 relative">
                                                   <label for="prompt-{{id}}-textarea" class="sr-only">{{globalIndex}}. {{localIndex}}. {{question}}</label>
                                                   <div id="prompt-{{id}}-display" class="w-full rounded-md border border-base-300 bg-base-100 px-3 py-2 text-base text-base-content min-h-[2.5rem] cursor-pointer overflow-visible markdown-content" style="display: none;"></div>
                                                   <textarea id="prompt-{{id}}-textarea" name="prompt-{{id}}" placeholder="Enter prompt..." aria-label="Enter prompt..." class="flex w-full rounded-md border-0 bg-transparent p-0 pt-[1px] text-base text-base-content placeholder:text-base-content/60 focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0" required="" rows="3" style="resize: none; overflow: hidden;">{{prompt}}</textarea>
                                               </div>
                                               <!-- toolbar -->
                                               <div class="px-3 flex justify-between items-center">
                                                   <div class="flex gap-1">
                                                       {{#unless @first}}
                                                       <form action="/admin2/move-question-up?admin=1" method="post" class="inline">
                                                           <input type="hidden" name="id" value="{{id}}">
                                                           <button type="submit" class="btn btn-ghost btn-xs btn-square" title="Move Up">
                                                               <i data-lucide="chevron-up" class="w-4 h-4"></i>
                                                           </button>
                                                       </form>
                                                       {{/unless}}
                                                       {{#unless @last}}
                                                       <form action="/admin2/move-question-down?admin=1" method="post" class="inline">
                                                           <input type="hidden" name="id" value="{{id}}">
                                                           <button type="submit" class="btn btn-ghost btn-xs btn-square" title="Move Down">
                                                               <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                                           </button>
                                                       </form>
                                                       {{/unless}}
                                                        <button hx-post="/admin2/delete-question?admin=1" hx-confirm="Are you sure you want to delete this question?" hx-vals='{"id": "{{id}}"}' class="btn btn-ghost btn-xs btn-square" title="Remove">
                                                            <i data-lucide="x" class="w-4 h-4"></i>
                                                        </button>
                                                   </div>
                                                   <div class="flex gap-1">
                                                       <!-- Improve with AI -->
                                                       <button type="button" class="btn btn-ghost btn-xs btn-square" title="Improve with AI">
                                                           <i data-lucide="sparkles" class="w-4 h-4"></i>
                                                       </button>
                                                       <!-- Reset form -->
                                                       <button type="button" class="btn btn-ghost btn-xs btn-square" title="Reset">
                                                           <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                                                       </button>
                                                       <!-- Save button -->
                                                       <button type="button" class="btn btn-ghost btn-xs btn-square" title="Save">
                                                           <i data-lucide="save" class="w-4 h-4"></i>
                                                       </button>
                                                    </div>
                                                </div>
                                           </div>
                                         </div>
                                 </li>
                              {{/each}}

                           </ul>
                         <div class="mt-6 p-4 bg-base-200 rounded-lg">
                             <h4 class="text-lg font-semibold mb-2">Add New Question to "{{@key}}" in "{{@../key}}"</h4>
                             <form action="/admin2/add-question?admin=1" method="post" class="space-y-3">
                                 <input type="hidden" name="model" value="{{@../key}}">
                                 <input type="hidden" name="section" value="{{@key}}">
                                 <input type="text" name="question" class="input input-bordered w-full" placeholder="Enter new question..." required>
                                 <textarea name="prompt" class="textarea textarea-bordered w-full h-24" placeholder="Enter prompt..." required></textarea>
                                 <button type="submit" class="btn btn-primary">Add Question</button>
                             </form>
                         </div>
                    </div>
                {{/each}}
            </div>
        {{/each}}

         <div class="flex justify-end">
             <button type="submit" class="btn btn-primary btn-sm">Save All Changes</button>
         </div>
     </form>

     <script>
         const modelSections = {
           {{#each grouped}}
             "{{@key}}": [{{#each this}}"{{@key}}",{{/each}}],
           {{/each}}
         };
         const uniqueModels = [{{#each uniqueModels}}"{{this}}",{{/each}}];
         const progressClasses = ['step-secondary', 'step-accent', 'step-neutral', 'step-info', 'step-success', 'step-warning', 'step-error'];
     </script>
     <script>
         function showModel(model) {
             // Hide all models
             document.querySelectorAll('.model-content').forEach(el => el.style.display = 'none');
             // Show selected model
             document.querySelector(`[data-model="${model}"]`).style.display = 'block';
             // Update model steps progress
             const currentIndex = uniqueModels.indexOf(model);
             document.querySelectorAll('.steps')[0].querySelectorAll('.step').forEach((li, i) => {
                 li.className = 'step';
                 if (i <= currentIndex) li.classList.add('step-primary');
             });
             // Update section steps for this model
             const sections = modelSections[model] || [];
             const ul = document.getElementById('section-steps');
             ul.innerHTML = sections.map((s, i) => `<li class="step ${i === 0 ? 'step-primary' : ''}" onclick="showSection('${s}')">${s}</li>`).join('');
             // Show all sections in the visible model
             document.querySelectorAll('.section-item').forEach(el => el.style.display = 'block');
         }
         function showSection(section) {
             // Filter sections to selected
             const allSections = document.querySelectorAll('.section-item');
             allSections.forEach(el => {
                 if (el.getAttribute('data-section') === section) {
                     el.style.display = 'block';
                 } else {
                     el.style.display = 'none';
                 }
             });
             // Update section steps progress
             const sectionLis = document.querySelectorAll('.steps')[1].querySelectorAll('.step');
             const sections = Array.from(sectionLis).map(li => li.innerText);
             const currentIndex = sections.indexOf(section);
             sectionLis.forEach((li, i) => {
                 li.className = 'step';
                 if (i <= currentIndex) li.classList.add('step-primary');
             });
         }
          // Initially show first model
          showModel(uniqueModels[0]);
          document.querySelectorAll('.steps')[0].querySelector('.step').classList.add('step-primary');

          function toggleCard(id) {
            const allCards = document.querySelectorAll('[id^="card-"]');
            const allIndicators = document.querySelectorAll('[id^="indicator-"]');
            allCards.forEach(card => {
              if (card.id !== `card-${id}`) {
                card.classList.add('hidden');
                const indId = card.id.replace('card-', 'indicator-');
                const ind = document.getElementById(indId);
                const circle = ind.querySelector('.rounded-full');
                circle.classList.remove('bg-primary', 'text-white');
                circle.classList.add('bg-base-300', 'text-base-content');
                const segment = ind.querySelector('.segment');
                if (segment) {
                  segment.classList.remove('bg-primary');
                  segment.classList.add('bg-base-300');
                }
              }
            });
            const card = document.getElementById(`card-${id}`);
            const indicator = document.getElementById(`indicator-${id}`);
            const circle = indicator.querySelector('.rounded-full');
            const ul = indicator.closest('ul');
            const indicators = Array.from(ul.querySelectorAll('[id^="indicator-"]'));
            if (card.classList.contains('hidden')) {
              card.classList.remove('hidden');
              const currentIndex = indicators.findIndex(ind => ind.id === `indicator-${id}`);
              indicators.forEach((ind, idx) => {
                const seg = ind.querySelector('.segment');
                const circ = ind.querySelector('.rounded-full');
                if (idx <= currentIndex) {
                  circ.classList.remove('bg-base-300', 'text-base-content');
                  circ.classList.add('bg-primary', 'text-white');
                  if (seg) {
                    seg.classList.remove('bg-base-300');
                    seg.classList.add('bg-primary');
                  }
                } else {
                  circ.classList.remove('bg-primary', 'text-white');
                  circ.classList.add('bg-base-300', 'text-base-content');
                  if (seg) {
                    seg.classList.remove('bg-primary');
                    seg.classList.add('bg-base-300');
                  }
                }
              });
            } else {
              card.classList.add('hidden');
              indicators.forEach((ind) => {
                const seg = ind.querySelector('.segment');
                const circ = ind.querySelector('.rounded-full');
                circ.classList.remove('bg-primary', 'text-white');
                circ.classList.add('bg-base-300', 'text-base-content');
                if (seg) {
                  seg.classList.remove('bg-primary');
                  seg.classList.add('bg-base-300');
                }
              });
            }
          }
     </script>