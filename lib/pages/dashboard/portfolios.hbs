<main id="portfolios-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <!-- Header Section -->
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            {{t 'portfolios.portfolios.title'}}
          </h1>
          <p class="text-lg text-muted-foreground">
            {{t 'portfolios.portfolios.description'}}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="btn btn-primary" onclick="openCreatePortfolioModal()">
            {{{icon 'plus' class='w-4 h-4 mr-2' size='16'}}}
            {{t 'portfolios.portfolios.create_portfolio'}}
          </button>
        </div>
      </div>

      <!-- Portfolio Stats Overview -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Filters and Search -->
        <div class="col-span-full mb-4">
          <div class="flex items-center gap-3">
            <div class="flex-1 max-w-md relative">
              <div class="relative">
                {{{icon 'search' class='absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground' size='16'}}}
                <input type="text" id="portfolio-search" placeholder="{{t 'portfolios.portfolios.search_placeholder'}}" class="input w-full pl-10 pr-10" oninput="filterPortfolios()">
                <button type="button" id="portfolio-search-clear" class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground hover:text-foreground opacity-0 transition-opacity duration-200" onclick="clearPortfolioSearch()" style="display: none;">
                  {{{icon 'x' class='w-4 h-4' size='16'}}}
                </button>
              </div>
            </div>
            <div class="flex items-center gap-2">
              {{{icon 'filter' class='w-4 h-4 text-muted-foreground' size='16'}}}
              <select id="portfolio-sort" class="select w-auto min-w-0" onchange="sortPortfolios()">
                <option value="newest">{{t 'portfolios.portfolios.sort_newest'}}</option>
                <option value="oldest">{{t 'portfolios.portfolios.sort_oldest'}}</option>
                <option value="name">{{t 'portfolios.portfolios.sort_name'}}</option>
                <option value="ideas">{{t 'portfolios.portfolios.sort_ideas'}}</option>
                <option value="completion">{{t 'portfolios.portfolios.sort_completion'}}</option>
              </select>
            </div>
          </div>
        </div>
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">{{t 'portfolios.portfolios.total_portfolios'}}</h3>
              <p class="text-2xl font-semibold text-foreground">{{stats.portfolios.total}}</p>
            </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">
{{{icon 'archive' class='w-4 h-4 text-primary-foreground' size='16'}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">{{t 'portfolios.portfolios.active_ideas'}}</h3>
              <p class="text-2xl font-semibold text-foreground">{{stats.portfolios.totalIdeas}}</p>
            </div>
            <div>
              <div class="bg-secondary/20 rounded-lg">
                <div class="w-10 h-10 bg-secondary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-secondary rounded-lg absolute top-0.5 left-0.5">
                    {{{icon 'lightbulb' class='w-4 h-4 text-secondary-foreground' size='16'}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">{{t 'portfolios.portfolios.avg_completion'}}</h3>
              <p class="text-2xl font-semibold text-foreground">{{stats.portfolios.avgCompletion}}%</p>
            </div>
            <div>
              <div class="bg-success/20 rounded-lg">
                <div class="w-10 h-10 bg-success/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">
{{{icon 'trending-up' class='w-4 h-4 text-success-foreground' size='16'}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">{{t 'portfolios.portfolios.team_members'}}</h3>
              <p class="text-2xl font-semibold text-foreground">{{stats.portfolios.totalTeamMembers}}</p>
            </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">
                    {{{icon 'users' class='w-4 h-4 text-primary-foreground' size='16'}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Portfolios Grid -->
      <div id="portfolios-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#if portfolios}}
          {{#each portfolios}}
          <div class="bg-card rounded-lg border border-border p-6 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-foreground mb-1">{{name}}</h3>
                 <p class="text-sm text-muted-foreground line-clamp-2 w-full break-words">{{description}}</p>
              </div>
               {{#if isOwner}}
               <div class="flex items-center gap-2 ml-4">
                 <button class="btn btn-ghost btn-sm" onclick="editPortfolio('{{id}}')" title="Edit Portfolio">
{{{icon 'edit' class='w-4 h-4' size='14'}}}
                 </button>
                 <button class="btn btn-ghost btn-sm text-destructive hover:text-destructive" onclick="deletePortfolio('{{id}}')" title="Delete Portfolio">
{{{icon 'trash' class='w-4 h-4' size='14'}}}
                 </button>
               </div>
               {{else}}
               <div class="ml-4 text-sm text-muted-foreground">
                 Member
               </div>
               {{/if}}
            </div>

            <!-- Portfolio Stats -->
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-primary">{{ideaCount}}</div>
                <div class="text-xs text-muted-foreground">Ideas</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-success">{{completionRate}}%</div>
                <div class="text-xs text-muted-foreground">Complete</div>
              </div>
            </div>

            <!-- Progress Bar -->
            <div class="mb-4">
              <div class="flex items-center justify-between text-sm mb-1">
                <span class="text-muted-foreground">Overall Progress</span>
                <span class="text-foreground font-medium">{{completionRate}}%</span>
              </div>
              <div class="w-full bg-muted rounded-full h-2">
                <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: {{completionRate}}%"></div>
              </div>
            </div>

            <!-- Team Members -->
            {{#if teamMembers}}
            <div class="mb-4">
              <div class="flex items-center gap-2 mb-2">
{{{icon 'users' class='w-4 h-4 text-muted-foreground' size='14'}}}
                <span class="text-sm text-muted-foreground">Team ({{teamMembers.length}})</span>
              </div>
              <div class="flex -space-x-2">
                {{#each teamMembers}}
                <div class="w-8 h-8 rounded-full bg-primary/10 border-2 border-background flex items-center justify-center" title="{{name}}">
                  {{#if avatar}}
                    <img src="{{avatar}}" alt="{{name}}" class="w-full h-full rounded-full object-cover">
                  {{else}}
                    <span class="text-xs font-medium text-primary">{{initials name}}</span>
                  {{/if}}
                </div>
                {{/each}}
              </div>
            </div>
            {{/if}}

              <!-- Action Buttons -->
              <div class="flex gap-2">
                  <a href="/portfolios/{{id}}" class="btn btn-outline btn-sm {{#if (or isOwner (eq memberRole "editor"))}}flex-1{{else}}w-full{{/if}}">
 {{{icon 'eye' class='w-4 h-4 mr-1' size='14'}}}
                   {{t 'portfolios.portfolios.view'}}
                 </a>
                  {{#if (or isOwner (eq memberRole "editor"))}}
                 <a href="/portfolios/{{id}}/ideas" class="btn btn-outline btn-sm flex-1">
 {{{icon 'plus' class='w-4 h-4 mr-1' size='14'}}}
                   {{t 'portfolios.portfolios.add_ideas'}}
                 </a>
                 {{/if}}
              </div>
          </div>
          {{/each}}
        {{else}}
          <!-- Empty State -->
          <div class="col-span-full">
            <div class="bg-card rounded-lg border border-border p-12 text-center">
              <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
{{{icon 'archive' class='text-muted-foreground' size='24'}}}
              </div>
               <h3 class="text-lg font-medium text-foreground mb-2">{{t 'portfolios.portfolios.no_portfolios'}}</h3>
               <p class="text-muted-foreground mb-6">{{t 'portfolios.portfolios.create_first'}}</p>
               <button class="btn btn-primary" onclick="openCreatePortfolioModal()">
 {{{icon 'plus' class='w-4 h-4 mr-2' size='16'}}}
                 {{t 'portfolios.portfolios.create_first_btn'}}
               </button>
            </div>
          </div>
        {{/if}}
      </div>

      <!-- Analytics Section -->
      {{#if portfolios}}
      <div class="bg-card rounded-lg border border-border p-6">
         <h2 class="text-xl font-semibold text-foreground mb-6">{{t 'portfolios.portfolios.portfolio_analytics'}}</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Completion Rates Chart -->
          <div>
             <h3 class="text-lg font-medium text-foreground mb-4">{{t 'portfolios.portfolios.completion_rates'}}</h3>
            <div class="space-y-3">
              {{#each portfolios}}
              <div class="flex items-center gap-3">
                <div class="flex-1">
                  <div class="flex items-center justify-between text-sm mb-1">
                    <span class="text-foreground font-medium">{{name}}</span>
                    <span class="text-muted-foreground">{{completionRate}}%</span>
                  </div>
                  <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: {{completionRate}}%"></div>
                  </div>
                </div>
              </div>
              {{/each}}
            </div>
          </div>

          <!-- Portfolio Distribution -->
          <div>
             <h3 class="text-lg font-medium text-foreground mb-4">{{t 'portfolios.portfolios.ideas_distribution'}}</h3>
            <div class="space-y-3">
              {{#each portfolios}}
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-primary"></div>
                  <span class="text-sm text-foreground">{{name}}</span>
                </div>
                <div class="flex items-center gap-2">
                   <span class="text-sm text-muted-foreground">{{ideaCount}} {{t 'portfolios.portfolios.ideas_text'}}</span>
                  <div class="w-16 bg-muted rounded-full h-2">
                    <div class="bg-primary h-2 rounded-full" style="width: {{#if (gt ../stats.portfolios.totalIdeas 0)}}{{math (divide ideaCount ../stats.portfolios.totalIdeas) 100}}%{{else}}0%{{/if}}"></div>
                  </div>
                </div>
              </div>
              {{/each}}
            </div>
          </div>
        </div>
      </div>
      {{/if}}

    </div>
  </div>
</main>

<!-- Create Portfolio Modal -->
<div id="create-portfolio-modal" class="fixed inset-0 bg-black/50 hidden z-50 flex items-center justify-center p-4" style="display: none;">
    <div class="bg-card rounded-lg border border-border p-6 w-full max-w-md">
      <div class="flex items-center justify-between mb-4">
         <h3 class="text-lg font-semibold text-foreground">{{t 'portfolios.portfolios.modal_create_title'}}</h3>
        <button class="btn btn-ghost btn-sm" onclick="closeCreatePortfolioModal()">
          {{{icon 'x' class='w-4 h-4' size='14'}}}
        </button>
      </div>

      <form id="create-portfolio-form" onsubmit="createPortfolio(event)">
        <div class="space-y-4">
          <div>
             <label for="portfolio-name" class="block text-sm font-medium text-foreground mb-1">{{t 'portfolios.portfolios.name_label'}}</label>
             <input type="text" id="portfolio-name" name="name" required class="input input-bordered w-full" placeholder="{{t 'portfolios.portfolios.name_placeholder'}}">
          </div>

          <div>
             <label for="portfolio-description" class="block text-sm font-medium text-foreground mb-1">{{t 'portfolios.portfolios.description_label'}}</label>
             <textarea id="portfolio-description" name="description" rows="3" class="textarea textarea-bordered w-full" placeholder="{{t 'portfolios.portfolios.desc_placeholder'}}"></textarea>
          </div>

          <div class="flex gap-3 pt-4">
             <button type="button" class="btn btn-outline flex-1" onclick="closeCreatePortfolioModal()">{{t 'portfolios.portfolios.cancel'}}</button>
              <button type="submit" class="btn btn-primary flex-1">{{t 'portfolios.portfolios.create_portfolio'}}</button>
           </div>
         </div>
       </form>
     </div>
 </div>

<!-- Edit Portfolio Modal -->
<div id="edit-portfolio-modal" class="fixed inset-0 bg-black/50 hidden z-50 flex items-center justify-center p-4" style="display: none;">
    <div class="bg-card rounded-lg border border-border p-6 w-full max-w-md">
      <div class="flex items-center justify-between mb-4">
         <h3 class="text-lg font-semibold text-foreground">{{t 'portfolios.portfolios.modal_edit_title'}}</h3>
        <button class="btn btn-ghost btn-sm" onclick="closeEditPortfolioModal()">
          {{{icon 'x' class='w-4 h-4' size='14'}}}
        </button>
      </div>

      <form id="edit-portfolio-form" onsubmit="updatePortfolio(event)">
        <div class="space-y-4">
          <div>
             <label for="edit-portfolio-name" class="block text-sm font-medium text-foreground mb-1">{{t 'portfolios.portfolios.name_label'}}</label>
             <input type="text" id="edit-portfolio-name" name="name" required class="input input-bordered w-full" placeholder="{{t 'portfolios.portfolios.name_placeholder'}}">
          </div>

          <div>
             <label for="edit-portfolio-description" class="block text-sm font-medium text-foreground mb-1">{{t 'portfolios.portfolios.description_label'}}</label>
             <textarea id="edit-portfolio-description" name="description" rows="3" class="textarea textarea-bordered w-full" placeholder="{{t 'portfolios.portfolios.desc_placeholder'}}"></textarea>
          </div>

          <div>
            <label for="edit-portfolio-color" class="block text-sm font-medium text-foreground mb-1">Color Theme</label>
            <input type="color" id="edit-portfolio-color" name="color" class="input input-bordered w-full h-12" value="#3b82f6">
          </div>

          <div class="flex gap-3 pt-4">
             <button type="button" class="btn btn-outline flex-1" onclick="closeEditPortfolioModal()">{{t 'portfolios.portfolios.cancel'}}</button>
              <button type="submit" class="btn btn-primary flex-1">{{t 'portfolios.portfolios.update_portfolio'}}</button>
           </div>
         </div>
       </form>
     </div>
 </div>

