<div class="flex h-[calc(100vh-4rem)]">
    {{> sidebar projects=projects}}
    <main class="flex flex-col justify-center items-center p-6 bg-background overflow-y-auto w-full">
        <div class="w-full max-w-6xl">
            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-foreground mb-2">{{t 'dashboard.portfolios.title'}}</h1>
                <p class="text-muted-foreground">Manage and organize your startup ideas into portfolios</p>
            </div>

            {{#if hasPortfolios}}
            <!-- Portfolios Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                {{#each portfolios}}
                <div class="bg-card rounded-lg shadow-sm border border-border p-6 hover:shadow-md transition-shadow">
                    <!-- Portfolio Header -->
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white font-semibold" style="background-color: {{this.color}}">
                                {{substr this.name 0 1}}
                            </div>
                            <div>
                                <h3 class="font-semibold text-foreground">{{this.name}}</h3>
                                <p class="text-sm text-muted-foreground">{{this.description}}</p>
                            </div>
                        </div>
                        <div class="flex space-x-2">
                            <a href="/portfolios/{{this.id}}" class="text-primary hover:text-primary/80 p-1">
                                {{{icon 'eye' class='w-4 h-4'}}}
                            </a>
                            <a href="/portfolios/{{this.id}}/ideas" class="text-primary hover:text-primary/80 p-1">
                                {{{icon 'plus' class='w-4 h-4'}}}
                            </a>
                        </div>
                    </div>

                    <!-- Portfolio Stats -->
                    <div class="grid grid-cols-3 gap-4 mb-4">
                        <div class="text-center">
                            <div class="text-2xl font-bold text-primary">{{this.stats.totalIdeas}}</div>
                            <div class="text-xs text-muted-foreground">{{t 'dashboard.portfolios.ideas'}}</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-green-600">{{this.stats.completedIdeas}}</div>
                            <div class="text-xs text-muted-foreground">{{t 'dashboard.portfolios.complete'}}</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-blue-600">{{this.stats.averageCompletion}}%</div>
                            <div class="text-xs text-muted-foreground">Avg Progress</div>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="w-full bg-muted rounded-full h-2 mb-4">
                        <div class="bg-primary h-2 rounded-full" style="width: {{this.stats.averageCompletion}}%"></div>
                    </div>

                    <!-- Last Updated -->
                    <div class="text-xs text-muted-foreground">
                        Updated {{formatDate this.updated_at}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <!-- Empty State -->
            <div class="text-center py-12">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-muted rounded-2xl mb-6">
                    {{{icon 'folder' class='w-8 h-8 text-muted-foreground'}}}
                </div>
                <h3 class="text-xl font-semibold text-foreground mb-2">No portfolios yet</h3>
                <p class="text-muted-foreground mb-6">Create your first portfolio to start organizing your startup ideas</p>
                <button type="button" class="btn btn-primary" onclick="showCreatePortfolioModal()">
                    {{{icon 'plus' class='w-4 h-4 mr-2'}}}
                    Create Portfolio
                </button>
            </div>
            {{/if}}

            <!-- Create Portfolio Button (if has portfolios) -->
            {{#if hasPortfolios}}
            <div class="text-center">
                <button type="button" class="btn btn-outline" onclick="showCreatePortfolioModal()">
                    {{{icon 'plus' class='w-4 h-4 mr-2'}}}
                    Create New Portfolio
                </button>
            </div>
            {{/if}}
        </div>
    </main>
</div>

<!-- Create Portfolio Modal -->
<div id="create-portfolio-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-card rounded-lg shadow-xl max-w-md w-full">
            <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-foreground">Create New Portfolio</h3>
                    <button onclick="hideCreatePortfolioModal()" class="text-muted-foreground hover:text-foreground">
                        {{{icon 'x' class='w-5 h-5'}}}
                    </button>
                </div>

                <form method="post" action="/portfolios">
                    <input type="hidden" name="_csrf" value="{{csrf}}" />

                    <div class="space-y-4">
                        <div>
                            <label for="portfolio-name" class="block text-sm font-medium text-foreground mb-2">
                                Portfolio Name
                            </label>
                            <input type="text" id="portfolio-name" name="name" required
                                class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                                placeholder="Enter portfolio name">
                        </div>

                        <div>
                            <label for="portfolio-description" class="block text-sm font-medium text-foreground mb-2">
                                Description (Optional)
                            </label>
                            <textarea id="portfolio-description" name="description" rows="3"
                                class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                                placeholder="Describe what this portfolio is for"></textarea>
                        </div>

                        <div>
                            <label for="portfolio-color" class="block text-sm font-medium text-foreground mb-2">
                                Color Theme
                            </label>
                            <div class="grid grid-cols-6 gap-2">
                                {{#each (array "#3B82F6" "#EF4444" "#10B981" "#F59E0B" "#8B5CF6" "#EC4899"}}
                                <label class="cursor-pointer">
                                    <input type="radio" name="color" value="{{this}}" class="sr-only peer" {{#if (eq this "#3B82F6")}}checked{{/if}}>
                                    <div class="w-8 h-8 rounded-full border-2 border-border peer-checked:border-primary flex items-center justify-center">
                                        <div class="w-6 h-6 rounded-full" style="background-color: {{this}}"></div>
                                    </div>
                                </label>
                                {{/each}}
                            </div>
                        </div>
                    </div>

                    <div class="flex space-x-3 mt-6">
                        <button type="button" onclick="hideCreatePortfolioModal()" class="flex-1 px-4 py-2 text-muted-foreground border border-border rounded-md hover:bg-muted transition-colors">
                            Cancel
                        </button>
                        <button type="submit" class="flex-1 bg-primary text-primary-foreground px-4 py-2 rounded-md hover:bg-primary/90 transition-colors">
                            Create Portfolio
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

