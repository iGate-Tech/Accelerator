{
  "name": "accelerator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"npm run watch-css\" \"nodemon index.js\" \"bdui start --open\"",
    "build": "npm run build-css",
    "build-css": "npx @tailwindcss/cli -i public/css/input.css -o public/css/output.css",
    "watch-css": "npx @tailwindcss/cli -i public/css/input.css -o public/css/output.css --watch",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "deploy": "git push origin staging:main",
    "db:reset": "psql \"$SUPABASE_DB_URL\" -f reset_database.sql",
    "db:schema": "psql \"$SUPABASE_DB_URL\" -f schema.sql",
    "db:setup": "npm run db:reset && npm run db:schema",
    "db:reset-remote": "psql \"$SUPABASE_DB_URL\" -c \"DO \\$$ \\$ DECLARE table_name TEXT; BEGIN FOR table_name IN SELECT tablename FROM pg_tables WHERE schemaname = 'public' LOOP EXECUTE 'DROP TABLE IF EXISTS ' || quote_ident(table_name) || ' CASCADE'; RAISE NOTICE 'Dropped table: %', table_name; END LOOP; END \\$$;\\\"",
    "db:schema-remote": "psql \"$SUPABASE_DB_URL\" -f schema.sql",
    "db:deploy": "npm run db:reset-remote && npm run db:schema-remote"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AR-92/accelerator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/AR-92/accelerator/issues"
  },
  "homepage": "https://github.com/AR-92/accelerator#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.0",
    "express-handlebars": "^8.0.4",
    "express-session": "^1.18.2",
    "handlebars": "^4.7.8",
    "i18next": "^25.7.3",
    "i18next-http-middleware": "^3.9.1",
    "jsdom": "^27.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-static": "^0.556.0",
    "marked": "^17.0.1",
    "memorystore": "^1.6.7",
    "moment": "^2.30.1",
    "session-file-store": "^1.5.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "puppeteer": "^24.34.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "tailwindcss-rtl": "^0.9.0"
  }
}
