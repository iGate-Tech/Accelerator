<script src="https://unpkg.com/htmx.org@1.9.10"></script>
<script src="https://unpkg.com/htmx.org/dist/ext/ws.js"></script>
<script>
// Voting functionality
async function voteOnIdea(ideaId) {
  try {
    const response = await fetch('/api/votes', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        idea_id: ideaId,
        rating: 5 // Default to 5 stars for simplicity
      })
    });

    const result = await response.json();

    if (response.ok) {
      // Show success message
      showToast(result.message || 'Vote cast successfully!', 'success');
      // Refresh all sections
      htmx.trigger('body', 'refresh-stats');
      htmx.trigger('body', 'refresh-transactions');
      htmx.trigger('body', 'refresh-activity');
      htmx.trigger('body', 'refresh-notifications');
      htmx.trigger('body', 'refresh-ideas');
    } else {
      showToast(result.error || 'Failed to cast vote', 'error');
    }
  } catch (error) {
    console.error('Error voting:', error);
    showToast('Failed to cast vote', 'error');
  }
}

// Toast notification function
function showToast(message, type = 'info') {
  const toast = document.createElement('div');
  toast.className = `fixed top-4 right-4 z-50 px-4 py-2 rounded-lg text-white font-medium ${
    type === 'success' ? 'bg-green-500' :
    type === 'error' ? 'bg-red-500' :
    'bg-blue-500'
  }`;
  toast.textContent = message;

  document.body.appendChild(toast);

  setTimeout(() => {
    toast.remove();
  }, 3000);
}

// HTMX configuration
document.addEventListener('DOMContentLoaded', function() {
  // Add loading indicators
  htmx.on('htmx:beforeRequest', function(evt) {
    const target = evt.target;
    if (target.id) {
      target.style.opacity = '0.7';
    }
  });

  htmx.on('htmx:afterRequest', function(evt) {
    const target = evt.target;
    if (target.id) {
      target.style.opacity = '1';
    }
  });
});
</script>
</script>