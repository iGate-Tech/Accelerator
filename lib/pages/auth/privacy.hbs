<div class="w-full min-h-screen flex flex-col items-center justify-center" dir="{{#if (eq lng 'ar')}}rtl{{else}}ltr{{/if}}"
      <div class="max-w-4xl mx-auto px-3 sm:px-0 w-full relative">
         <img src="/images/accelerator_logo.svg" alt="Accelerator Logo" class="w-32 sm:w-40 my-4 sm:my-8 mx-auto" />
         <div class="flex flex-col items-center justify-center h-full gap-4 w-full max-w-3xl mx-auto bg-card shadow-primary rounded-lg p-3 sm:p-5 border border-input" style="direction: {{#if (eq lng 'ar')}}rtl{{else}}ltr{{/if}}; text-align: {{#if (eq lng 'ar')}}right{{else}}left{{/if}};">
        <div class="grid gap-2 text-center mb-6">
          <h1 class="text-3xl font-bold text-foreground text-glow text-center">{{t 'auth.privacy.title'}}</h1>
          <p class="text-balance text-muted-foreground">
           {{t 'auth.privacy.description'}}
         </p>
       </div>

        <div class="p-3 sm:p-6 space-y-6 w-full">
        <div class="{{#if (eq lng 'ar')}}text-right{{else}}text-left{{/if}}">
           <p class="text-sm text-muted-foreground mb-8">{{t 'auth.privacy.last_updated'}}</p>

          <h2 class="text-2xl font-bold text-foreground mb-4">{{t 'auth.privacy.section1_title'}}</h2>
          <p class="text-muted-foreground mb-6">
            {{t 'auth.privacy.section1_content'}}
          </p>

        <h2 class="text-2xl font-bold text-foreground mb-4">{{t 'auth.privacy.section2_title'}}</h2>
         <p class="text-muted-foreground mb-6">
           {{t 'auth.privacy.section2_content'}}
         </p>

        <h2 class="text-2xl font-bold text-foreground mb-4">{{t 'auth.privacy.section3_title'}}</h2>
        <p class="text-muted-foreground mb-6">
          {{t 'auth.privacy.section3_content'}}
        </p>

        <h2 class="text-2xl font-bold text-foreground mb-4">{{t 'auth.privacy.section4_title'}}</h2>
         <p class="text-muted-foreground mb-6">
           {{t 'auth.privacy.section4_content'}}
         </p>

        <h2 class="text-2xl font-bold text-foreground mb-4">{{t 'auth.privacy.section5_title'}}</h2>
        <p class="text-muted-foreground mb-6">
          {{t 'auth.privacy.section5_content'}}
        </p>

        <h2 class="text-2xl font-bold text-foreground mb-4">{{t 'auth.privacy.section6_title'}}</h2>
        <p class="text-muted-foreground mb-6">
          {{t 'auth.privacy.section6_content'}}
        </p>
         <div class="bg-muted/50 p-4 rounded-lg">
           <p class="text-foreground font-medium">{{t 'auth.privacy.contact'}}</p>
         </div>
         </div>

         <div class="mt-6 pt-6 border-t border-border">
           <p class="text-sm text-muted-foreground mb-4">
             {{t 'auth.privacy.agreement'}}
           </p>
          <a href="/auth/signup" class="text-sm text-primary hover:underline">
              {{t 'auth.privacy.back_to_signup'}}
            </a>
          </div>
         </div>
      </div>
   </div>
       </div>


     </div>
   </div>