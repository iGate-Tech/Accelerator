<!-- sidebar -->
<div
  class="sidebar relative w-[400px] bg-base-100 rounded-2xl p-3 shadow-sm border border-base-200 h-[85vh] overflow-visible"
>
  <!-- Tabs -->
  <div class="flex items-center gap-1 mb-3 text-sm">
    <span
      class="px-3 py-1 rounded-lg bg-base-100 shadow-sm font-medium"
    >Make</span>
    <span class="px-3 py-1 text-base-content/60">Edit</span>
    <span class="px-3 py-1 text-base-content/60">Reports</span>
    <div class="ml-auto flex gap-2 text-base-content/60">
      <i class="lucide lucide-search w-4 h-4" data-lucide="search"></i> <i class="lucide lucide-chevron-right w-4 h-4" data-lucide="chevron-right"></i>
    </div>
  </div>

  <!-- Section -->
  <div class="px-2">
    <p class="text-xs text-base-content/60 mb-2">Accelerator</p>

    <ul class="text-sm space-y-1 relative">
      {{#each this}}
      <!-- {{name}} -->
      <li>
        <div class="flex items-center gap-3 py-0.5 px-2 cursor-pointer rounded-md" onclick="toggleSidebarItem(this)">
          <span class="text-base-content/60"><i class="lucide lucide-chevron-right w-4 h-4" data-lucide="chevron-right"></i></span>
          <span class="flex-1 editable-text" oninput="updateItem(this, 'model')">{{name}}</span>
          <span class="text-base-content/60 text-xs">{{totalModelQuestions sections}}</span>
          <div class="dropdown dropdown-hover">
            <div tabindex="0" role="button" class="btn m-1 p-0">
              <i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i>
            </div>
            <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-md z-1 w-52 p-2 shadow-sm">
              <li><a onclick="editItem(this, 'model')"><i class="lucide lucide-edit w-4 h-4 mr-2" data-lucide="edit"></i>Edit</a></li>
              <li><a onclick="saveItem(this, 'model')"><i class="lucide lucide-save w-4 h-4 mr-2" data-lucide="save"></i>Save</a></li>
              <li><a onclick="deleteItem(this, 'model')"><i class="lucide lucide-trash w-4 h-4 mr-2" data-lucide="trash"></i>Delete</a></li>
              <li><a onclick="addItem(this, 'section')"><i class="lucide lucide-plus w-4 h-4 mr-2" data-lucide="plus"></i>Add Section</a></li>
            </ul>
          </div>
        </div>

        <!-- Nested sections -->
              <ul class="ml-3 pl-2 border-l border-primary space-y-1 hidden mt-1">
          {{#each sections}}
          <li>
            <div class="flex items-center gap-3 py-0.5 px-2 cursor-pointer rounded-md" onclick="toggleSidebarItem(this)">
              <span class="text-base-content/70"><i class="lucide lucide-chevron-right w-4 h-4" data-lucide="chevron-right"></i></span>
              <span class="flex-1 editable-text" oninput="updateItem(this, 'section')">{{name}}</span>
              <span class="text-base-content/60 text-xs">{{sumLengths content}}</span>
              <div class="dropdown dropdown-hover">
                <div tabindex="0" role="button" class="btn m-1 p-0">
                  <i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i>
                </div>
                <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-md z-1 w-52 p-2 shadow-sm">
                  <li><a onclick="editItem(this, 'section')"><i class="lucide lucide-edit w-4 h-4 mr-2" data-lucide="edit"></i>Edit</a></li>
                  <li><a onclick="saveItem(this, 'section')"><i class="lucide lucide-save w-4 h-4 mr-2" data-lucide="save"></i>Save</a></li>
                  <li><a onclick="deleteItem(this, 'section')"><i class="lucide lucide-trash w-4 h-4 mr-2" data-lucide="trash"></i>Delete</a></li>
                  <li><a onclick="addItem(this, 'group')"><i class="lucide lucide-plus w-4 h-4 mr-2" data-lucide="plus"></i>Add Group</a></li>
                </ul>
              </div>
            </div>

            <!-- Nested content groups -->
            <ul class="ml-3 pl-2 border-l border-primary space-y-1 hidden mt-1">
            {{#each content}}
            <li>
              <div class="flex items-center gap-3 py-0.5 px-2 cursor-pointer rounded-md" onclick="toggleSidebarItem(this)">
                <span class="text-base-content/60"><i class="lucide lucide-chevron-right w-4 h-4" data-lucide="chevron-right"></i></span>
                <span class="flex-1 editable-text" oninput="updateItem(this, 'group')">Group {{@index}} ({{countQuestions this}} questions)</span>
                <span class="text-base-content/60 text-xs">{{countQuestions this}}</span>
                <div class="dropdown dropdown-hover">
                  <div tabindex="0" role="button" class="btn m-1 p-0">
                    <i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i>
                  </div>
                  <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-md z-1 w-52 p-2 shadow-sm">
                    <li><a onclick="editItem(this, 'group')"><i class="lucide lucide-edit w-4 h-4 mr-2" data-lucide="edit"></i>Edit</a></li>
                    <li><a onclick="saveItem(this, 'group')"><i class="lucide lucide-save w-4 h-4 mr-2" data-lucide="save"></i>Save</a></li>
                    <li><a onclick="deleteItem(this, 'group')"><i class="lucide lucide-trash w-4 h-4 mr-2" data-lucide="trash"></i>Delete</a></li>
                    <li><a onclick="addItem(this, 'question')"><i class="lucide lucide-plus w-4 h-4 mr-2" data-lucide="plus"></i>Add Question</a></li>
                  </ul>
                </div>
              </div>

              <!-- Nested questions -->
        <ul class="ml-3 pl-2 border-l border-primary space-y-1 hidden mt-1">
      {{#each .}}
              <li class="flex items-center gap-2 py-1 px-2 cursor-pointer rounded-md relative" onclick="toggleSidebarItem(this)">
                <span class="flex-1 text-xs editable-text" oninput="updateItem(this, 'question')">{{question}}</span>
                <div class="dropdown dropdown-hover ml-auto">
                  <div tabindex="0" role="button" class="btn m-1 p-0">
                    <i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i>
                  </div>
                  <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-md z-1 w-52 p-2 shadow-sm">
                    <li><a onclick="editItem(this, 'question')"><i class="lucide lucide-edit w-4 h-4 mr-2" data-lucide="edit"></i>Edit</a></li>
                    <li><a onclick="saveItem(this, 'question')"><i class="lucide lucide-save w-4 h-4 mr-2" data-lucide="save"></i>Save</a></li>
                    <li><a onclick="deleteItem(this, 'question')"><i class="lucide lucide-trash w-4 h-4 mr-2" data-lucide="trash"></i>Delete</a></li>
                  </ul>
                </div>
              </li>
              {{/each}}
            </ul>
            {{/each}}
          </ul>
          {{/each}}
        </ul>
      </li>
      {{/each}}
    </ul>
  </div>
</div>