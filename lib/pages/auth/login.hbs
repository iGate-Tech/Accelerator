 <div class="w-full min-h-screen flex flex-col items-center justify-center" >
    <img src="/images/accelerator_logo.svg" alt="Accelerator Logo" class="w-40 my-10" />
  <div class="flex items-center">
    <div class="flex flex-col items-center justify-center h-full gap-6 w-[400px] mx-auto bg-card shadow-primary rounded-lg p-6 border border-input">
      <div class="grid gap-2 text-center">
        <h1 class="text-3xl font-bold text-foreground text-glow text-center">Login</h1>
        <p class="text-balance text-muted-foreground">
          Enter your email below to login to your account
        </p>
      </div>

      <form hx-post="/auth/login" hx-target="#auth-response" hx-swap="innerHTML"
        hx-on:htmx:before-request="showSpinner()" hx-on:htmx:after-request="hideSpinner()"
        class="grid gap-4 text-center">
        <input type="hidden" name="_csrf" value="{{csrf}}" />
        <div class="grid gap-2 text-left">
          <label
            class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
            for="email">
            Email
          </label>
          <input type="email" name="email"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
            id="email" placeholder="m@example.com" required="" />
        </div>

        <div class="grid gap-2 text-left">
          <div class="flex items-center gap-6">
            <label
              class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              for="password">
              Password
            </label>
            <a class="ml-auto inline-block text-sm underline text-muted-foreground hover:text-foreground focus:outline-none monotone-logo"
              href="/auth/forgot-password">
              Forgot your password?
            </a>
          </div>
          <div class="relative">
            <input type="password" name="password"
              class="flex h-9 w-full rounded-md border border-input/80 bg-transparent px-3 py-1 pr-10 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
              id="password" placeholder="Enter your password" required="" />
            <button type="button"
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-muted-foreground hover:text-foreground"
              onclick="togglePassword()">
              <span id="eye-open">
                {{{icon "eye" class="w-4 h-4"}}}
              </span>
              <span id="eye-closed" class="hidden">
                {{{icon "eye-off" class="w-4 h-4"}}}
              </span>
            </button>
          </div>
        </div>

        <div class="flex items-center space-x-2">
          <div class="relative">
            <input class="h-4 w-4 appearance-none rounded-full border border-input/80 checked:bg-primary checked:border-primary peer" id="remember" name="remember" type="checkbox" />
            <svg class="absolute inset-0 w-4 h-4 text-white scale-75 peer-checked:block hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20,6 9,17 4,12"></polyline>
            </svg>
          </div>
          <label
            class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
            for="remember">
            Remember me for 30 days
          </label>
        </div>

        <div class="w-full">
          <button type="submit" id="login-button" class="shiny-cta text-center bg-card"
            style="padding: 0.5rem 1rem; width: 200px; margin: 0 auto;">
            <span>
              <span id="login-text">Login</span>
              <span id="login-spinner" class="ml-2">{{{icon
                "loader-2"
                class="animate-spin h-4 w-4"
                }}}</span>
            </span>
          </button>
        </div>

      </form>

      <div class="mt-4 text-center text-sm text-muted-foreground">
        Don't have an account?
        <a class="underline text-muted-foreground hover:text-foreground focus:outline-none monotone-logo"
          href="/auth/signup">Sign up</a>
      </div>
    </div>
   </div>
  <div class="mb-[200px]"></div>

 </div>
</div>

<div id="auth-response"></div>