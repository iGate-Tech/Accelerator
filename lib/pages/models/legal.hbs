{{> progress-bar activeStep=activeStep ideaId=ideaId}}

{{> model-header title=pageTitle description=(t "models.legal.overview")
ratingStars="★★★★★" ratingValue="5.0" voteCount="0 votes" category=ideaCategory tags=ideaTags}}

{{> model-progress data='[
  {
    "id": "company-structure",
    "fullLabel": "1. Company Structure",
    "shortLabel": "1.",
    "position": 0
  }},
  {
    "id": "intellectual-property",
    "fullLabel": "2. Intellectual Property",
    "shortLabel": "2.",
    "position": 25
  }},
  {
    "id": "contracts-agreements",
    "fullLabel": "3. Contracts & Agreements",
    "shortLabel": "3.",
    "position": 50
  }},
  {
    "id": "compliance-regulations",
    "fullLabel": "4. Compliance & Regulations",
    "shortLabel": "4.",
    "position": 75
  }},
  {
    "id": "cap-table-equity",
    "fullLabel": "5. Cap Table & Equity",
    "shortLabel": "5.",
    "position": 100
  }}
]'}}

<main class="flex flex-col mx-auto items-center justify-center">
    <div class="sections-container">
        <!-- Company Structure Section -->
        <div id="company-structure" class="section mb-6">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Company Structure</h2>
            <p class="text-muted-foreground mb-6">Establish your legal foundation.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="company-structure-q1" step="1" question="What is your company name?" placeholder="This section establishes your company basics. Provide name with industry-based suggestions if unsure. AI can help brainstorm names. Use this section for legal foundation. Chat with AI to generate company names or learn naming considerations."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="company-structure-q2" step="2" question="What legal structure are you using?" placeholder="This section defines your legal structure. Choose LLC, sole proprietorship, or other forms with flexibility considerations. AI can recommend based on stage. Use this section for business entity setup. Chat with AI to understand legal structures or get recommendation help."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
                     <div class="flex-1">
                          {{> question-block id="company-structure-q3" step="3" question="Do you have a registration number?" placeholder="This section confirms registration status. Provide Commercial Registration or Business Registration number if available. AI can guide registration process. Use this section for legal compliance. Chat with AI to learn registration requirements or get process assistance."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.legal.section_completed") buttonText=(t "models.legal.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Intellectual Property Section -->
        <div id="intellectual-property" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Intellectual Property</h2>
            <p class="text-muted-foreground mb-6">Protect your innovations.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="intellectual-property-q1" step="4" question="What IP protections do you need?" placeholder="This section identifies needed IP protections. Consider trademarks, copyrights, patents, trade secrets with startup recommendations. AI can explain protection types. Use this section for IP strategy. Chat with AI to learn IP protections or get tailored recommendations."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="intellectual-property-q2" step="5" question="Do you have patentable technology?" placeholder="This section assesses patentable technology. Identify proprietary algorithms, AI models, hardware designs. AI can help evaluate patentability. Use this section for patent planning. Chat with AI to understand patent requirements or get patentability assessment."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.legal.section_completed") buttonText=(t "models.legal.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Contracts & Agreements Section -->
        <div id="contracts-agreements" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Contracts & Agreements</h2>
            <p class="text-muted-foreground mb-6">Secure your business relationships.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="contracts-agreements-q1" step="6" question="What contracts do you need?" placeholder="This section identifies necessary contracts. Include founder agreements, NDAs, employment contracts, SLAs, vendor agreements. AI can help draft templates. Use this section for legal relationships. Chat with AI to learn contract types or get drafting assistance."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.legal.section_completed") buttonText=(t "models.legal.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Compliance & Regulations Section -->
        <div id="compliance-regulations" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Compliance & Regulations</h2>
            <p class="text-muted-foreground mb-6">Ensure regulatory adherence.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="compliance-regulations-q1" step="7" question="What compliance requirements apply?" placeholder="This section identifies compliance requirements. Include corporate compliance, data protection, cybersecurity, industry regulations. AI can recommend based on business. Use this section for regulatory adherence. Chat with AI to understand compliance or get requirement identification."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.legal.section_completed") buttonText=(t "models.legal.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Cap Table & Equity Section -->
        <div id="cap-table-equity" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Cap Table & Equity</h2>
            <p class="text-muted-foreground mb-6">Manage ownership and equity.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="cap-table-equity-q1" step="8" question="Describe your cap table structure." placeholder="This section describes cap table structure. Include founder ownership, ESOP pool, investor dilution planning. AI can generate downloadable tables. Use this section for equity management. Chat with AI to learn cap table basics or get structure recommendations."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="cap-table-equity-q2" step="9" question="Do you want an employee stock option pool?" placeholder="This section considers employee stock options. Recommended at 5-15% for talent attraction and retention. AI can advise on pool sizing. Use this section for compensation planning. Chat with AI to understand ESOPs or get sizing recommendations."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
                     <div class="flex-1">
                          {{> question-block id="cap-table-equity-q3" step="10" question="When do you expect an investment round?" placeholder="This section plans investment timing. Consider pre-seed, seed, Series A timing for cap table adjustments. AI can help with round sequencing. Use this section for fundraising timeline. Chat with AI to learn investment rounds or get timing advice."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">4</div>
                     <div class="flex-1">
                          {{> question-block id="cap-table-equity-q4" step="11" question="Do you want a downloadable cap table?" placeholder="This section offers downloadable cap table. AI can create Excel or PDF formats based on your inputs. Use this section for investor presentations. Chat with AI to understand cap table formats or get customization help."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.legal.complete_legal") buttonText=(t "models.legal.complete_legal_button")}}
                    </div>
                </div>
            </div>
        </div>
     </div>
</main>

<div class=" h-[300px]"></div>

