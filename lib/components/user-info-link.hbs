<a href="/settings"
    class="w-full mb-2 relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors bg-primary-50 hover:bg-primary-100 hover:text-primary-900">
    <div class="grid flex-1 text-left text-sm leading-tight">
        <div class="flex flex-1">
            <div>

                <span class="truncate font-medium user-name">{{user.profile.name}}</span>
                <span class="truncate text-xs text-muted-foreground user-email">{{user.email}}</span>
            </div>

{{{icon 'settings' class='h-4 w-4 shrink-0' size='16'}}}

        </div>

        <div class="flex items-center justify-between text-sm flex-1">
            <span class="truncate text-xs text-muted-foreground self-center flex-1 nav-current-plan-name">{{capitalize user.profile.package_type}} {{t 'nav.plan'}}</span>
            <span class="truncate text-xs text-muted-foreground self-center nav-current-plan-details">{{#if (eq user.profile.package_type "free")}}{{t 'nav.free'}}{{else}}${{user.profile.package_type}} {{t 'payments.upgrade.month'}}{{/if}}</span>
        </div>
    </div>
</a>