          >Legal Model</span></div>
      </div>

      <div class="flex flex-col gap-4">
        <h1
          class="text-2xl sm:text-3xl md:text-4xl font-sans font-light text-foreground mb-6 sm:mb-10 text-center"
        >
          Hi
          <span class="text-primary">Demo</span>, what's your next big idea?
        </h1>

        <div
          class="card w-full bg-base-100 shadow-2xl/100 shadow-primary hover:shadow-xl transition-all duration-300 border border-base-200 hover:border-primary/30 rounded-lg overflow-hidden relative p-4"
        >
          <!-- Description wrapper -->
          <div class="pl-4 pr-2 relative">
            <label for="prompt-91-textarea" class="sr-only">241. 1. What is your
              mission?</label>
            <div
              id="prompt-91-display"
              class="w-full rounded-md border border-base-300 bg-base-100 px-3 py-2 text-base text-base-content min-h-[2.5rem] cursor-pointer overflow-visible markdown-content"
              style="display: none;"
            ></div>
            <textarea
              id="prompt-91-textarea"
              name="prompt-91"
              placeholder="Enter prompt..."
              aria-label="Enter prompt..."
              class="flex w-full rounded-md border-0 bg-transparent p-0 pt-[1px] text-base text-base-content placeholder:text-base-content/60 focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0"
              required=""
              rows="3"
              style="resize: none; overflow: hidden;"
            >As part of the Idea Model in Section 4: Branding, answer the
              following question for your startup: What is your mission?.
              Provide a comprehensive, startup-focused response with specific,
              actionable details.</textarea>
          </div>
          <!-- toolbar -->
          <div class="px-3 flex justify-between items-center">
            <div class="flex gap-1">
              <form
                action="/admin2/move-question-down?admin=1"
                method="post"
                class="inline"
              >
                <input type="hidden" name="id" value="91" />
                <button
                  type="submit"
                  class="btn btn-ghost btn-xs btn-square"
                  title="Move Down"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    data-lucide="chevron-down"
                    class="lucide lucide-chevron-down w-4 h-4" data-lucide="chevron-down"
                  ><path d="m6 9 6 6 6-6"></path></svg>
                </button>
              </form>
              <button
                hx-post="/admin2/delete-question?admin=1"
                hx-confirm="Are you sure you want to delete this question?"
                hx-vals='{"id": "91"}'
                class="btn btn-ghost btn-xs btn-square"
                title="Remove"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-lucide="x"
                  class="lucide lucide-x w-4 h-4"
                ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
              </button>
            </div>
            <div class="flex gap-1">
              <!-- Improve with AI -->
              <button
                type="button"
                class="btn btn-ghost btn-xs btn-square"
                title="Improve with AI"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-lucide="sparkles"
                  class="lucide lucide-sparkles w-4 h-4"
                ><path
                    d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"
                  ></path><path d="M20 2v4"></path><path
                    d="M22 4h-4"
                  ></path><circle cx="4" cy="20" r="2"></circle></svg>
              </button>
              <!-- Reset form -->
              <button
                type="button"
                class="btn btn-ghost btn-xs btn-square"
                title="Reset"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-lucide="rotate-ccw"
                  class="lucide lucide-rotate-ccw w-4 h-4"
                ><path
                    d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
                  ></path><path d="M3 3v5h5"></path></svg>
              </button>
              <!-- Save button -->
              <button
                type="button"
                class="btn btn-ghost btn-xs btn-square"
                title="Save"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-lucide="save"
                  class="lucide lucide-save w-4 h-4"
                ><path
                    d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"
                  ></path><path
                    d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"
                  ></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
      <script>
        function activateBadge(el) {
          const badges = Array.from(document.querySelectorAll('.horizontal-badge'));
          const arrows = document.querySelectorAll('svg.lucide-move-right');
          const index = badges.indexOf(el);

          // Remove primary color from all badges and reset to show number, hide text
          badges.forEach(badge => {
            badge.classList.remove('badge-primary');
            badge.querySelector('.number').classList.remove('hidden');
            badge.querySelector('.text').classList.add('hidden');
          });

          // Add primary color to all badges up to the clicked one
          for (let i = 0; i <= index; i++) {
            badges[i].classList.add('badge-primary');
          }

          // For the clicked badge, show text and hide number
          el.querySelector('.number').classList.add('hidden');
          el.querySelector('.text').classList.remove('hidden');

          // Update arrow colors
          arrows.forEach((arrow, i) => {
            if (i < index) {
              arrow.classList.remove('text-gray-300');
              arrow.classList.add('text-primary');
            } else {
              arrow.classList.remove('text-primary');
              arrow.classList.add('text-gray-300');
            }
          });

          console.log(el.querySelector('.text').textContent.trim());
        }

        // Initialize Lucide icons
        lucide.createIcons();
      </script>
    </div>
  </div>
</div>