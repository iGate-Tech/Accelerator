<div class="flex flex-col border border-border rounded-full bg-card question-card" id="{{id}}-question-card" data-expanded="true">


    <form id="{{id}}-new-project-form" class="flex m-auto max-w-[900px] min-w-[900px] flex-col gap-1 w-full" method="post"
        action="/projects/new">
        <!-- CSRF Token (Important for security) -->
        <input type="hidden" name="_csrf" value="">

        <div class="flex flex-col w-full">
            <div class="">
                <div class=" flex flex-col gap-2 rounded-2xl relative py-2  ">
                      <!-- Question and credit estimate wrapper -->
                      <div class="pl-4 pr-2 flex justify-between items-center cursor-pointer question-toggle" data-expanded="false">
                           <span
                               class="inline-flex items-center gap-2 px-2 py-1 bg-primary/5 text-primary border border-primary/20 text-xs rounded-full hover:bg-primary/10 transition-colors">
{{{icon 'chevron-right' class='w-3 h-3 text-primary transition-transform duration-200' size='24'}}}
                               <span class="text-primary font-semibold">{{step}}. {{question}}</span>
                           </span>
                           <span id="{{id}}-credit-estimate" class="inline-flex items-center px-2 py-1 bg-warning/5 text-warning border border-warning/20 text-xs font-semibold rounded-full">Estimated credits: 10</span>
                      </div>

                        <!-- Expandable Content -->
                        <div id="{{id}}-expandable-content" class="expandable-content overflow-hidden flex flex-col" style="display: none;">
                           <!-- Description wrapper -->
                           <div class=" pl-4 pr-2 relative mt-4">
                               <label for="assistant-prompt" class="sr-only">Describe your
                                   project requirements</label>
                                 <div id="{{id}}-assistant-prompt-display" class="w-full rounded-md border border-input bg-background px-3 py-2 text-base text-foreground min-h-[6rem] cursor-pointer overflow-hidden markdown-content" style="display: none; word-wrap: break-word;"></div>
                                  <textarea id="{{id}}-assistant-prompt" name="prompt"
                                       placeholder="{{placeholder}}"
                                       aria-label="Describe your project requirements" aria-describedby="prompt-help char-counter"
                                      class="flex w-full rounded-md border-0 bg-transparent p-3 pt-[1px] text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0 font-mono leading-relaxed"
                                      required=""
                                      style="min-height: 6rem; resize: vertical; overflow: auto; height: auto; line-height: 1.6;">{{description}}</textarea>
                               <p id="prompt-help" class="sr-only">Enter your project
                                   description or requirements</p>
                           </div>

                         <!-- toolbar -->
                         <div class="px-3 flex gap-2 items-center mt-4">
                         <div class="flex gap-2 items-center flex-shrink-0">
                              <!-- Chat with AI about Requirements -->
                              <button type="button" aria-label="Chat with AI about Requirements"
                                  title="Chat with AI about Requirements"
                                  class="shiny-button rounded-full inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'message-circle' class='w-4 h-4' size='16'}}}

                                 <span class="inline transition-all duration-200">Chat
                                     with AI</span>
                             </button>

                              <!-- Auto Fill with AI -->
                               <button type="button" aria-label="Auto Fill with AI" title="Auto Fill with AI" data-question="{{question}}" data-section="{{section}}"
                                   class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'sparkles' class='w-4 h-4' size='16'}}}

                                  <span class="hidden group-hover:inline transition-all duration-200">Auto Fill
                                      with AI</span>
                               </button>

                              <!-- Improve with AI -->
                               <button type="button" aria-label="Improve with AI" title="Improve with AI" data-section="{{section}}"
                                   class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'wand-sparkles' class='w-4 h-4' size='16'}}}

                                  <span class="hidden group-hover:inline transition-all duration-200">Improve
                                      Description with AI</span>
                               </button>

                             <!-- Reset form -->
                             <button type="button" aria-label="Reset form" title="Reset form"
                                 class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'rotate-ccw' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">Reset
                                     Form</span>
                             </button>
                         </div>

                        <!-- Submit button on the right -->
                        <div class="min-w-0 flex gap-2 ml-auto flex-shrink items-center">
                             <span id="{{id}}-char-counter" class="text-xs text-red-500/60 mr-2" aria-live="polite">Characters:
                                0 / 2000</span>
                             <button type="submit" aria-label="Save" title="Save"
                                 class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'save' class='w-4 h-4' size='16'}}}

                                 <span class="inline transition-all duration-200">Save</span>
                             </button>
             </div>
         </div>
     </div>
     </div> <!-- End expandable-content -->
 </div>
         </div>

         <!-- Chat Interface (appears below toolbar when Chat button is clicked) -->
         <div id="{{id}}-chat-container"
             class="hidden border-t border-border bg-card rounded-md overflow-hidden max-w-[900px] mt-4"
             role="log" aria-live="polite" aria-label="AI chat conversation">
        <!-- Chat Messages -->
        <div id="{{id}}-chat-messages" class="max-h-96 overflow-y-auto p-6 space-y-4" role="log" aria-live="polite">
            <div class="text-center text-muted-foreground text-sm py-8 px-4 bg-muted/30 rounded-lg border border-dashed border-border">
                💬 Start a conversation about your project requirements. The AI will help you refine and improve them.
            </div>
        </div>

        <!-- Chat Input -->
        <div class="border-t border-border bg-muted/20 p-4">
             <div class="flex gap-3 items-end">
                 <div class="flex-1 relative">
                     <textarea id="{{id}}-chat-input"
                         placeholder="Ask about your requirements, suggest improvements, or get advice..."
                         class="w-full min-h-[44px] max-h-32 resize-none rounded-lg border border-border bg-background px-4 py-3 text-sm placeholder:text-muted-foreground focus-visible:border-primary focus-visible:ring-2 focus-visible:ring-primary/20 focus-visible:outline-none transition-all duration-200"
                         rows="1" style="overflow: hidden;"></textarea>
                 </div>
             </div>
              <div class="flex justify-between items-center mt-3">
                  <span id="{{id}}-chat-char-counter" class="text-xs text-muted-foreground bg-muted px-2 py-1 rounded">0 / 1000</span>
              </div>
        </div>
    </div>
</div>

    </form>

  <style>
      /* Collapsible functionality */
      .question-toggle {
          transition: background-color 0.2s ease;
      }

      .question-toggle:hover {
          background-color: rgba(0, 0, 0, 0.02);
      }



      #{{id}}-expand-icon {
          transition: transform 0.3s ease;
      }

      /* Chat message styling */
     .message {
         word-wrap: break-word;
         line-height: 1.5;
     }

     .message--user {
         align-self: flex-end;
     }

     .message--ai {
         align-self: flex-start;
     }

     .message-group {
         animation: fadeIn 0.3s ease-in;
     }

     @keyframes fadeIn {
         from { opacity: 0; transform: translateY(10px); }
         to { opacity: 1; transform: translateY(0); }
     }

     /* Typing indicator animation */
     .typing-indicator .typing-dot {
         animation: typing 1.4s infinite ease-in-out;
     }

     .typing-indicator .typing-dot:nth-child(2) {
         animation-delay: 0.2s;
     }

     .typing-indicator .typing-dot:nth-child(3) {
         animation-delay: 0.4s;
     }

     @keyframes typing {
         0%, 60%, 100% {
             transform: translateY(0);
             opacity: 0.4;
         }
         30% {
             transform: translateY(-10px);
             opacity: 1;
         }
     }

     /* Spinning conic gradient border for chat button (like sidebar search) */
      .shiny-button {
          --gradient-angle: 0deg;
          --gradient-angle-offset: 0deg;
          --gradient-percent: 20%;
          --gradient-shine: #9e28b5;
          --shadow-size: 2px;
          position: relative;
          overflow: hidden;
          border: 2px solid transparent;
          background:
              linear-gradient(#ffffff, #ffffff) padding-box,
              conic-gradient(
                  from calc(var(--gradient-angle) - var(--gradient-angle-offset)),
                  transparent 0deg,
                  #ffc600 18deg,
                  #9e28b5 54deg,
                  #6cd14d 90deg,
                  #00a7e0 126deg,
                  transparent 162deg,
                  transparent 360deg
              )
              border-box;
          box-shadow: inset 0 0 0 1px #dedede;
          outline: none;
          transition:
              --gradient-angle-offset 800ms cubic-bezier(0.25, 1, 0.5, 1),
              --gradient-percent 800ms cubic-bezier(0.25, 1, 0.5, 1),
              --gradient-shine 800ms cubic-bezier(0.25, 1, 0.5, 1);
          isolation: isolate;
          outline-offset: 4px;
          z-index: 0;
          animation: border-spin 2.5s linear infinite;
      }

      .dark .shiny-button {
          background:
              linear-gradient(#030303, #030303) padding-box,
              conic-gradient(
                  from calc(var(--gradient-angle) - var(--gradient-angle-offset)),
                  transparent 0deg,
                  #ffc600 18deg,
                  #9e28b5 54deg,
                  #6cd14d 90deg,
                  #00a7e0 126deg,
                  transparent 162deg,
                  transparent 360deg
              )
              border-box;
          box-shadow: inset 0 0 0 1px #1a1818;
      }

      .shiny-button:focus {
          --gradient-percent: 100%;
          --gradient-angle-offset: 180deg;
      }

       @keyframes border-spin {
           to {
               --gradient-angle: 360deg;
           }
       }

       /* Markdown content styling */
       .markdown-content p {
           margin-bottom: 1rem;
           line-height: 1.6;
       }
       .markdown-content h1, .markdown-content h2, .markdown-content h3 {
           font-weight: bold;
           margin-bottom: 0.5rem;
           line-height: 1.4;
       }
       .markdown-content h1 { font-size: 1.5em; }
       .markdown-content h2 { font-size: 1.25em; }
       .markdown-content h3 { font-size: 1.1em; }
       .markdown-content ul, .markdown-content ol {
           margin-bottom: 1rem;
           padding-left: 1.5rem;
       }
       .markdown-content li {
           margin-bottom: 0.25rem;
       }
       .markdown-content blockquote {
           border-left: 4px solid #ccc;
           padding-left: 1rem;
           margin-bottom: 1rem;
           font-style: italic;
       }
       .markdown-content code {
           background-color: #f4f4f4;
           padding: 0.2em 0.4em;
           border-radius: 3px;
           font-family: monospace;
       }
       .markdown-content pre {
           background-color: #f4f4f4;
           padding: 1rem;
           border-radius: 3px;
           overflow-x: auto;
           margin-bottom: 1rem;
       }
       .markdown-content pre code {
           background-color: transparent;
           padding: 0;
       }
  </style>



<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
<script>
    // Wait for marked to load
    window.waitForMarked = function(callback) {
        if (typeof marked !== 'undefined') {
            callback();
        } else {
            setTimeout(() => window.waitForMarked(callback), 100);
        }
    }

       document.addEventListener('DOMContentLoaded', () => {
           // Component parameters
           const modelType = "{{modelType}}";
           const section = "{{section}}";
           const ideaId = "{{ideaId}}";

           // Global variable to track currently expanded question
           if (typeof window.currentlyExpandedQuestionId === 'undefined') {
               window.currentlyExpandedQuestionId = null;
           }

        // Customize marked renderer to avoid <pre> for code blocks
        const renderer = new marked.Renderer();
        renderer.codeblock = (code, lang) => `<p><code>${code}</code></p>`;
        // marked.setOptions({ renderer }); // Not needed if passing to parse

        // Initialize collapsible functionality
        const questionCard = document.getElementById('{{id}}-question-card');
        const toggleBtn = questionCard.querySelector('.question-toggle');
        const expandableContent = questionCard.querySelector('#{{id}}-expandable-content');
        const expandIcon = questionCard.querySelector('#{{id}}-expand-icon');

        // Declare chat variables early for use in toggle handler
        let isChatOpen = false;
        const chatContainer = questionCard.querySelector('#{{id}}-chat-container');

        if (toggleBtn && expandableContent && expandIcon && questionCard) {
            // Initialize based on data-expanded
            const initialExpanded = toggleBtn.dataset.expanded === 'true';
            if (initialExpanded) {
                // Expand
                expandableContent.style.display = 'block';
                expandIcon.style.transform = 'rotate(90deg)';
                questionCard.classList.remove('rounded-full');
                questionCard.classList.add('rounded-md');
                toggleBtn.setAttribute('aria-expanded', 'true');
                window.currentlyExpandedQuestionId = '{{id}}';
            } else {
                // Collapse
                expandableContent.style.display = 'none';
                expandIcon.style.transform = 'rotate(0deg)';
                questionCard.classList.remove('rounded-md');
                questionCard.classList.add('rounded-full');
                toggleBtn.setAttribute('aria-expanded', 'false');
            }

            toggleBtn.addEventListener('click', () => {
                const isExpanded = toggleBtn.dataset.expanded === 'true';

                if (isExpanded) {
                    // Collapse
                    expandableContent.style.display = 'none';
                    expandIcon.style.transform = 'rotate(0deg)';
                    questionCard.classList.remove('rounded-md');
                    questionCard.classList.add('rounded-full');
                    toggleBtn.dataset.expanded = 'false';
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    // Also collapse chat if open
                    if (isChatOpen) {
                        isChatOpen = false;
                        chatContainer.classList.add('hidden');
                    }
                    window.currentlyExpandedQuestionId = null;
                } else {
                    // Before expanding, collapse any other expanded question
                    if (window.currentlyExpandedQuestionId && window.currentlyExpandedQuestionId !== '{{id}}') {
                        const otherToggleBtn = document.querySelector(`#${window.currentlyExpandedQuestionId}-question-card .question-toggle`);
                        const otherExpandableContent = document.getElementById(`${window.currentlyExpandedQuestionId}-expandable-content`);
                        const otherExpandIcon = document.getElementById(`${window.currentlyExpandedQuestionId}-expand-icon`);
                        const otherQuestionCard = document.getElementById(`${window.currentlyExpandedQuestionId}-question-card`);
                        const otherChatContainer = document.getElementById(`${window.currentlyExpandedQuestionId}-chat-container`);

                        if (otherToggleBtn && otherExpandableContent && otherExpandIcon && otherQuestionCard) {
                            otherExpandableContent.style.display = 'none';
                            otherExpandIcon.style.transform = 'rotate(0deg)';
                            otherQuestionCard.classList.remove('rounded-md');
                            otherQuestionCard.classList.add('rounded-full');
                            otherToggleBtn.dataset.expanded = 'false';
                            otherToggleBtn.setAttribute('aria-expanded', 'false');
                            if (otherChatContainer) {
                                otherChatContainer.classList.add('hidden');
                            }
                        }
                    }
                    // Expand
                    expandableContent.style.display = 'block';
                    expandIcon.style.transform = 'rotate(90deg)';
                    questionCard.classList.remove('rounded-full');
                    questionCard.classList.add('rounded-md');
                    toggleBtn.dataset.expanded = 'true';
                    toggleBtn.setAttribute('aria-expanded', 'true');
                    window.currentlyExpandedQuestionId = '{{id}}';
                }
            });

            // Set initial ARIA attributes
            toggleBtn.setAttribute('aria-expanded', initialExpanded ? 'true' : 'false');
            toggleBtn.setAttribute('role', 'button');
            toggleBtn.setAttribute('tabindex', '0');
        }

        // Initialize form elements
        const form = questionCard.querySelector('#{{id}}-new-project-form');
        const descriptionTextarea = questionCard.querySelector('#{{id}}-assistant-prompt');
        const submitButton = form.querySelector('button[type="submit"]');

        // Auto-expand textarea to show full content
        function autoExpandTextarea() {
            // Reset height to auto to get natural height
            descriptionTextarea.style.height = 'auto';
            // Set height to scrollHeight to show full content
            descriptionTextarea.style.height = descriptionTextarea.scrollHeight + 'px';
            // Ensure minimum height for better UX
            if (descriptionTextarea.scrollHeight < 96) { // 6rem = 96px
                descriptionTextarea.style.height = '6rem';
            }
        }

        // Character counter
        function updateCharCounter() {
            const length = descriptionTextarea.value.length;
            const counter = questionCard.querySelector('#{{id}}-char-counter');
            counter.textContent = `Characters: ${length} / 2000`;
            if (length < 100 || length > 2000) {
                counter.className = 'text-xs text-red-500/60 mr-2';
            } else {
                counter.className = 'text-xs text-green-500/60 mr-2';
            }
            autoExpandTextarea();
        }

        // Initialize textarea height
        descriptionTextarea.style.minHeight = '6rem'; // Better minimum height for Markdown editing
        descriptionTextarea.style.resize = 'vertical'; // Allow vertical resizing
        descriptionTextarea.style.overflow = 'auto'; // Show scrollbar when needed

        descriptionTextarea.addEventListener('input', updateCharCounter);
        descriptionTextarea.addEventListener('input', autoExpandTextarea);

        // Handle display/edit mode toggle
        const displayDiv = questionCard.querySelector('#{{id}}-assistant-prompt-display');

        // Function to render markdown to display div
        function renderToDisplay() {
            const content = descriptionTextarea.value;
            if (content.trim()) {
                waitForMarked(() => {
                    try {

                        // Clean content: remove leading/trailing whitespace on each line
                        const cleanedContent = content.replace(/^\s+/gm, '').replace(/\s+$/gm, '');

                        const parsed = marked.parse(cleanedContent, { renderer, breaks: true });

                        displayDiv.innerHTML = DOMPurify.sanitize(parsed);
                        displayDiv.style.display = 'block';
                        descriptionTextarea.style.display = 'none';
                        autoExpandDisplayDiv();
                    } catch (error) {
                        console.error('Markdown parsing failed:', error);
                        displayDiv.textContent = content; // Fallback
                        displayDiv.style.display = 'block';
                        descriptionTextarea.style.display = 'none';
                        autoExpandDisplayDiv();
                    }
                });
            } else {
                // If no content, keep in edit mode
                displayDiv.style.display = 'none';
                descriptionTextarea.style.display = 'block';
            }
        }

        // Function to switch to edit mode
        function switchToEdit() {
            displayDiv.style.display = 'none';
            descriptionTextarea.style.display = 'block';
            // Auto-expand to show full content
            setTimeout(() => {
                autoExpandTextarea();
            }, 10);
            descriptionTextarea.focus();
        }

        // Click display div to edit
        displayDiv.addEventListener('click', switchToEdit);

        // Blur textarea to render
        descriptionTextarea.addEventListener('blur', () => {
            if (descriptionTextarea.value.trim()) {
                renderToDisplay();
            }
        });

        // Auto-expand display div
        function autoExpandDisplayDiv() {
            // Reset height to auto to get natural height
            displayDiv.style.height = 'auto';
        }

        // Initialize: if textarea has content, render it; otherwise ensure textarea is properly sized
        if (descriptionTextarea.value.trim()) {
            // Small delay to ensure all content is loaded
            setTimeout(() => {
                renderToDisplay();
            }, 50);
        } else {
            // Ensure textarea has proper initial height even when empty
            setTimeout(autoExpandTextarea, 10);
        }





        // Toast helper - now defined below



        // AI button handlers
        async function callAIApi(endpoint, data) {
            try {
                const response = await fetch(`/api/ai/${endpoint}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                return await response.json();
            } catch (error) {
                console.error('AI API error:', error);
                return { error: 'Network error' };
            }
        }

        // Enhanced toast function that waits for toast system
        function showToastMessage(message, type) {
            // Try multiple ways to show toast
            if (typeof window.showToast === 'function') {
                return window.showToast(message, type);
            } else if (typeof window.showSuccessToast === 'function' && type === 'success') {
                return window.showSuccessToast('Success', message);
            } else if (typeof window.showErrorToast === 'function' && type === 'error') {
                return window.showErrorToast('Error', message);
            } else if (typeof window.showWarningToast === 'function' && type === 'warning') {
                return window.showWarningToast('Warning', message);
            } else if (typeof window.showInfoToast === 'function' && type === 'info') {
                return window.showInfoToast('Info', message);
            } else {
                // Fallback: try to find toast container and create simple toast
                const container = document.getElementById('toast-container');
                if (container) {
                    const toast = document.createElement('div');
                    toast.className = `toast toast-${type} p-4 rounded-lg border shadow-lg max-w-sm bg-card text-card-foreground border-border`;
                    toast.textContent = message;
                    container.appendChild(toast);
                    setTimeout(() => toast.remove(), 5000);
                }
            }
        }

        // Helper function to set button loading state
        function setButtonLoading(button, loading) {
            if (!button) return;

            const icon = button.querySelector('svg');
            const textSpan = button.querySelector('span');

            if (loading) {
                button.disabled = true;
                button.classList.add('cursor-not-allowed', 'bg-warning/20', 'border-warning/50');

                // Replace icon with loading spinner
                if (icon) {
                    icon.outerHTML = `{{{icon 'loader' class='w-4 h-4 animate-spin text-warning' size='16'}}}`;
                }

                // Show processing text
                if (textSpan) {
                    textSpan.textContent = 'Processing...';
                    textSpan.classList.remove('hidden', 'group-hover:inline');
                    textSpan.classList.add('inline', 'text-warning');
                }
            } else {
                button.disabled = false;
                button.classList.remove('cursor-not-allowed', 'bg-warning/20', 'border-warning/50');

                // Restore original icon
                const spinner = button.querySelector('.animate-spin');
                if (spinner) {
                    const ariaLabel = button.getAttribute('aria-label');
                    let originalIcon = '';

                     if (ariaLabel.includes('Improve')) {
                         originalIcon = `{{{icon 'wand-sparkles' class='w-4 h-4' size='16'}}}`;
                     } else if (ariaLabel.includes('Auto Fill')) {
                         originalIcon = `{{{icon 'sparkles' class='w-4 h-4' size='16'}}}`;
                     } else if (ariaLabel.includes('Chat with AI')) {
                         originalIcon = `{{{icon 'message-circle' class='w-4 h-4' size='16'}}}`;
                     }

                    spinner.outerHTML = originalIcon;
                }

                // Reset text to original state and restore hover behavior
                if (textSpan) {
                    // Reset to original text based on button type
                    const ariaLabel = button.getAttribute('aria-label');
                    if (ariaLabel.includes('Improve')) {
                        textSpan.textContent = 'Improve Description with AI';
                    } else if (ariaLabel.includes('Auto Fill')) {
                        textSpan.textContent = 'Auto Fill with AI';
                     } else if (ariaLabel.includes('Chat with AI')) {
                        textSpan.textContent = 'Chat with AI';
                        // Keep text always visible for chat button
                        textSpan.classList.remove('hidden', 'group-hover:inline', 'text-warning');
                        textSpan.classList.add('inline');
                        return; // Skip the general reset
                    }

                    // Restore original classes for hover behavior
                    textSpan.classList.remove('inline', 'text-warning');
                    textSpan.classList.add('hidden', 'group-hover:inline');
                }
            }
        }










        // Reset form
        const resetFormBtn = form.querySelector('[aria-label="Reset form"]');
        if (resetFormBtn) {
             resetFormBtn.addEventListener('click', function (e) {
                 descriptionTextarea.value = '';
                 descriptionTextarea.dataset.originalContent = '';
                 const displayDiv = questionCard.querySelector('#{{id}}-assistant-prompt-display');
                 displayDiv.innerHTML = '';
                 displayDiv.style.display = 'none';
                 descriptionTextarea.style.display = 'block';
                 updateCharCounter();
                 showToastMessage('Form reset successfully', 'info');
             });
        }



        // Auto Fill with AI
        const autoFillBtn = form.querySelector('[aria-label="Auto Fill with AI"]');
        if (autoFillBtn) {
            autoFillBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const question = autoFillBtn.dataset.question;
                const section = autoFillBtn.dataset.section;
                if (!question.trim()) {
                    showToastMessage('No question available for AI generation', 'warning');
                    return;
                }
                setButtonLoading(autoFillBtn, true);
                try {
                    showToastMessage('Generating description with AI...', 'info');
                    const endpoint = section ? `generate/idea/${section}` : 'generate';
                     const result = await callAIApi(endpoint, { question, ideaId });
                    if (result.error) {
                        showToastMessage('AI error: ' + result.error, 'error');
                    } else {
                        descriptionTextarea.dataset.originalContent = result.generated_content;
                        descriptionTextarea.value = result.generated_content;
                        waitForMarked(() => {
                            try {
                                const cleanedContent = result.generated_content.replace(/^\s+/gm, '').replace(/\s+$/gm, '');
                                const displayDivGen = document.getElementById('{{id}}-assistant-prompt-display');
                                displayDivGen.innerHTML = DOMPurify.sanitize(marked.parse(cleanedContent, { renderer, breaks: true }));
                                displayDivGen.style.display = 'block';
                                descriptionTextarea.style.display = 'none';
                                autoExpandDisplayDiv();
                            } catch (error) {
                                console.error('Markdown parsing failed:', error);
                                const displayDivGen = document.getElementById('{{id}}-assistant-prompt-display');
                                displayDivGen.textContent = result.generated_content; // Fallback
                                displayDivGen.style.display = 'block';
                                descriptionTextarea.style.display = 'none';
                                autoExpandDisplayDiv();
                            }
                        });
                        updateCharCounter();
                        showToastMessage('Description generated successfully', 'success');
                        showToastMessage('10 credits deducted for AI usage', 'warning');
                        if (typeof window.loadNavCreditBalance === 'function') {
                            window.loadNavCreditBalance();
                        }
                    }
                } catch (error) {
                    console.error('Auto fill description error:', error);
                    showToastMessage('Network error. Please try again.', 'error');
                } finally {
                    setButtonLoading(autoFillBtn, false);
                }
            });
        }

        // Improve with AI
        const improveBtn = form.querySelector('[aria-label="Improve with AI"]');
        if (improveBtn) {
            improveBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const description = descriptionTextarea.value;
                const section = improveBtn.dataset.section;
                if (!description.trim()) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                setButtonLoading(improveBtn, true);
                try {
                    showToastMessage('Improving description with AI...', 'info');
                    const endpoint = section ? `improve/idea/${section}` : 'improve';
                     const result = await callAIApi(endpoint, { description, ideaId });
                    if (result.error) {
                        showToastMessage('AI error: ' + result.error, 'error');
                    } else {
                        descriptionTextarea.value = result.improved_description;
                        updateCharCounter();
                        showToastMessage('Description improved successfully', 'success');
                        showToastMessage('10 credits deducted for AI usage', 'warning');
                        if (typeof window.loadNavCreditBalance === 'function') {
                            window.loadNavCreditBalance();
                        }
                    }
                } catch (error) {
                    console.error('Improve description error:', error);
                    showToastMessage('Network error. Please try again.', 'error');
                } finally {
                    setButtonLoading(improveBtn, false);
                }
            });
        }

        // Form submission
        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            // Client-side validation
            if (!descriptionTextarea.value.trim()) {
                showToastMessage('Please enter a description', 'warning');
                return;
            }
            const descLength = descriptionTextarea.value.length;
            if (descLength < 10 || descLength > 2000) {
                showToastMessage('Description must be between 10 and 2000 characters', 'warning');
                return;
            }

            // Collect form data
            const description = descriptionTextarea.value;

            // Show loading state
            submitButton.disabled = true;
            submitButton.innerHTML = '<span>Saving...</span>';

            showToastMessage('Saving...', 'info');

            let success = false;

            try {
                if (modelType && section && ideaId) {
                    // Save to model section
                    // First, get or create model instance
                    const modelResponse = await fetch(`/api/models/${modelType}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            idea_id: ideaId
                        })
                    });

                    if (!modelResponse.ok) {
                        const errorText = await modelResponse.text();
                        throw new Error(`Failed to get model instance: ${modelResponse.status} ${errorText}`);
                    }

                    const modelData = await modelResponse.json();
                    if (!modelData || !modelData.id) {
                        throw new Error('Invalid model data received');
                    }
                    const modelId = modelData.id;

                    // Extract question key from id (e.g., "problem-validation-q1" -> "q1")
                    const questionKey = '{{id}}'.split('-').pop();

                    // First, fetch existing section data
                    const getResponse = await fetch(`/api/models/${modelId}/sections/${section}`, {
                        method: 'GET',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    let existingSectionData = {};
                    if (getResponse.ok) {
                        const sectionInfo = await getResponse.json();
                        const existingData = sectionInfo.section_data;

                        if (typeof existingData === 'string') {
                            // Backward compatibility: convert old string data to object
                            existingSectionData = { "q1": existingData };
                        } else if (existingData && typeof existingData === 'object') {
                            existingSectionData = existingData;
                        }
                    }

                    // Update the specific question
                    existingSectionData[questionKey] = description;

                    // Then save updated section data
                    const saveResponse = await fetch(`/api/models/${modelId}/sections/${section}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            section_data: existingSectionData,
                            is_completed: true
                        })
                    });

                    if (saveResponse.ok) {
                        success = true;
                        showToastMessage('Section saved successfully', 'success');
                        // Update completion if needed
                        if (typeof window.updateCompletion === 'function') {
                            window.updateCompletion();
                        }
                    } else {
                        const errorText = await saveResponse.text();
                        throw new Error(`Failed to save section: ${saveResponse.status} ${errorText}`);
                    }
                } else {
                    // Original idea creation logic
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            _csrf: document.querySelector('input[name="_csrf"]').value,
                            prompt: description
                        })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        success = true;
                        showToastMessage('Idea saved successfully!', 'success');
                        // Success - redirect to idea detail page after a short delay to show toast
                        setTimeout(() => {
                            window.location.href = `/models/idea?ideaId=${data.idea_id}`;
                        }, 1000);
                    } else {
                        const errorData = await response.json();
                        throw new Error(errorData.error || 'Failed to create project');
                    }
                }
            } catch (error) {
                console.error('Submission error:', error);
                showToastMessage('Error: ' + error.message, 'error');
            } finally {
                // Reset loading state only if not already handled in success case
                if (!success) {
                    submitButton.disabled = false;
                    submitButton.innerHTML = `{{{icon 'save' class='w-4 h-4' size='16'}}}<span class="inline transition-all duration-200">Save</span>`;
                }
            }
        });

         // Chat functionality
         let chatHistory = [];
         // isChatOpen and chatContainer already declared above

         const chatBtn = form.querySelector('[aria-label="Chat with AI about Requirements"]');
         const chatMessages = questionCard.querySelector('#{{id}}-chat-messages');
         const chatInput = questionCard.querySelector('#{{id}}-chat-input');
         const chatCharCounter = questionCard.querySelector('#{{id}}-chat-char-counter');



           // Toggle chat visibility
            chatBtn.addEventListener('click', () => {
                isChatOpen = !isChatOpen;
                chatContainer.classList.toggle('hidden', !isChatOpen);

                if (isChatOpen) {
                    renderChatMessages();
                }
            });

        // Auto-resize chat input
        function autoResizeChatInput() {
            chatInput.style.height = 'auto';
            chatInput.style.height = Math.min(chatInput.scrollHeight, 128) + 'px';
        }

        // Update chat character counter
        function updateChatCharCounter() {
            const length = chatInput.value.length;
            chatCharCounter.textContent = `${length} / 1000`;
            autoResizeChatInput();
        }

        chatInput.addEventListener('input', updateChatCharCounter);
        updateChatCharCounter();

        // Render chat messages
        function renderChatMessages() {
            chatMessages.innerHTML = '';

            if (chatHistory.length === 0) {
                chatMessages.innerHTML = `
                    <div class="text-center text-muted-foreground text-sm py-8 px-4 bg-muted/30 rounded-lg border border-dashed border-border" role="status" aria-live="polite">
                        💬 Chat with AI to get help refining your project requirements. (Temporary - not saved)
                    </div>
                `;
                return;
            }

             chatHistory.forEach(message => {
                 const messageGroup = document.createElement('article');
                 messageGroup.className = `message-group message-group--${message.role}`;

                 // Add timestamp
                 const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                 const isoTimestamp = new Date().toISOString();

                 if (message.role === 'user') {
                     // User message (right side)
                     messageGroup.innerHTML = `
                         <div class="flex flex-col items-end space-y-1">
                             <div class="message message--user bg-primary text-primary-foreground px-4 py-3 rounded-2xl rounded-br-md max-w-[80%] shadow-sm">
                                 ${message.content.replace(/\n/g, '<br>')}
                             </div>
                             <time class="message-timestamp message-timestamp--user text-xs text-muted-foreground" datetime="${isoTimestamp}">${timestamp}</time>
                         </div>
                     `;
                   } else {
                       // AI message (left side)
                       const aiMessageDiv = document.createElement('div');
                       aiMessageDiv.className = 'message message--ai bg-muted text-foreground px-4 py-3 rounded-2xl rounded-bl-md max-w-[80%] shadow-sm border border-border/50';
                       aiMessageDiv.innerHTML = DOMPurify.sanitize(marked.parse(message.content, { renderer, breaks: true }));
                       aiMessageDiv.dataset.rawContent = message.content;

                       const flexDiv = document.createElement('div');
                       flexDiv.className = 'flex flex-col space-y-1';
                       flexDiv.appendChild(aiMessageDiv);
                       flexDiv.innerHTML += `
                           <div class="flex justify-start gap-1 mt-1">
                               <button type="button" class="use-as-answer-btn text-xs text-primary hover:text-primary/80 underline decoration-primary/30 hover:decoration-primary/60 transition-colors cursor-pointer" title="Use this as the new answer">
                                   Use as Answer
                               </button>
                               <span class="text-muted-foreground text-xs">•</span>
                               <button type="button" class="append-to-answer-btn text-xs text-primary hover:text-primary/80 underline decoration-primary/30 hover:decoration-primary/60 transition-colors cursor-pointer" title="Append this to the current answer">
                                   Append to Answer
                               </button>
                           </div>
                           <time class="message-timestamp message-timestamp--ai text-xs text-muted-foreground" datetime="${isoTimestamp}">${timestamp}</time>
                       `;

                       // Add event listeners to the buttons
                       flexDiv.querySelectorAll('.use-as-answer-btn').forEach(btn => {
                           btn.addEventListener('click', function(e) {
                               e.preventDefault();
                               const messageGroup = this.closest('.message-group--ai');
                               if (!messageGroup) return;
                               const messageDiv = messageGroup.querySelector('.message--ai');
                               if (!messageDiv || !messageDiv.dataset.rawContent) return;
                               const rawContent = messageDiv.dataset.rawContent;

                               // Switch to edit mode if in display mode
                               const displayDiv = questionCard.querySelector('#{{id}}-assistant-prompt-display');
                               if (displayDiv && displayDiv.style.display !== 'none') {
                                   displayDiv.style.display = 'none';
                                   descriptionTextarea.style.display = 'block';
                                   descriptionTextarea.focus();
                               }

                               // Set the answer
                               descriptionTextarea.value = rawContent;
                               updateCharCounter();
                               autoExpandTextarea();

                               showToastMessage('Answer updated with AI response', 'success');
                           });
                       });

                       flexDiv.querySelectorAll('.append-to-answer-btn').forEach(btn => {
                           btn.addEventListener('click', function(e) {
                               e.preventDefault();
                               const messageGroup = this.closest('.message-group--ai');
                               if (!messageGroup) return;
                               const messageDiv = messageGroup.querySelector('.message--ai');
                               if (!messageDiv || !messageDiv.dataset.rawContent) return;
                               const rawContent = messageDiv.dataset.rawContent;

                               // Switch to edit mode if in display mode
                               const displayDiv = questionCard.querySelector('#{{id}}-assistant-prompt-display');
                               if (displayDiv && displayDiv.style.display !== 'none') {
                                   displayDiv.style.display = 'none';
                                   descriptionTextarea.style.display = 'block';
                                   descriptionTextarea.focus();
                               }

                               // Append to current answer
                               const currentValue = descriptionTextarea.value.trim();
                               if (currentValue) {
                                   descriptionTextarea.value = currentValue + '\n\n' + rawContent;
                               } else {
                                   descriptionTextarea.value = rawContent;
                               }
                               updateCharCounter();
                               autoExpandTextarea();

                               showToastMessage('AI response appended to answer', 'success');
                           });
                       });

                       messageGroup.appendChild(flexDiv);
                   }

                 chatMessages.appendChild(messageGroup);
             });

            // Scroll to bottom
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }



        // Send chat message
        async function sendChatMessage() {
            const message = chatInput.value.trim();
            if (!message || message.length > 1000) return;

            // Add user message to history
            chatHistory.push({ role: 'user', content: message });
            renderChatMessages();

            // Clear input
            chatInput.value = '';
            updateChatCharCounter();

            // Get current form context
            const currentDescription = descriptionTextarea.value.trim();

            const context = currentDescription ? `Description: ${currentDescription}` : '';

            // Show loading state
            setButtonLoading(chatBtn, true);

            const loadingMessageDiv = document.createElement('article');
            loadingMessageDiv.className = 'message-group message-group--ai';
            loadingMessageDiv.innerHTML = `
                <div class="flex flex-col space-y-1">
                    <div class="message message--ai bg-muted text-foreground px-4 py-3 rounded-2xl rounded-bl-md max-w-[80%] shadow-sm border border-border/50">
                        <div class="typing-indicator flex items-center space-x-1" aria-label="AI is typing">
                            <div class="typing-dot w-2 h-2 bg-muted-foreground/60 rounded-full animate-pulse"></div>
                            <div class="typing-dot w-2 h-2 bg-muted-foreground/60 rounded-full animate-pulse" style="animation-delay: 0.2s"></div>
                            <div class="typing-dot w-2 h-2 bg-muted-foreground/60 rounded-full animate-pulse" style="animation-delay: 0.4s"></div>
                        </div>
                    </div>
                </div>
            `;
            chatMessages.appendChild(loadingMessageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                const response = await fetch('/api/ai/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                     body: JSON.stringify({
                         messages: chatHistory,
                         ideaId: ideaId
                     })
                });

                const data = await response.json();

                if (response.ok) {
                    // Add AI response to history
                    chatHistory.push({ role: 'assistant', content: data.response });
                    renderChatMessages();

                    showToastMessage('Message sent successfully', 'success');
                    showToastMessage('10 credits deducted for AI chat', 'warning');
                    if (typeof window.loadNavCreditBalance === 'function') {
                        window.loadNavCreditBalance();
                    }
                } else {
                    showToastMessage('AI chat error: ' + (data.error || 'Unknown error'), 'error');
                    // Remove loading message
                    loadingMessageDiv.remove();
                }
            } catch (error) {
                console.error('Chat error:', error);
                showToastMessage('Network error. Please try again.', 'error');
                // Remove loading message
                loadingMessageDiv.remove();
            } finally {
                setButtonLoading(chatBtn, false);
            }
        }



        // Send message on Enter (but allow Shift+Enter for new lines)
        chatInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendChatMessage();
            }
        });


    });


</script>