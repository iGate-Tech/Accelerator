
<div class="min-h-screen bg-base-100">
   <div class="relative overflow-hidden">
     <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
       <!-- Header -->
        <div class="text-center mb-8 sm:mb-12">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4 sm:mb-6">
              {{t 'onboarding.package.title'}}
            </h1>
            <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
              {{t 'onboarding.package.subtitle'}}
            </p>
        </div>

{{> onboarding-progress activeStep="package"}}

         <!-- Onboarding Message -->
         <div class="bg-gradient-to-r from-primary/5 to-secondary/5 border border-primary/10 rounded-lg sm:rounded-xl p-4 sm:p-6 mb-6 sm:mb-8 lg:mb-10">
           <div class="flex items-start">
             <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-primary/10 rounded-lg sm:rounded-xl flex items-center justify-center mr-3 sm:mr-4 lg:mr-5 flex-shrink-0">
               {{{icon 'rocket' class="w-3 h-3 sm:w-4 sm:h-4 lg:w-5 lg:h-5 text-primary"}}}
             </div>
                   <div>
                     <h3 class="text-sm sm:text-base lg:text-lg font-semibold text-foreground mb-2">{{t 'onboarding.package.welcome_title'}}! 🚀</h3>
                     <p class="text-xs sm:text-sm lg:text-base text-muted-foreground leading-relaxed">
                      {{t 'onboarding.package.welcome_message'}}
                     </p>
                  </div>
           </div>
         </div>

       <!-- Current Balance Card -->
       <div class="bg-card rounded-2xl shadow-xl p-6 mb-8 sm:mb-12 border border-border">
                  <div class="text-center">
                <div class="text-sm text-muted-foreground mb-2">{{t 'billing.current_balance'}}</div>
            <div class="text-4xl sm:text-5xl font-bold text-primary">{{currentBalance}} {{t 'billing.credits'}}</div>
         </div>
       </div>

        <!-- Package Plans -->
        <form method="POST" action="/onboarding/plan" class="space-y-8">
          <input type="hidden" name="_csrf" value="{{csrf}}"/>

          <!-- Step 1: Choose Package -->
          <div id="step1" class="step-content">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
              {{#each packages}}
              <label class="bg-card rounded-xl border border-border shadow-sm hover:shadow-md transition-shadow duration-200 cursor-pointer">
                <input type="radio" name="package_type" value="{{type}}" class="sr-only peer" required/>
                <div class="p-4 sm:p-6 lg:p-8 peer-checked:border-primary peer-checked:bg-primary/5">
                  <div class="text-center mb-6">
                     <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-foreground mb-3">{{name}}</h3>
                    <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary mb-1">${{price_monthly}}</div>
                     <div class="text-sm text-muted-foreground mb-2">{{t 'upgrade.month'}}</div>
                    <div class="text-xs sm:text-sm text-muted-foreground">{{credits_monthly}} {{t 'billing.credits'}} included</div>
                  </div>

                  <div class="space-y-3 mb-6">
                    <div class="flex items-center space-x-3">
                      <div class="w-5 h-5 sm:w-6 sm:h-6 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                        {{{icon 'check' class="w-3 h-3 sm:w-4 sm:h-4 text-green-600 dark:text-green-400"}}}
                      </div>
                       <span class="text-xs sm:text-sm text-foreground">{{t 'buy-credits.instant_delivery'}}</span>
                    </div>

                    <div class="flex items-center space-x-3">
                      <div class="w-5 h-5 sm:w-6 sm:h-6 bg-blue-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                        {{{icon 'clock' class="w-3 h-3 sm:w-4 sm:h-4 text-blue-600 dark:text-blue-400"}}}
                      </div>
                      <span class="text-xs sm:text-sm text-foreground">{{t 'buy-credits.no_expiration'}}</span>
                    </div>

                    <div class="flex items-center space-x-3">
                      <div class="w-5 h-5 sm:w-6 sm:h-6 bg-amber-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                        {{{icon 'lightbulb' class="w-3 h-3 sm:w-4 sm:h-4 text-amber-600 dark:text-amber-400"}}}
                      </div>
                      <span class="text-xs sm:text-sm text-foreground">{{t 'landing.features.ai_powered_features'}}</span>
                    </div>
                  </div>

                  <div class="text-center">
                    <div class="w-full bg-primary/10 text-primary font-semibold py-3 px-4 sm:px-6 rounded-lg text-sm sm:text-base peer-checked:bg-primary peer-checked:text-primary-foreground">
                       <span class="flex items-center justify-center space-x-2">
                         <span>{{t 'onboarding.package.select_plan'}} {{name}}</span>
                         {{{icon 'arrow-right' class="w-4 h-4 sm:w-5 sm:h-5"}}}
                       </span>
                    </div>
                  </div>
                </div>
              </label>
              {{/each}}
            </div>


          </div>

          <!-- Step 2: Payment Method -->
          <div id="step2" class="step-content hidden">
            <div class="bg-card rounded-lg border border-border p-4 sm:p-6">
              <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-4">{{t 'add-payment-method.title'}}</h2>
              <p class="text-muted-foreground mb-6">{{t 'add-payment-method.description'}}</p>

            <!-- Card Type Selection -->
            <div class="mb-6">
              <label class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.payment_method_type'}}</label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
               <label class="relative">
                 <input type="radio" name="cardType" value="credit" class="sr-only peer" checked>
                  <div class="p-3 sm:p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                    <div class="flex items-center gap-3">
                      {{{icon 'credit-card' class='w-5 h-5 sm:w-6 sm:h-6 text-primary' size='24'}}}
                      <div>
                        <div class="font-medium text-foreground">{{t 'add-payment-method.credit_card'}}</div>
                        <div class="text-sm text-muted-foreground">{{t 'add-payment-method.visa_mastercard'}}</div>
                      </div>
                    </div>
                  </div>
               </label>
               <label class="relative">
                 <input type="radio" name="cardType" value="debit" class="sr-only peer">
                  <div class="p-3 sm:p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                    <div class="flex items-center gap-3">
                      {{{icon 'credit-card' class='w-5 h-5 sm:w-6 sm:h-6 text-primary' size='24'}}}
                      <div>
                        <div class="font-medium text-foreground">{{t 'add-payment-method.debit_card'}}</div>
                        <div class="text-sm text-muted-foreground">{{t 'add-payment-method.bank_debit_cards'}}</div>
                      </div>
                    </div>
                  </div>
               </label>
               <label class="relative">
                 <input type="radio" name="cardType" value="paypal" class="sr-only peer">
                  <div class="p-3 sm:p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                    <div class="flex items-center gap-3">
                      {{{icon 'wallet' class='w-5 h-5 sm:w-6 sm:h-6 text-primary' size='24'}}}
                      <div>
                        <div class="font-medium text-foreground">{{t 'add-payment-method.paypal'}}</div>
                        <div class="text-sm text-muted-foreground">{{t 'add-payment-method.paypal_account'}}</div>
                      </div>
                    </div>
                  </div>
               </label>
             </div>
           </div>

           <!-- Card Details -->
           <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
             <div class="md:col-span-2">
               <label for="cardNumber" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.card_number'}}</label>
               <div class="relative">
                 <input type="text" id="cardNumber" name="cardNumber" placeholder="{{t 'add-payment-method.card_number_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
                 <div class="absolute right-3 top-1/2 transform -translate-y-1/2 flex gap-1">
                   <div class="w-6 h-4 bg-blue-600 rounded text-white text-xs flex items-center justify-center font-bold">V</div>
                   <div class="w-6 h-4 bg-red-600 rounded text-white text-xs flex items-center justify-center font-bold">M</div>
                   <div class="w-6 h-4 bg-blue-400 rounded text-white text-xs flex items-center justify-center font-bold">A</div>
                 </div>
               </div>
             </div>

             <div>
               <label for="expiryDate" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.expiry_date'}}</label>
                <input type="text" id="expiryDate" name="expiryDate" placeholder="{{t 'add-payment-method.expiry_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
             </div>

             <div>
               <label for="cvv" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.cvv'}}</label>
                <input type="text" id="cvv" name="cvv" placeholder="{{t 'add-payment-method.cvv_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
             </div>
           </div>

           <!-- Cardholder Name -->
           <div>
             <label for="cardholderName" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.cardholder_name'}}</label>
              <input type="text" id="cardholderName" name="cardholderName" placeholder="{{t 'add-payment-method.cardholder_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
           </div>

            <!-- Billing Address -->
            <div>
              <h3 class="text-base sm:text-lg font-medium text-foreground mb-4">{{t 'add-payment-method.billing_address'}}</h3>
             <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
               <div class="md:col-span-2">
                 <label for="address" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.street_address'}}</label>
                  <input type="text" id="address" name="address" placeholder="{{t 'add-payment-method.street_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
               </div>

               <div>
                 <label for="city" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.city'}}</label>
                  <input type="text" id="city" name="city" placeholder="{{t 'add-payment-method.city_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
               </div>

               <div>
                 <label for="zipCode" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.zip_code'}}</label>
                  <input type="text" id="zipCode" name="zipCode" placeholder="{{t 'add-payment-method.zip_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
               </div>

               <div>
                 <label for="country" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.country'}}</label>
                  <select id="country" name="country" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
                   <option value="">{{t 'add-payment-method.select_country'}}</option>
                   <option value="US">{{t 'add-payment-method.united_states'}}</option>
                   <option value="CA">{{t 'add-payment-method.canada'}}</option>
                   <option value="UK">{{t 'add-payment-method.united_kingdom'}}</option>
                   <option value="AU">{{t 'add-payment-method.australia'}}</option>
                   <option value="DE">{{t 'add-payment-method.germany'}}</option>
                   <option value="FR">{{t 'add-payment-method.france'}}</option>
                   <option value="JP">{{t 'add-payment-method.japan'}}</option>
                   <option value="SA">{{t 'add-payment-method.saudi_arabia'}}</option>
                 </select>
               </div>

               <div>
                 <label for="state" class="block text-sm font-medium text-foreground mb-2">{{t 'add-payment-method.state_province'}}</label>
                  <input type="text" id="state" name="state" placeholder="{{t 'add-payment-method.state_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base" required>
               </div>
             </div>
           </div>

            <!-- Security Notice -->
            <div class="bg-muted/50 rounded-lg p-3 sm:p-4">
              <div class="flex items-start gap-3">
                {{{icon 'shield-check' class='w-4 h-4 sm:w-5 sm:h-5 text-success mt-0.5' size='20'}}}
                <div>
                  <h4 class="font-medium text-foreground">{{t 'add-payment-method.secure_payment'}}</h4>
                  <p class="text-sm text-muted-foreground">{{t 'add-payment-method.payment_secure'}}</p>
                </div>
              </div>
            </div>

              <!-- Submit Button -->
              <div class="pt-6 flex flex-col sm:flex-row gap-4">
                <button type="button" id="back-btn" class="px-6 py-3 border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-lg transition-colors text-base font-medium">
                  {{{icon 'arrow-left' class="w-5 h-5 mr-2"}}}
                  Back
                </button>
                <button type="submit" class="flex-1 bg-primary hover:bg-primary/90 text-primary-foreground font-semibold py-3 px-6 rounded-lg transition-colors duration-200 text-base">
                  <span class="flex items-center justify-center space-x-2">
                    <span>Complete Setup</span>
                    {{{icon 'arrow-right' class="w-5 h-5"}}}
                  </span>
                </button>
              </div>
            </div>
          </div>
        </form>

         <!-- Footer -->
         <div class="text-center mt-8 sm:mt-12">
           <p class="text-sm text-muted-foreground">{{t 'onboarding.package.footer'}}</p>
         </div>
       </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const step1 = document.getElementById('step1');
        const step2 = document.getElementById('step2');
        const backBtn = document.getElementById('back-btn');
        const currentStep = document.getElementById('current-step');
        const stepTitle = document.getElementById('step-title');
        const packageRadios = document.querySelectorAll('input[name="package_type"]');

        // Auto-advance to payment step when package is selected
        packageRadios.forEach(radio => {
          radio.addEventListener('change', function() {
            step1.classList.add('hidden');
            step2.classList.remove('hidden');
            // Update progress bar
            const step2Circle = document.getElementById('step2-circle');
            const step2Label = document.getElementById('step2-label');
            const step1To2Line = document.getElementById('step1-2-line');
            if (step2Circle) step2Circle.classList.remove('bg-muted', 'text-muted-foreground');
            if (step2Circle) step2Circle.classList.add('bg-primary', 'text-primary-content');
            if (step2Label) step2Label.classList.remove('text-muted-foreground');
            if (step2Label) step2Label.classList.add('text-primary');
            if (step1To2Line) step1To2Line.classList.remove('bg-muted');
            if (step1To2Line) step1To2Line.classList.add('bg-primary');
          });
        });

        // Back button
        backBtn.addEventListener('click', function() {
          step2.classList.add('hidden');
          step1.classList.remove('hidden');
          // Revert progress bar
          const step2Circle = document.getElementById('step2-circle');
          const step2Label = document.getElementById('step2-label');
          const step1To2Line = document.getElementById('step1-2-line');
          if (step2Circle) step2Circle.classList.remove('bg-primary', 'text-primary-content');
          if (step2Circle) step2Circle.classList.add('bg-muted', 'text-muted-foreground');
          if (step2Label) step2Label.classList.remove('text-primary');
          if (step2Label) step2Label.classList.add('text-muted-foreground');
          if (step1To2Line) step1To2Line.classList.remove('bg-primary');
          if (step1To2Line) step1To2Line.classList.add('bg-muted');
        });
      });
    </script>
  </div>