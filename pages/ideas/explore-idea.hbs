<div class="p-20">
    <div class="grid gap-1  mb-12">
        <h1 class="font-heading text-3xl font-semibold text-foreground">
            Explore Ideas
        </h1>
        <p class="text-lg text-muted-foreground">
            Explore other people ideas here
        </p>
    </div>

    <!-- Search and Filter Controls -->
    <div class="bg-card rounded-lg p-6 mb-8 border border-border">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Search Input -->
            <div class="md:col-span-2">
                <label for="search-input" class="block text-sm font-medium text-foreground mb-2">Search</label>
                <div class="relative">
                    <input type="text" id="search-input" placeholder="Search ideas..."
                           class="w-full pl-10 pr-4 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                    {{{icon 'search' class='absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground'}}}
                </div>
            </div>

            <!-- Category Filter -->
            <div>
                <label for="category-filter" class="block text-sm font-medium text-foreground mb-2">Category</label>
                <select id="category-filter" class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="">All Categories</option>
                    {{#each categories}}
                    <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
            </div>

            <!-- Sort Options -->
            <div>
                <label for="sort-select" class="block text-sm font-medium text-foreground mb-2">Sort By</label>
                <select id="sort-select" class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                    <option value="rating">Highest Rated</option>
                    <option value="title">Title A-Z</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Ideas Grid Section -->
    <div id="ideas-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#each ideas}}
        {{> idea-card .}}
        {{/each}}
    </div>

    <!-- No Results Message -->
    <div id="no-results" class="hidden text-center py-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-muted rounded-2xl mb-6">
            {{{icon 'search-x' class='w-8 h-8 text-muted-foreground'}}}
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-2">No ideas found</h3>
        <p class="text-muted-foreground">Try adjusting your search criteria</p>
    </div>
</div>

