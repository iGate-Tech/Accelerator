<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-4 mb-6">
        <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center">
          {{{ icon 'building-2' class='w-8 h-8 text-white' }}}
        </div>
         <div>
           <h1 class="text-4xl font-bold text-gray-900">{{t 'reports-business-plan.title'}}</h1>
           <p class="text-xl text-gray-600 mt-2">{{t 'reports-business-plan.subtitle'}}</p>
         </div>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-8 max-w-2xl mx-auto">
         <div class="text-center mb-6">
           <h2 class="text-2xl font-semibold text-gray-900 mb-2">{{t 'reports-business-plan.generate_title'}}</h2>
           <p class="text-gray-600">{{t 'reports-business-plan.description'}}</p>
         </div>

        {{#if userIdeas.length}}
        <form hx-post="/api/reports/business-plan" hx-target="body" hx-swap="beforeend" hx-on:htmx:before-request="clearAlerts(); showLoading()" hx-on:htmx:after-swap="hideLoading()" hx-on:htmx:after-request="updateCreditBalance()" class="space-y-6">

          <div>
             <label for="ideaId" class="block text-sm font-medium text-gray-700 mb-2">
               {{t 'reports-business-plan.select_idea'}} *
             </label>
            <select id="ideaId" name="ideaId" required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
               <option value="">{{t 'reports-business-plan.select_placeholder'}}</option>
              {{#each userIdeas}}
              <option value="{{id}}">{{title}} {{#if completion_percentage}}({{completion_percentage}}% complete){{/if}}</option>
              {{/each}}
            </select>
          </div>

          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <div class="flex items-start">
              <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3 mt-0.5">
                {{{ icon 'info' class='w-4 h-4 text-blue-600' }}}
              </div>
              <div>
                 <h4 class="text-sm font-semibold text-blue-900 mb-1">{{t 'reports-business-plan.requirements'}}</h4>
                 <ul class="text-sm text-blue-800 space-y-1">
                   <li>• {{t 'reports-business-plan.requirement1'}}</li>
                   <li>• {{t 'reports-business-plan.requirement2'}}</li>
                   <li>• {{t 'reports-business-plan.requirement3'}}</li>
                   <li>• {{t 'reports-business-plan.requirement4'}}</li>
                 </ul>
              </div>
            </div>
          </div>

          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <div class="flex items-center">
              <div class="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center mr-3">
                {{{ icon 'zap' class='w-4 h-4 text-yellow-600' }}}
              </div>
              <div>
                 <h4 class="text-sm font-semibold text-yellow-900">{{t 'reports-business-plan.cost_credits'}}</h4>
                 <p class="text-sm text-yellow-800">{{t 'reports-business-plan.current_balance'}}: <span class="font-semibold">{{userCredits}} credits</span></p>
              </div>
            </div>
          </div>

          <div class="flex gap-4">
             <button type="submit"
               class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
               {{#if (lt userCredits 50)}}disabled{{/if}}>
                <span>{{t 'reports-business-plan.generate_button'}}</span>
               {{#if (gte userCredits 50)}}
                 {{{ icon 'sparkles' class='w-5 h-5' }}}
               {{/if}}
               <span class="htmx-indicator ml-2">
                 {{{ icon 'loader-2' class='animate-spin w-5 h-5' }}}
               </span>
             </button>
          </div>
        </form>
        {{else}}
        <div class="text-center py-8">
          <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            {{{ icon 'lightbulb' class='w-8 h-8 text-gray-400' }}}
          </div>
           <h3 class="text-lg font-medium text-gray-900 mb-2">{{t 'reports-business-plan.no_ideas_title'}}</h3>
           <p class="text-gray-600 mb-6">{{t 'reports-business-plan.no_ideas_description'}}</p>
           <a href="/new-idea" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors inline-flex items-center space-x-2">
             {{{ icon 'plus' class='w-4 h-4' }}}
             <span>{{t 'reports-business-plan.create_first_idea'}}</span>
           </a>
        </div>
        {{/if}}
      </div>
    </div>

    <!-- Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'file-text' class='w-6 h-6 text-green-600' }}}
        </div>
         <h3 class="text-lg font-semibold text-gray-900 mb-2">{{t 'reports-business-plan.features_comprehensive'}}</h3>
         <p class="text-gray-600 text-sm">{{t 'reports-business-plan.features_comprehensive_desc'}}</p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'brain' class='w-6 h-6 text-blue-600' }}}
        </div>
         <h3 class="text-lg font-semibold text-gray-900 mb-2">{{t 'reports-business-plan.features_ai_powered'}}</h3>
         <p class="text-gray-600 text-sm">{{t 'reports-business-plan.features_ai_powered_desc'}}</p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 text-center">
        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          {{{ icon 'download' class='w-6 h-6 text-purple-600' }}}
        </div>
         <h3 class="text-lg font-semibold text-gray-900 mb-2">{{t 'reports-business-plan.features_professional'}}</h3>
         <p class="text-gray-600 text-sm">{{t 'reports-business-plan.features_professional_desc'}}</p>
      </div>
    </div>

  </div>
</div>

<script>
async function updateCreditBalance() {
  try {
    const response = await fetch('/api/credits/balance');
    if (response.ok) {
      const html = await response.text();
      const element = document.getElementById('nav-credit-balance');
      if (element) {
        element.innerHTML = html;
      }
    }
  } catch (error) {
    console.error('Failed to update credit balance:', error);
  }
}

function clearAlerts() {
  const alerts = document.querySelectorAll('.alert');
  alerts.forEach(alert => alert.remove());
}

function showLoading() {
  const loader = document.createElement('div');
  loader.id = 'loading-overlay';
  loader.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
  loader.innerHTML = '<div class="animate-spin rounded-full h-32 w-32 border-b-2 border-white"></div>';
  document.body.appendChild(loader);
}

function hideLoading() {
  const loader = document.getElementById('loading-overlay');
  if (loader) loader.remove();
}

// Handle HTMX response
document.addEventListener('htmx:afterRequest', function(event) {
  if (event.detail.target === document.body) {
    const response = event.detail.xhr.response;
    try {
      const data = JSON.parse(response);
      if (data.success && data.report && data.report.file_url) {
        window.location.href = data.report.file_url;
      } else if (data.error) {
        // Error already shown in alert
      }
    } catch (e) {
      // Not JSON, perhaps error alert
    }
  }
});
</script>