<main id="dashboard-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Dashboard Overview
          </h1>
          <p class="text-lg text-muted-foreground">
            Monitor progress and key metrics across all scales
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="btn btn-primary">

            {{{icon 'plus' class='' size='16'}}}

            New Project
          </button>
        </div>
       </div>

       <!-- Toast Examples -->
       <div class="grid w-full max-w-xl items-start gap-4">
         {{> toast type="default" icon="circle-check" title="Success! Your changes have been saved" description="This is an alert with icon, title and description."}}
         {{> toast type="default" icon="popcorn" title="This Alert has a title and an icon. No description."}}
         {{> toast type="destructive" icon="circle-alert" title="Unable to process your payment." description="Please verify your billing information and try again." listItems=(array "Check your card details" "Ensure sufficient funds" "Verify billing address")}}
       </div>

       <!-- Key Metrics Grid -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5 xl:grid-cols-5">
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">Total Ideas</h3>
               <p class="text-2xl font-semibold text-foreground">{{stats.ideas.total}}</p>
             </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'folder-open' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

            <span class="text-success">+2</span>
            Since last month
          </p>
        </div>
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">Completed Ideas</h3>
               <p class="text-2xl font-semibold text-foreground">{{stats.ideas.completed}}</p>
             </div>
            <div>
              <div class="bg-secondary/20 rounded-lg">
                <div class="w-10 h-10 bg-secondary/20 rounded-lg relative">
                  <div
                    class="flex items-center justify-center w-9 h-9 bg-secondary rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'lightbulb' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

            <span class="text-success">+8</span>
            Since last month
          </p>
        </div>
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">Credit Balance</h3>
               <p class="text-2xl font-semibold text-foreground">{{stats.credits.currentBalance}}</p>
             </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'users' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

            <span class="text-success">+3</span>
            Since last month
          </p>
        </div>
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">Completion Rate</h3>
               <p class="text-2xl font-semibold text-foreground">{{stats.ideas.completionRate}}%</p>
             </div>
            <div>
              <div class="bg-success/20 rounded-lg">
                <div class="w-10 h-10 bg-success/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'dollar-sign' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

            <span class="text-success">+25%</span>
            Since last month
          </p>
        </div>
         <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">Average Rating</h3>
               <p class="text-2xl font-semibold text-foreground">{{stats.ideas.averageRating}}★</p>
             </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">

                    {{{icon 'trending-up' class='w-4 h-4 text-{{color}}-foreground' size='16'}}}

                  </div>
                </div>
              </div>
            </div>
          </div>
<p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">

            {{{icon 'trending-up' class='w-5 h-4' size='16'}}}

            <span class="text-success">+15%</span>
            Since last month
          </p>
        </div>
      </div>

        <!-- Main Content Grid -->
         <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Recent Activity -->
          <div>
            <div class="bg-card rounded-lg border border-border p-6">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold text-foreground">Recent Activity</h2>
                <a href="/user-activity" class="btn btn-ghost text-sm">
                  View All
                  {{{icon 'arrow-right' class='' size='14'}}}
                </a>
              </div>
              <div class="space-y-4">
                {{#if stats.activity.length}}
                  {{#each stats.activity}}
                  <div class="flex items-start gap-3 p-3 rounded-lg bg-muted/30">
                    <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
                      {{#if (eq action_type "idea_created")}}
{{{icon 'lightbulb' class='w-4 h-4 text-primary'}}}
                      {{else if (eq action_type "vote_cast")}}
{{{icon 'star' class='w-4 h-4 text-yellow-500'}}}
                      {{else if (eq action_type "model_completed")}}
{{{icon 'check-circle' class='w-4 h-4 text-green-500'}}}
                      {{else}}
{{{icon 'book-open' class='w-4 h-4 text-blue-500'}}}
                      {{/if}}
                    </div>
                    <div class="flex-1">
                      <p class="text-sm text-foreground">
                        {{#if (eq action_type "idea_created")}}
                          Created a new idea
                        {{else if (eq action_type "vote_cast")}}
                          Cast a vote on an idea
                        {{else if (eq action_type "model_completed")}}
                          Completed a model section
                        {{else if (eq action_type "model_section_updated")}}
                          Updated model section
                        {{else if (eq action_type "package_selected")}}
                          Selected a package plan
                        {{else if (eq action_type "profile_completed")}}
                          Completed profile setup
                        {{else}}
                          {{action_type}}
                        {{/if}}
                      </p>
                      <p class="text-xs text-muted-foreground">{{formatDate created_at}}</p>
                    </div>
                  </div>
                  {{/each}}
                {{else}}
                  <div class="text-center py-8">
                    <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
{{{icon 'activity' class='text-muted-foreground' size='24'}}}
                    </div>
                    <h3 class="text-lg font-medium text-foreground mb-2">No activity yet</h3>
                    <p class="text-muted-foreground mb-4">Start creating ideas to see your activity here</p>
                    <a href="/new-idea" class="btn btn-primary">Create Your First Idea</a>
                  </div>
                {{/if}}
              </div>
            </div>
          </div>



          <!-- Credit Balance and Additional Sections -->
          <div class="space-y-6">
            <!-- Credit Balance -->
            <div class="bg-card rounded-lg border border-border p-6">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold text-foreground">Credit Balance</h2>
                <a href="/buy-credits" class="btn btn-ghost text-sm">
                  Buy Credits
                  {{{icon 'arrow-right' class='' size='14'}}}
                </a>
              </div>
              <div class="text-center">
                <div class="text-3xl font-bold text-primary mb-2">{{stats.credits.currentBalance}}</div>
                <p class="text-sm text-muted-foreground mb-4">Available Credits</p>
                <div class="grid grid-cols-2 gap-4 text-sm">
                  <div>
                    <span class="text-muted-foreground">Earned (30d)</span>
                    <div class="font-semibold text-green-600">+{{stats.credits.earned30d}}</div>
                  </div>
                  <div>
                    <span class="text-muted-foreground">Spent (30d)</span>
                    <div class="font-semibold text-red-600">-{{stats.credits.spent30d}}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Model Progress -->
          <div class="bg-card rounded-lg border border-border p-6">
            <h2 class="text-xl font-semibold text-foreground mb-4">Model Progress</h2>
            <div class="space-y-4">
              {{#each stats.models}}
                <div class="flex items-center justify-between">
                  <span class="text-sm font-medium text-foreground capitalize">{{@key}} Model</span>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">{{completed}}/{{total}}</span>
                    <div class="w-16 h-2 bg-muted rounded-full overflow-hidden">
                      <div class="h-full bg-primary rounded-full" style="width: {{#if (gt total 0)}}{{math (divide completed total) 100}}%{{else}}0%{{/if}}"></div>
                    </div>
                  </div>
                </div>
              {{/each}}
              {{#if (eq (len stats.models) 0)}}
                <p class="text-sm text-muted-foreground text-center py-4">No model progress yet</p>
              {{/if}}
            </div>

          </div>
            <!-- Quick Stats -->
            <div class="bg-card rounded-lg border border-border p-6">
              <h2 class="text-xl font-semibold text-foreground mb-4">Quick Stats</h2>
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted-foreground">Ideas Created</span>
                  <span class="text-sm font-medium text-foreground">{{stats.ideas.total}}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted-foreground">Votes Given</span>
                  <span class="text-sm font-medium text-foreground">{{stats.votes.totalGiven}}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted-foreground">Completion Rate</span>
                  <span class="text-sm font-medium text-foreground">{{stats.ideas.completionRate}}%</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted-foreground">Avg Rating</span>
                  <span class="text-sm font-medium text-foreground">{{stats.ideas.averageRating}}★</span>
                </div>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="bg-card rounded-lg border border-border p-6">
              <h2 class="text-xl font-semibold text-foreground mb-4">Quick Actions</h2>
              <div class="grid grid-cols-1 gap-3">
                <a href="/new-idea" class="btn btn-outline w-full justify-start">
                  {{{icon 'plus' class='' size='14'}}}
                  Create New Idea
                </a>
                <a href="/explore-ideas" class="btn btn-outline w-full justify-start">
                  {{{icon 'search' class='' size='14'}}}
                  Explore Ideas
                </a>

                {{#if (eq user.package_type 'enterprise')}}
                <a href="/portfolios" class="btn btn-outline w-full justify-start">
                  {{{icon 'archive' class='' size='14'}}}
                  Manage Portfolios
                </a>
                {{/if}}
                <a href="/settings" class="btn btn-outline w-full justify-start">
                  {{{icon 'settings' class='' size='14'}}}
                  Settings
                </a>
              </div>
            </div>
        </div>
      </div>

       <!-- Enterprise/Corporate Specific Sections -->
     </div>
   </div>
 </main>

<script>
    // Dashboard functionality with real-time updates
    document.addEventListener('DOMContentLoaded', () => {
      // Initialize real-time updates
      initializeRealtimeUpdates();

      // Initialize any dashboard-specific functionality
      initializeDashboardCharts();
    });

    function initializeRealtimeUpdates() {
      if (!window.Realtime) return;

      // Subscribe to credit updates
      window.Realtime.subscribe('credit_update', function(data) {
        updateCreditBalance(data.balance);
        updateCreditCharts(data);
      });

      // Subscribe to activity updates
      window.Realtime.subscribe('activity', function(data) {
        addRealtimeActivity(data);
      });

      // Subscribe to idea updates
      window.Realtime.subscribe('idea_update', function(data) {
        updateIdeaStats(data);
      });
    }

    function updateCreditBalance(balance) {
      const creditElements = document.querySelectorAll('.credit-balance, #current-balance');
      creditElements.forEach(el => {
        if (el.id === 'current-balance') {
          // Update the complex credit display
          el.innerHTML = `
            <h3 class="text-lg font-medium text-foreground mb-4">Current Balance</h3>
            <p class="text-2xl font-bold text-foreground">${balance} credits</p>
          `;
        } else {
          el.textContent = balance;
        }
      });
    }

    function updateCreditCharts(data) {
      // Update credit progress bars
      const progressElements = document.querySelectorAll('.credit-progress');
      progressElements.forEach(element => {
        const maxCredits = parseInt(element.getAttribute('data-max-credits')) || 1000;
        const percentage = Math.min((data.balance / maxCredits) * 100, 100);
        element.style.width = `${percentage}%`;
      });

      // Update earned/spent displays
      const earnedEl = document.querySelector('.credit-earned');
      const spentEl = document.querySelector('.credit-spent');

      if (earnedEl) earnedEl.textContent = `+${data.earned || 0}`;
      if (spentEl) spentEl.textContent = `-${Math.abs(data.spent || 0)}`;
    }

    function addRealtimeActivity(activity) {
      const activityFeed = document.querySelector('.activity-feed');
      if (!activityFeed) return;

      // Create new activity item
      const item = document.createElement('div');
      item.className = 'activity-item flex items-start gap-3 p-3 rounded-lg bg-base-100 border border-base-200';
      item.innerHTML = `
        <div class="activity-icon flex-shrink-0">
          ${getActivityIcon(activity.action_type)}
        </div>
        <div class="activity-content flex-1">
          <p class="text-sm text-foreground">${getActivityDescription(activity)}</p>
          <p class="text-xs text-muted-foreground">Just now</p>
        </div>
      `;

      // Add to top of feed
      activityFeed.insertBefore(item, activityFeed.firstChild);

      // Remove oldest item if too many
      while (activityFeed.children.length > 10) {
        activityFeed.removeChild(activityFeed.lastChild);
      }

      // Add highlight effect
      item.style.animation = 'highlight 2s ease-out';
    }

    function getActivityIcon(actionType) {
      const icons = {
        create: '<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>',
        update: '<svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>',
        delete: '<svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>',
        report_generated: '<svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
        credits_purchased: '<svg class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/></svg>',
      };

      return icons[actionType] || '<svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
    }

    function getActivityDescription(activity) {
      const descriptions = {
        idea_created: 'Created a new idea',
        vote_cast: 'Cast a vote on an idea',
        model_completed: 'Completed a model section',
        report_generated: 'Generated a report',
        credits_purchased: 'Purchased credits',
        package_upgraded: 'Upgraded package plan'
      };

      return descriptions[activity.action_type] || activity.action_type;
    }

    function updateIdeaStats(data) {
      // Update idea counts and completion rates
      if (data.validation_threshold_met !== undefined) {
        const validatedElements = document.querySelectorAll('.idea-validated-count');
        validatedElements.forEach(el => {
          const current = parseInt(el.textContent) || 0;
          el.textContent = data.validation_threshold_met ? current + 1 : Math.max(0, current - 1);
        });
      }
    }

    function initializeDashboardCharts() {
      // Initialize any chart libraries or custom chart rendering
      // This could be extended to use Chart.js, D3.js, or similar libraries

      // For now, just ensure progress bars are properly sized
      const progressBars = document.querySelectorAll('.progress-bar');
      progressBars.forEach(bar => {
        const width = bar.style.width;
        if (width) {
          bar.style.width = width; // Ensure it's applied
        }
      });
    }

    // Add CSS animation for activity highlights
    const style = document.createElement('style');
    style.textContent = `
      @keyframes highlight {
        0% { background-color: rgba(59, 130, 246, 0.1); }
        100% { background-color: transparent; }
      }
    `;
    document.head.appendChild(style);
  </script>