<div class="flex h-[calc(100vh-4rem)]">
  {{> sidebar projects=projects lng=lng}}
  <main class="flex-1 overflow-y-auto bg-background">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8">
      <div class="space-y-8">

        <!-- Header -->
        <div class="text-center sm:text-left">
          <h1 class="text-3xl font-bold text-foreground">{{t 'settings.settings.title'}}</h1>
          <p class="text-muted-foreground mt-2">{{t 'settings.settings.subtitle'}}</p>
         </div>

         <div id="alert-container" class="w-full max-w-md mx-auto"></div>

         <!-- Profile Settings -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">{{t 'settings.settings.profile'}}</h2>
             <form method="POST" action="/settings/profile" enctype="multipart/form-data" hx-post="/settings/profile" hx-target="body" hx-swap="beforeend" hx-on:htmx:before-request="clearAlerts(); showLoading()" hx-on:htmx:after-swap="hideLoading()" class="space-y-3 sm:space-y-4">
              <input type="hidden" name="_csrf" value="{{csrf}}"/>

              <!-- Avatar Section -->
              <div class="flex items-center space-x-4 mb-4">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-muted flex items-center justify-center overflow-hidden">
                  {{#if user.avatar_url}}
                    <img src="{{user.avatar_url}}" alt="Avatar" class="w-full h-full object-cover"/>
                  {{else}}
                    <svg class="w-8 h-8 sm:w-10 sm:h-10 text-muted-foreground" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  {{/if}}
                </div>
                <div class="flex-1">
                  <label for="avatar" class="block text-sm font-medium text-foreground mb-1">{{t 'settings.settings.change_avatar'}}</label>
                  <input type="file" id="avatar" name="avatar" accept="image/*" class="block w-full text-sm text-muted-foreground file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-primary file:text-primary-foreground hover:file:bg-primary/90"/>
                  <p class="text-xs text-muted-foreground mt-1">{{t 'settings.settings.max_5mb'}}</p>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                <div>
                  <label for="name" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.name'}}</label>
                  <input type="text" id="name" name="name" value="{{user.name}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.email'}}</label>
                  <input type="email" id="email" name="email" value="{{user.email}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
                <div>
                  <label for="role" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.role'}}</label>
                  <input type="text" id="role" name="role" value="{{user.role}}" placeholder="{{t 'settings.settings.role_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"/>
                </div>
                <div>
                  <label for="location" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.location'}}</label>
                  <input type="text" id="location" name="location" value="{{user.location}}" placeholder="e.g., New York, USA" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"/>
                </div>
              </div>
              <div>
                <label for="bio" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.bio'}}</label>
                <textarea id="bio" name="bio" rows="3" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">{{user.bio}}</textarea>
              </div>
              <button type="submit" class="bg-primary hover:bg-primary/90 text-primary-foreground px-4 py-2 sm:px-4 sm:py-2 rounded-md font-medium transition-colors text-sm sm:text-base">
                {{t 'settings.settings.save_changes'}}
              </button>
            </form>
          </div>
        </div>

        <!-- Password Settings -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">{{t 'settings.settings.password'}}</h2>
            <form method="POST" action="/settings/password" hx-post="/settings/password" hx-target="body" hx-swap="beforeend" hx-on:htmx:before-request="clearAlerts(); showLoading()" hx-on:htmx:after-swap="hideLoading()" class="space-y-3 sm:space-y-4">
              <input type="hidden" name="_csrf" value="{{csrf}}"/>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                <div>
                  <label for="currentPassword" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.current_password'}}</label>
                  <input type="password" id="currentPassword" name="currentPassword" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
                <div></div>
                <div>
                  <label for="newPassword" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.new_password'}}</label>
                  <input type="password" id="newPassword" name="newPassword" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
                <div>
                  <label for="confirmPassword" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.confirm_password'}}</label>
                  <input type="password" id="confirmPassword" name="confirmPassword" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
              </div>
              <button type="submit" class="bg-primary hover:bg-primary/90 text-primary-foreground px-4 py-2 sm:px-4 sm:py-2 rounded-md font-medium transition-colors text-sm sm:text-base">
                {{t 'settings.settings.update_password'}}
              </button>
            </form>
          </div>
        </div>

        <!-- Preferences -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">Preferences</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
              <!-- Theme Settings -->
              <div>
                <h3 class="text-base sm:text-lg font-medium text-foreground mb-2 sm:mb-3">{{t 'settings.settings.theme'}}</h3>
                <form method="POST" action="/settings/theme" hx-post="/settings/theme" hx-target="body" hx-swap="beforeend" hx-on:htmx:before-request="clearAlerts(); showLoading()" hx-on:htmx:after-swap="hideLoading()" class="space-y-4">
                  <input type="hidden" name="_csrf" value="{{csrf}}"/>
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-muted-foreground">{{t 'settings.settings.theme_mode'}}</span>
                     <button type="submit" id="theme-toggle" class="relative inline-flex h-6 w-11 items-center rounded-full bg-muted transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 {{#if (eq settings.theme 'dark')}}bg-primary{{/if}}">
                      <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform {{#if (eq settings.theme 'dark')}}translate-x-6{{/if}} translate-x-1"></span>
                    </button>
                  </div>
                  <input type="hidden" id="theme-input" name="theme" value="{{settings.theme}}"/>
                </form>
              </div>

              <!-- Language Settings -->
              <div>
                <h3 class="text-base sm:text-lg font-medium text-foreground mb-2 sm:mb-3">{{t 'settings.settings.language'}}</h3>
                <form method="POST" action="/settings/language" hx-post="/settings/language" hx-target="body" hx-swap="beforeend" hx-on:htmx:before-request="clearAlerts(); showLoading()" hx-on:htmx:after-swap="hideLoading()" class="space-y-4">
                  <input type="hidden" name="_csrf" value="{{csrf}}"/>
                  <div>
                    <label for="language" class="block text-sm font-medium text-foreground mb-2">{{t 'settings.settings.select_language'}}</label>
                    <select id="language" name="language" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                      <option value="en" {{#if (eq settings.language 'en')}}selected{{/if}}>English</option>
                      <option value="ar" {{#if (eq settings.language 'ar')}}selected{{/if}}>العربية</option>
                    </select>
                  </div>
                  <button type="submit" class="bg-primary hover:bg-primary/90 text-primary-foreground px-4 py-2 sm:px-4 sm:py-2 rounded-md font-medium transition-colors text-sm sm:text-base">
                    {{t 'settings.settings.save_language'}}
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <!-- Notification Preferences -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">Notification Preferences</h2>
            <form method="POST" action="/settings/notifications" class="space-y-6">
              <input type="hidden" name="_csrf" value="{{csrf}}"/>

              <!-- Email Notifications -->
              <div>
                <h3 class="text-base font-medium text-foreground mb-3">Email Notifications</h3>
                <div class="space-y-3">
                  <div class="flex items-center">
                    <input type="checkbox" id="email_project_updates" name="email_project_updates" {{#if notifications.notifications_email_project_updates}}checked{{/if}} class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded"/>
                    <label for="email_project_updates" class="ml-2 block text-sm text-foreground">
                      Project updates and progress notifications
                    </label>
                  </div>
                  <div class="flex items-center">
                    <input type="checkbox" id="email_billing" name="email_billing" {{#if notifications.notifications_email_billing}}checked{{/if}} class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded"/>
                    <label for="email_billing" class="ml-2 block text-sm text-foreground">
                      Billing and payment notifications
                    </label>
                  </div>
                  <div class="flex items-center">
                    <input type="checkbox" id="email_marketing" name="email_marketing" {{#if notifications.notifications_email_marketing}}checked{{/if}} class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded"/>
                    <label for="email_marketing" class="ml-2 block text-sm text-foreground">
                      Marketing and promotional emails
                    </label>
                  </div>
                </div>
              </div>

              <!-- Push Notifications -->
              <div>
                <h3 class="text-base font-medium text-foreground mb-3">Push Notifications</h3>
                <div class="space-y-3">
                  <div class="flex items-center">
                    <input type="checkbox" id="push_messages" name="push_messages" {{#if notifications.notifications_push_messages}}checked{{/if}} class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded"/>
                    <label for="push_messages" class="ml-2 block text-sm text-foreground">
                      Messages and notifications
                    </label>
                  </div>
                  <div class="flex items-center">
                    <input type="checkbox" id="push_reminders" name="push_reminders" {{#if notifications.notifications_push_reminders}}checked{{/if}} class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded"/>
                    <label for="push_reminders" class="ml-2 block text-sm text-foreground">
                      Reminders and deadlines
                    </label>
                  </div>
                </div>
              </div>

              <button type="submit" class="bg-primary hover:bg-primary/90 text-primary-foreground px-4 py-2 rounded-md font-medium transition-colors">
                Save Notification Preferences
              </button>
            </form>
          </div>
        </div>

        <!-- Billing & Packages -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">Billing & Packages</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
              <!-- Upgrade Package -->
              <div>
                <h3 class="text-base sm:text-lg font-medium text-foreground mb-2 sm:mb-3">Upgrade Package</h3>
                <div class="space-y-4">
                  <div>
                    <h4 class="text-sm font-medium text-foreground">Current Package</h4>
                    <p class="text-sm text-muted-foreground capitalize">{{#if user.package_type}}{{user.package_type}}{{else}}free{{/if}}</p>
                  </div>
                  <a href="/upgrade-package" class="w-full bg-primary hover:bg-primary/90 text-primary-foreground px-4 py-2 rounded-md text-sm font-medium transition-colors text-center block">
                    Upgrade Package
                  </a>
                </div>
              </div>

              <!-- Buy Credits -->
              <div>
                <h3 class="text-base sm:text-lg font-medium text-foreground mb-2 sm:mb-3">Buy Credits</h3>
                <div class="space-y-4">
                  <div>
                    <h4 class="text-sm font-medium text-foreground">Current Balance</h4>
                    <p class="text-sm text-muted-foreground">{{currentBalance}} credits</p>
                  </div>
                  <a href="/buy-credits" class="w-full bg-primary hover:bg-primary/90 text-primary-foreground px-4 py-2 rounded-md text-sm font-medium transition-colors text-center block">
                    Buy Credits
                  </a>
                </div>
              </div>

              <!-- Billing History -->
              <div>
                <h3 class="text-base sm:text-lg font-medium text-foreground mb-2 sm:mb-3">Billing History</h3>
                <div class="space-y-4">
                  <p class="text-sm text-muted-foreground">View past payments</p>
                  <a href="/billing-history" class="w-full bg-secondary hover:bg-secondary/90 text-secondary-foreground px-4 py-2 rounded-md text-sm font-medium transition-colors text-center block">
                    View History
                  </a>
                </div>
              </div>

              <!-- Payment Methods -->
              <div>
                <h3 class="text-base sm:text-lg font-medium text-foreground mb-2 sm:mb-3">Payment Methods</h3>
                <div class="space-y-4">
                  <p class="text-sm text-muted-foreground">Manage saved cards</p>
                  <a href="/payment-methods" class="w-full bg-secondary hover:bg-secondary/90 text-secondary-foreground px-4 py-2 rounded-md text-sm font-medium transition-colors text-center block">
                    Manage Cards
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Account Actions -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">{{t 'settings.settings.account'}}</h2>
            <div class="space-y-4">
              <div class="p-4 border border-destructive/20 rounded-lg">
                <div class="flex items-center justify-between mb-4">
                  <div>
                    <h3 class="text-sm font-medium text-destructive">{{t 'settings.settings.delete_account'}}</h3>
                    <p class="text-sm text-muted-foreground">{{t 'settings.settings.delete_account_desc'}}</p>
                  </div>
                </div>
                <form method="POST" action="/settings/delete" class="space-y-4">
                  <input type="hidden" name="_csrf" value="{{csrf}}"/>
                  <div>
                    <label for="confirm_delete" class="block text-sm font-medium text-foreground mb-2">Type "DELETE" to confirm</label>
                    <input type="text" id="confirm_delete" name="confirm_delete" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-destructive focus:border-transparent" placeholder="DELETE" required/>
                  </div>
                  <button type="submit" class="bg-destructive hover:bg-destructive/90 text-destructive-foreground px-4 py-2 sm:px-4 sm:py-2 rounded-md text-sm font-medium transition-colors">
                    {{t 'settings.settings.delete'}}
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
 </div>

   <!-- Loading Screen -->
   <div id="auth-loading-screen" class="fixed inset-0 bg-background flex items-center justify-center z-50 hidden">
     <div class="text-center">
       <svg class="animate-spin h-16 w-16 sm:h-20 sm:w-20 md:h-24 md:w-24 mx-auto" viewBox="0 0 24 24">
         <defs>
           <linearGradient id="spinner-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
             <stop offset="0%" stop-color="#9e28b5"/>
             <stop offset="25%" stop-color="#00a7e0"/>
             <stop offset="50%" stop-color="#6cd14d"/>
             <stop offset="75%" stop-color="#ffc600"/>
             <stop offset="100%" stop-color="#9e28b5"/>
           </linearGradient>
         </defs>
         <circle cx="12" cy="12" r="10" stroke="url(#spinner-gradient)" stroke-width="2" fill="none"/>
       </svg>
        <h2 class="text-xl font-semibold text-foreground mt-4 mb-2">{{t 'loading.settings_title'}}</h2>
        <p class="text-muted-foreground">{{t 'loading.settings_description'}}</p>
     </div>
   </div>

 <script>
 function clearAlerts() {
     const alerts = document.querySelectorAll('.alert');
     alerts.forEach(alert => alert.remove());
 }

 // Auto-hide alerts after 5 seconds
 function setupAlertAutoHide() {
     setTimeout(() => {
       const alerts = document.querySelectorAll('.alert-auto-hide');
       alerts.forEach(alert => alert.remove());
     }, 5000);
 }

   // Setup auto-hide for alerts added via HTMX
   document.addEventListener('htmx:afterSwap', (event) => {
     if (event.detail.target === document.body) {
       setupAlertAutoHide();
     }
   });

   function showLoading() {
     document.getElementById('auth-loading-screen').classList.remove('hidden');
   }

   function hideLoading() {
     document.getElementById('auth-loading-screen').classList.add('hidden');
   }
   // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const themeInput = document.getElementById('theme-input');

   themeToggle.addEventListener('click', function() {
     const isDark = themeInput.value === 'dark';
     const newTheme = isDark ? 'light' : 'dark';
     themeInput.value = newTheme;
     themeToggle.classList.toggle('bg-primary', !isDark);
     themeToggle.querySelector('span').classList.toggle('translate-x-6', !isDark);
     themeToggle.querySelector('span').classList.toggle('translate-x-1', isDark);

     // Update localStorage
     localStorage.setItem('theme', newTheme);
   });

  // Loading states for forms
  document.addEventListener('DOMContentLoaded', function() {
    const forms = document.querySelectorAll('form');
    forms.forEach(form => {
      form.addEventListener('submit', function(e) {
        // Validate avatar file
        const avatarInput = form.querySelector('input[name="avatar"]');
        if (avatarInput && avatarInput.files.length > 0) {
          const file = avatarInput.files[0];
          if (!file.type.startsWith('image/')) {
            alert('Please select a valid image file.');
            e.preventDefault();
            return;
          }
          if (file.size > 5 * 1024 * 1024) {
            alert('File size must be less than 5MB.');
            e.preventDefault();
            return;
          }
        }

        const submitButtons = form.querySelectorAll('button[type="submit"], input[type="submit"]');
        submitButtons.forEach(button => {
          button.disabled = true;
          button.textContent = 'Saving...';
          button.classList.add('opacity-50', 'cursor-not-allowed');
        });
      });
    });
  });
</script>