  <form action="/tasks" method="POST" id="taskForm">
      <input type="hidden" name="action" id="action" value="send">
      <input type="hidden" name="taskContent" value="{{taskContent}}">
      <input type="hidden" name="taskTimestamp" value="{{taskTimestamp}}">
      <input type="hidden" name="taskModel" value="{{taskModel}}">
      <textarea
          name="prompt"
          id="promptTextarea"
          class="textarea textarea-ghost w-full resize-none font-['Electrolize'] text-base-content text-2xl placeholder:text-base-content placeholder:text-2xl focus:ring-0 active:ring-0 focus:outline-none"
          placeholder="Enter your agent instructions here..."
      >{{currentPrompt}}</textarea>
      <div class="flex justify-between items-center mt-2">
          <div class="flex gap-2">
              <button
                  type="button"
                  onclick="setAction('improve')"
                  class="bg-primary/10 text-primary px-3 py-1 rounded-full flex items-center gap-1 text-xs hover:bg-primary/20 transition cursor-pointer"
              >
                  <i data-lucide="sparkles" class="w-3 h-3"></i>
                  Improve with AI
              </button>
              <button
                  type="button"
                  onclick="setAction('suggest')"
                  class="bg-secondary/10 text-secondary px-3 py-1 rounded-full flex items-center gap-1 text-xs hover:bg-secondary/20 transition cursor-pointer"
              >
                  <i data-lucide="lightbulb" class="w-3 h-3"></i>
                  AI Suggestion
              </button>
               <button
                   type="button"
                   onclick="resetPrompt()"
                   class="bg-error/10 text-error px-3 py-1 rounded-full flex items-center gap-1 text-xs hover:bg-error/20 transition cursor-pointer"
               >
                   <i data-lucide="rotate-ccw" class="w-3 h-3"></i>
                   Reset
               </button>
               <button
                   type="button"
                   id="pauseBtn"
                   onclick="pauseAgent()"
                   class="bg-warning/10 text-warning px-3 py-1 rounded-full flex items-center gap-1 text-xs hover:bg-warning/20 transition cursor-pointer"
                   style="display: none;"
               >
                   <i data-lucide="pause" class="w-3 h-3"></i>
                   Pause
               </button>
               <button
                   type="button"
                   id="resumeBtn"
                   onclick="resumeAgent()"
                   class="bg-info/10 text-info px-3 py-1 rounded-full flex items-center gap-1 text-xs hover:bg-info/20 transition cursor-pointer"
                   style="display: none;"
               >
                   <i data-lucide="play" class="w-3 h-3"></i>
                   Resume
               </button>
          </div>
          <button
              type="button"
              id="sendBtn"
              class="bg-success/10 text-success px-3 py-1 rounded-full flex items-center gap-1 text-xs hover:bg-success/20 transition cursor-pointer"
          >
              <i data-lucide="send" class="w-3 h-3"></i>
              Send
          </button>
       </div>
   </form>
   <script src="https://cdn.jsdelivr.net/npm/marked/lib/marked.umd.js"></script>
   <script>
       window.addEventListener('load', () => {
       let abortController = null;
       let currentFormData = null;

       function setAction(action) {
           document.getElementById('action').value = action;
           document.getElementById('taskForm').submit();
       }
       function resetPrompt() {
           document.getElementById('promptTextarea').value = '';
           if (window.agentService) agentService.send('RESET');
       }

       function pauseAgent() {
           if (abortController) {
               abortController.abort();
           }
           if (window.agentService) agentService.send('PAUSE');
       }

       function resumeAgent() {
           if (currentFormData) {
               startStreaming(currentFormData);
           }
           if (window.agentService) agentService.send('RESUME');
       }

                             async function startStreaming(formData) {
                                 abortController = new AbortController();
                                 const urlEncoded = new URLSearchParams(formData);
                                 const response = await fetch('/tasks', {
                                     method: 'POST',
                                     headers: {
                                         'Content-Type': 'application/x-www-form-urlencoded'
                                     },
                                     body: urlEncoded,
                                     signal: abortController.signal
                                 });
                                 const reader = response.body.getReader();
                                 let result = '';
                                 const contentDiv = document.getElementById('contentDiv');
                                 const currentResponseDiv = document.createElement('div');
                                 contentDiv.appendChild(currentResponseDiv);
                                 // Initialize with empty card
                                 if (window.taskTemplate) {
                                     const initialTaskHtml = window.taskTemplate({
                                         content: '',
                                         timestamp: '',
                                         model: ''
                                     });
                                     currentResponseDiv.innerHTML = initialTaskHtml;
                                 } else {
                                     console.error('taskTemplate not available');
                                 }
                                 const decoder = new TextDecoder();
                                 try {
                                     while (true) {
                                         const { done, value } = await reader.read();
                                         if (done) {
                                             if (window.agentService) agentService.send('COMPLETE');
                                             // Update with final content, timestamp, model
                                             if (window.taskTemplate) {
                                                 const timestamp = document.getElementById('taskTimestamp').value || new Date().toLocaleString();
                                                 const model = document.getElementById('taskModel').value || 'Unknown';
                                                 const finalMarkdown = result.replace(/<[^>]*>/g, '');
                                                 const finalTaskHtml = window.taskTemplate({
                                                     content: marked.parse(finalMarkdown),
                                                     timestamp: timestamp,
                                                     model: model
                                                 });
                                                 currentResponseDiv.innerHTML = finalTaskHtml;
                                             }
                                             break;
                                         }
                                         result += decoder.decode(value, { stream: true });
                                         const streamingContent = currentResponseDiv.querySelector('.streaming-content');
                                         if (streamingContent) {
                                             streamingContent.innerHTML = marked.parse(result.replace(/<[^>]*>/g, ''));
                                         }
                                     }
                                 } catch (error) {
                                     if (error.name === 'AbortError') {
                                         console.log('Stream aborted');
                                         if (window.agentService) agentService.send('PAUSE');
                                     } else {
                                         throw error;
                                     }
                                 }
                             }

       // Subscribe to state changes
       if (window.agentService) {
           agentService.subscribe((state) => {
               updateUI(state);
           });
       } else {
           console.error('agentService not available');
       }

       document.getElementById('promptTextarea').addEventListener('keydown', function(e) {
           if (e.key === 'Enter' && !e.shiftKey) {
               e.preventDefault();
               document.getElementById('sendBtn').click();
           }
       });

       document.getElementById('sendBtn').addEventListener('click', async (e) => {
            e.preventDefault();
            const form = document.getElementById('taskForm');
            const formData = new FormData(form);
            formData.set('action', 'send');
            currentFormData = formData;
            if (window.agentService) agentService.send('START');
            await startStreaming(formData);
        });

                             function updateUI(state) {
                                 const { value } = state;
                      
                                 // Update agent status elements if they exist
                                 const statusBadge = document.getElementById('agent-status-badge');
                                 if (statusBadge) {
                                     statusBadge.className = `badge ${getBadgeClass(value)}`;
                                     statusBadge.textContent = getBadgeText(value);
                                 }
                      
                                 const progressBar = document.getElementById('agent-progress');
                                 if (progressBar) {
                                     progressBar.value = getProgressForState(value);
                                 }
                      
                                 const progressText = document.querySelector('.badge-xs');
                                 if (progressText && progressText.textContent.includes('% Complete')) {
                                     progressText.textContent = `${getProgressForState(value)}% Complete`;
                                 }
                      
                                 const messageEl = document.getElementById('agent-message');
                                 if (messageEl) {
                                     messageEl.textContent = getMessageForState(value);
                                 }
                      
                                 // Update checkboxes for task steps
                                 const checkboxes = document.querySelectorAll('.checkbox');
                                 checkboxes.forEach((cb, index) => {
                                     if (value === 'before_start') {
                                         cb.checked = index < 2; // Planning and Design checked
                                     } else if (value === 'working') {
                                         cb.checked = index < 3; // Add Implementation
                                     } else if (value === 'completed') {
                                         cb.checked = true; // All checked
                                     } else {
                                         cb.checked = index < 2; // Default
                                     }
                                 });
                      
                                 // Show/hide buttons
                                 const pauseBtn = document.getElementById('pauseBtn');
                                 const resumeBtn = document.getElementById('resumeBtn');
                                 if (pauseBtn) pauseBtn.style.display = value === 'working' ? 'block' : 'none';
                                 if (resumeBtn) resumeBtn.style.display = value === 'pause' ? 'block' : 'none';
                      
                                 // Enable/disable input
                                 const textarea = document.getElementById('promptTextarea');
                                 if (textarea) textarea.disabled = value === 'working';
                             }

       function getProgressForState(state) {
           const progresses = {
               before_start: 0,
               working: 25,
               pause: 25, // maintain
               completed: 100,
               resume: 50
           };
           return progresses[state] || 0;
       }

       function getMessageForState(state) {
           const messages = {
               before_start: 'Agent is idle. Enter a prompt to begin.',
               working: 'Agent is processing your request...',
               pause: 'Agent paused. Click resume to continue.',
               completed: 'Task completed successfully.',
               resume: 'Resuming agent processing...'
           };
           return messages[state] || 'Unknown state';
       }

       function getBadgeClass(state) {
           const classes = {
               before_start: 'badge-neutral',
               working: 'badge-primary animate-pulse',
               pause: 'badge-warning',
               completed: 'badge-success',
               resume: 'badge-info'
           };
           return classes[state] || 'badge-neutral';
       }

       function getBadgeText(state) {
           const texts = {
               before_start: 'Ready',
               working: 'Working',
               pause: 'Paused',
               completed: 'Completed',
               resume: 'Resuming'
           };
           return texts[state] || 'Unknown';
       }
       });
   </script>