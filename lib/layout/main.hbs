<!DOCTYPE html>
<html lang="{{lng}}" dir="{{#if (eq lng 'ar')}}rtl{{else}}ltr{{/if}}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="icon" href="/images/favicon.svg">
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&amp;amp;family=Newsreader:ital,opsz,wght@1,6..72,300;1,6..72,400&amp;amp;display=swap"
        rel="stylesheet" />
    <!-- Iconify -->
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <link rel="stylesheet" href="/css/output.css">
    <style>



        .htmx-request {
            opacity: 0.8;
        }

        .htmx-request .loading {
            display: inline;
        }

        .loading {
            display: none;
        }

        .htmx-settling {
            opacity: 1;
        }
    </style>
    {{#if styles}}{{styles}}{{/if}}
</head>

<body class="{{bodyClass}} bg-base-100 min-h-screen">
    {{> nav}}

    <main class="main-content">
        {{{body}}}
    </main>

    <div id="toast-container"
        style="position: fixed; top: 5rem; right: 27rem; z-index: 9999; width: 400px; height: auto; pointer-events: none;">
    </div>

    {{#if scripts}}{{scripts}}{{/if}}

    <script src="/js/toast.js"></script>
     <script>
         // Enhanced toast system is now loaded

         // Global function for populating new-idea form from existing ideas
         window.redirectToPopulate = function (ideaId) {
             window.location.href = `/new-idea?populate=${ideaId}`;
         };

         // Toggle function for card details
         function toggleCardDetails(card) {
             const details = card.querySelector('.card-details');
             if (details) {
                 details.style.display = details.style.display === 'none' ? 'block' : 'none';
             }
         }

         // Event delegation for populate buttons
         document.addEventListener('click', function(e) {
             const button = e.target.closest('[data-populate-id]');
             if (button) {
                 e.preventDefault();
                 const id = button.dataset.populateId;
                 redirectToPopulate(id);
             }
         });
      </script>

    <script>
      function toggleTheme() {
        const html = document.documentElement;
        html.classList.toggle('dark');
        const isDark = html.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateThemeToggle(isDark);
      }

      function updateThemeToggle(isDark) {
        const lightIcon = document.getElementById('theme-icon-light');
        const darkIcon = document.getElementById('theme-icon-dark');
        if (lightIcon && darkIcon) {
          if (isDark) {
            lightIcon.classList.add('hidden');
            darkIcon.classList.remove('hidden');
          } else {
            darkIcon.classList.add('hidden');
            lightIcon.classList.remove('hidden');
          }
        }
      }

      function normalizeLanguage(lang) {
        if (!lang) return 'en';
        const normalized = lang.toLowerCase().split('-')[0]; // Get primary language code
        return ['en', 'ar'].includes(normalized) ? normalized : 'en';
      }

      async function switchLanguage() {
        const currentLang = normalizeLanguage(localStorage.getItem('language') || 'en');
        const newLang = currentLang === 'en' ? 'ar' : 'en';
        localStorage.setItem('language', newLang);
        updateLangSwitcher(newLang);

        // Sync language preference with server if user is authenticated
        try {
          const response = await fetch('/api/set-language', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ language: newLang }),
          });

          if (response.ok) {
            console.log('Language preference synced with server');
          } else {
            console.warn('Failed to sync language with server');
          }
        } catch (error) {
          console.error('Error syncing language with server:', error);
        }

        // Reload the page with language query param to ensure it's applied
        window.location.href = `${window.location.pathname}?lng=${newLang}`;
      }

      function updateLangSwitcher(lang) {
        const textSpan = document.getElementById('lang-text');
        if (textSpan) {
          textSpan.textContent = lang.toUpperCase();
        }
      }

      // Initialize language display on page load
      document.addEventListener('DOMContentLoaded', function() {
        const serverLang = normalizeLanguage('{{lng}}');
        localStorage.setItem('language', serverLang);
        updateLangSwitcher(serverLang);
      });

      function toggleGridMenu() {
        const dropdown = document.getElementById('grid-dropdown');
        if (dropdown) {
          const isVisible = !dropdown.classList.contains('hidden');
          if (isVisible) {
            dropdown.classList.add('hidden');
            dropdown.classList.add('invisible');
            dropdown.classList.add('opacity-0');
          } else {
            dropdown.classList.remove('hidden');
            dropdown.classList.remove('invisible');
            dropdown.classList.remove('opacity-0');
          }
        }
      }

      function toggleUserMenu() {
        const dropdown = document.getElementById('admin-user-dropdown');
        if (dropdown) {
          const isVisible = !dropdown.classList.contains('hidden');
          if (isVisible) {
            dropdown.classList.add('hidden');
            dropdown.classList.add('invisible');
            dropdown.classList.add('opacity-0');
          } else {
            dropdown.classList.remove('hidden');
            dropdown.classList.remove('invisible');
            dropdown.classList.remove('opacity-0');
          }
        }
      }

      function toggleNotificationMenu() {
        const dropdown = document.getElementById('notification-dropdown');
        if (dropdown) {
          const isVisible = !dropdown.classList.contains('hidden');
          if (isVisible) {
            dropdown.classList.add('hidden');
            dropdown.classList.add('invisible');
            dropdown.classList.add('opacity-0');
          } else {
            dropdown.classList.remove('hidden');
            dropdown.classList.remove('invisible');
            dropdown.classList.remove('opacity-0');
          }
        }
      }

      async function markAsRead(notificationId) {
        try {
          const response = await fetch(`/api/notifications/${notificationId}/read`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
            },
          });
          if (response.ok) {
            // Refresh the dropdown
            htmx.trigger('#notification-dropdown', 'revealed');
          } else {
            showToast('Failed to mark as read', 'error');
          }
        } catch (error) {
          console.error('Mark as read error:', error);
          showToast('Failed to mark as read', 'error');
        }
      }
      </script>

    {{#if flash.success}}
    {{#each flash.success}}
    <script>showToast({{{ json this}}}, 'success');</script>
    {{/each}}
    {{/if}}
    {{#if flash.error}}
    {{#each flash.error}}
    <script>showToast({{{ json this}}}, 'error');</script>
    {{/each}}
    {{/if}}
    {{#if flash.info}}
    {{#each flash.info}}
    <script>showToast({{{ json this}}}, 'info');</script>
    {{/each}}
    {{/if}}
    {{#if flash.warning}}
    {{#each flash.warning}}
    <script>showToast({{{ json this}}}, 'warning');</script>
    {{/each}}
    {{/if}}
</body>

</html>