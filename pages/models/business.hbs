{{> progress-bar activeStep=activeStep ideaId=ideaId}}

{{> model-header title=pageTitle description="Comprehensive business development and validation overview"
ratingStars="★★★★★" ratingValue="5.0" voteCount="0 votes" category=ideaCategory tags=ideaTags}}

{{> model-progress data='[
  {
    "id": "product-section",
    "fullLabel": "1. Product Section",
