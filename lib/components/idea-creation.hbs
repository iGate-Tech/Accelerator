        // Reset form
        const resetFormBtn = form.querySelector('[aria-label="Reset form"]');
        if (resetFormBtn) {
            resetFormBtn.addEventListener('click', function (e) {
                descriptionTextarea.value = '';
                descriptionTextarea.dataset.originalContent = '';
                const displayDiv = document.getElementById('assistant-prompt-display');
                displayDiv.innerHTML = '';
                displayDiv.style.display = 'none';
                descriptionTextarea.style.display = 'block';
                updateCharCounter();
                showToastMessage('Form reset successfully', 'info');
            });
        }

        // Auto fill with AI
        const autoFillBtn = document.querySelector('[aria-label="Auto fill with AI"]');
        if (autoFillBtn) {
            autoFillBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const currentDescription = descriptionTextarea.value.trim();
                if (!currentDescription) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                setButtonLoading(autoFillBtn, true);
                try {
                    showToastMessage('Auto filling with AI...', 'info');
                    const result = await callAIApi('auto-fill', { description: currentDescription });
                    if (result.error) {
                        showToastMessage('AI error: ' + result.error, 'error');
                    } else {
                        const currentTitle = titleSpan.textContent.trim();
                        const currentCategory = categorySpan.textContent.trim();
                        const currentTags = Array.from(document.querySelectorAll('.tag-lskjsdb span[contenteditable]')).map(span => span.textContent.trim()).filter(tag => tag);

                        let filledCount = 0;

                        // Fill title if missing or default
                        if (!currentTitle || currentTitle === 'Untitled') {
                            titleSpan.innerHTML = result.title || '';
                            filledCount++;
                        }

                        // Fill category if missing or default
                        if (!currentCategory || currentCategory === 'Category') {
                            categorySpan.innerHTML = result.category || '';
                            filledCount++;
                        }

                        // Fill description if too small or missing
                        if (!currentDescription || currentDescription.length < 100) {
        const randomIdeaBtn = document.querySelector('[aria-label="Generate random idea"]');

        waitForMarked(() => {
                                descriptionTextarea.dataset.originalContent = result.description || '';
                                descriptionTextarea.value = result.description || '';
                                const displayDivFill = document.getElementById('assistant-prompt-display');
                                const processedContent = (result.description || '').replace(/\n/g, '\n\n');
                                displayDivFill.innerHTML = marked.parse(processedContent, { breaks: true });
                                displayDivFill.style.display = 'block';
                                descriptionTextarea.style.display = 'none';
                            });
                            updateCharCounter();
                            filledCount++;
                        }

                        // Fill tags if none exist
                        if (currentTags.length === 0) {
                            if (result.tags && result.tags.length > 0) {
                                addTagsFromArray(result.tags);
                                filledCount++;
                            } else {
                                // If auto-fill didn't provide tags, try add-tags API
                                try {
                                    const tagsResult = await callAIApi('add-tags', { description: currentDescription });
                                    if (tagsResult.tags && tagsResult.tags.length > 0) {
                                        addTagsFromArray(tagsResult.tags);
                                        filledCount++;
                                        showToastMessage('10 credits deducted for additional AI usage', 'warning');
                                    }
                                } catch (tagsError) {
                                    console.error('Add tags error:', tagsError);
                                }
                            }
                        }

                        if (filledCount > 0) {
                            showToastMessage('Form auto filled successfully', 'success');
                            showToastMessage('10 credits deducted for AI usage', 'warning');
                            if (typeof window.loadNavCreditBalance === 'function') {
                                window.loadNavCreditBalance();
                            }
                        } else {
                            showToastMessage('All fields are already complete', 'info');
                        }
                    }
                } catch (error) {
                    console.error('Auto fill error:', error);
                    showToastMessage('Network error. Please try again.', 'error');
                } finally {
                    setButtonLoading(autoFillBtn, false);
                }
