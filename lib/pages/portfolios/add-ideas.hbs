<main id="add-ideas-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <!-- Header Section -->
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center">
              {{{icon 'folder-plus' class='w-6 h-6 text-primary' size='24'}}}
            </div>
            <div>
              <h1 class="font-heading text-3xl font-semibold text-foreground">
                Add Ideas to {{portfolio.name}}
              </h1>
              <p class="text-lg text-muted-foreground">
                Select ideas to add to this portfolio
              </p>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <a href="/portfolios/{{portfolio.id}}" class="btn btn-outline">
            {{{icon 'arrow-left' class='w-4 h-4 mr-2' size='16'}}}
            Back to Portfolio
          </a>
        </div>
      </div>

      <!-- Available Ideas -->
      <div class="bg-card rounded-lg border border-border p-6">
         {{#if hasIdeas}}
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-foreground mb-2">Available Ideas</h2>
          <p class="text-muted-foreground">Select the ideas you want to add to this portfolio</p>
        </div>

         <form id="add-ideas-form" onsubmit="addIdeasToPortfolio(event)">
           <!-- Search -->
           <div class="mb-4">
             <div class="relative max-w-md">
               <div class="relative">
{{{icon 'search' class='absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground' size='16'}}}
                 <input type="text" id="idea-search" placeholder="Search ideas..." class="input w-full pl-10 pr-10" oninput="filterIdeas()">
                 <button type="button" id="idea-search-clear" class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground hover:text-foreground opacity-0 transition-opacity duration-200" onclick="clearIdeaSearch()" style="display: none;">
{{{icon 'x' class='w-4 h-4' size='16'}}}
                 </button>
               </div>
             </div>
           </div>

           <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6" id="ideas-grid">
            {{#each availableIdeas}}
            <div class="bg-muted/30 rounded-lg p-4 border border-border hover:bg-muted/50 transition-colors">
              <div class="flex items-start gap-3 mb-3">
                <input type="checkbox" id="idea-{{id}}" name="ideaIds" value="{{id}}" class="checkbox checkbox-primary mt-1">
                <div class="flex-1">
                  <label for="idea-{{id}}" class="cursor-pointer">
                    <h3 class="font-medium text-foreground mb-1 line-clamp-2">{{title}}</h3>
                    <p class="text-sm text-muted-foreground">{{category}}</p>
                  </label>
                </div>
              </div>

              <div class="space-y-2 ml-8">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-muted-foreground">Completion</span>
                  <span class="text-foreground font-medium">{{completion_percentage}}%</span>
                </div>
                <div class="w-full bg-muted rounded-full h-2">
                  <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: {{completion_percentage}}%"></div>
                </div>

                <div class="flex items-center justify-between text-sm">
                  <span class="text-muted-foreground">Status</span>
                  <span class="px-2 py-1 rounded-full text-xs font-medium
                    {{#eq overall_status "completed"}}bg-success/20 text-success
                    {{else if (eq overall_status "in_progress")}}bg-warning/20 text-warning
                    {{else}}bg-muted text-muted-foreground{{/eq}}">{{overall_status}}</span>
                </div>

                {{#if rating}}
                <div class="flex items-center justify-between text-sm">
                  <span class="text-muted-foreground">Rating</span>
                  <div class="flex items-center gap-1">
                    <span class="text-foreground font-medium">{{rating}}</span>
{{{icon 'star' class='w-3 h-3 fill-yellow text-yellow' size='12'}}}
                  </div>
                </div>
                {{/if}}

                <div class="flex items-center justify-between text-sm">
                  <span class="text-muted-foreground">Created</span>
                  <span class="text-foreground">{{created_at_formatted}}</span>
                </div>
              </div>
            </div>
            {{/each}}
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-border">
            <div class="text-sm text-muted-foreground">
              <span id="selected-count">0</span> ideas selected
            </div>
            <div class="flex gap-3">
              <a href="/portfolios/{{portfolio.id}}" class="btn btn-outline">Cancel</a>
              <button type="submit" class="btn btn-primary" id="add-ideas-btn" disabled>
                Add Selected Ideas
              </button>
            </div>
          </div>
        </form>
        {{else}}
        <!-- Empty State -->
        <div class="text-center py-12">
          <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
{{{icon 'lightbulb-off' class='text-muted-foreground' size='24'}}}
          </div>
          <h3 class="text-lg font-medium text-foreground mb-2">No available ideas</h3>
          <p class="text-muted-foreground mb-6">All your ideas are already in this portfolio, or you haven't created any ideas yet.</p>
          <div class="flex gap-3 justify-center">
            <a href="/new-idea" class="btn btn-primary">
              {{{icon 'plus' class='w-4 h-4 mr-2' size='16'}}}
              Create New Idea
            </a>
            <a href="/portfolios/{{portfolio.id}}" class="btn btn-outline">Back to Portfolio</a>
          </div>
        </div>
        {{/if}}
      </div>

    </div>
  </div>
</main>

<script>
  const portfolioId = '{{portfolio.id}}';

  // Update selected count and button state
  function updateSelection() {
    const checkboxes = document.querySelectorAll('input[name="ideaIds"]:checked');
    const selectedCount = checkboxes.length;
    const addButton = document.getElementById('add-ideas-btn');
    const countDisplay = document.getElementById('selected-count');

    countDisplay.textContent = selectedCount;
    addButton.disabled = selectedCount === 0;
  }

  // Listen for checkbox changes
  document.addEventListener('change', function(e) {
    if (e.target.name === 'ideaIds') {
      updateSelection();
    }
  });

  // Add ideas to portfolio
  async function addIdeasToPortfolio(event) {
    event.preventDefault();

    const formData = new FormData(event.target);
    const selectedIdeas = formData.getAll('ideaIds');

    if (selectedIdeas.length === 0) {
      showToast({ message: 'Please select at least one idea' }, 'warning');
      return;
    }

    const addButton = document.getElementById('add-ideas-btn');
    const originalText = addButton.textContent;
    addButton.disabled = true;
    addButton.textContent = 'Adding...';

    try {
      let successCount = 0;
      let errorCount = 0;

      // Add each idea to portfolio
      for (const ideaId of selectedIdeas) {
        try {
          const formData = new FormData();
          formData.append('ideaId', ideaId);

          const response = await fetch(`/portfolios/${portfolioId}/ideas`, {
            method: 'POST',
            body: formData
          });

          if (response.ok) {
            successCount++;
          } else {
            errorCount++;
            console.error(`Failed to add idea ${ideaId}`);
          }
        } catch (error) {
          errorCount++;
          console.error(`Error adding idea ${ideaId}:`, error);
        }
      }

      if (successCount > 0) {
        showToast({
          message: `Successfully added ${successCount} idea${successCount > 1 ? 's' : ''} to portfolio!`
        }, 'success');

        // Redirect back to portfolio after a short delay
        setTimeout(() => {
          window.location.href = `/portfolios/${portfolioId}`;
        }, 1500);
      }

      if (errorCount > 0) {
        showToast({
          message: `Failed to add ${errorCount} idea${errorCount > 1 ? 's' : ''}. Please try again.`
        }, 'error');
      }

    } catch (error) {
      console.error('Error adding ideas to portfolio:', error);
      showToast({ message: 'Failed to add ideas to portfolio' }, 'error');
    } finally {
      addButton.disabled = false;
      addButton.textContent = originalText;
    }
  }

   // Filter ideas
   let allIdeas = {{{json availableIdeas}}};

   function filterIdeas() {
     const searchTerm = document.getElementById('idea-search').value.toLowerCase();
     const filteredIdeas = allIdeas.filter(idea =>
       idea.title.toLowerCase().includes(searchTerm) ||
       (idea.category && idea.category.toLowerCase().includes(searchTerm))
     );
     renderIdeas(filteredIdeas);

     // Show/hide clear button
     const clearButton = document.getElementById('idea-search-clear');
     if (searchTerm.length > 0) {
       clearButton.style.display = 'block';
       setTimeout(() => clearButton.classList.remove('opacity-0'), 10);
     } else {
       clearButton.classList.add('opacity-0');
       setTimeout(() => clearButton.style.display = 'none', 200);
     }
   }

   function clearIdeaSearch() {
     const searchInput = document.getElementById('idea-search');
     searchInput.value = '';
     filterIdeas();
     searchInput.focus();
   }

   function renderIdeas(ideas) {
     const grid = document.getElementById('ideas-grid');
     if (ideas.length === 0) {
       grid.innerHTML = `
         <div class="col-span-full text-center py-8">
           <p class="text-muted-foreground">No ideas match your search.</p>
         </div>
       `;
       return;
     }

     grid.innerHTML = ideas.map(idea => `
       <div class="bg-muted/30 rounded-lg p-4 border border-border hover:bg-muted/50 transition-colors">
         <div class="flex items-start gap-3 mb-3">
           <input type="checkbox" id="idea-${idea.id}" name="ideaIds" value="${idea.id}" class="checkbox checkbox-primary mt-1">
           <div class="flex-1">
             <label for="idea-${idea.id}" class="cursor-pointer">
               <h3 class="font-medium text-foreground mb-1 line-clamp-2">${idea.title}</h3>
               <p class="text-sm text-muted-foreground">${idea.category || ''}</p>
             </label>
           </div>
         </div>

         <div class="space-y-2 ml-8">
           <div class="flex items-center justify-between text-sm">
             <span class="text-muted-foreground">Completion</span>
             <span class="text-foreground font-medium">${idea.completion_percentage}%</span>
           </div>
           <div class="w-full bg-muted rounded-full h-2">
             <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: ${idea.completion_percentage}%"></div>
           </div>

           <div class="flex items-center justify-between text-sm">
             <span class="text-muted-foreground">Status</span>
             <span class="px-2 py-1 rounded-full text-xs font-medium
               ${idea.overall_status === 'completed' ? 'bg-success/20 text-success' :
                 idea.overall_status === 'in_progress' ? 'bg-warning/20 text-warning' :
                 'bg-muted text-muted-foreground'}">${idea.overall_status}</span>
           </div>

           ${idea.rating ? `
           <div class="flex items-center justify-between text-sm">
             <span class="text-muted-foreground">Rating</span>
             <div class="flex items-center gap-1">
               <span class="text-foreground font-medium">${idea.rating}</span>
{{{icon 'star' class='w-3 h-3 fill-yellow text-yellow' size='12'}}}
             </div>
           </div>
           ` : ''}

           <div class="flex items-center justify-between text-sm">
             <span class="text-muted-foreground">Created</span>
             <span class="text-foreground">${new Date(idea.created_at).toLocaleDateString()}</span>
           </div>
         </div>
       </div>
     `).join('');
     updateSelection();
   }

   // Initialize
   document.addEventListener('DOMContentLoaded', function() {
     renderIdeas(allIdeas);
   });
</script>