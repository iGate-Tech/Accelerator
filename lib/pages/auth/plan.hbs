<div class="min-h-screen bg-base-100">
   <div class="relative overflow-hidden">
     <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
       <!-- Header -->
        <div class="text-center mb-8 sm:mb-12">
           <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4 sm:mb-6">
             {{t 'onboarding.package.title'}}
           </h1>
           <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
             {{t 'onboarding.package.subtitle'}}
           </p>
       </div>

        {{> onboarding-progress activeStep="package"}}

        <div id="alert-container" class="w-full max-w-md mx-auto mb-4"></div>

        <!-- Billing Toggle -->
       <div class="flex justify-center mb-6">
         <div class="bg-muted rounded-lg p-1 flex items-center">
           <button id="monthly-btn" class="px-4 py-2 rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground">Monthly</button>
           <button id="yearly-btn" class="px-4 py-2 rounded-md text-sm font-medium transition-colors text-muted-foreground hover:text-foreground">Yearly</button>
         </div>
       </div>

        <!-- Onboarding Message -->
        <div class="bg-gradient-to-r from-primary/5 to-secondary/5 border border-primary/10 rounded-lg sm:rounded-xl p-4 sm:p-6 mb-6 sm:mb-8 lg:mb-10">
          <div class="flex items-start">
            <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-primary/10 rounded-lg sm:rounded-xl flex items-center justify-center mr-3 sm:mr-4 lg:mr-5 flex-shrink-0">
              {{{icon 'rocket' class="w-3 h-3 sm:w-4 sm:h-4 lg:w-5 lg:h-5 text-primary"}}}
            </div>
                  <div>
                    <h3 class="text-sm sm:text-base lg:text-lg font-semibold text-foreground mb-2">{{t 'onboarding.package.welcome_title'}}! 🚀</h3>
                    <p class="text-xs sm:text-sm lg:text-base text-muted-foreground leading-relaxed">
                     {{t 'onboarding.package.welcome_message'}}
                    </p>
                 </div>
          </div>
       </div>



       <!-- Package Plans -->
         <form method="POST" action="/onboarding/plan" hx-post="/onboarding/plan" hx-target="body" hx-swap="beforeend" hx-on:htmx:before-request="clearAlerts(); showLoading()" hx-on:htmx:after-swap="hideLoading()"
          <input type="hidden" name="_csrf" value="{{csrf}}"/>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
            {{#each packages}}
            <label class="bg-card rounded-xl border border-border shadow-sm hover:shadow-md transition-shadow duration-200 cursor-pointer">
              <input type="radio" name="package_type" value="{{type}}" class="sr-only peer" required/>
              <div class="p-4 sm:p-6 lg:p-8 peer-checked:border-primary peer-checked:bg-primary/5">
                <div class="text-center mb-6">
                   <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-foreground mb-3">{{name}}</h3>
                  <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary mb-1 price-display" data-monthly-price="{{price_monthly}}" data-yearly-price="{{price_yearly}}">${{price_monthly}}</div>
                   <div class="text-sm text-muted-foreground mb-2 billing-period">per month</div>
                  <div class="text-xs sm:text-sm text-muted-foreground credits-included" data-monthly-credits="{{credits_monthly}}" data-yearly-credits="{{credits_yearly}}">{{credits_monthly}} credits included</div>
                </div>

                <div class="space-y-3 mb-6">
                  <div class="flex items-center space-x-3">
                    <div class="w-5 h-5 sm:w-6 sm:h-6 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                      {{{icon 'check' class="w-3 h-3 sm:w-4 sm:h-4 text-green-600 dark:text-green-400"}}}
                    </div>
                     <span class="text-xs sm:text-sm text-foreground">{{t 'buy-credits.instant_delivery'}}</span>
                  </div>

                  <div class="flex items-center space-x-3">
                    <div class="w-5 h-5 sm:w-6 sm:h-6 bg-blue-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                      {{{icon 'clock' class="w-3 h-3 sm:w-4 sm:h-4 text-blue-600 dark:text-blue-400"}}}
                    </div>
                    <span class="text-xs sm:text-sm text-foreground">{{t 'buy-credits.no_expiration'}}</span>
                  </div>

                  <div class="flex items-center space-x-3">
                    <div class="w-5 h-5 sm:w-6 sm:h-6 bg-amber-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                      {{{icon 'lightbulb' class="w-3 h-3 sm:w-4 sm:h-4 text-amber-600 dark:text-amber-400"}}}
                    </div>
                    <span class="text-xs sm:text-sm text-foreground">{{t 'landing.features.ai_powered_features'}}</span>
                  </div>
                </div>

                <div class="text-center">
                  <div class="w-full bg-primary/10 text-primary font-semibold py-3 px-4 sm:px-6 rounded-lg text-sm sm:text-base peer-checked:bg-primary peer-checked:text-primary-foreground">
                     <span class="flex items-center justify-center space-x-2">
                       <span>{{t 'onboarding.package.select_plan'}} {{name}}</span>
                       {{{icon 'arrow-right' class="w-4 h-4 sm:w-5 sm:h-5"}}}
                     </span>
                  </div>
                </div>
              </div>
            </label>
            {{/each}}
          </div>


        </form>

         <!-- Footer -->
         <div class="text-center mt-8 sm:mt-12">
           <p class="text-sm text-muted-foreground">{{t 'onboarding.package.footer'}}</p>
         </div>
       </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const packageRadios = document.querySelectorAll('input[name="package_type"]');
        const form = document.querySelector('form');
        const monthlyBtn = document.getElementById('monthly-btn');
        const yearlyBtn = document.getElementById('yearly-btn');
        const priceDisplays = document.querySelectorAll('.price-display');
        const billingPeriods = document.querySelectorAll('.billing-period');
        const creditsIncluded = document.querySelectorAll('.credits-included');

        let isYearly = false;

        function updatePricing() {
          priceDisplays.forEach(display => {
            const monthlyPrice = display.dataset.monthlyPrice;
            const yearlyPrice = display.dataset.yearlyPrice;
            display.textContent = isYearly ? `$${yearlyPrice}` : `$${monthlyPrice}`;
          });

          billingPeriods.forEach(period => {
            period.textContent = isYearly ? 'per year' : 'per month';
          });

          creditsIncluded.forEach(credits => {
            const monthlyCredits = credits.dataset.monthlyCredits;
            const yearlyCredits = credits.dataset.yearlyCredits;
            credits.textContent = `${isYearly ? yearlyCredits : monthlyCredits} credits included`;
          });
        }

        monthlyBtn.addEventListener('click', function() {
          isYearly = false;
          monthlyBtn.classList.add('bg-primary', 'text-primary-foreground');
          monthlyBtn.classList.remove('text-muted-foreground');
          yearlyBtn.classList.remove('bg-primary', 'text-primary-foreground');
          yearlyBtn.classList.add('text-muted-foreground');
          updatePricing();
        });

        yearlyBtn.addEventListener('click', function() {
          isYearly = true;
          yearlyBtn.classList.add('bg-primary', 'text-primary-foreground');
          yearlyBtn.classList.remove('text-muted-foreground');
          monthlyBtn.classList.remove('bg-primary', 'text-primary-foreground');
          monthlyBtn.classList.add('text-muted-foreground');
          updatePricing();
        });

        packageRadios.forEach(radio => {
          radio.addEventListener('change', function() {
            // Auto-submit the form when a package is selected
            form.submit();
          });
        });
      });
     </script>

     <!-- Loading Screen -->
     <div id="auth-loading-screen" class="fixed inset-0 bg-background flex items-center justify-center z-50 hidden">
       <div class="text-center">
         <svg class="animate-spin h-16 w-16 sm:h-20 sm:w-20 md:h-24 md:w-24 mx-auto" viewBox="0 0 24 24">
           <defs>
             <linearGradient id="spinner-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
               <stop offset="0%" stop-color="#9e28b5"/>
               <stop offset="25%" stop-color="#00a7e0"/>
               <stop offset="50%" stop-color="#6cd14d"/>
               <stop offset="75%" stop-color="#ffc600"/>
               <stop offset="100%" stop-color="#9e28b5"/>
             </linearGradient>
           </defs>
           <circle cx="12" cy="12" r="10" stroke="url(#spinner-gradient)" stroke-width="2" fill="none"/>
         </svg>
          <h2 class="text-xl font-semibold text-foreground mt-4 mb-2">{{t 'loading.select_plan_title'}}</h2>
          <p class="text-muted-foreground">{{t 'loading.select_plan_description'}}</p>
       </div>
     </div>

     <script>
     function clearAlerts() {
         const alerts = document.querySelectorAll('.alert');
         alerts.forEach(alert => alert.remove());
     }

     // Auto-hide alerts after 5 seconds
     function setupAlertAutoHide() {
         setTimeout(() => {
           const alerts = document.querySelectorAll('.alert-auto-hide');
           alerts.forEach(alert => alert.remove());
         }, 5000);
     }

       // Setup auto-hide for alerts added via HTMX
       document.addEventListener('htmx:afterSwap', (event) => {
         if (event.detail.target === document.body) {
           setupAlertAutoHide();
         }
       });

       function showLoading() {
         document.getElementById('auth-loading-screen').classList.remove('hidden');
       }

       function hideLoading() {
         document.getElementById('auth-loading-screen').classList.add('hidden');
       }
     </script>
   </div>