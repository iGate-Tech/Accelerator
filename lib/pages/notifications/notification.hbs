<main id="notification-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Notifications
          </h1>
          <p class="text-lg text-muted-foreground">
            Stay updated with the latest alerts and messages
          </p>
        </div>
      <div class="flex items-center gap-2">
            <button id="mark-all-read-btn" class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
              Mark All as Read
            </button>
         </div>
      </div>

      <!-- Notification List -->
      <div id="notifications-list" class="space-y-4">
        <div id="loading-notifications" class="text-center py-8">
          <div class="inline-flex items-center gap-2 text-muted-foreground">
            {{{icon "loader" class="animate-spin w-4 h-4"}}}
            Loading notifications...
          </div>
        </div>
      </div>

      <!-- Load More -->
       <div class="text-center py-4">
         <button class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
           Load More Notifications
         </button>
       </div>
    </div>
  </div>

  <script>
    let currentOffset = 0;
    const limit = 20;

    // Load notifications
    async function loadNotifications(loadMore = false) {
      try {
        const response = await fetch(`/api/notifications?limit=${limit}&offset=${currentOffset}`);
        const notifications = await response.json();

        if (!loadMore) {
          document.getElementById('notifications-list').innerHTML = '';
        }

        if (notifications.length === 0 && !loadMore) {
          document.getElementById('notifications-list').innerHTML = `
            <div class="text-center py-12">
              <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM15 12H9v5H4V5h11v7z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-medium text-foreground mb-2">No notifications yet</h3>
              <p class="text-muted-foreground">You'll see notifications here when you receive updates</p>
            </div>
          `;
          return;
        }

        const notificationsList = document.getElementById('notifications-list');

        notifications.forEach(notification => {
          const notificationElement = createNotificationElement(notification);
          notificationsList.appendChild(notificationElement);
        });

        if (notifications.length === limit) {
          currentOffset += limit;
          // Add load more button if there might be more
          if (!document.getElementById('load-more-btn')) {
            const loadMoreBtn = document.createElement('div');
            loadMoreBtn.className = 'text-center py-4';
            loadMoreBtn.innerHTML = `
              <button id="load-more-btn" class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
                Load More Notifications
              </button>
            `;
            notificationsList.appendChild(loadMoreBtn);

            document.getElementById('load-more-btn').addEventListener('click', () => {
              loadNotifications(true);
            });
          }
        }
      } catch (error) {
        console.error('Error loading notifications:', error);
        document.getElementById('notifications-list').innerHTML = `
          <div class="text-center py-8 text-red-600">
            Failed to load notifications. Please try again.
          </div>
        `;
      }
    }

    // Create notification element
    function createNotificationElement(notification) {
      const div = document.createElement('div');
      div.className = `bg-card rounded-full border border-border p-4 ${!notification.is_read ? 'border-l-4 border-l-primary' : ''}`;

      const iconClass = getNotificationIcon(notification.type);
      const timeAgo = getTimeAgo(notification.created_at);

      div.innerHTML = `
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 ${iconClass.bg} rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 ${iconClass.color}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${iconClass.path}"></path>
              </svg>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-medium text-foreground">${getNotificationTitle(notification.type)}</h3>
              <span class="text-xs text-muted-foreground">${timeAgo}</span>
            </div>
            <p class="text-sm text-muted-foreground mt-1">${notification.message}</p>
          </div>
          <button class="mark-read-btn text-muted-foreground hover:text-foreground opacity-0 group-hover:opacity-100 transition-opacity"
                  data-id="${notification.id}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      `;

      // Add hover effect for mark as read button
      div.classList.add('group');

      // Add click handler for marking as read
      div.querySelector('.mark-read-btn').addEventListener('click', async (e) => {
        e.stopPropagation();
        await markAsRead(notification.id);
        div.classList.remove('border-l-4', 'border-l-primary');
        div.querySelector('.mark-read-btn').style.opacity = '0';
      });

      return div;
    }

    // Get notification icon based on type
    function getNotificationIcon(type) {
      switch (type) {
        case 'welcome':
          return { bg: 'bg-purple-100', color: 'text-purple-600', path: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z' };
        case 'getting_started':
          return { bg: 'bg-blue-100', color: 'text-blue-600', path: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' };
        case 'tip':
          return { bg: 'bg-amber-100', color: 'text-amber-600', path: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' };
        case 'profile_complete':
          return { bg: 'bg-green-100', color: 'text-green-600', path: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' };
        case 'validation_threshold_reached':
          return { bg: 'bg-green-100', color: 'text-green-600', path: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' };
        case 'reward_earned':
          return { bg: 'bg-yellow-100', color: 'text-yellow-600', path: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1' };
        default:
          return { bg: 'bg-blue-100', color: 'text-blue-600', path: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' };
      }
    }

    // Get notification title based on type
    function getNotificationTitle(type) {
      switch (type) {
        case 'welcome':
          return '🎉 Welcome to Accelerator!';
        case 'getting_started':
          return '🚀 Getting Started';
        case 'tip':
          return '💡 Pro Tip';
        case 'profile_complete':
          return '✅ Profile Complete';
        case 'validation_threshold_reached':
          return '🎉 Idea Validated!';
        case 'reward_earned':
          return '💰 Reward Earned';
        default:
          return 'Notification';
      }
    }

    // Get time ago string
    function getTimeAgo(dateString) {
      const now = new Date();
      const date = new Date(dateString);
      const diffInSeconds = Math.floor((now - date) / 1000);

      if (diffInSeconds < 60) return 'Just now';
      if (diffInSeconds < 3600) return `${Math.floor(diffInSeconds / 60)}m ago`;
      if (diffInSeconds < 86400) return `${Math.floor(diffInSeconds / 3600)}h ago`;
      return `${Math.floor(diffInSeconds / 86400)}d ago`;
    }

    // Mark notification as read
    async function markAsRead(notificationId) {
      try {
        await fetch(`/api/notifications/${notificationId}/read`, { method: 'PUT' });
      } catch (error) {
        console.error('Error marking notification as read:', error);
      }
    }

    // Mark all notifications as read
    document.getElementById('mark-all-read-btn').addEventListener('click', async () => {
      try {
        const response = await fetch('/api/notifications/read-all', { method: 'PUT' });
        if (response.ok) {
          // Reload notifications to update UI
          currentOffset = 0;
          loadNotifications();
          if (typeof showToast === 'function') {
            showToast('All notifications marked as read', 'success');
          }
        }
      } catch (error) {
        console.error('Error marking all as read:', error);
      }
    });

    // Load notifications on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadNotifications();
    });
  </script>
</main>