{{!< main}}
<div class="flex gap-10  items-center min-h-[85vh]">
{{> hierarchical-sidebar rawData}}

   <div class="flex justify-center items-center gap-8">

      

      {{> question-card
        title="Hi <span class='text-primary'>Demo</span>, what's your next big idea? (Hierarchical)"
        placeholder="Enter prompt..."
        content="As part of the Idea Model in Section 4: Branding, answer the following question for your startup: What is your mission?. Provide a comprehensive, startup-focused response with specific, actionable details."
      }}
    </div>
      <script>
        // Hierarchical question selection
        document.addEventListener('click', function(e) {
          if (e.target.closest('a[data-question-id]')) {
            e.preventDefault();
            const link = e.target.closest('a[data-question-id]');
            const questionId = link.getAttribute('data-question-id');
            const path = link.getAttribute('data-path');
            console.log('Selected question:', questionId, 'Path:', path);
            // TODO: Load question prompt into textarea
            // For now, alert
            alert('Selected question: ' + questionId + ' in path: ' + path);
          }
        });

        // CRUD functionality
        let copiedId = null;

        function copyNode(el) {
          let container = el.closest('details');
          if (!container) {
            const dropdownUl = el.closest('ul.dropdown');
            if (dropdownUl) {
              container = dropdownUl.parentElement.querySelector('details') || dropdownUl.parentElement.querySelector('a[data-nodeid]');
            }
          }
          if (!container) container = el.closest('a[data-nodeid]');
          if (container) {
            copiedId = container.dataset.nodeid;
            console.log('Copied node:', copiedId);
            alert('Node copied');
          } else {
            console.log('Could not find container to copy');
          }
        }

        function pasteAsChild(el) {
          if (!copiedId) {
            alert('No node copied');
            return;
          }
          let container = el.closest('details');
          if (!container) {
            const dropdownUl = el.closest('ul.dropdown');
            if (dropdownUl) {
              container = dropdownUl.parentElement.querySelector('details') || dropdownUl.parentElement.querySelector('a[data-nodeid]');
            }
          }
          if (!container) container = el.closest('a[data-nodeid]');
          if (container) {
            console.log('Pasting to:', container.dataset.nodeid, 'from:', copiedId);
            fetch('/paste-as-child', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ parentId: container.dataset.nodeid, copyId: copiedId })
            }).then(res => res.json()).then(data => {
              console.log('Paste response:', data);
              if (data.success) {
                location.reload();
              } else {
                alert('Paste failed');
              }
            }).catch(err => {
              console.error('Paste error:', err);
              alert('Paste error');
            });
          } else {
            console.log('Could not find container to paste');
          }
        }

        function editItem(el) {
           let container = el.closest('details');
           if (!container) {
             const dropdownUl = el.closest('ul.dropdown');
             if (dropdownUl) {
               container = dropdownUl.parentElement.querySelector('a[data-nodeid]');
             }
           }
           if (!container) container = el.closest('a[data-nodeid]');
           let header;
           if (container.tagName.toLowerCase() === 'details') {
             header = container.querySelector('summary');
           } else {
             header = container;
           }
           const nameSpan = header.querySelector('.node-name');
           if (nameSpan) {
             const currentText = nameSpan.textContent.trim();
             const input = document.createElement('input');
             input.type = 'text';
             input.value = currentText;
             input.className = 'input input-sm';
             header.replaceChild(input, nameSpan);
             input.focus();
             input.select();
             input.addEventListener('keydown', (e) => {
               if (e.key === 'Enter') {
                 saveItem(el);
               } else if (e.key === 'Escape') {
                 header.replaceChild(nameSpan, input);
               }
             });
           }
         }

            

        function saveItem(el) {
           let container = el.closest('details');
           if (!container) {
             const dropdownUl = el.closest('ul.dropdown');
             if (dropdownUl) {
               container = dropdownUl.parentElement.querySelector('a[data-nodeid]');
             }
           }
           if (!container) container = el.closest('a[data-nodeid]');
           let header;
           if (container.tagName.toLowerCase() === 'details') {
             header = container.querySelector('summary');
           } else {
             header = container;
           }
           const input = header.querySelector('input');
           if (input) {
             const newText = input.value.trim();
             const nameSpan = document.createElement('span');
             nameSpan.className = 'node-name';
             nameSpan.textContent = newText;
             header.replaceChild(nameSpan, input);
             const nodeId = container.dataset.nodeid;
             fetch('/update-node/' + nodeId, {
               method: 'POST',
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify({ name: newText })
             });
           }
         }

        function addLeaf(el) {
            let container = el.closest('details');
            if (!container) {
              const dropdownUl = el.closest('ul.dropdown');
              if (dropdownUl) {
                container = dropdownUl.parentElement.querySelector('details') || dropdownUl.parentElement.querySelector('a[data-nodeid]');
              }
            }
            if (!container) container = el.closest('a[data-nodeid]');
            let ul = container.querySelector('ul:not(.dropdown):not(.questions-ul)');
            if (!ul) {
              ul = document.createElement('ul');
              container.appendChild(ul);
            }
            if (container.tagName.toLowerCase() === 'details') container.open = true;
            const tempId = Date.now().toString();
            const newLi = document.createElement('li');
            newLi.innerHTML = '<a href="#" class="flex justify-between items-center" data-nodeid="' + tempId + '"><span class="flex items-center"><i class="lucide lucide-file-text w-4 h-4" data-lucide="file-text"></i><span class="node-name ml-2">New Leaf</span></span><button class="btn btn-ghost btn-sm" popovertarget="popover-' + tempId + '" style="anchor-name:--anchor-' + tempId + '" onclick="event.stopPropagation()"><i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i></button></a><ul class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm" popover id="popover-' + tempId + '" style="position-anchor:--anchor-' + tempId + '"><li><a onclick="editItem(this)"><i class="lucide lucide-edit w-4 h-4" data-lucide="edit"></i> Edit</a></li><li><a onclick="saveItem(this)"><i class="lucide lucide-save w-4 h-4" data-lucide="save"></i> Save</a></li><li><a onclick="deleteItem(this)"><i class="lucide lucide-trash w-4 h-4" data-lucide="trash"></i> Delete</a></li></ul>';
            ul.appendChild(newLi);
            lucide.createIcons();
            fetch('/add-node', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ parentId: container.dataset.nodeid || null, type: 'leaf', name: 'New Leaf' })
            }).then(res => res.json()).then(data => {
              if (data.success) {
                newLi.querySelector('a').dataset.nodeid = data.id;
                const popoverId = 'popover-' + data.uniqueId;
                newLi.querySelector('button').setAttribute('popovertarget', popoverId);
                newLi.querySelector('button').style.anchorName = '--anchor-' + data.uniqueId;
                newLi.querySelector('ul').id = popoverId;
                newLi.querySelector('ul').style.positionAnchor = '--anchor-' + data.uniqueId;
              }
            });
          }

        function addSub(el) {
            let container = el.closest('details');
            if (!container) {
              const dropdownUl = el.closest('ul.dropdown');
              if (dropdownUl) {
                container = dropdownUl.parentElement.querySelector('details') || dropdownUl.parentElement.querySelector('a[data-nodeid]');
              }
            }
            if (!container) container = el.closest('a[data-nodeid]');
            let ul = container.querySelector('ul:not(.dropdown)');
            if (!ul) {
              ul = document.createElement('ul');
              container.appendChild(ul);
            }
            if (container.tagName.toLowerCase() === 'details') container.open = true;
            const tempId = Date.now().toString();
            const newLi = document.createElement('li');
            newLi.innerHTML = '<details class="dropdown" data-nodeid="' + tempId + '"><summary><i class="lucide lucide-folder w-4 h-4 flex-shrink-0" data-lucide="folder"></i><span class="node-name">New Sub</span><button class="btn btn-ghost btn-sm" popovertarget="popover-' + tempId + '" style="anchor-name:--anchor-' + tempId + '" onclick="event.stopPropagation()"><i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i></button><ul class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm" popover id="popover-' + tempId + '" style="position-anchor:--anchor-' + tempId + '"><li><a onclick="editItem(this)"><i class="lucide lucide-edit w-4 h-4" data-lucide="edit"></i> Edit</a></li><li><a onclick="saveItem(this)"><i class="lucide lucide-save w-4 h-4" data-lucide="save"></i> Save</a></li><li><a onclick="addSub(this)"><i class="lucide lucide-folder-plus w-4 h-4" data-lucide="folder-plus"></i> Add sub</a></li><li><a onclick="addLeaf(this)"><i class="lucide lucide-file-plus w-4 h-4" data-lucide="file-plus"></i> Add leaf</a></li><li><a onclick="deleteItem(this)"><i class="lucide lucide-trash w-4 h-4" data-lucide="trash"></i> Delete</a></li></ul></summary><ul></ul></details>';
            ul.appendChild(newLi);
            lucide.createIcons();
            fetch('/add-node', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ parentId: container.dataset.nodeid || null, type: 'sub', name: 'New Sub' })
            }).then(res => res.json()).then(data => {
              if (data.success) {
                newLi.querySelector('details').dataset.nodeid = data.id;
                const popoverId = 'popover-' + data.uniqueId;
                newLi.querySelector('button').setAttribute('popovertarget', popoverId);
                newLi.querySelector('button').style.anchorName = '--anchor-' + data.uniqueId;
                newLi.querySelector('ul').id = popoverId;
                newLi.querySelector('ul').style.positionAnchor = '--anchor-' + data.uniqueId;
              }
            });
          }

        function deleteItem(el) {
          let container = el.closest('details');
          if (!container) {
            const dropdownUl = el.closest('ul.dropdown');
            if (dropdownUl) {
              container = dropdownUl.parentElement.querySelector('a[data-nodeid]');
            }
          }
          if (!container) container = el.closest('a[data-nodeid]');
          const nodeId = container.dataset.nodeid;
          window.pendingDeleteNodeId = nodeId;
          window.pendingDeleteLi = container.closest('li');
          const checkbox = document.getElementById('delete_modal');
          checkbox.checked = true;
        }

        function addSubToRoot() {
           const sidebar = document.querySelector('.sidebar');
           let ul = sidebar.querySelector('ul.menu.w-full');
           if (!ul) {
             ul = document.createElement('ul');
             ul.className = 'menu w-full';
             sidebar.appendChild(ul);
           }
           const tempId = Date.now().toString();
           const newLi = document.createElement('li');
           newLi.innerHTML = '<details class="dropdown w-full" data-nodeid="' + tempId + '"><summary><i class="lucide lucide-folder w-4 h-4 flex-shrink-0 min-w-4 min-h-4" data-lucide="folder"></i><span class="node-name">New Sub</span><button class="btn btn-ghost btn-sm" popovertarget="popover-' + tempId + '" style="anchor-name:--anchor-' + tempId + '" onclick="event.stopPropagation()"><i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i></button><ul class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm" popover id="popover-' + tempId + '" style="position-anchor:--anchor-' + tempId + '"><li><a onclick="editItem(this)"><i class="lucide lucide-edit w-4 h-4" data-lucide="edit"></i> Edit</a></li><li><a onclick="saveItem(this)"><i class="lucide lucide-save w-4 h-4" data-lucide="save"></i> Save</a></li><li><a onclick="addSub(this)"><i class="lucide lucide-folder-plus w-4 h-4" data-lucide="folder-plus"></i> Add sub</a></li><li><a onclick="addLeaf(this)"><i class="lucide lucide-file-plus w-4 h-4" data-lucide="file-plus"></i> Add leaf</a></li><li><a onclick="deleteItem(this)"><i class="lucide lucide-trash w-4 h-4" data-lucide="trash"></i> Delete</a></li></ul></summary><ul></ul></details>';
           ul.appendChild(newLi);
           lucide.createIcons();
            fetch('/add-node', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ parentId: null, type: 'sub', name: 'New Sub' })
            }).then(res => res.json()).then(data => {
              if (data.success) {
                newLi.querySelector('details').dataset.nodeid = data.id;
                const popoverId = 'popover-' + data.uniqueId;
                newLi.querySelector('button').setAttribute('popovertarget', popoverId);
                newLi.querySelector('button').style.anchorName = '--anchor-' + data.uniqueId;
                newLi.querySelector('ul').id = popoverId;
                newLi.querySelector('ul').style.positionAnchor = '--anchor-' + data.uniqueId;
              }
            });
         }

        function addLeafToRoot() {
           const sidebar = document.querySelector('.sidebar');
           let ul = sidebar.querySelector('ul.menu.w-full');
           if (!ul) {
             ul = document.createElement('ul');
             ul.className = 'menu w-full';
             sidebar.appendChild(ul);
           }
           const tempId = Date.now().toString();
           const newLi = document.createElement('li');
           newLi.innerHTML = '<a href="#" class="flex justify-between items-center" data-nodeid="' + tempId + '"><span class="flex items-center"><i class="lucide lucide-file-text w-4 h-4  flex-shrink-0 min-w-4 min-h-4" data-lucide="file-text"></i><span class="node-name ml-2">New Leaf</span></span><button class="btn btn-ghost btn-sm" popovertarget="popover-' + tempId + '" style="anchor-name:--anchor-' + tempId + '" onclick="event.stopPropagation()"><i class="lucide lucide-ellipsis-vertical w-4 h-4" data-lucide="ellipsis-vertical"></i></button></a><ul class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm" popover id="popover-' + tempId + '" style="position-anchor:--anchor-' + tempId + '"><li><a onclick="editItem(this)"><i class="lucide lucide-edit w-4 h-4" data-lucide="edit"></i> Edit</a></li><li><a onclick="saveItem(this)"><i class="lucide lucide-save w-4 h-4" data-lucide="save"></i> Save</a></li><li><a onclick="deleteItem(this)"><i class="lucide lucide-trash w-4 h-4" data-lucide="trash"></i> Delete</a></li></ul>';
           ul.appendChild(newLi);
           lucide.createIcons();
            fetch('/add-node', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ parentId: null, type: 'leaf', name: 'New Leaf' })
            }).then(res => res.json()).then(data => {
              if (data.success) {
                newLi.querySelector('a').dataset.nodeid = data.id;
                const popoverId = 'popover-' + data.uniqueId;
                newLi.querySelector('button').setAttribute('popovertarget', popoverId);
                newLi.querySelector('button').style.anchorName = '--anchor-' + data.uniqueId;
                newLi.querySelector('ul').id = popoverId;
                newLi.querySelector('ul').style.positionAnchor = '--anchor-' + data.uniqueId;
              }
            });
         }

        function confirmDelete() {
          const nodeId = window.pendingDeleteNodeId;
          const li = window.pendingDeleteLi;
          fetch('/delete-node/' + nodeId, { method: 'POST' })
            .then(response => {
              if (response.ok) {
                if (li) li.remove();
                const checkbox = document.getElementById('delete_modal');
                checkbox.checked = false;
              } else {
                alert('Failed to delete node');
              }
            })
            .catch(err => {
              console.error('Error:', err);
              alert('Error deleting node');
            });
        }

        function cancelDelete() {
          const checkbox = document.getElementById('delete_modal');
          checkbox.checked = false;
        }

        // Initialize Lucide icons
        lucide.createIcons();
      </script>

      <!-- Delete confirmation modal -->
      <input type="checkbox" id="delete_modal" class="modal-toggle" />
      <div class="modal">
        <div class="modal-box modal-sm border border-error bg-error text-white p-2">
          <div class="flex justify-between items-center">
            <span class="font-bold">Are you sure you want to delete this node?</span>
            <div>
              <button class="btn btn-outline btn-sm" onclick="confirmDelete()">Confirm</button>
            </div>
          </div>
        </div>
        <label class="modal-backdrop" for="delete_modal">Close</label>
      </div>
    </div>
  </div>
</div>