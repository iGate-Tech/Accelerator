<main id="voting-reward-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
        <div class="flex items-center justify-between">
          <div class="grid gap-1">
            <h1 class="font-heading text-3xl font-semibold text-foreground">
              {{t 'voting_rewards.title'}}
            </h1>
            <p class="text-lg text-muted-foreground">
              {{t 'voting_rewards.description'}}
            </p>
          </div>
        </div>

       <!-- Key Metrics Grid -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-4">
        <!-- Credit Balance -->
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">{{t 'voting_rewards.credit_balance'}}</h3>
               <p class="text-2xl font-semibold text-foreground" id="credit-balance">{{profile.credit_balance}}</p>
            </div>
            <div>
            <div class="bg-primary/20 rounded-lg">
              <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">
                    {{{icon "coins" class="w-4 h-4 text-primary-foreground"}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
             <span class="text-success" id="earned-30d">+{{stats.earned30d}}</span>
            {{t 'voting_rewards.earned_30d'}}
          </p>
        </div>

        <!-- Total Votes Given -->
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">{{t 'voting_rewards.votes_given'}}</h3>
               <p class="text-2xl font-semibold text-foreground" id="votes-given">{{stats.votesGiven}}</p>
            </div>
            <div>
            <div class="bg-info/20 rounded-lg">
              <div class="w-10 h-10 bg-info/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-info rounded-lg absolute top-0.5 left-0.5">
                    {{{icon "star" class="w-4 h-4 text-info-foreground"}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
             <span class="text-success" id="rewarding-votes">{{stats.rewardingVotes}}</span>
            {{t 'voting_rewards.rewarding_votes'}}
          </p>
        </div>

        <!-- Rewards Earned -->
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">{{t 'voting_rewards.rewards_earned'}}</h3>
               <p class="text-2xl font-semibold text-foreground" id="total-earned">{{stats.rewardsEarned}}</p>
            </div>
            <div>
            <div class="bg-success/20 rounded-lg">
              <div class="w-10 h-10 bg-success/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">
                    {{{icon "check-circle" class="w-4 h-4 text-success-foreground"}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
             <span class="text-success" id="earned-30d-amount">+{{stats.earned30d}}</span>
            {{t 'voting_rewards.credits_30d'}}
          </p>
        </div>

        <!-- Success Rate -->
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">{{t 'voting_rewards.success_rate'}}</h3>
               <p class="text-2xl font-semibold text-foreground" id="success-rate">{{stats.successRate}}%</p>
            </div>
            <div>
            <div class="bg-warning/20 rounded-lg">
              <div class="w-10 h-10 bg-warning/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-warning rounded-lg absolute top-0.5 left-0.5">
                    {{{icon "bar-chart-3" class="w-4 h-4 text-warning-foreground"}}}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            {{t 'voting_rewards.ideas_validated'}}
          </p>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Recent Rewards & Activity -->
        <div class="lg:col-span-2">
          <!-- Reward Transactions -->
          <div class="bg-card rounded-lg border border-border p-6 mb-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">{{t 'voting_rewards.recent_transactions'}}</h2>
              <a href="#" class="btn btn-ghost text-sm" onclick="loadMoreTransactions()">
                {{t 'voting_rewards.view_all'}}
                {{{icon 'arrow-right' class='' size='14'}}}
              </a>
            </div>
             <div id="reward-transactions" class="space-y-4">
               {{#if creditTransactions.length}}
                 {{#each creditTransactions}}
                   <div class="flex items-center justify-between p-4 bg-muted/30 rounded-lg">
                     <div class="flex items-center gap-3">
                       <div class="w-8 h-8 {{#if (eq transaction_type 'reward_earned')}}bg-success/20{{else}}bg-destructive/20{{/if}} rounded-full flex items-center justify-center">
                         <svg class="w-4 h-4 {{#if (eq transaction_type 'reward_earned')}}text-success{{else}}text-destructive{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                         </svg>
                       </div>
                       <div>
                          <p class="text-sm font-medium text-foreground">{{#if (eq transaction_type 'reward_earned')}}{{t 'voting_rewards.reward_earned'}}{{else}}{{t 'voting_rewards.reward_distributed'}}{{/if}}</p>
                         <p class="text-xs text-muted-foreground">{{formatDate created_at}}</p>
                       </div>
                     </div>
                     <div class="text-sm font-semibold {{#if (eq transaction_type 'reward_earned')}}text-success{{else}}text-destructive{{/if}}">
                       {{#if (eq transaction_type 'reward_earned')}}+{{else}}-{{/if}}{{amount}}
                     </div>
                   </div>
                 {{/each}}
               {{else}}
                 <div class="text-center py-8">
                   <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                     {{{icon 'coins' class='text-muted-foreground' size='24'}}}
                   </div>
                    <h3 class="text-lg font-medium text-foreground mb-2">{{t 'voting_rewards.no_transactions'}}</h3>
                    <p class="text-muted-foreground">{{t 'voting_rewards.earn_rewards'}}</p>
                 </div>
               {{/if}}
             </div>
          </div>

          <!-- Voting Activity -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
               <h2 class="text-xl font-semibold text-foreground">{{t 'voting_rewards.recent_activity'}}</h2>
               <a href="/explore-idea" class="btn btn-ghost text-sm">
                {{t 'voting_rewards.vote_more'}}
                {{{icon 'arrow-right' class='' size='14'}}}
              </a>
            </div>
             <div id="voting-activity" class="space-y-4">
               {{#if votingActivity.length}}
                 {{#each votingActivity}}
                   <div class="flex items-start gap-3 p-3 rounded-lg bg-muted/30">
                     <div class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center">
                       <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                       </svg>
                     </div>
                     <div class="flex-1">
                       <p class="text-sm text-foreground">
                          {{#if (eq action_type 'vote_cast')}}{{t 'voting_rewards.voted_on'}}{{else}}{{t 'voting_rewards.earned_reward_for'}}{{/if}} <strong>"{{ideas.title}}"</strong>
                       </p>
                       <p class="text-xs text-muted-foreground">{{formatDate created_at}}</p>
                        {{#if details.reward_amount}}<p class="text-xs text-success font-medium">+{{details.reward_amount}} {{t 'voting_rewards.credits_earned'}}</p>{{/if}}
                     </div>
                   </div>
                 {{/each}}
               {{else}}
                 <div class="text-center py-8">
                   <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                     {{{icon 'star' class='text-muted-foreground' size='24'}}}
                   </div>
                    <h3 class="text-lg font-medium text-foreground mb-2">{{t 'voting_rewards.no_activity'}}</h3>
                    <p class="text-muted-foreground mb-4">{{t 'voting_rewards.start_voting'}}</p>
                    <a href="/explore-idea" class="btn btn-primary">{{t 'voting_rewards.explore_ideas'}}</a>
                 </div>
               {{/if}}
             </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Reward Notifications -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">{{t 'voting_rewards.reward_notifications'}}</h2>
            </div>
             <div id="reward-notifications" class="space-y-4">
               {{#if rewardNotifications.length}}
                 {{#each rewardNotifications}}
                   <div class="p-3 bg-muted/30 rounded-lg">
                     <p class="text-sm text-foreground">{{message}}</p>
                     <p class="text-xs text-muted-foreground">{{formatDate created_at}}</p>
                   </div>
                 {{/each}}
               {{else}}
                 <div class="text-center py-4">
                    <p class="text-sm text-muted-foreground">{{t 'voting_rewards.no_reward_notifications'}}</p>
                 </div>
               {{/if}}
             </div>
          </div>

          <!-- Available Ideas to Vote -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
               <h2 class="text-xl font-semibold text-foreground">{{t 'voting_rewards.ideas_to_vote'}}</h2>
               <a href="/explore-idea" class="btn btn-ghost text-sm">
                {{t 'voting_rewards.explore_all'}}
              </a>
            </div>
             <div id="available-ideas" class="space-y-4">
               {{#if votableIdeas.length}}
                 {{#each votableIdeas}}
                   <div class="flex items-start gap-3 p-3 rounded-lg bg-muted/30 hover:bg-muted/50 transition-colors">
                     <div class="flex-1 min-w-0">
                       <h4 class="text-sm font-medium text-foreground truncate">{{title}}</h4>
                       <p class="text-xs text-muted-foreground mb-2">{{category}}</p>
                       <div class="flex items-center gap-2">
                         <div class="flex items-center gap-1">
                           <svg class="w-3 h-3 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                           </svg>
                           <span class="text-xs text-muted-foreground">{{average_rating}}</span>
                         </div>
                          <button onclick="voteOnIdea('{{id}}')" class="btn btn-primary btn-sm">
                            {{t 'voting_rewards.vote'}}
                          </button>
                       </div>
                     </div>
                   </div>
                 {{/each}}
               {{else}}
                 <div class="text-center py-4">
                    <p class="text-sm text-muted-foreground">{{t 'voting_rewards.no_votable_ideas'}}</p>
                    <a href="/explore-idea" class="text-sm text-primary hover:underline">{{t 'voting_rewards.explore_more'}}</a>
                 </div>
               {{/if}}
             </div>
          </div>

            <!-- Quick Actions -->
           <div class="bg-card rounded-lg border border-border p-6">
              <h2 class="text-xl font-semibold text-foreground mb-4">{{t 'voting_rewards.quick_actions'}}</h2>
             <div class="grid grid-cols-1 gap-3">
                <a href="/explore-idea" class="flex items-center gap-3 w-full px-4 py-3 text-sm font-medium text-foreground bg-background border border-border rounded-lg hover:bg-accent hover:text-accent-foreground transition-colors">
                 <div class="flex-shrink-0 w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center">
                   <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                   </svg>
                 </div>
                  <span class="flex-1">{{t 'voting_rewards.vote_on_ideas'}}</span>
                 <div class="flex-shrink-0">
                    {{{icon "chevron-right" class="w-4 h-4 text-muted-foreground"}}}
                 </div>
               </a>
               <a href="/new-idea" class="flex items-center gap-3 w-full px-4 py-3 text-sm font-medium text-foreground bg-background border border-border rounded-lg hover:bg-accent hover:text-accent-foreground transition-colors">
                 <div class="flex-shrink-0 w-8 h-8 bg-secondary/50 rounded-lg flex items-center justify-center">
                    {{{icon "plus" class="w-4 h-4 text-secondary-foreground"}}}
                 </div>
                  <span class="flex-1">{{t 'voting_rewards.create_idea'}}</span>
                 <div class="flex-shrink-0">
                    {{{icon "chevron-right" class="w-4 h-4 text-muted-foreground"}}}
                 </div>
               </a>
               <a href="/buy-credits" class="flex items-center gap-3 w-full px-4 py-3 text-sm font-medium text-foreground bg-background border border-border rounded-lg hover:bg-accent hover:text-accent-foreground transition-colors">
                 <div class="flex-shrink-0 w-8 h-8 bg-success/10 rounded-lg flex items-center justify-center">
                    {{{icon "credit-card" class="w-4 h-4 text-success"}}}
                 </div>
                  <span class="flex-1">{{t 'voting_rewards.buy_credits'}}</span>
                 <div class="flex-shrink-0">
                    {{{icon "chevron-right" class="w-4 h-4 text-muted-foreground"}}}
                 </div>
               </a>
             </div>
           </div>
        </div>
      </div>
    </div>
  </div>
</main>

</script>