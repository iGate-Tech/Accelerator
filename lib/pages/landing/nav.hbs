          fill="currentColor" />
      </svg>
    </div>
    <span class="font-sans font-medium text-base tracking-tight text-white">Accelerator</span>
  </div>

  <!-- Links (Hidden on small screens) -->
  <div class="hidden md:flex items-center gap-6 mr-8">
    <a href="#hero" class="text-xs font-medium text-white/50 hover:text-white transition-colors">Home</a>
    <a href="#features" class="text-xs font-medium text-white/50 hover:text-white transition-colors">Features</a>
    <a href="#pricing" class="text-xs font-medium text-white/50 hover:text-white transition-colors">Pricing</a>
  </div>

  <!-- Language Switcher -->
  <div class="hidden md:flex items-center mr-4">
    <button id="lang-en" class="px-2 py-1 text-xs font-medium rounded-l-md bg-white text-black" onclick="switchLanguage('en')">
      EN
    </button>
    <button id="lang-ar" class="px-2 py-1 text-xs font-medium rounded-r-md bg-white/50 text-white hover:bg-white hover:text-black" onclick="switchLanguage('ar')">
      AR
    </button>
  </div>

  <!-- Action Buttons -->
  <div class="flex gap-2">

    <a href="/auth/login"
      class="flex gap-2 hover:bg-brand-purple transition-colors group text-xs font-semibold text-black bg-white rounded-full pt-2 pr-4 pb-2 pl-4 gap-x-2 gap-y-2 items-center flex-none">
      Start Building
      {{{icon "arrow-right" size="1em" class="group-hover:translate-x-0.5 transition-transform"}}}
    </a>
  </div>
</nav>

<script>
  function switchLanguage(lang) {
    // Set the language in localStorage
    localStorage.setItem('language', lang);

    // Update button styles
    const enBtn = document.getElementById('lang-en');
    const arBtn = document.getElementById('lang-ar');
    if (lang === 'en') {
      enBtn.classList.remove('bg-white/50', 'text-white', 'hover:bg-white', 'hover:text-black');
      enBtn.classList.add('bg-white', 'text-black');
      arBtn.classList.remove('bg-white', 'text-black');
      arBtn.classList.add('bg-white/50', 'text-white', 'hover:bg-white', 'hover:text-black');
    } else {
      arBtn.classList.remove('bg-white/50', 'text-white', 'hover:bg-white', 'hover:text-black');
      arBtn.classList.add('bg-white', 'text-black');
      enBtn.classList.remove('bg-white', 'text-black');
      enBtn.classList.add('bg-white/50', 'text-white', 'hover:bg-white', 'hover:text-black');
    }

    // Here you would implement the actual language switching logic
    // For example, reload the page or update content dynamically
    // For now, just log it
    console.log('Language switched to:', lang);
  }

  // Load saved language on page load
  document.addEventListener('DOMContentLoaded', () => {
    const savedLang = localStorage.getItem('language') || 'en';
    switchLanguage(savedLang);
  });
</script>