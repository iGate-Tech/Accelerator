<!-- Section Header -->
<div id="features" class="flex flex-col items-center text-center max-w-3xl mb-20 relative z-10 mx-auto" data-aos="fade-up">
  <!-- Hero-Inspired Vertical Beam Animation -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 h-48 w-6 overflow-hidden flex justify-center">
    <svg class="h-full w-full" viewBox="0 0 6 192" fill="none">
      <path d="M3 0V192" stroke="url(#header-beam)" stroke-width="1.5" stroke-linecap="round"
        class="beam-line animate-beam opacity-70"></path>
      <defs></defs>
    </svg>
  </div>

  <div class="flex items-center gap-3 mb-8 px-4 py-1.5 rounded-full border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/5 backdrop-blur-sm">
    <span class="flex h-2 w-2 relative">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-purple opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-purple"></span>
    </span>
     <span class="text-xs font-mono text-brand-purple uppercase tracking-[0.2em] font-medium">
       (t "landing.features.badge")</span>
  </div>

   <h2 class="text-5xl md:text-6xl lg:text-7xl font-serif font-medium tracking-tight text-gray-900 dark:text-white mb-6">
     (t "landing.features.title_ai_powered") <br />
     <span class="text-gray-600 dark:text-white/60">(t "landing.features.title_effortless")</span>
   </h2>

   <p class="text-xl text-gray-700 dark:text-white/60 leading-relaxed max-w-2xl font-light tracking-tight mb-10">
     (t "landing.features.description")
   </p>


</div>
<!-- Feature Cards Grid -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 z-10 w-full max-w-7xl relative gap-x-8 gap-y-8">
  <!-- Script for Flashlight Effect -->
  <script>
    document.querySelectorAll(".spotlight-card".forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty("--mouse-x", `${x}px`);
        card.style.setProperty("--mouse-y", `${y}px`);
      });
    });
  </script>

  <!-- Card 1: Automated Execution -->
  <div
    class="spotlight-card group relative flex flex-col p-10 rounded-[32px] border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/[0.02] overflow-hidden transition-all duration-500"
    data-aos="fade-up" data-aos-delay="100">
    <!-- Spotlight Background -->
    <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      style="
              background: radial-gradient(
                600px circle at var(--mouse-x) var(--mouse-y),
                rgba(255, 255, 255, 0.06),
                transparent 40%
              );
            "></div>
    <!-- Spotlight Border -->
    <div
      class="pointer-events-none absolute inset-0 rounded-[32px] border border-brand-purple/50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      style="
              mask-image: radial-gradient(
                300px circle at var(--mouse-x) var(--mouse-y),
                black,
                transparent
              );
              -webkit-mask-image: radial-gradient(
                300px circle at var(--mouse-x) var(--mouse-y),
                black,
                transparent
              );
            "></div>

    <div
      class="absolute inset-0 bg-gradient-to-b from-white/[0.02] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500">
    </div>

     <h3 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white mb-4 relative z-10">
       (t "landing.features.card1_title")
     </h3>
     <p class="text-base text-gray-600 dark:text-white/50 leading-relaxed mb-12 relative z-10 font-light">
       (t "landing.features.card1_desc")
     </p>

    <!-- Visual: Chat/Terminal UI -->
    <div
      class="relative z-10 mt-auto w-full h-72 rounded-2xl border border-white/10 bg-black overflow-hidden flex flex-col shadow-2xl">
      <!-- Header -->
      <div class="px-5 py-4 border-b border-gray-200 dark:border-white/5 flex items-center justify-between bg-gray-50 dark:bg-white/5">
        <div class="flex items-center gap-2 opacity-50">
          <div class="w-2 h-2 rounded-full bg-gray-400 dark:bg-white/40"></div>
          <div class="w-2 h-2 rounded-full bg-gray-400 dark:bg-white/40"></div>
        </div>
        <span class="text-xs text-gray-500 dark:text-white/30 font-mono">ACCELERATOR_AI v1.0</span>
      </div>
      <!-- Body -->
      <div class="p-6 flex flex-col gap-5 relative h-full">
        <div class="absolute top-0 right-0 bottom-0 left-0"></div>

        <!-- User Message -->
        <div
          class="self-end max-w-[90%] bg-gray-100 dark:bg-white/10 backdrop-blur-sm rounded-2xl rounded-tr-sm p-4 border border-gray-200 dark:border-white/5 animate-[fadeIn_1s_ease-out]">
           <p class="text-xs text-gray-800 dark:text-white/90 font-light leading-relaxed">
             (t "landing.features.card1_example")
             <span class="text-gray-900 dark:text-white font-medium">(t "landing.features.card1_saas")</span>.
             (t "landing.features.card1_focus")
             <span class="text-brand-purple">(t "landing.features.card1_ai_productivity")</span>.
           </p>
        </div>

        <!-- System Message -->
        <div
          class="self-start max-w-[90%] bg-gray-50 dark:bg-white/[0.03] backdrop-blur-md rounded-2xl rounded-tl-sm p-5 border border-gray-200 dark:border-white/10 relative overflow-hidden group-hover:border-brand-purple/20 transition-colors duration-500">
          <div class="flex items-center gap-2 mb-3 text-brand-purple font-mono text-[10px] uppercase tracking-wider">
             {{{icon 'sparkles' class='lucide-sparkles' size='14'}}}
             (t "landing.features.card1_ai_name")
           </div>
           <p class="mb-4 text-xs text-gray-700 dark:text-white/80 font-light">
             (t "landing.features.card1_analyzing")
           </p>

          <!-- Progress Bar -->
          <div class="w-full bg-black/40 rounded-full h-1.5 mb-2 overflow-hidden">
            <div class="bg-brand-purple h-full w-[85%] animate-[pulse_2s_infinite]"></div>
          </div>
           <div class="flex justify-between text-[10px] text-brand-purple/60 font-mono">
             <span>(t "landing.features.card1_generating")</span>
             <span>(t "landing.features.card1_ideas")</span>
           </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 2: Smart Liquidity (Clean &amp; Hero Inspired) -->
  <div class="spotlight-card relative flex flex-col p-[1px] rounded-[32px] overflow-hidden lg:-mt-8 lg:mb-8 z-20 group"
    data-aos="fade-up" data-aos-delay="200">
    <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-transparent to-transparent rounded-[32px]">
    </div>
    <div class="absolute inset-0 bg-black rounded-[31px] m-[1px] overflow-hidden">
      <!-- Inner Spotlight Background -->
<div
     class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"
     style="
             background: radial-gradient(
               600px circle at var(--mouse-x) var(--mouse-y),
               rgba(255, 255, 255, 0.08),
               transparent 40%
             );
           "></div>
    </div>

    <!-- Spotlight Border Overlay -->
    <div
      class="pointer-events-none absolute inset-0 rounded-[32px] border border-brand-purple/50 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-50"
      style="
              mask-image: radial-gradient(
                300px circle at var(--mouse-x) var(--mouse-y),
                black,
                transparent
              );
              -webkit-mask-image: radial-gradient(
                300px circle at var(--mouse-x) var(--mouse-y),
                black,
                transparent
              );
            "></div>

    <div class="relative z-10 flex flex-col h-full p-10 group">
      <div class="flex items-center gap-3 mb-4">
        <div class="relative">
          <div
            class="absolute inset-0 bg-brand-purple/20 blur-md rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500">
          </div>
          {{{icon 'zap' class='lucide lucide-zap text-brand-purple relative z-10' size='24'}}}
        </div>
         <h3 class="text-2xl font-semibold tracking-tight text-white group-hover:text-white transition-colors">
           (t "landing.features.card2_title")
         </h3>
       </div>
       <p class="text-base text-white/50 leading-relaxed mb-12 font-light group-hover:text-white/70 transition-colors">
         (t "landing.features.card2_desc")
       </p>

      <!-- Visual: Hero-Inspired Orbit &amp; Sonar -->
      <div class="mt-auto relative w-full h-80 flex items-center justify-center perspective-1000">
        <!-- Animated Background Noodles &amp; Beams -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none overflow-visible z-0" viewBox="0 0 400 320"
          preserveAspectRatio="xMidYMid slice">
          <defs></defs>

          <!-- Path 1: Top Right into Center -->
          <path d="M420,40 C320,40 280,160 200,160" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1">
          </path>
          <path d="M420,40 C320,40 280,160 200,160" fill="none" stroke="url(#smart-beam-grad)" stroke-width="1.5"
            stroke-dasharray="100 1000" stroke-linecap="round" class="animate-[beam_3s_linear_infinite]"></path>

          <!-- Path 2: Bottom Left into Center -->
          <path d="M-20,280 C80,280 120,160 200,160" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1">
          </path>
          <path d="M-20,280 C80,280 120,160 200,160" fill="none" stroke="url(#smart-beam-grad)" stroke-width="1.5"
            stroke-dasharray="80 1000" stroke-linecap="round" class="animate-[beam_4s_linear_infinite]"></path>

          <!-- Path 3: Vertical Drop -->
          <path d="M200,0 L200,160" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1" stroke-dasharray="2 4">
          </path>
        </svg>

        <!-- Clean Sonar Rings -->
        <div
          class="absolute w-96 h-96 border border-brand-purple/5 rounded-full animate-[ping_4s_cubic-bezier(0,0,0.2,1)_infinite] opacity-10">
        </div>
        <div
          class="absolute w-80 h-80 border border-white/5 rounded-full animate-[ping_3s_cubic-bezier(0,0,0.2,1)_infinite] opacity-20 delay-700">
        </div>

        <!-- Outer Rotating Ring with Detail -->
        <div class="absolute w-64 h-64 border border-white/5 rounded-full animate-[spin_40s_linear_infinite]">
          <div class="absolute top-1/2 -right-1 w-2 h-2 bg-white/10 rounded-full"></div>
          <div class="absolute top-1/2 -left-1 w-2 h-2 bg-white/10 rounded-full"></div>
        </div>

        <!-- Middle Rotating Ring -->
        <div class="absolute w-60 h-60 border border-white/10 rounded-full animate-[spin_30s_linear_infinite]">
        </div>

        <!-- Inner Dashed Ring -->
        <div
          class="absolute w-44 h-44 border border-white/5 rounded-full animate-[spin_20s_linear_infinite_reverse] border-dashed">
        </div>

        <!-- Active Glow Ring -->
        <div
          class="absolute w-36 h-36 border border-brand-purple/20 rounded-full animate-[spin_15s_linear_infinite] opacity-0 group-hover:opacity-100 transition-opacity duration-700">
          <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-brand-purple mt-[-3px] rounded-full shadow-[0_0_10px_rgba(158,40,181,1)]">
          </div>
        </div>

        <!-- Orbiting Elements -->
        <div class="absolute w-60 h-60 animate-[spin_30s_linear_infinite]">
          <!-- Gem Node -->
          <div
            class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-black p-2.5 rounded-full border border-white/10 group-hover:border-brand-purple/30 group-hover:shadow-[0_0_20px_rgba(158,40,181,0.1)] transition-all duration-500">
            {{{icon 'gem' class='lucide lucide-gem text-white/40 group-hover:text-brand-purple transition-colors' size='16'}}}
          </div>
          <!-- Card Node -->
          <div
            class="absolute bottom-0 right-1/2 translate-x-1/2 translate-y-1/2 bg-black p-2.5 rounded-full border border-white/10 group-hover:border-brand-purple/30 group-hover:shadow-[0_0_20px_rgba(158,40,181,0.1)] transition-all duration-500">
            {{{icon 'credit-card' class='lucide lucide-credit-card text-white/40 group-hover:text-brand-purple transition-colors' size='16'}}}
          </div>
        </div>

        <!-- Central Hub -->
        <div
          class="z-10 flex group-hover:border-brand-purple/40 transition-colors duration-500 bg-base-panel w-24 h-24 border-white/10 border rounded-3xl relative items-center justify-center overflow-hidden shadow-2xl">
          {{{icon 'layers' class='lucide lucide-layers text-white relative z-20 group-hover:text-brand-purple transition-colors duration-500' size='32'}}}
          <!-- Scanner Effect -->
          <div
            class="animate-[pulse_2s_infinite] bg-gradient-to-tr from-transparent via-brand-purple/10 to-transparent absolute top-0 right-0 bottom-0 left-0 z-10">
          </div>
          <!-- Technical Grid BG -->
          <div class="absolute inset-0 opacity-20 z-0" style="
                    background-image: radial-gradient(
                      currentColor 0.5px,
                      transparent 0.5px
                    );
                    background-size: 18px 18px;
                  "></div>
        </div>

        <div class="absolute bottom-4 flex flex-col items-center">
          <div
            class="flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/5 group-hover:border-brand-purple/20 transition-colors">
            <span class="relative flex h-1.5 w-1.5">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-purple opacity-75"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-brand-purple"></span>
            </span>
             <div
               class="text-[10px] text-white/40 font-mono tracking-widest uppercase group-hover:text-white/70 transition-colors">
               (t "landing.features.card2_network_active")
             </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3: Multi-Sig Governance -->
  <div
    class="spotlight-card group relative flex flex-col p-10 rounded-[32px] border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/[0.02] overflow-hidden transition-all duration-500"
    data-aos="fade-up" data-aos-delay="300">
    <!-- Spotlight Background -->
    <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      style="
              background: radial-gradient(
                600px circle at var(--mouse-x) var(--mouse-y),
                rgba(255, 255, 255, 0.06),
                transparent 40%
              );
            "></div>
    <!-- Spotlight Border -->
    <div
      class="pointer-events-none absolute inset-0 rounded-[32px] border border-brand-purple/50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      style="
              mask-image: radial-gradient(
                300px circle at var(--mouse-x) var(--mouse-y),
                black,
                transparent
              );
              -webkit-mask-image: radial-gradient(
                300px circle at var(--mouse-x) var(--mouse-y),
                black,
                transparent
              );
            "></div>

     <h3 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white mb-4 relative z-10">
       (t "landing.features.card3_title")
     </h3>
     <p class="text-base text-gray-600 dark:text-white/50 leading-relaxed mb-12 relative z-10 font-light">
       (t "landing.features.card3_desc")
     </p>

    <!-- Visual: Dashboard UI -->
    <div
      class="relative mt-auto w-full h-72 rounded-2xl border border-white/10 bg-black p-7 flex flex-col justify-center gap-6 shadow-2xl">
      <!-- Team Header -->
      <div class="flex justify-between items-center pb-4 border-b border-white/5">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-none"></span>
           <span class="text-xs text-white/50 font-mono uppercase tracking-wider">(t "landing.features.card3_model_version")</span>
        </div>
        <div class="flex -space-x-2">
          <div
            class="w-7 h-7 rounded-full border border-black bg-white/10 flex items-center justify-center text-white/80 text-[10px] font-medium">
            JD
          </div>
          <div
            class="w-7 h-7 rounded-full border border-black bg-brand-purple/20 flex items-center justify-center text-brand-purple text-[10px] font-medium">
            AS
          </div>
          <div
            class="w-7 h-7 rounded-full border border-black bg-white/5 flex items-center justify-center text-[9px] text-white/40">
            +3
          </div>
        </div>
      </div>

      <!-- Approval Slider -->
      <div class="relative py-1">
         <div class="flex justify-between text-[10px] text-white/40 mb-2 font-mono uppercase">
           <span class="">(t "landing.features.card3_allocation_limit")</span>
           <span class="text-brand-purple">(t "landing.features.card3_approved")</span>
         </div>
        <div class="w-full h-2 bg-white/10 rounded-full relative flex items-center">
          <div class="absolute left-0 h-full w-[75%] bg-white/80 rounded-full"></div>
          <!-- Slider Knob -->
          <div
            class="absolute left-[75%] w-4 h-4 bg-white rounded-full z-10 transform -translate-x-1/2 border-2 border-black cursor-grab">
          </div>

          <!-- Tooltip -->
           <div
             class="absolute left-[75%] -top-9 -translate-x-1/2 bg-black border border-white/10 text-white text-[10px] px-2.5 py-1.5 rounded shadow-lg whitespace-nowrap animate-bounce">
             (t "landing.features.card3_signed_by")
            <div
              class="absolute bottom-[-4px] left-1/2 -translate-x-1/2 w-2 h-2 bg-black border-r border-b border-white/10 transform rotate-45">
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-2 gap-4 mt-2">
        <div
          class="flex items-center justify-center gap-2 p-3 rounded-lg bg-white/5 border border-white/5 hover:bg-white/10 transition-colors cursor-pointer">
           {{{icon 'history' class='lucide lucide-history text-white/40' size='14'}}}
           <span class="text-xs text-white/60 font-medium">(t "landing.features.card3_audit_log")</span>
         </div>
         <div
           class="flex items-center justify-center gap-2 p-3 rounded-lg bg-brand-purple/10 border border-brand-purple/20 cursor-pointer hover:bg-brand-purple/20 transition-colors">
           {{{icon 'check-circle' class='lucide lucide-check-circle text-brand-purple' size='14'}}}
           <span class="text-xs text-brand-purple font-medium">(t "landing.features.card3_approve_tx")</span>
        </div>
      </div>
    </div>
  </div>
</div>