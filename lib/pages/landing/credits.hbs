<!-- Credits Packages Section -->
<div id="credits" class="py-24 relative z-10 mx-auto max-w-7xl">
  <!-- Section Header -->
  <div class="text-center mb-12 mx-auto max-w-3xl">
    <div class="flex items-center gap-3 mb-8 px-4 py-1.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm w-fit mx-auto">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
      </span>
       <span class="text-xs font-mono text-green-500 uppercase tracking-[0.2em] font-medium">
         {{t "landing.credits.badge"}}</span>
    </div>

    <h2 class="text-5xl md:text-6xl lg:text-7xl font-serif font-medium tracking-tight text-white mb-6">
      {{t "landing.credits.title_power"}}
      <span class="text-white/60">{{t "landing.credits.title_innovation"}}</span>
    </h2>

    <p class="text-xl text-white/60 leading-relaxed max-w-2xl mx-auto font-light tracking-tight mb-8">
      {{t "landing.credits.description"}}
    </p>
  </div>

  <!-- Credits Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Small Package -->
    <div class="relative flex flex-col p-8 rounded-3xl border border-white/10 bg-white/[0.02] backdrop-blur-sm hover:border-green-500/20 transition-all duration-300 group">
       <div class="mb-6">
         <h3 class="text-2xl font-semibold text-white mb-2">{{t "landing.credits.starter_pack"}}</h3>
         <p class="text-white/60 text-sm">{{t "landing.credits.starter_desc"}}</p>
       </div>

       <div class="mb-8">
         <div class="flex items-baseline">
           <span class="text-4xl font-bold text-white">{{t "landing.credits.price_9"}}</span>
           <span class="text-white/60 ml-2">{{t "landing.credits.one_time"}}</span>
         </div>
         <p class="text-green-400 text-sm mt-2 font-medium">{{t "landing.credits.credits_500"}}</p>
       </div>

       <ul class="space-y-4 mb-8 flex-grow">
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.ai_generations_500"}}
         </li>
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.basic_modeling"}}
         </li>
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.validity_30"}}
         </li>
       </ul>

       <button class="w-full py-3 px-6 rounded-full bg-white/10 hover:bg-white/20 text-white font-medium transition-colors">
         {{t "landing.credits.buy_now"}}
       </button>
    </div>

    <!-- Medium Package -->
    <div class="relative flex flex-col p-8 rounded-3xl border-2 border-green-500/50 bg-gradient-to-b from-green-500/10 to-transparent backdrop-blur-sm hover:border-green-500 transition-all duration-300 group">
      <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
         <span class="bg-green-500 text-black text-xs font-bold px-3 py-1 rounded-full">{{t "landing.credits.best_value"}}</span>
      </div>

       <div class="mb-6">
         <h3 class="text-2xl font-semibold text-white mb-2">{{t "landing.credits.growth_pack"}}</h3>
         <p class="text-white/60 text-sm">{{t "landing.credits.growth_desc"}}</p>
       </div>

       <div class="mb-8">
         <div class="flex items-baseline">
           <span class="text-4xl font-bold text-white">{{t "landing.credits.price_24"}}</span>
           <span class="text-white/60 ml-2">{{t "landing.credits.one_time"}}</span>
         </div>
         <p class="text-green-400 text-sm mt-2 font-medium">{{t "landing.credits.credits_1500"}}</p>
         <p class="text-white/40 text-xs">{{t "landing.credits.save_20"}}</p>
       </div>

       <ul class="space-y-4 mb-8 flex-grow">
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.ai_generations_1500"}}
         </li>
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.advanced_modeling"}}
         </li>
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.team_planning"}}
         </li>
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.validity_90"}}
         </li>
       </ul>

       <button class="w-full py-3 px-6 rounded-full bg-green-500 hover:bg-green-600 text-black font-medium transition-colors">
         {{t "landing.credits.buy_growth_pack"}}
       </button>
    </div>

    <!-- Large Package -->
    <div class="relative flex flex-col p-8 rounded-3xl border border-white/10 bg-white/[0.02] backdrop-blur-sm hover:border-green-500/20 transition-all duration-300 group">
       <div class="mb-6">
         <h3 class="text-2xl font-semibold text-white mb-2">{{t "landing.credits.enterprise_pack"}}</h3>
         <p class="text-white/60 text-sm">{{t "landing.credits.enterprise_desc"}}</p>
       </div>

       <div class="mb-8">
         <div class="flex items-baseline">
           <span class="text-4xl font-bold text-white">{{t "landing.credits.price_49"}}</span>
           <span class="text-white/60 ml-2">{{t "landing.credits.one_time"}}</span>
         </div>
         <p class="text-green-400 text-sm mt-2 font-medium">{{t "landing.credits.credits_5000"}}</p>
         <p class="text-white/40 text-xs">{{t "landing.credits.save_35"}}</p>
       </div>

       <ul class="space-y-4 mb-8 flex-grow">
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.ai_generations_5000"}}
         </li>
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.all_premium_features"}}
         </li>
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.priority_processing"}}
         </li>
         <li class="flex items-center text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3'}}}
           {{t "landing.credits.validity_1_year"}}
         </li>
       </ul>

       <button class="w-full py-3 px-6 rounded-full bg-white/10 hover:bg-white/20 text-white font-medium transition-colors">
         {{t "landing.credits.buy_enterprise_pack"}}
       </button>
    </div>
  </div>

   <!-- Credit Info -->
   <div class="text-center mt-16">
     <p class="text-white/60 text-sm mb-4">
       {{t "landing.credits.credits_info"}}
     </p>
     <p class="text-white/40 text-xs">
       {{t "landing.credits.custom_packages"}}
     </p>
   </div>
</div>