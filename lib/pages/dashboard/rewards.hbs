<div class="flex h-[calc(100vh-4rem)]">
  {{> sidebar projects=projects lng=lng}}
  <main class="flex-1 overflow-y-auto bg-background">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8">
      <div class="space-y-8">

        <!-- Header -->
        <div class="text-center sm:text-left">
          <h1 class="text-3xl font-bold text-foreground">Rewards</h1>
          <p class="text-muted-foreground mt-2">View all your earned rewards</p>
        </div>

        <!-- Rewards Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
          <div class="bg-card rounded-lg border border-border shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-2 bg-green-100 rounded-lg">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                </svg>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-muted-foreground">Total Rewards</p>
                <p class="text-2xl font-bold text-foreground">{{totalRewards}}</p>
              </div>
            </div>
          </div>
          <div class="bg-card rounded-lg border border-border shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-2 bg-blue-100 rounded-lg">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-muted-foreground">Reward Types</p>
                <p class="text-2xl font-bold text-foreground">{{rewards.length}}</p>
              </div>
            </div>
          </div>
          <div class="bg-card rounded-lg border border-border shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-2 bg-yellow-100 rounded-lg">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-muted-foreground">Latest Reward</p>
                <p class="text-2xl font-bold text-foreground">{{#if rewards.0}}{{rewards.0.amount}}{{else}}0{{/if}}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Rewards History -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">Reward History</h2>
            {{#if rewards.length}}
              <div class="space-y-4">
                {{#each rewards}}
                  <div class="flex items-center justify-between p-4 border border-border rounded-lg">
                    <div class="flex items-center space-x-4">
                      <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                        </svg>
                      </div>
                      <div>
                        <p class="font-medium text-foreground capitalize">{{type}} Reward</p>
                        <p class="text-sm text-muted-foreground">{{formatDate created_at}}</p>
                      </div>
                    </div>
                    <div class="text-right">
                      <p class="text-lg font-bold text-green-600">+{{amount}}</p>
                      <p class="text-sm text-muted-foreground">credits</p>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="text-muted-foreground text-center py-8">No rewards earned yet.</p>
            {{/if}}
          </div>
        </div>

      </div>
    </div>
  </main>
</div>