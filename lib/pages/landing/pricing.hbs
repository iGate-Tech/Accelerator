<!-- Pricing Section -->
<div id="pricing" class="py-24 relative z-10 mx-auto max-w-7xl">
  <!-- Section Header -->
  <div class="text-center mb-12 mx-auto max-w-3xl">
    <div class="flex items-center gap-3 mb-8 px-4 py-1.5 rounded-full border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/5 backdrop-blur-sm w-fit mx-auto">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-500 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
      </span>
       <span class="text-xs font-mono text-purple-500 uppercase tracking-[0.2em] font-medium">
         (t "landing.pricing.badge")</span>
    </div>

     <h2 class="text-5xl md:text-6xl lg:text-7xl font-serif font-medium tracking-tight text-gray-900 dark:text-white mb-6">
       (t "landing.pricing.title_choose")
       <span class="text-gray-600 dark:text-white/60">(t "landing.pricing.title_path")</span>
     </h2>

     <p class="text-xl text-gray-700 dark:text-white/60 leading-relaxed max-w-2xl mx-auto font-light tracking-tight mb-8">
       (t "landing.pricing.description")
     </p>
  </div>

  <!-- Pricing Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Basic Plan -->
    <div class="relative flex flex-col p-8 rounded-3xl border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/[0.02] backdrop-blur-sm hover:border-purple-500/20 transition-all duration-300 group">
       <div class="mb-6">
         <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-2">(t "landing.pricing.starter")</h3>
         <p class="text-gray-600 dark:text-white/60 text-sm">(t "landing.pricing.starter_desc")</p>
       </div>

       <div class="mb-8">
         <div class="flex items-baseline">
           <span class="text-4xl font-bold text-gray-900 dark:text-white">(t "landing.pricing.price_0")</span>
           <span class="text-gray-600 dark:text-white/60 ml-2">(t "landing.pricing.per_month")</span>
         </div>
         <p class="text-gray-500 dark:text-white/40 text-xs mt-2">(t "landing.pricing.free_forever")</p>
       </div>

       <ul class="space-y-4 mb-8 flex-grow">
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.starter_feature1")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.starter_feature2")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.starter_feature3")
         </li>
       </ul>

       <button class="w-full py-3 px-6 rounded-full bg-gray-200 dark:bg-white/10 hover:bg-gray-300 dark:hover:bg-white/20 text-gray-900 dark:text-white font-medium transition-colors">
         (t "landing.pricing.get_started_free")
       </button>
    </div>

    <!-- Pro Plan -->
    <div class="relative flex flex-col p-8 rounded-3xl border-2 border-purple-500/50 bg-gradient-to-b from-purple-500/10 to-transparent backdrop-blur-sm hover:border-purple-500 transition-all duration-300 group">
      <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
         <span class="bg-purple-500 text-black text-xs font-bold px-3 py-1 rounded-full">(t "landing.pricing.most_popular")</span>
      </div>

       <div class="mb-6">
         <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-2">(t "landing.pricing.professional")</h3>
         <p class="text-gray-600 dark:text-white/60 text-sm">(t "landing.pricing.professional_desc")</p>
       </div>

       <div class="mb-8">
         <div class="flex items-baseline">
           <span class="text-4xl font-bold text-gray-900 dark:text-white">(t "landing.pricing.price_29")</span>
           <span class="text-gray-600 dark:text-white/60 ml-2">(t "landing.pricing.per_month")</span>
         </div>
         <p class="text-gray-500 dark:text-white/40 text-xs mt-2">(t "landing.pricing.billed_monthly")</p>
       </div>

       <ul class="space-y-4 mb-8 flex-grow">
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.pro_feature1")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.pro_feature2")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.pro_feature3")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.pro_feature4")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.pro_feature5")
         </li>
       </ul>

       <button class="w-full py-3 px-6 rounded-full bg-purple-500 hover:bg-purple-600 text-black font-medium transition-colors">
         (t "landing.pricing.start_pro_trial")
       </button>
    </div>

    <!-- Enterprise Plan -->
    <div class="relative flex flex-col p-8 rounded-3xl border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/[0.02] backdrop-blur-sm hover:border-purple-500/20 transition-all duration-300 group">
       <div class="mb-6">
         <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-2">(t "landing.pricing.enterprise")</h3>
         <p class="text-gray-600 dark:text-white/60 text-sm">(t "landing.pricing.enterprise_desc")</p>
       </div>

       <div class="mb-8">
         <div class="flex items-baseline">
           <span class="text-4xl font-bold text-gray-900 dark:text-white">(t "landing.pricing.price_99")</span>
           <span class="text-gray-600 dark:text-white/60 ml-2">(t "landing.pricing.per_month")</span>
         </div>
         <p class="text-gray-500 dark:text-white/40 text-xs mt-2">(t "landing.pricing.custom_pricing")</p>
       </div>

       <ul class="space-y-4 mb-8 flex-grow">
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.enterprise_feature1")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.enterprise_feature2")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.enterprise_feature3")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.enterprise_feature4")
         </li>
         <li class="flex items-center text-gray-700 dark:text-white/80 text-sm">
{{{icon 'check' class='w-4 h-4 text-green-500 mr-3' size='24'}}}
           (t "landing.pricing.enterprise_feature5")
         </li>
       </ul>

       <button class="w-full py-3 px-6 rounded-full bg-gray-200 dark:bg-white/10 hover:bg-gray-300 dark:hover:bg-white/20 text-gray-900 dark:text-white font-medium transition-colors">
         (t "landing.pricing.contact_sales")
       </button>
    </div>
  </div>

  <!-- FAQ or Additional Info -->
   <div class="text-center mt-16">
     <p class="text-gray-600 dark:text-white/60 text-sm">
       (t "landing.pricing.trial_info")
     </p>
   </div>
</div>