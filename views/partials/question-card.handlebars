<div class="mx-auto flex flex-col items-center justify-center gap-4 p-4">
    <h1
      id="question-card-title"
      class="text-2xl sm:text-3xl md:text-4xl font-sans font-light text-foreground mb-2 sm:mb-2 text-center"
      data-i18n="title"
    >
     {{{title}}}
   </h1>

     <div
       class="card w-full max-w-lg min-w-[800px] mx-auto bg-base-100 transition-shadow duration-3000 border border-base-200 hover:border-primary/30 rounded-lg overflow-hidden relative p-4"
     >
    <!-- Description wrapper -->
    <div class="pl-4 pr-2 relative">
   
      <div
        class="w-full rounded-md border border-base-300 bg-base-100 px-3 py-2 text-base text-base-content min-h-[2.5rem] cursor-pointer overflow-visible markdown-content"
        style="display: none;"
      ></div>
       <textarea
         id="question-content"
          placeholder="{{placeholder}}"
          data-i18n="placeholder"

        class="flex w-full rounded-md border-0 bg-transparent p-0 pt-[1px] text-base text-base-content placeholder:text-base-content/60 focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0"

        rows="3"
        style="resize: none; overflow: hidden;"
      >{{{content}}}</textarea>
    </div>
       {{> toolbar}}

      <!-- Chat Section -->
      <div id="chat-section" class="mt-4 max-h-64 overflow-y-auto">
        <!-- Sample chat messages -->
        <div class="chat chat-start">
          <div class="chat-image avatar">
            <div class="w-10 rounded-full">
              <img src="/favicon.svg" alt="AI" />
            </div>
          </div>
          <div class="chat-header">
            AI Assistant
            <time class="text-xs opacity-50">2 min ago</time>
          </div>
          <div class="chat-bubble">Hello, how can I help you today?</div>
          <div class="chat-footer opacity-50">Delivered</div>
        </div>
        <div class="chat chat-end">
          <div class="chat-image avatar">
            <div class="w-10 rounded-full">
              <img src="/avatar.png" alt="User" />
            </div>
          </div>
          <div class="chat-header">
            You
            <time class="text-xs opacity-50">1 min ago</time>
          </div>
          <div class="chat-bubble">I need assistance with this question.</div>
          <div class="chat-footer opacity-50">Seen</div>
        </div>
        <div class="chat chat-start">
          <div class="chat-image avatar">
            <div class="w-10 rounded-full">
              <img src="/favicon.svg" alt="AI" />
            </div>
          </div>
          <div class="chat-header">
            AI Assistant
            <time class="text-xs opacity-50">30 sec ago</time>
          </div>
          <div class="chat-bubble">Sure, let's dive in!</div>
          <div class="chat-footer opacity-50">Delivered</div>
        </div>
      </div>

      <!-- Chat Input -->
      <div class="mt-4 flex gap-2">
        <textarea
          id="chat-input"
          placeholder="Chat with AI..."
          class="textarea textarea-bordered flex-1"
          rows="2"
        ></textarea>
        <button class="btn btn-primary self-end" id="send-chat-btn">
          <i data-lucide="send" class="lucide lucide-send w-4 h-4"></i>
        </button>
      </div>

      </div>
   </div>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const card = document.querySelector('.card');
  if (card) {
    const colors = ['rgba(255,0,0,0.5)', 'rgba(255,165,0,0.5)', 'rgba(255,255,0,0.5)', 'rgba(0,255,0,0.5)', 'rgba(0,0,255,0.5)', 'rgba(75,0,130,0.5)', 'rgba(238,130,238,0.5)'];
    // Start with purple
    card.style.boxShadow = '0px 10px 60px 0px rgba(238,130,238,0.5)';
    function animate() {
      const time = Date.now() * 0.001; // seconds
      const x = Math.random() * 100 - 50;
      const y = Math.random() * 40 - 10;
      const blur = 60 + Math.random() * 40; // 60 to 100
      const spread = Math.random() * 10 - 5;
      const colorIndex = Math.floor(time * 0.1) % colors.length;
      const color = colors[colorIndex];
      card.style.boxShadow = `${x}px ${y}px ${blur}px ${spread}px ${color}`;
      const delay = Math.random() * 3000 + 1000; // 1000 to 4000ms
      setTimeout(animate, delay);
    }
    // Start animating after a short delay
    setTimeout(animate, 1000);
  }
});

// Function to decode HTML entities
function decodeHtmlEntities(str) {
  const textarea = document.createElement('textarea');
  textarea.innerHTML = str;
  return textarea.value;
}

// Initialize reactive question object
window.currentQuestion = {
  title: decodeHtmlEntities('{{title}}'),
  content: decodeHtmlEntities('{{content}}'),
  placeholder: decodeHtmlEntities('{{placeholder}}')
};

// Function to update the UI from the currentQuestion object
window.updateQuestionCard = function() {
  const titleEl = document.getElementById('question-card-title');
  const contentEl = document.getElementById('question-content');
  if (titleEl) titleEl.innerHTML = window.currentQuestion.title || '';  // Use innerHTML to render HTML
  if (contentEl) {
    contentEl.value = window.currentQuestion.content || '';
    contentEl.setAttribute('placeholder', window.currentQuestion.placeholder || '');
  }
};

// Initially update the card with server-rendered data
window.updateQuestionCard();

// Initialize chat functionality
document.getElementById('send-chat-btn').addEventListener('click', () => {
  const input = document.getElementById('chat-input');
  const message = input.value.trim();
  if (message) {
    addChatMessage('user', message);
    input.value = '';
    // Simulate AI response
    setTimeout(() => {
      addChatMessage('ai', 'That\'s a great question! Let me think...');
    }, 1000);
  }
});

function addChatMessage(type, message) {
  const chatSection = document.getElementById('chat-section');
  const chatDiv = document.createElement('div');
  chatDiv.className = `chat chat-${type === 'ai' ? 'start' : 'end'}`;
  const now = new Date();
  const time = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
  chatDiv.innerHTML = `
    <div class="chat-image avatar">
      <div class="w-10 rounded-full">
        <img src="${type === 'ai' ? '/favicon.svg' : '/avatar.png'}" alt="${type === 'ai' ? 'AI' : 'User'}" />
      </div>
    </div>
    <div class="chat-header">
      ${type === 'ai' ? 'AI Assistant' : 'You'}
      <time class="text-xs opacity-50">${time}</time>
    </div>
    <div class="chat-bubble">${message}</div>
    <div class="chat-footer opacity-50">${type === 'ai' ? 'Delivered' : 'Sent'}</div>
  `;
  chatSection.appendChild(chatDiv);
  chatSection.scrollTop = chatSection.scrollHeight;
}

// Initialize Lucide icons for the card and toolbar
if (window.lucide) {
  lucide.createIcons();
}
</script>