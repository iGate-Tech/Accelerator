{{!< main}}
    <div class="max-w-6xl lg:max-w-7xl mx-auto">
        <div class="bg-base-100 rounded-xl shadow-lg border border-base-200 p-10 lg:p-12">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-12 gap-6">
                <h1 class="text-4xl lg:text-5xl font-bold text-base-content leading-tight">{{idea.name}}</h1>
                <div class="flex gap-4">
                    <form action="/delete/{{idea.id}}" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this idea?')">
                        <button type="submit" class="btn btn-error btn-sm hover:btn-error transition-colors">
                            <i data-lucide="trash" class="w-4 h-4"></i>
                            Delete
                        </button>
                    </form>
                    <a href="/" class="btn btn-outline btn-sm hover:btn-outline transition-colors">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        Back to Ideas
                    </a>
                </div>
            </div>

            <div class="lg:flex lg:space-x-12">
                <div class="lg:w-1/4 mb-8 lg:mb-0">
                    <div class="sticky top-6">
                        <h3 class="text-xl font-semibold text-base-content mb-6">Sections</h3>
                        <nav class="space-y-2">
                            {{#each idea.models}}
                                {{#each sections}}
                                    <a href="#section-{{@../../index}}-{{@../index}}" class="block px-4 py-3 rounded-lg hover:bg-base-200 transition-colors text-base-content">
                                        {{name}}
                                    </a>
                                {{/each}}
                            {{/each}}
                        </nav>
                    </div>
                </div>
                <div class="lg:w-3/4">
                    {{#each idea.models}}
                        <div class="mb-12">
                            <h2 class="text-3xl font-semibold text-base-content mb-8 border-b border-base-300 pb-4">{{name}}</h2>
                             {{#each sections}}
                                 <div id="section-{{@../../index}}-{{@../index}}" class="mb-8">
                                     <div class="collapse collapse-arrow bg-base-50 border border-base-200 rounded-xl hover:bg-base-100 transition-colors">
                                         <input type="checkbox" />
                                         <div class="collapse-title text-2xl font-semibold text-base-content px-8 py-6">
                                             {{name}}
                                         </div>
                                         <div class="collapse-content px-8 pb-8">
                                        {{#each questions}}
                                            {{#if answer}}
                                                <div class="mb-8 last:mb-0">
                                                    <h4 class="font-bold text-base-content mb-4 text-lg">{{question}}</h4>
                                                    <div class="answer-container">
                                                        <div class="answer-display bg-white border border-base-200 rounded-lg p-6 text-base-content/90 shadow-sm text-base leading-relaxed" style="min-height: 120px;">
                                                            {{{markdown answer}}}
                                                        </div>
                                                        <div class="answer-edit hidden">
                                                            <form action="/update-answer" method="post" class="space-y-4">
                                                                <input type="hidden" name="id" value="{{../../idea.id}}" />
                                                                <input type="hidden" name="modelIndex" value="{{@../../index}}" />
                                                                <input type="hidden" name="sectionIndex" value="{{@../index}}" />
                                                                <input type="hidden" name="questionIndex" value="{{@index}}" />
                                                                <textarea name="answer" class="w-full p-4 border border-base-300 rounded-lg resize-none focus:outline-none focus:ring-2 focus:ring-primary text-base" placeholder="Enter your answer..." style="min-height: 120px;">{{answer}}</textarea>
                                                                <div class="flex gap-3 justify-end">
                                                                    <button type="button" class="btn btn-ghost cancel-edit">Cancel</button>
                                                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                        <button class="btn btn-outline edit-btn mt-4">Edit</button>
                                                    </div>
                                                </div>
                                            {{/if}}
                                        {{/each}}
                                         </div>
                                     </div>
                                 </div>
                            {{/each}}
                        </div>
                    {{/each}}
                </div>
            </div>
             </div>
         </div>
     </div>

 <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Auto-resize textareas
        const textareas = document.querySelectorAll('textarea[name="answer"]');
        textareas.forEach(textarea => {
            function autoResize() {
                textarea.style.overflow = 'hidden';
                textarea.style.height = 'auto';
                textarea.style.height = textarea.scrollHeight + 'px';
            }
            textarea.addEventListener('input', autoResize);
            textarea.addEventListener('change', autoResize);
            setTimeout(autoResize, 100); // Initial resize after render
        });

        // Toggle edit mode
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('edit-btn')) {
                const container = e.target.parentElement;
                const display = container.querySelector('.answer-display');
                const edit = container.querySelector('.answer-edit');
                display.classList.add('hidden');
                edit.classList.remove('hidden');
                e.target.classList.add('hidden');
            }
            if (e.target.classList.contains('cancel-edit')) {
                const container = e.target.closest('.answer-container');
                const display = container.querySelector('.answer-display');
                const edit = container.querySelector('.answer-edit');
                const editBtn = container.querySelector('.edit-btn');
                display.classList.remove('hidden');
                edit.classList.add('hidden');
                editBtn.classList.remove('hidden');
            }
        });

        // Smooth scroll for sidebar links
        document.querySelectorAll('nav a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    });
</script>