{{!< main}}
<div class="flex gap-10 justify-center items-center min-h-[85vh]">
  
  {{> sidebar}}

  <div class="flex items-center gap-8">

    <div class="flex flex-col items-center">
      <div class="flex mb-10 justify-center items-center">
