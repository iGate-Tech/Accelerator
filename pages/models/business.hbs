    "position": 0
  },
  {
    "id": "market-section",
    "fullLabel": "2. Market Section",
    "shortLabel": "2.",
    "position": 16.67
  },
  {
    "id": "competition-analysis",
    "fullLabel": "3. Competition Analysis",
    "shortLabel": "3.",
    "position": 33.33
  },
  {
    "id": "risk-register",
    "fullLabel": "4. Risk Register",
    "shortLabel": "4.",
    "position": 50
  },
  {
    "id": "value-proposition",
    "fullLabel": "5. Value Proposition",
    "shortLabel": "5.",
    "position": 66.67
  },
