<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <!-- Report Header -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden mb-8">
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 px-8 py-6 text-white">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold mb-2">{{report.ideas.title}} - {{report.report_type}}</h1>
            <p class="text-blue-100">{{report.ideas.description}}</p>
          </div>
          <div class="text-right">
            <div class="text-sm opacity-90">Generated on</div>
            <div class="text-lg font-semibold">{{formatDate report.generated_at}}</div>
          </div>
        </div>
      </div>

      <div class="px-8 py-6 bg-gray-50 border-b">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
              {{#if (eq report.report_type "business-plan")}}
                {{{ icon 'building-2' class='w-6 h-6 text-blue-600' }}}
              {{else if (eq report.report_type "pitch-deck")}}
                {{{ icon 'presentation' class='w-6 h-6 text-blue-600' }}}
              {{else if (eq report.report_type "valuation")}}
                {{{ icon 'dollar-sign' class='w-6 h-6 text-blue-600' }}}
              {{/if}}
            </div>
            <div>
              <h2 class="text-xl font-semibold text-gray-900 capitalize">{{report.report_type}}</h2>
              <p class="text-gray-600">AI-generated professional report</p>
            </div>
          </div>

          <div class="flex space-x-3">
            <button onclick="window.print()" class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 transition-colors flex items-center space-x-2">
              {{{ icon 'printer' class='w-4 h-4' }}}
              <span>Print</span>
            </button>
            <button onclick="downloadPDF()" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors flex items-center space-x-2">
              {{{ icon 'download' class='w-4 h-4' }}}
              <span>Download PDF</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Report Content -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
      <div class="px-8 py-6">
        <div class="prose prose-lg max-w-none">
          {{{formatReportContent report.report_data.content}}}
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-8 text-center text-gray-600">
      <p>Report generated by Accelerator AI • Confidential</p>
    </div>
  </div>
</div>

<script>
// Format the report content with proper HTML structure
function formatReportContent(content) {
  if (!content) return '<p>No content available</p>';

  // Split content by main sections (assuming sections are marked with numbers or headers)
  const sections = content.split(/\n(?=\d+\.|EXECUTIVE SUMMARY|COMPANY DESCRIPTION|MARKET ANALYSIS|COMPETITIVE ANALYSIS|MARKETING|FINANCIAL|TEAM|BUSINESS MODEL|TECHNICAL|LEGAL|OPERATIONAL|RISK|VALUATION|CONCLUSION|CLOSING)/i);

  let formattedContent = '';

  sections.forEach(section => {
    if (section.trim()) {
      // Check if it's a main section header
      if (/^\d+\.|EXECUTIVE SUMMARY|COMPANY DESCRIPTION|MARKET ANALYSIS|COMPETITIVE ANALYSIS|MARKETING|FINANCIAL|TEAM|BUSINESS MODEL|TECHNICAL|LEGAL|OPERATIONAL|RISK|VALUATION|CONCLUSION|CLOSING/i.test(section)) {
        // Main section header
        const headerMatch = section.match(/^(.+?)(?:\n|$)/);
        if (headerMatch) {
          const header = headerMatch[1].trim();
          const content = section.substring(header.length).trim();

          formattedContent += `
            <section class="mb-8">
              <h2 class="text-2xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">${header}</h2>
              <div class="prose prose-gray max-w-none">
                ${formatSectionContent(content)}
              </div>
            </section>
          `;
        }
      } else if (section.trim()) {
        // Regular content section
        formattedContent += `
          <section class="mb-6">
            <div class="prose prose-gray max-w-none">
              ${formatSectionContent(section)}
            </div>
          </section>
        `;
      }
    }
  });

  return formattedContent;
}

// Format individual section content
function formatSectionContent(content) {
  if (!content) return '';

  // Convert line breaks to paragraphs
  let formatted = content
    // Convert bullet points
    .replace(/^•\s*/gm, '<li>')
    .replace(/^-\s*/gm, '<li>')
    .replace(/^\*\s*/gm, '<li>')
    // Handle numbered lists
    .replace(/^\d+\.\s*/gm, '<li>')
    // Convert paragraphs (double line breaks)
    .split(/\n\s*\n/)
    .map(paragraph => {
      paragraph = paragraph.trim();
      if (!paragraph) return '';

      // Check if it's a list
      if (paragraph.includes('<li>')) {
        return `<ul class="list-disc list-inside space-y-1 mb-4">${paragraph}</ul>`;
      }

      // Check if it's a numbered list
      if (paragraph.match(/^\d+\./m)) {
        return `<ol class="list-decimal list-inside space-y-1 mb-4">${paragraph.replace(/^\d+\.\s*/gm, '<li>')}</ol>`;
      }

      // Regular paragraph
      return `<p class="mb-4 leading-relaxed text-gray-700">${paragraph}</p>`;
    })
    .join('');

  // Handle bold text (**text** or *text*)
  formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-gray-900">$1</strong>');
  formatted = formatted.replace(/\*(.*?)\*/g, '<em class="italic">$1</em>');

  // Handle dollar amounts and numbers
  formatted = formatted.replace(/\$(\d+(?:,\d{3})*(?:\.\d{2})?)/g, '<span class="font-semibold text-green-600">$$$1</span>');

  return formatted;
}

// Download as PDF (placeholder - would need a proper PDF generation library)
function downloadPDF() {
  alert('PDF download feature would be implemented with a library like Puppeteer or jsPDF');
}
</script>

<style>
.prose {
  color: color-mix(in oklab, var(--color-foreground), transparent 80%);
}

.prose h2 {
  color: #111827;
  font-weight: 700;
  margin-bottom: 1rem;
}

.prose h3 {
  color: #111827;
  font-weight: 600;
  margin-bottom: 0.75rem;
}

.prose p {
  margin-bottom: 1rem;
  line-height: 1.7;
}

.prose ul, .prose ol {
  margin-bottom: 1rem;
  padding-left: 1.5rem;
}

.prose li {
  margin-bottom: 0.25rem;
}

.prose strong {
  font-weight: 600;
  color: #111827;
}

.prose em {
  font-style: italic;
}

@media print {
  .print\\:hidden {
    display: none !important;
  }

  body {
    background: white !important;
  }

  .prose {
    font-size: 12pt;
    line-height: 1.4;
  }
}
</style>