<nav class="bg-base-100 text-foreground px-2 sm:px-4 border-b border-input flex items-center justify-between min-h-12">
  <div class="flex items-center gap-2 sm:gap-4">
    <div class="h-6 w-6 ml-1 mr-4 sm:mr-6 text-primary"><img src="/images/favicon.svg" class="h-full w-full" /></div>

     <div class="hidden md:flex items-center gap-2 sm:gap-4">
       <div class="flex flex-col items-center justify-center group">
         <div class="border-t-4 border-primary w-6 rounded-md{{#if (eq activeNav 'projects')}} opacity-100{{else}} opacity-0 group-hover:opacity-100{{/if}}"></div>
         <a href="/new-idea"
           class="text-{{#if (eq activeNav 'projects')}}primary{{else}}muted-foreground group-hover:text-foreground hover:text-foreground{{/if}} font-medium text-sm leading-[2.7] group-hover:font-medium hover:font-medium">
           <span class="nav-text">Projects</span>
         </a>
       </div>
       <div class="flex flex-col items-center justify-center group">
         <div class="border-t-4 border-primary w-6 rounded-md{{#if (eq activeNav 'dashboard')}} opacity-100{{else}} opacity-0 group-hover:opacity-100{{/if}}"></div>
         <a href="/dashboard"
           class="text-{{#if (eq activeNav 'dashboard')}}primary{{else}}muted-foreground group-hover:text-foreground hover:text-foreground{{/if}} font-medium text-sm leading-[2.7] group-hover:font-medium hover:font-medium">
           <span class="nav-text">Dashboard</span>
         </a>
       </div>
       {{#if (eq user.profile.package_type "enterprise")}}
       <div id="nav-portfolio-item" class="flex flex-col items-center justify-center group">
         <div class="border-t-4 border-primary w-6 rounded-md{{#if (eq activeNav 'portfolios')}} opacity-100{{else}} opacity-0 group-hover:opacity-100{{/if}}"></div>
         <a href="/portfolios"
           class="text-{{#if (eq activeNav 'portfolios')}}primary{{else}}muted-foreground group-hover:text-foreground hover:text-foreground{{/if}} font-medium text-sm leading-[2.7] group-hover:font-medium hover:font-medium">
           <span class="nav-text">Portfolio</span>
         </a>
       </div>
       {{/if}}
       <div class="flex flex-col items-center justify-center group">
         <div class="border-t-4 border-primary w-6 rounded-md{{#if (eq activeNav 'voting')}} opacity-100{{else}} opacity-0 group-hover:opacity-100{{/if}}"></div>
         <a href="/voting-reward"
           class="text-{{#if (eq activeNav 'voting')}}primary{{else}}muted-foreground group-hover:text-foreground hover:text-foreground{{/if}} font-medium text-sm leading-[2.7] group-hover:font-medium hover:font-medium focus:outline-none">
           <span class="nav-text">Voting &amp; Rewards</span>
         </a>
       </div>
    </div>
  </div>
  <div class="flex items-center">
     <div class="h-12 w-px bg-border"></div>
     <!-- Credit Balance -->
    <div class="hidden md:flex items-center gap-2 px-3 py-2 ml-4">

      {{{icon 'coins' class='w-5 h-5 text-primary' size='16'}}}

       <span id="nav-credit-balance" class="text-sm font-medium">{{user.profile.credit_balance}} Credits</span>
    </div>

    <!-- Theme Toggle Button -->
    <button id="theme-toggle"
      class="ml-4 self-center w-6 h-6 text-muted-foreground hover:text-primary rounded-full cursor-pointer font-medium border-0"
      onclick="toggleTheme()">
      <span id="theme-icon-light">{{{icon "sun" class="h-5 w-5"}}}</span>
      <span id="theme-icon-dark" class="hidden">{{{icon
        "moon"
        class="h-5 w-5"
        }}}</span>
    </button>

    <!-- Language Switcher -->
    <button id="lang-switcher" class="flex items-center gap-1 ml-4 px-2 py-1 text-xs font-medium rounded-md bg-muted text-muted-foreground hover:bg-primary hover:text-primary-foreground" onclick="switchLanguage()">
      {{{icon "languages" class="h-4 w-4"}}}
      <span id="lang-text">EN</span>
    </button>

    <!-- Notification Button -->
    <a href="/notification"
      class="ml-4 self-center w-6 h-6 text-muted-foreground hover:text-primary rounded-full cursor-pointer font-medium border-0 flex items-center justify-center relative">
      {{{icon "bell" class="h-5 w-5"}}}
      <span id="nav-notification-indicator" class="absolute -top-1 -right-1 h-2 w-2 bg-red-500 rounded-full hidden"></span>
    </a>

    <!-- Grid Menu -->
    <div class="relative self-center" id="grid-menu">
      <button onclick="toggleGridMenu()"
        class="ml-4 text-muted-foreground hover:text-primary rounded-full p-2 cursor-pointer font-medium border-0">

        {{{icon 'grip' class='w-4 h-4' size='16'}}}

      </button>

      <!-- Grid Dropdown -->
      <div
        class="absolute right-0 mt-2 w-[200px] bg-popover backdrop-blur-sm border border-input/80 rounded-md shadow-xl z-30 transition-all duration-200 opacity-0 invisible hidden"
        id="grid-dropdown">
        <div class="p-1">
          <div class="px-2 py-1 text-sm font-medium text-muted-foreground">Quick Access</div>
          <div class="bg-border -mx-1 my-1 h-px"></div>
          <div role="group" class="p-1">
             <a href="/dashboard"
               class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

               <div class="flex flex-col">
                  <span class="flex">{{{icon 'layout-dashboard' class='mr-2 h-4 w-4' size='16'}}}Dashboard</span>
                 <span class="text-xs text-muted-foreground">Main dashboard overview</span>
               </div>
             </a>
              <div class="bg-border -mx-1 my-1 h-px"></div>
              <a href="/new-idea"
                class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

                <div class="flex flex-col">
                  <span class="flex">{{{icon 'plus' class='mr-2 h-4 w-4' size='16'}}}New Idea</span>
                  <span class="text-xs text-muted-foreground">Create a new project idea</span>
                </div>
              </a>
              <div class="bg-border -mx-1 my-1 h-px"></div>
               <a href="/explore-idea"
                 class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

                <div class="flex flex-col">
                  <span class="flex">{{{icon 'search' class='mr-2 h-4 w-4' size='16'}}}Explore Ideas</span>
                  <span class="text-xs text-muted-foreground">Discover public ideas</span>
                </div>
              </a>
              {{#if (eq user.profile.package_type "enterprise")}}
              <div class="bg-border -mx-1 my-1 h-px"></div>
              <a id="grid-portfolio-link" href="/portfolios"
                class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

                <div class="flex flex-col">
                  <span class="flex">{{{icon 'archive' class='mr-2 h-4 w-4' size='16'}}}Portfolios</span>
                  <span class="text-xs text-muted-foreground">Team collaboration platform</span>
                </div>
              </a>
              {{/if}}
            <div class="bg-border -mx-1 my-1 h-px"></div>
             <a href="/models/business"
               class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

               <div class="flex flex-col">
                  <span class="flex">{{{icon 'briefcase' class='mr-2 h-4 w-4' size='16'}}}Business Models</span>
                 <span class="text-xs text-muted-foreground">Startup management tools</span>
               </div>
             </a>
             <div class="bg-border -mx-1 my-1 h-px"></div>
             <a href="/user-activity"
               class="relative flex cursor-default select-none items-center rounded-sm px-2 py-2 text-sm outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

               <div class="flex flex-col">
                  <span class="flex">{{{icon 'activity' class='mr-2 h-4 w-4' size='16'}}}Activity</span>
                 <span class="text-xs text-muted-foreground">View your recent activity</span>
               </div>
             </a>
             <div class="bg-border -mx-1 my-1 h-px"></div>
           </div>
        </div>
      </div>
    </div>
    <!-- User Menu -->
    <div class="relative self-center" id="admin-user-menu">
      <button onclick="toggleUserMenu()"
        class="flex items-center gap-3 h-10 px-3 rounded-md transition-all duration-200 hover:text-primary cursor-pointer border-0"
        id="admin-user-menu-button">
        <img src="/images/avatar.png" class="h-6 w-6 rounded-full object-cover shrink-0 user-avatar" alt="User Avatar">


      </button>

      <!-- User Dropdown -->
      <div
        class="absolute right-0 mt-2 w-64 bg-base-100 border border-input rounded-md shadow-lg z-30 transition-all duration-200 opacity-0 invisible hidden"
        id="admin-user-dropdown">
        <div class="p-2">

          <!-- User profile section -->
          {{> user-info-link}}






          <!-- Upgrade Package -->
          <a href="/upgrade-package"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

            {{{icon "arrow-up-circle" class="h-4 w-4 shrink-0"}}}

            Upgrade Package
          </a>

          <!-- Buy Credits -->
          <a href="/buy-credits"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

            {{{icon "coins" class="h-4 w-4 shrink-0"}}}

            Buy Credits
          </a>

          <!-- Billing -->
          <a href="/billing"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

            {{{icon "credit-card" class="h-4 w-4 shrink-0"}}}

            Billing
          </a>

          <!-- Add Payment Method -->
          <a href="/add-payment-method"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

            {{{icon "plus-circle" class="h-4 w-4 shrink-0"}}}

            Add Payment Method
            </a>

            <!-- User Activity -->
          <a href="/user-activity"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

            {{{icon "activity" class="h-4 w-4 shrink-0"}}}

            User Activity
          </a>

          <!-- Separator -->
          <div class="border-t border-input -mx-1 my-1"></div>




          <!-- Log out item -->
          <a hx-post="/auth/logout"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors text-error hover:bg-error/10">

{{{icon 'log-out' class='h-4 w-4 shrink-0' size='16'}}}

            Log out
          </a>


        </div>
      </div>
    </div>
  </div>
</nav>

