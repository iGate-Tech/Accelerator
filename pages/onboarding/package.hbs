<div class="min-h-screen bg-base-100 flex items-center justify-center px-4">
  <div class="max-w-4xl w-full">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-foreground mb-2">Choose Your Package</h1>
      <p class="text-muted-foreground">Select the plan that best fits your needs</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <!-- Starter Plan -->
      <div class="bg-card border border-border rounded-lg p-6 hover:shadow-lg transition">
        <div class="text-center mb-4">
          <h2 class="text-xl font-semibold mb-2">Starter</h2>
          <div class="text-3xl font-bold text-primary mb-1">$0</div>
          <p class="text-sm text-muted-foreground">Free forever</p>
        </div>
        <ul class="space-y-2 mb-6 text-sm">
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>5 AI generations per month</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Basic templates</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Email support</li>
        </ul>
        <button class="w-full bg-secondary hover:bg-secondary/80 text-secondary-foreground py-2 px-4 rounded-md transition" onclick="selectPackage('starter')">
          Select Starter
        </button>
      </div>

      <!-- Professional Plan -->
      <div class="bg-card border border-border rounded-lg p-6 hover:shadow-lg transition relative">
        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-primary text-primary-foreground px-3 py-1 rounded-full text-xs font-semibold">Most Popular</div>
        <div class="text-center mb-4">
          <h2 class="text-xl font-semibold mb-2">Professional</h2>
          <div class="text-3xl font-bold text-primary mb-1">$29</div>
          <p class="text-sm text-muted-foreground">per month</p>
        </div>
        <ul class="space-y-2 mb-6 text-sm">
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Unlimited AI generations</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>All templates</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Priority support</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Advanced analytics</li>
        </ul>
        <button class="w-full bg-primary hover:bg-primary/80 text-primary-foreground py-2 px-4 rounded-md transition" onclick="selectPackage('professional')">
          Select Professional
        </button>
      </div>

      <!-- Enterprise Plan -->
      <div class="bg-card border border-border rounded-lg p-6 hover:shadow-lg transition">
        <div class="text-center mb-4">
          <h2 class="text-xl font-semibold mb-2">Enterprise</h2>
          <div class="text-3xl font-bold text-primary mb-1">$99</div>
          <p class="text-sm text-muted-foreground">per month</p>
        </div>
        <ul class="space-y-2 mb-6 text-sm">
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Everything in Professional</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Team collaboration</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Dedicated account manager</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>Custom integrations</li>
        </ul>
        <button class="w-full bg-secondary hover:bg-secondary/80 text-secondary-foreground py-2 px-4 rounded-md transition" onclick="selectPackage('enterprise')">
          Select Enterprise
        </button>
      </div>
    </div>

    <div class="text-center mt-8">
      <p class="text-sm text-muted-foreground">You can change your plan anytime from your account settings.</p>
    </div>
  </div>
</div>

<script>
function selectPackage(packageType) {
  // Submit the form or make API call to set package
  fetch('/api/user/package', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ package_type: packageType }),
    credentials: 'same-origin'
  })
  .then(response => {
    if (response.ok) {
      window.location.href = '/onboarding/profile';
    }
  })
  .catch(error => console.error('Error:', error));
}
</script>