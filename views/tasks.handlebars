<script>
document.addEventListener('DOMContentLoaded', () => {
  // Initialize Lucide icons
  if (window.lucide) {
    lucide.createIcons();
  }

  // Auto-scroll to bottom of chat
  const chatMessages = document.getElementById('chat-messages');
  if (chatMessages) {
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  // Agent selection functionality
  const agentCards = document.querySelectorAll('.agent-card');
  agentCards.forEach(card => {
    card.addEventListener('click', () => {
      // Remove active state from all cards
      agentCards.forEach(c => c.classList.remove('ring-2', 'ring-white/50'));
      // Add active state to clicked card
      card.classList.add('ring-2', 'ring-white/50');

      // Here you could switch the chat context
      const agentName = card.querySelector('h3').textContent;
      console.log('Selected agent:', agentName);
    });
  });

  // Make first agent active by default
  if (agentCards.length > 0) {
    agentCards[0].classList.add('ring-2', 'ring-white/50');
  }

  // Typing indicator (simulate)
  setTimeout(() => {
    // Could add typing indicator here
  }, 2000);
});
</script>

<style>
@keyframes slide-in {
