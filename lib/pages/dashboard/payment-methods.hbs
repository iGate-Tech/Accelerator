<div class="flex h-[calc(100vh-4rem)]">
  {{> sidebar projects=projects lng=lng}}
  <main class="flex-1 overflow-y-auto bg-background">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8">
      <div class="space-y-8">

        <!-- Header -->
        <div class="text-center sm:text-left">
          <h1 class="text-3xl font-bold text-foreground">Payment Methods</h1>
          <p class="text-muted-foreground mt-2">Manage your saved payment methods</p>
        </div>

        <!-- Saved Payment Methods -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">Saved Cards</h2>
            {{#if paymentMethods.length}}
              <div class="space-y-4">
                {{#each paymentMethods}}
                  <div class="flex items-center justify-between p-4 border border-border rounded-lg">
                    <div class="flex items-center space-x-4">
                      <div class="w-10 h-8 bg-muted rounded flex items-center justify-center text-xs font-bold text-muted-foreground">
                        ****
                      </div>
                      <div>
                        <p class="font-medium text-foreground">{{brand}} ending in {{last4}}</p>
                        <p class="text-sm text-muted-foreground">Expires 12/25</p>
                      </div>
                    </div>
                    <button class="text-destructive hover:text-destructive/80 text-sm font-medium">
                      Remove
                    </button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="text-muted-foreground text-center py-8">No saved payment methods.</p>
            {{/if}}
          </div>
        </div>

        <!-- Add New Payment Method -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">Add New Card</h2>
            <form method="POST" action="/payment-methods" class="space-y-4">
              <input type="hidden" name="_csrf" value="{{csrf}}"/>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2">
                  <label for="card_number" class="block text-sm font-medium text-foreground mb-2">Card Number</label>
                  <input type="text" id="card_number" name="card_number" placeholder="1234 5678 9012 3456" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
                <div>
                  <label for="expiry" class="block text-sm font-medium text-foreground mb-2">Expiry Date</label>
                  <input type="text" id="expiry" name="expiry" placeholder="MM/YY" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
                <div>
                  <label for="cvv" class="block text-sm font-medium text-foreground mb-2">CVV</label>
                  <input type="text" id="cvv" name="cvv" placeholder="123" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
                <div class="sm:col-span-2">
                  <label for="cardholder_name" class="block text-sm font-medium text-foreground mb-2">Cardholder Name</label>
                  <input type="text" id="cardholder_name" name="cardholder_name" placeholder="John Doe" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required/>
                </div>
              </div>
              <button type="submit" class="bg-primary hover:bg-primary/90 text-primary-foreground px-4 py-2 rounded-md font-medium transition-colors">
                Add Payment Method
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>