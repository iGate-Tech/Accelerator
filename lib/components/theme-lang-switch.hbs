{{#if show}}
{{!-- Theme and Language Switch Component --}}
<div class="flex justify-between items-center w-full">
  {{!-- Language Toggle --}}
  <button id="lang-toggle" class="flex items-center justify-center w-16 h-8 sm:w-10 sm:h-10 rounded-lg hover:bg-muted transition-colors" title="Switch Language">
    {{{icon 'languages' class='h-4 w-4 mr-1'}}}
    <span id="lang-text" class="text-sm font-medium">EN</span>
  </button>

  {{!-- Theme Toggle --}}
  <button id="theme-toggle" class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-lg hover:bg-muted transition-colors" title="Toggle Theme">
    {{{icon 'sun' class='w-4 h-4 sm:w-5 sm:h-5 text-yellow-500' id='sun-icon'}}}
    {{{icon 'moon' class='w-4 h-4 sm:w-5 sm:h-5 text-blue-500 hidden' id='moon-icon'}}}
  </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const langToggle = document.getElementById('lang-toggle');
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');
  const langText = document.getElementById('lang-text');

  // Language Toggle
  langToggle.addEventListener('click', function() {
    const currentLang = new URLSearchParams(window.location.search).get('lng') || 'en';
    const newLang = currentLang === 'ar' ? 'en' : 'ar';
    const newUrl = new URL(window.location);
    newUrl.searchParams.set('lng', newLang);
    window.location.href = newUrl.toString();
  });

  // Initialize language display
  const currentLang = new URLSearchParams(window.location.search).get('lng') || 'en';
  langText.textContent = currentLang.toUpperCase();

  // Theme Toggle
  let isDark = localStorage.getItem('theme') === 'dark' ||
               (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);

  function updateTheme() {
    document.documentElement.classList.toggle('dark', isDark);
    sunIcon.classList.toggle('hidden', isDark);
    moonIcon.classList.toggle('hidden', !isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  themeToggle.addEventListener('click', function() {
    isDark = !isDark;
    updateTheme();
  });

  // Initialize theme
  updateTheme();
});
</script>
{{/if}}