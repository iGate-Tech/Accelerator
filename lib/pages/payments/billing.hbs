<main id="billing-main-content" class="flex-1 overflow-auto bg-background">
   <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
     <div class="flex flex-col gap-4 lg:gap-6 mt-4 sm:mt-6">
       <!-- Header -->
       <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
         <div class="grid gap-1">
           <h1 class="font-heading text-2xl sm:text-3xl font-semibold text-foreground">
             {{t 'billing.title'}}
           </h1>
           <p class="text-base sm:text-lg text-muted-foreground">
 {{t 'billing.description'}}
           </p>
         </div>
         <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
           <button class="px-3 sm:px-4 py-2 text-sm font-medium border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-md transition-colors">
             {{t 'billing.export_transactions'}}
           </button>
           <a href="/add-payment-method" class="px-3 sm:px-4 py-2 text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 rounded-md transition-colors">
             {{t 'billing.add_payment_method'}}
           </a>
         </div>
      </div>

       <!-- Overview Cards -->
       <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
         <!-- Current Balance -->
         <div class="rounded-lg bg-card px-3 sm:px-4 py-4 sm:py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-2 sm:px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">{{t 'billing.current_balance'}}</h3>
               <p class="text-xl sm:text-2xl font-semibold text-foreground">{{billingStats.currentBalance}} {{t 'billing.credits'}}</p>
             </div>
             <div>
               <div class="bg-success/20 rounded-lg">
                 <div class="w-8 h-8 sm:w-10 sm:h-10 bg-success/20 rounded-lg relative">
                   <div class="flex items-center justify-center w-7 h-7 sm:w-9 sm:h-9 bg-success rounded-lg absolute top-0.5 left-0.5">
                     {{{icon 'coins' class='w-3 h-3 sm:w-4 sm:h-4 text-white' size='16'}}}
                   </div>
                 </div>
               </div>
             </div>
           </div>
           <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
             <span class="text-success">{{t 'billing.available'}}</span>
           </p>
         </div>

         <!-- Total Spent This Month -->
         <div class="rounded-lg bg-card px-3 sm:px-4 py-4 sm:py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-2 sm:px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">{{t 'billing.spent_this_month'}}</h3>
               <p class="text-xl sm:text-2xl font-semibold text-foreground">{{billingStats.spentThisMonth}} {{t 'billing.credits'}}</p>
             </div>
             <div>
               <div class="bg-primary/20 rounded-lg">
                 <div class="w-8 h-8 sm:w-10 sm:h-10 bg-primary/20 rounded-lg relative">
                   <div class="flex items-center justify-center w-7 h-7 sm:w-9 sm:h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">
                     {{{icon 'trending-up' class='w-3 h-3 sm:w-4 sm:h-4 text-white' size='16'}}}
                   </div>
                 </div>
               </div>
             </div>
           </div>
           <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
             <span class="text-muted-foreground">{{t 'billing.ai_usage_reports'}}</span>
           </p>
         </div>

         <!-- Current Package -->
         <div class="rounded-lg bg-card px-3 sm:px-4 py-4 sm:py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-2 sm:px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">{{t 'billing.current_package'}}</h3>
                <p class="text-xl sm:text-2xl font-semibold text-foreground">{{#if packageDetails}}{{packageDetails.name}}{{else}}{{capitalize profile.package_type}}{{/if}}</p>
             </div>
             <div>
               <div class="bg-secondary/20 rounded-lg">
                 <div class="w-8 h-8 sm:w-10 sm:h-10 bg-secondary/20 rounded-lg relative">
                   <div class="flex items-center justify-center w-7 h-7 sm:w-9 sm:h-9 bg-secondary rounded-lg absolute top-0.5 left-0.5">
                     {{{icon 'package' class='w-3 h-3 sm:w-4 sm:h-4 text-white' size='16'}}}
                   </div>
                 </div>
               </div>
             </div>
           </div>
           <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
             <span class="text-muted-foreground">
                   {{#if (eq profile.package_type "free")}}
                     {{t 'billing.basic_features'}}
                   {{else}}
                     ${{divide profile.package_price 100}}{{t 'dashboard.payments.upgrade.per_month'}}
                   {{/if}}
             </span>
           </p>
         </div>

         <!-- Pending Transactions -->
         <div class="rounded-lg bg-card px-3 sm:px-4 py-4 sm:py-6 text-card-foreground shadow-sm border border-border">
           <div class="flex items-center justify-between px-2 sm:px-3 py-1">
             <div class="flex flex-col gap-1">
               <h3 class="text-sm font-medium text-muted-foreground">{{t 'billing.pending_items'}}</h3>
               <p class="text-xl sm:text-2xl font-semibold text-foreground">{{billingStats.pendingPayments}}</p>
             </div>
             <div>
               <div class="bg-warning/20 rounded-lg">
                 <div class="w-8 h-8 sm:w-10 sm:h-10 bg-warning/20 rounded-lg relative">
                   <div class="flex items-center justify-center w-7 h-7 sm:w-9 sm:h-9 bg-warning rounded-lg absolute top-0.5 left-0.5">
                     {{{icon 'clock' class='w-3 h-3 sm:w-4 sm:h-4 text-white' size='16'}}}
                   </div>
                 </div>
               </div>
             </div>
           </div>
           <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
             <span class="text-warning">{{billingStats.pendingPayments}} {{t 'billing.transactions'}}</span>
           </p>
         </div>
      </div>

       <!-- Transaction History Section -->
       <div class="bg-card rounded-lg border border-border overflow-hidden">
         <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-border">
             <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
             <h2 class="text-lg sm:text-xl font-semibold text-foreground">{{t 'billing.transaction_history'}}</h2>
             <div class="flex items-center gap-2">
               <select id="transaction-filter" class="px-3 py-1.5 text-sm border border-input rounded-md bg-background w-full sm:w-auto">
                 <option value="all">{{t 'billing.all_transactions'}}</option>
                 <option value="billing">{{t 'billing.billing'}}</option>
                 <option value="credits">{{t 'billing.credits'}}</option>
                 <option value="rewards">{{t 'billing.rewards'}}</option>
               </select>
             </div>
           </div>
        </div>

        <!-- Transaction Table -->
        <div class="overflow-x-auto">
          <table class="w-full">
             <thead class="bg-muted/50">
               <tr>
                 <th class="px-3 sm:px-6 py-2 sm:py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">{{t 'billing.date'}}</th>
                 <th class="px-3 sm:px-6 py-2 sm:py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">{{t 'billing.type'}}</th>
                 <th class="px-3 sm:px-6 py-2 sm:py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">{{t 'billing.description'}}</th>
                 <th class="px-3 sm:px-6 py-2 sm:py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">{{t 'billing.amount'}}</th>
                 <th class="px-3 sm:px-6 py-2 sm:py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">{{t 'billing.status'}}</th>
                 <th class="px-3 sm:px-6 py-2 sm:py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">{{t 'billing.actions'}}</th>
               </tr>
             </thead>
            <tbody class="bg-card divide-y divide-border">
              {{#each transactions}}
              <tr class="hover:bg-muted/50 transaction-row" data-type="{{transaction_type}}">
                 <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-sm text-foreground">
                   <div class="flex items-center">
                     <div class="flex-shrink-0 w-6 h-6 sm:w-8 sm:h-8 {{#if (eq transaction_type "reward_earned")}}bg-yellow/10{{else if (eq transaction_type "credit_purchase")}}bg-green/10{{else if (eq transaction_type "ai_generation")}}bg-blue/10{{else if (eq transaction_type "report_generation")}}bg-purple/10{{else}}bg-gray/10{{/if}} rounded-full flex items-center justify-center mr-2 sm:mr-3">
                       {{#if (eq transaction_type "reward_earned")}}
                         {{{icon 'dollar-sign' class='w-3 h-3 sm:w-4 sm:h-4 text-yellow-600' size='16'}}}
                       {{else if (eq transaction_type "credit_purchase")}}
                         {{{icon 'coins' class='w-3 h-3 sm:w-4 sm:h-4 text-green-600' size='16'}}}
                       {{else if (eq transaction_type "billing")}}
                         {{{icon 'credit-card' class='w-3 h-3 sm:w-4 sm:h-4 text-primary' size='16'}}}
                       {{else if (eq transaction_type "ai_generation")}}
                         {{{icon 'brain' class='w-3 h-3 sm:w-4 sm:h-4 text-blue-600' size='16'}}}
                       {{else}}
                         {{{icon 'file' class='w-3 h-3 sm:w-4 sm:h-4 text-gray-600' size='16'}}}
                       {{/if}}
                     </div>
                     <div>
                       <div class="text-sm font-medium text-foreground">{{formatDate created_at "short"}}</div>
                       <div class="text-xs sm:text-sm text-muted-foreground">{{formatDate created_at "time"}}</div>
                     </div>
                   </div>
                 </td>
                 <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                   <span class="inline-flex px-2 py-1 text-xs font-medium {{#if (eq transaction_type "reward_earned")}}bg-yellow/10 text-yellow-700{{else if (eq transaction_type "credit_purchase")}}bg-green/10 text-green-700{{else if (eq transaction_type "billing")}}bg-primary/10 text-primary{{else if (eq transaction_type "ai_generation")}}bg-blue/10 text-blue-700{{else}}bg-gray/10 text-gray-700{{/if}} rounded-full">
                      {{#if (eq transaction_type "reward_earned")}}
                        {{t 'billing.reward_earned'}}
                      {{else if (eq transaction_type "credit_purchase")}}
                        {{t 'billing.purchase'}}
                      {{else if (eq transaction_type "billing")}}
                        {{t 'billing.billing'}}
                      {{else if (eq transaction_type "ai_generation")}}
                        {{t 'billing.ai_usage'}}
                      {{else if (eq transaction_type "report_generation")}}
                        {{t 'billing.report'}}
                      {{else}}
                        {{transaction_type}}
                      {{/if}}
                   </span>
                 </td>
                 <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                   <div class="text-sm text-foreground">
                      {{#if (eq transaction_type "reward_earned")}}
                        {{t 'billing.voting_reward'}}
                      {{else if (eq transaction_type "credit_purchase")}}
                        {{t 'billing.credit_purchase'}}
                      {{else if (eq transaction_type "billing")}}
                        {{t 'billing.subscription_payment'}}
                      {{else if (eq transaction_type "ai_generation")}}
                        {{t 'billing.ai_generation'}}
                      {{else if (eq transaction_type "report_generation")}}
                        {{t 'billing.report_generation'}}
                      {{else}}
                        {{transaction_type}}
                      {{/if}}
                   </div>
                   <div class="text-sm text-muted-foreground">
                     {{#if metadata.description}}
                       {{metadata.description}}
                     {{else if metadata.package_name}}
                       {{metadata.package_name}}
                     {{else if metadata.idea_title}}
                       "{{metadata.idea_title}}"
                     {{else}}
                        {{t 'billing.transaction_details'}}
                     {{/if}}
                   </div>
                 </td>
                 <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-sm font-medium {{#if (gt amount 0)}}text-success{{else}}text-foreground{{/if}}">
                    {{#if (gt amount 0)}}
                      +{{amount}} {{#if (eq transaction_type "billing")}}USD{{else}}{{t 'billing.credits'}}{{/if}}
                    {{else}}
                      {{amount}} {{#if (eq transaction_type "billing")}}USD{{else}}{{t 'billing.credits'}}{{/if}}
                    {{/if}}
                 </td>
                 <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                   <span class="inline-flex px-2 py-1 text-xs font-medium bg-success/10 text-success rounded-full">
                      {{t 'billing.completed'}}
                   </span>
                 </td>
                 <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-sm font-medium">
                   <div class="flex items-center gap-2">
                      {{#if (eq transaction_type "billing")}}
                       <button class="text-primary hover:text-primary/80" title="Download Invoice">
                          {{{icon 'download' class='w-4 h-4' size='16'}}}
                          <span class="sr-only">{{t 'billing.download_invoice'}}</span>
                       </button>
                     {{/if}}
                     <button class="text-muted-foreground hover:text-foreground" title="View Details">
                        {{{icon 'more-horizontal' class='w-4 h-4' size='16'}}}
                        <span class="sr-only">{{t 'billing.view_details'}}</span>
                     </button>
                   </div>
                 </td>
              </tr>
              {{else}}
               <tr>
                 <td colspan="6" class="px-3 sm:px-6 py-6 sm:py-8 text-center text-sm text-muted-foreground">
                   {{t 'billing.no_transactions'}}
                 </td>
               </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

         <!-- Pagination -->
         <div class="px-4 sm:px-6 py-3 sm:py-4 border-t border-border bg-card">
           <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
             <div class="text-sm text-muted-foreground">
               {{t 'billing.showing'}} <span class="font-medium">{{transactions.length}}</span> {{t 'billing.transactions'}}
             </div>
             <div class="flex items-center gap-2">
               <button class="px-3 py-1.5 text-sm font-medium border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                 {{t 'billing.previous'}}
               </button>
               <button class="px-3 py-1.5 text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 rounded-md transition-colors">1</button>
               <button class="px-3 py-1.5 text-sm font-medium border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-md transition-colors">
                 {{t 'billing.next'}}
               </button>
             </div>
           </div>
         </div>
      </div>

      <!-- Credit Usage Breakdown -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
         <!-- Credit Usage Chart -->
         <div class="bg-card rounded-lg border border-border p-4 sm:p-6">
           <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 gap-2">
             <h2 class="text-lg sm:text-xl font-semibold text-foreground">{{t 'billing.credit_usage'}}</h2>
             <select class="text-sm border border-input rounded-md px-3 py-1 bg-background w-full sm:w-auto">
               <option>{{t 'billing.last_30_days'}}</option>
               <option>{{t 'billing.last_90_days'}}</option>
               <option>{{t 'billing.all_time'}}</option>
             </select>
           </div>
           <div class="h-48 sm:h-64 flex items-center justify-center bg-muted/20 rounded-lg">
             <div class="text-center">
               {{{icon 'bar-chart-2' class='w-10 h-10 sm:w-12 sm:h-12 text-muted-foreground mx-auto mb-4' size='24'}}}
               <p class="text-sm sm:text-base text-muted-foreground">Usage chart visualization</p>
               <p class="text-xs sm:text-sm text-muted-foreground mt-1">Integration with charting library needed</p>
             </div>
           </div>
           <div class="mt-4 grid grid-cols-2 gap-4">
             <div class="text-center">
               <div class="text-xl sm:text-2xl font-bold text-foreground">{{billingStats.spentThisMonth}}</div>
               <div class="text-sm text-muted-foreground">{{t 'billing.spent_this_month'}}</div>
             </div>
             <div class="text-center">
               <div class="text-xl sm:text-2xl font-bold text-foreground">{{billingStats.currentBalance}}</div>
               <div class="text-sm text-muted-foreground">{{t 'billing.current_balance'}}</div>
             </div>
           </div>
        </div>

         <!-- Package & Billing Info -->
         <div class="bg-card rounded-lg border border-border p-4 sm:p-6">
           <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-4">{{t 'billing.package_billing_info'}}</h2>

          <div class="space-y-4">
             <!-- Current Package -->
             <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between p-4 border border-border rounded-lg gap-4">
               <div>
                   <h3 class="font-medium text-foreground">{{#if packageDetails}}{{packageDetails.name}}{{else}}{{capitalize profile.package_type}}{{/if}}</h3>
                  <p class="text-sm text-muted-foreground">
                {{#if (eq profile.package_type "free")}}
                      {{t 'billing.basic_features'}}
                    {{else}}
                      ${{divide profile.package_price 100}}{{t 'dashboard.payments.upgrade.per_month'}} • {{profile.package_credits}} {{t 'billing.credits'}}
                    {{/if}}
                  </p>
               </div>
               <div class="text-left sm:text-right">
                 <span class="text-sm font-medium {{#if (eq profile.package_status "active")}}text-success{{else}}text-warning{{/if}} capitalize">
                   {{profile.package_status}}
                 </span>
                 {{#if profile.package_expires}}
                   <p class="text-xs text-muted-foreground">{{t 'billing.renews'}} {{formatDate profile.package_expires}}</p>
                 {{/if}}
               </div>
             </div>

             <!-- Billing Address -->
             <div class="p-4 border border-border rounded-lg">
               <h3 class="font-medium text-foreground mb-2">{{t 'billing.billing_address'}}</h3>
               <p class="text-sm text-muted-foreground">
                 {{#if profile.billing_address}}
                   {{profile.billing_address.street}}<br>
                   {{profile.billing_address.city}}, {{profile.billing_address.state}} {{profile.billing_address.zipCode}}<br>
                   {{profile.billing_address.country}}
                 {{else}}
                   {{t 'billing.no_billing_address'}}
                 {{/if}}
               </p>
             </div>

             <!-- Actions -->
             <div class="flex flex-col sm:flex-row gap-2">
               <a href="/upgrade-package" class="flex-1 px-4 py-2 bg-primary text-primary-foreground hover:bg-primary/90 rounded-md transition-colors text-center text-sm">
                 {{#if (eq profile.package_type "free")}}
                   {{t 'billing.upgrade_package'}}
                 {{else if (eq profile.package_type "student")}}
                   {{t 'billing.upgrade_enterprise'}}
                 {{else}}
                   {{t 'billing.manage_package'}}
                 {{/if}}
               </a>
               <a href="/settings" class="px-4 py-2 border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-md transition-colors text-sm text-center">
                 {{t 'billing.update_billing'}}
               </a>
             </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

