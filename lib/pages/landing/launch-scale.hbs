<section id="launch-scale"
   class="lg:px-12 flex flex-col overflow-hidden z-10 bg-background/50 w-full border-white/5 border-t px-6 py-32 relative backdrop-blur-xl items-center">
  <!-- Background Texture (Grid, Clean, No Glow) -->
  <div
    class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:100px_200px] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_100%)] opacity-70 pointer-events-none">
  </div>

  <div class="max-w-7xl w-full relative z-10">
    <!-- Header Section -->
    <div class="flex flex-col lg:flex-row justify-between lg:items-end gap-12 mb-16">
      <div class="flex flex-col gap-6 max-w-3xl">
        <!-- Index / Label -->
        <div class="flex items-center gap-4">
          <span
            class="flex items-center justify-center w-8 h-8 rounded-full border border-white/10 bg-white/5 text-xs font-mono text-white/50">03</span>
           <span class="text-xs font-mono text-brand-purple/90 uppercase tracking-[0.2em]">(t "landing.launch_scale.badge")</span>
        </div>

        <!-- Headline -->
         <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif font-medium tracking-tight text-white leading-[1.1] mb-6">
           (t "landing.launch_scale.title_main")
           <span class="text-white/40 italic">(t "landing.launch_scale.title_sub")</span>
         </h2>
      </div>

      <!-- Context Paragraph -->
      <div class="max-w-sm pb-2">
         <p class="text-white/50 text-sm leading-relaxed font-light">
           (t "landing.launch_scale.description")
         </p>
      </div>
    </div>

    <!-- Main Feature Card -->
    <div
      class="w-full rounded-[24px] border border-white/10 bg-black overflow-hidden flex flex-col lg:flex-row relative group">
      <!-- Left Column: Content -->
      <div class="lg:w-1/2 p-8 md:p-12 lg:p-16 flex flex-col justify-center items-start z-10 relative bg-black">
         <h3 class="text-3xl md:text-4xl font-serif font-medium text-white mb-6 tracking-tight">
           (t "landing.launch_scale.card_title")
         </h3>
         <p class="text-white/60 mb-8 leading-relaxed font-light max-w-md text-base">
           (t "landing.launch_scale.card_desc")
         </p>

        <div class="flex flex-wrap gap-3 w-full sm:w-auto">
          <!-- Primary Button (Brand Sky) -->
<button
         class="px-6 py-3 bg-brand-purple text-foreground font-semibold text-sm rounded-full hover:bg-brand-purple/90 transition-colors flex items-center justify-center gap-2 min-w-[140px]">
             (t "landing.launch_scale.start_now")
          </button>
          <!-- Secondary Button (Outline) -->
          <button
            class="px-8 py-3.5 border border-white/10 text-white font-medium text-sm rounded-full hover:bg-white/5 transition-colors flex items-center justify-center gap-2 min-w-[140px]">
             (t "landing.launch_scale.view_markets")
          </button>
        </div>
      </div>

      <!-- Right Column: Clean Technical Illustration -->
      <div
        class="lg:w-1/2 bg-black relative min-h-[400px] border-t lg:border-t-0 lg:border-l border-white/5 overflow-hidden flex items-center justify-center">
        <!-- Subtle Isometric Grid Pattern -->
        <div class="absolute inset-0 opacity-[0.03]" style="
              background-image:
                linear-gradient(currentColor 1px, transparent 1px),
                linear-gradient(90deg, currentColor 1px, transparent 1px);
              background-size: 48px 96px;
            "></div>

        <!-- Abstract Devices Composition -->
        <div class="relative w-full h-full flex items-center justify-center p-12 perspective-1000">
          <div
            class="relative w-72 h-56 transform rotate-x-6 rotate-y-[-6deg] hover:rotate-0 transition-transform duration-700 ease-out">
            <!-- Background Panel (Dashboard) -->
            <div
              class="absolute top-0 right-0 w-56 h-36 bg-black border border-white/10 rounded-xl shadow-2xl z-0 overflow-hidden">
              <div class="h-8 border-b border-white/5 flex items-center px-3 gap-2">
                <div class="w-1.5 h-1.5 rounded-full bg-white/20"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-white/20"></div>
              </div>
              <div class="p-4 grid grid-cols-2 gap-3">
                <div class="h-12 bg-white/5 rounded border border-white/5"></div>
                <div class="h-12 bg-white/5 rounded border border-white/5"></div>
              </div>
            </div>

            <!-- Foreground Panel (Mobile Interface) -->
            <div
              class="absolute bottom-4 left-4 w-44 h-32 bg-black border border-white/10 rounded-xl shadow-[0_20px_40px_-15px_rgba(0,0,0,1)] z-10 flex flex-col overflow-hidden">
              <div class="flex justify-between items-center p-4 border-b border-white/5 bg-white/[0.01]">
                <div class="flex items-center gap-2">
                  <div class="w-4 h-4 rounded-full bg-brand-purple flex items-center justify-center">
                    <svg class="w-2.5 h-2.5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="3">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                   <span class="text-[10px] font-mono text-white/60">(t "landing.launch_scale.idea_score")</span>
                 </div>
                 <span class="text-[10px] font-mono text-brand-purple">(t "landing.launch_scale.score_value")</span>
              </div>
              <div class="p-4 space-y-2">
                 <div class="flex justify-between items-center">
                   <span class="text-xs text-white/40">(t "landing.launch_scale.score_label")</span>
                   <span class="text-xs text-white font-mono">(t "landing.launch_scale.score_number")</span>
                 </div>
                <div class="w-full h-1 bg-white/5 rounded-full overflow-hidden">
                  <div class="w-2/3 h-full bg-brand-purple"></div>
                </div>
              </div>
            </div>

            <!-- Floating Coin/Icon -->
            <div
              class="absolute -top-6 -left-6 w-12 h-12 bg-black border border-white/10 rounded-full flex items-center justify-center z-20 shadow-xl animate-[bounce_4s_infinite]">
              <svg class="w-5 h-5 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.5">
                <path d="M12 2v20M2 12h20"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>