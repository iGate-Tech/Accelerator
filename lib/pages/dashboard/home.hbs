<!-- Dashboard Home Page -->
<main class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-6 mt-6">

      <!-- Welcome Header -->
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Welcome back, {{user.profile.name}}! 👋
          </h1>
          <p class="text-lg text-muted-foreground">
            Here's what's happening with your startup journey today
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a href="/new-idea" class="btn btn-primary">
            {{{icon 'plus' class='' size='16'}}}
            New Idea
          </a>
        </div>
      </div>

      <!-- Quick Stats Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Ideas Card -->
        <div class="bg-card rounded-lg border border-border p-6 text-card-foreground shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Total Ideas</h3>
              <p class="text-2xl font-semibold text-foreground">{{stats.ideas.total}}</p>
            </div>
            <div class="bg-primary/20 rounded-lg p-2">
              <div class="w-8 h-8 bg-primary/20 rounded-lg relative flex items-center justify-center">
                {{{icon 'lightbulb' class='w-5 h-5 text-primary' size='20'}}}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-3">
            <span class="text-success">{{stats.ideas.completed}} completed</span>
          </div>
        </div>

        <!-- Completion Rate Card -->
        <div class="bg-card rounded-lg border border-border p-6 text-card-foreground shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Completion Rate</h3>
              <p class="text-2xl font-semibold text-foreground">{{stats.ideas.completionRate}}%</p>
            </div>
            <div class="bg-success/20 rounded-lg p-2">
              <div class="w-8 h-8 bg-success/20 rounded-lg relative flex items-center justify-center">
                {{{icon 'trending-up' class='w-5 h-5 text-success' size='20'}}}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-3">
            <span class="text-muted-foreground">Keep up the great work!</span>
          </div>
        </div>

        <!-- Credits Card -->
        <div class="bg-card rounded-lg border border-border p-6 text-card-foreground shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Credits</h3>
              <p class="text-2xl font-semibold text-foreground">{{stats.credits.currentBalance}}</p>
            </div>
            <div class="bg-yellow-500/20 rounded-lg p-2">
              <div class="w-8 h-8 bg-yellow-500/20 rounded-lg relative flex items-center justify-center">
                {{{icon 'dollar-sign' class='w-5 h-5 text-yellow-500' size='20'}}}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-3">
            <a href="/buy-credits" class="text-primary hover:underline">Buy more credits</a>
          </div>
        </div>

        <!-- Package Status Card -->
        <div class="bg-card rounded-lg border border-border p-6 text-card-foreground shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Package</h3>
              <p class="text-lg font-semibold text-foreground capitalize">{{user.profile.package_type}}</p>
            </div>
            <div class="bg-accent/20 rounded-lg p-2">
              <div class="w-8 h-8 bg-accent/20 rounded-lg relative flex items-center justify-center">
                {{{icon 'star' class='w-5 h-5 text-accent' size='20'}}}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-3">
            {{#if (eq user.profile.package_type 'free')}}
              <a href="/upgrade-package" class="text-primary hover:underline">Upgrade plan</a>
            {{else}}
              <span class="text-success">Active</span>
            {{/if}}
          </div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Recent Ideas -->
        <div class="bg-card rounded-lg border border-border p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-foreground">Recent Ideas</h2>
            <a href="/ideas" class="btn btn-ghost text-sm">
              View All
              {{{icon 'arrow-right' class='' size='14'}}}
            </a>
          </div>

          {{#if stats.ideas.recent.length}}
            <div class="space-y-4">
              {{#each stats.ideas.recent}}
              <div class="flex items-start gap-3 p-3 rounded-lg bg-muted/30 hover:bg-muted/50 transition-colors">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                  {{#if (eq overall_status "completed")}}
                    {{{icon 'check-circle' class='w-5 h-5 text-success' size='20'}}}
                  {{else if (gt completion_percentage 50)}}
                    {{{icon 'clock' class='w-5 h-5 text-warning' size='20'}}}
                  {{else}}
                    {{{icon 'lightbulb' class='w-5 h-5 text-primary' size='20'}}}
                  {{/if}}
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium text-foreground truncate">{{title}}</h3>
                  <div class="flex items-center gap-2 mt-1">
                    <div class="w-full bg-muted rounded-full h-1.5">
                      <div class="bg-primary h-1.5 rounded-full transition-all duration-300" style="width: {{completion_percentage}}%"></div>
                    </div>
                    <span class="text-xs text-muted-foreground whitespace-nowrap">{{completion_percentage}}%</span>
                  </div>
                  <p class="text-xs text-muted-foreground mt-1">{{formatDate created_at}}</p>
                </div>
              </div>
              {{/each}}
            </div>
          {{else}}
            <div class="text-center py-8">
              <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                {{{icon 'lightbulb' class='text-muted-foreground' size='24'}}}
              </div>
              <h3 class="text-lg font-medium text-foreground mb-2">No ideas yet</h3>
              <p class="text-muted-foreground mb-4">Start your entrepreneurial journey by creating your first idea</p>
              <a href="/new-idea" class="btn btn-primary">Create Your First Idea</a>
            </div>
          {{/if}}
        </div>

        <!-- Activity Feed -->
        <div class="bg-card rounded-lg border border-border p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-foreground">Recent Activity</h2>
            <a href="/user-activity" class="btn btn-ghost text-sm">
              View All
              {{{icon 'arrow-right' class='' size='14'}}}
            </a>
          </div>

          {{#if stats.activity.length}}
            <div class="space-y-4">
              {{#each stats.activity}}
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                  {{#if (eq action_type "idea_created")}}
                    {{{icon 'plus' class='w-4 h-4 text-primary' size='16'}}}
                  {{else if (eq action_type "vote_cast")}}
                    {{{icon 'star' class='w-4 h-4 text-yellow-500' size='16'}}}
                  {{else if (eq action_type "model_completed")}}
                    {{{icon 'check-circle' class='w-4 h-4 text-success' size='16'}}}
                  {{else if (eq action_type "report_generated")}}
                    {{{icon 'file-text' class='w-4 h-4 text-blue-500' size='16'}}}
                  {{else}}
                    {{{icon 'activity' class='w-4 h-4 text-muted-foreground' size='16'}}}
                  {{/if}}
                </div>
                <div class="flex-1">
                  <p class="text-sm text-foreground">
                    {{#if (eq action_type "idea_created")}}
                      You created a new idea
                    {{else if (eq action_type "vote_cast")}}
                      You cast a vote on an idea
                    {{else if (eq action_type "model_completed")}}
                      You completed a model section
                    {{else if (eq action_type "report_generated")}}
                      You generated a report
                    {{else}}
                      {{action_type}}
                    {{/if}}
                  </p>
                  <p class="text-xs text-muted-foreground">{{formatDate created_at}}</p>
                </div>
              </div>
              {{/each}}
            </div>
          {{else}}
            <div class="text-center py-8">
              <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                {{{icon 'activity' class='text-muted-foreground' size='24'}}}
              </div>
              <h3 class="text-lg font-medium text-foreground mb-2">No activity yet</h3>
              <p class="text-muted-foreground">Your recent actions will appear here</p>
            </div>
          {{/if}}
        </div>
      </div>

      <!-- Portfolio Overview (Enterprise only) -->
      {{#if (eq user.profile.package_type "enterprise")}}
      <div class="bg-card rounded-lg border border-border p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-semibold text-foreground">Portfolio Overview</h2>
          <a href="/portfolios" class="btn btn-ghost text-sm">
            Manage Portfolios
            {{{icon 'arrow-right' class='' size='14'}}}
          </a>
        </div>

        {{#if stats.portfolios}}
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {{#each stats.portfolios}}
            <div class="bg-muted/30 rounded-lg p-4">
              <h3 class="font-medium text-foreground mb-2">{{name}}</h3>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-muted-foreground">Ideas:</span>
                  <span class="font-medium">{{ideaCount}}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-muted-foreground">Completed:</span>
                  <span class="font-medium text-success">{{completedIdeas}}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-muted-foreground">Progress:</span>
                  <span class="font-medium">{{avgCompletion}}%</span>
                </div>
              </div>
              <div class="w-full bg-muted rounded-full h-2 mt-3">
                <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: {{avgCompletion}}%"></div>
              </div>
            </div>
            {{/each}}
          </div>
        {{else}}
          <div class="text-center py-8">
            <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
              {{{icon 'archive' class='text-muted-foreground' size='24'}}}
            </div>
            <h3 class="text-lg font-medium text-foreground mb-2">No portfolios yet</h3>
            <p class="text-muted-foreground mb-4">Create portfolios to organize and track multiple startup ideas</p>
            <a href="/portfolios" class="btn btn-primary">Create Portfolio</a>
          </div>
        {{/if}}
      </div>
      {{/if}}

      <!-- Quick Actions -->
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Quick Actions</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a href="/new-idea" class="flex flex-col items-center p-4 rounded-lg bg-primary/5 hover:bg-primary/10 transition-colors">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-2">
              {{{icon 'plus' class='w-6 h-6 text-primary' size='24'}}}
            </div>
            <span class="text-sm font-medium text-center">New Idea</span>
          </a>

          <a href="/explore-ideas" class="flex flex-col items-center p-4 rounded-lg bg-secondary/5 hover:bg-secondary/10 transition-colors">
            <div class="w-12 h-12 bg-secondary/10 rounded-full flex items-center justify-center mb-2">
              {{{icon 'search' class='w-6 h-6 text-secondary' size='24'}}}
            </div>
            <span class="text-sm font-medium text-center">Explore Ideas</span>
          </a>

          <a href="/random-idea" class="flex flex-col items-center p-4 rounded-lg bg-accent/5 hover:bg-accent/10 transition-colors">
            <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center mb-2">
              {{{icon 'shuffle' class='w-6 h-6 text-accent' size='24'}}}
            </div>
            <span class="text-sm font-medium text-center">Random Idea</span>
          </a>

          <a href="/reports" class="flex flex-col items-center p-4 rounded-lg bg-success/5 hover:bg-success/10 transition-colors">
            <div class="w-12 h-12 bg-success/10 rounded-full flex items-center justify-center mb-2">
              {{{icon 'file-text' class='w-6 h-6 text-success' size='24'}}}
            </div>
            <span class="text-sm font-medium text-center">Generate Report</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Dashboard Home JavaScript -->
<script>
  // Initialize real-time updates for dashboard home
  document.addEventListener('DOMContentLoaded', function() {
    // Subscribe to credit updates
    if (window.Realtime) {
      window.Realtime.subscribe('credit_update', function(data) {
        // Update credit balance display
        const creditElements = document.querySelectorAll('.credit-balance');
        creditElements.forEach(el => {
          el.textContent = data.balance;
        });
      });

      window.Realtime.subscribe('activity', function(data) {
        // Could add real-time activity updates here
        console.log('New activity:', data);
      });
    }
  });
</script>