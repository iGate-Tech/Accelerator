# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
SESSION_SECRET=your-secret-key-change-in-production

# Supabase Configuration (REQUIRED - Replace with your actual Supabase project details)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_PUBLIC_KEY=your_supabase_anon_key_here

# Database URL for direct psql access (construct using service key)
# Format: postgresql://postgres:[SERVICE_KEY]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your_supabase_service_role_key_here@db.your_project_ref.supabase.co:5432/postgres

# AI Provider Configuration (Choose one or more)
# Primary AI provider: openrouter, openai, or anthropic
AI_PROVIDER=openrouter

# OpenRouter API Configuration (Get your API key from https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-3n-e2b-it:free
