 <div class="min-h-screen bg-gradient-to-br from-base-100 via-success/10 to-info/10">
  <div class="relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 20% 80%, color-mix(in oklab, hsl(var(--color-emerald-500)), transparent 95%) 2px, transparent 2px), radial-gradient(circle at 80% 20%, color-mix(in oklab, hsl(var(--color-blue-500)), transparent 95%) 2px, transparent 2px); background-size: 40px 40px;"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Header -->
       <div class="text-center mb-8 sm:mb-12">
          <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-gradient-to-br from-success to-info rounded-2xl mb-6 sm:mb-8 shadow-lg">
 {{{icon 'user' class="w-8 h-8 sm:w-10 sm:h-10 text-white"}}}
         </div>
             <h1 class="text-3xl sm:text-5xl font-bold text-foreground mb-4 sm:mb-6">
              {{t 'onboarding.profile.title'}}
            </h1>
             <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed px-4">
              {{t 'onboarding.profile.subtitle'}}
            </p>
       </div>

{{> onboarding-progress activeStep="profile"}}

       <!-- Form -->
         <div class="bg-card rounded-3xl shadow-2xl p-6 sm:p-8 md:p-12">
          <form method="post" action="/onboarding/profile" enctype="multipart/form-data" class="space-y-6 sm:space-y-8">
          <input type="hidden" name="_csrf" value="{{csrf}}"/>

              <!-- Display Name -->
              <div class="space-y-4 sm:space-y-6">
                    <h3 class="text-xl lg:text-2xl font-semibold text-foreground">{{t 'onboarding.profile.personal_info'}}</h3>

               <div class="pl-4 sm:pl-6 lg:pl-8">
                   <!-- Avatar Upload -->
                   <div class="flex flex-col items-center gap-4 mb-6">
                     <img src="{{#if profile.avatar_url}}{{profile.avatar_url}}{{else}}/images/avatar.png{{/if}}"
                          class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-border"
                          id="avatar-preview" alt="Current avatar">
                     <div class="text-center">
                       <input type="file" name="avatar" id="avatar-upload" accept="image/*" class="hidden" onchange="previewAvatar(this)">
                       <label for="avatar-upload" class="bg-primary text-primary-foreground px-4 py-2 rounded-lg cursor-pointer hover:bg-primary/90 transition-colors text-sm font-medium">
                         {{t 'settings.settings.change_photo'}}
                       </label>
                       <p class="text-xs text-muted-foreground mt-1">Max 5MB</p>
                     </div>
                   </div>

                   <label for="name" class="block text-base font-medium text-foreground mb-2">
                     {{t 'profile.display_name'}} <span class="text-error">*</span>
                   </label>
                   <input type="text" id="name" name="name" value="{{profile.name}}"
                     class="w-full px-4 py-4 border border-input rounded-lg focus:ring-2 focus:ring-success focus:border-success transition-all duration-200 bg-background focus:bg-background text-base min-h-[44px] placeholder:text-muted-foreground"
                     placeholder="{{t 'onboarding.profile.display_name_placeholder'}}" required/>
                   <p class="text-sm text-muted-foreground mt-1">{{t 'onboarding.profile.display_name_help'}}</p>
              </div>
            </div>

             <!-- Role -->
             <div class="space-y-4 sm:space-y-6">
                  <h3 class="text-xl lg:text-2xl font-semibold text-foreground">{{t 'onboarding.profile.professional_background'}}</h3>

              <div class="pl-4 sm:pl-6 lg:pl-8">
                   <label for="role" class="block text-base font-medium text-foreground mb-2">
                     {{t 'profile.your_role'}}
                   </label>
                  <div class="relative" data-placeholder="{{t 'onboarding.profile.role_placeholder'}}">
                    <button type="button" id="role-toggle" class="w-full px-4 py-4 border border-input rounded-lg bg-background text-left text-base min-h-[44px] flex items-center justify-between focus:ring-2 focus:ring-primary focus:border-primary transition-all duration-200">
                      <span id="role-selected" class="text-muted-foreground">{{t 'onboarding.profile.role_placeholder'}}</span>
                      <svg class="w-5 h-5 transition-transform" id="role-arrow" style="transform: rotate(0deg);">
                        <path fill="currentColor" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/>
                      </svg>
                    </button>
                    <div id="role-accordion" class="hidden mt-2 border border-input rounded-lg bg-background shadow-lg z-10">
                      <div class="p-2 space-y-2">
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="" class="opacity-0 absolute peer" {{#if (not profile.role)}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_placeholder'}}</span>
                        </label>
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="founder" class="opacity-0 absolute peer" {{#if (eq profile.role "founder")}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_founder'}}</span>
                        </label>
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="student" class="opacity-0 absolute peer" {{#if (eq profile.role "student")}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_student'}}</span>
                        </label>
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="developer" class="opacity-0 absolute peer" {{#if (eq profile.role "developer")}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_developer'}}</span>
                        </label>
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="designer" class="opacity-0 absolute peer" {{#if (eq profile.role "designer")}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_designer'}}</span>
                        </label>
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="marketer" class="opacity-0 absolute peer" {{#if (eq profile.role "marketer")}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_marketer'}}</span>
                        </label>
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="investor" class="opacity-0 absolute peer" {{#if (eq profile.role "investor")}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_investor'}}</span>
                        </label>
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="consultant" class="sr-only peer" {{#if (eq profile.role "consultant")}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_consultant'}}</span>
                        </label>
                        <label class="flex items-center space-x-3 p-2 hover:bg-muted rounded cursor-pointer">
                          <input type="radio" name="role" value="other" class="opacity-0 absolute peer" {{#if (eq profile.role "other")}}checked{{/if}}>
                          <div class="w-5 h-5 flex items-center justify-center border border-muted-foreground peer-checked:border-primary peer-checked:bg-primary rounded transition-colors">
                            <span class="text-muted-foreground peer-checked:text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity text-lg">✓</span>
                          </div>
                          <span class="text-base">{{t 'onboarding.profile.role_other'}}</span>
                        </label>
                      </div>
                    </div>
                  </div>
             </div>
           </div>

             <!-- Bio -->
             <div class="space-y-4 sm:space-y-6">
                  <h3 class="text-xl lg:text-2xl font-semibold text-foreground">{{t 'onboarding.profile.about_you'}}</h3>

              <div class="pl-4 sm:pl-6 lg:pl-8">
                   <label for="bio" class="block text-base font-medium text-foreground mb-2">
                     {{t 'profile.bio'}}
                   </label>
                  <textarea id="bio" name="bio" rows="4"
                    class="w-full px-4 py-4 border border-input rounded-lg focus:ring-2 focus:ring-secondary focus:border-secondary transition-all duration-200 bg-background focus:bg-background resize-none text-base placeholder:text-muted-foreground"
                   placeholder="{{t 'onboarding.profile.bio_placeholder'}}">{{#if profile.preferences}}{{profile.preferences.bio}}{{/if}}</textarea>
                 <p class="text-sm text-muted-foreground mt-1">{{t 'onboarding.profile.bio_help'}}</p>
             </div>
           </div>

            <!-- Location & Website -->
             <div class="space-y-4 sm:space-y-6">
                  <h3 class="text-xl lg:text-2xl font-semibold text-foreground">{{t 'onboarding.profile.contact_location'}}</h3>

              <div class="pl-4 sm:pl-6 lg:pl-8 grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
               <div>
                    <label for="location" class="block text-base font-medium text-foreground mb-2">
                      {{t 'profile.location'}}
                    </label>
                    <input type="text" id="location" name="location" value="{{#if profile.preferences}}{{profile.preferences.location}}{{/if}}"
                      class="w-full px-4 py-4 border border-input rounded-lg focus:ring-2 focus:ring-warning focus:border-warning transition-all duration-200 bg-background focus:bg-background text-base min-h-[44px] placeholder:text-muted-foreground"
                      placeholder="{{t 'onboarding.profile.location_placeholder'}}"/>
               </div>

               <div>
                    <label for="website" class="block text-base font-medium text-foreground mb-2">
                      {{t 'profile.website'}}
                    </label>
                    <input type="url" id="website" name="website" value="{{#if profile.preferences}}{{profile.preferences.website}}{{/if}}"
                      class="w-full px-4 py-4 border border-input rounded-lg focus:ring-2 focus:ring-warning focus:border-warning transition-all duration-200 bg-background focus:bg-background text-base min-h-[44px] placeholder:text-muted-foreground"
                      placeholder="{{t 'onboarding.profile.website_placeholder'}}"/>
               </div>
             </div>
            </div>

             <!-- Preferences -->
             <div class="space-y-4 sm:space-y-6">
                  <h3 class="text-xl lg:text-2xl font-semibold text-foreground">Preferences</h3>

              <div class="pl-4 sm:pl-6 lg:pl-8 grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
               <!-- Theme Toggle -->
               <div class="bg-card border border-border rounded-lg p-4">
                 <button type="button" onclick="toggleTheme()" class="w-full flex items-center gap-3 hover:bg-muted/50 transition-colors text-left rounded p-2">
                   <div class="flex-shrink-0">
                     <div class="w-10 h-10 bg-indigo-500/20 rounded-full flex items-center justify-center">
                       <span id="theme-icon-light">{{{icon 'sun' class="w-5 h-5 text-indigo-600"}}}</span>
                       <span id="theme-icon-dark" class="hidden">{{{icon 'moon' class="w-5 h-5 text-indigo-600"}}}</span>
                     </div>
                   </div>
                   <div class="flex-1 min-w-0">
                     <p class="text-sm font-medium text-foreground">Theme</p>
                     <p class="text-xs text-muted-foreground" id="theme-status">{{#if (eq settings.theme 'dark')}}Dark mode{{else}}Light mode{{/if}}</p>
                   </div>
                 </button>
               </div>

               <!-- Language Selection -->
               <div class="bg-card border border-border rounded-lg p-4">
                 <button type="button" onclick="switchLanguage()" class="w-full flex items-center gap-3 hover:bg-muted/50 transition-colors text-left rounded p-2">
                   <div class="flex-shrink-0">
                     <div class="w-10 h-10 bg-pink-500/20 rounded-full flex items-center justify-center">
                       {{{icon 'languages' class="w-5 h-5 text-pink-600"}}}
                     </div>
                   </div>
                   <div class="flex-1 min-w-0">
                     <p class="text-sm font-medium text-foreground">Language</p>
                     <p class="text-xs text-muted-foreground" id="lang-display">{{#if (eq settings.language 'ar')}}العربية{{else}}English{{/if}}</p>
                   </div>
                 </button>
               </div>
             </div>
           </div>

             <!-- Info Box -->
             <div class="bg-gradient-to-r from-success/10 to-info/10 border border-success/20 rounded-lg sm:rounded-2xl p-4 sm:p-6">
               <div class="flex items-start">
                 <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-success/10 rounded-lg sm:rounded-xl flex items-center justify-center mr-2 sm:mr-3 lg:mr-4 flex-shrink-0">
                   {{{icon 'info' class="w-3 h-3 sm:w-4 sm:h-4 lg:w-5 lg:h-5 text-success"}}}
                 </div>
                 <div>
                    <h4 class="text-sm sm:text-base lg:text-lg font-semibold text-foreground mb-2">{{t 'onboarding.profile.next_title'}}</h4>
                    <p class="text-sm lg:text-base text-muted-foreground leading-relaxed">
                     {{t 'onboarding.profile.next_content'}}
                   </p>
                </div>
              </div>
             </div>

             <!-- About Section -->
             <div class="bg-muted/50 border border-border rounded-lg sm:rounded-2xl p-4 sm:p-6">
               <div class="flex items-start gap-4">
                 <div class="w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                   {{{icon 'zap' class="w-5 h-5 sm:w-6 sm:h-6 text-primary"}}}
                 </div>
                 <div class="flex-1">
                   <h4 class="font-semibold text-foreground text-sm sm:text-base">About Accelerator</h4>
                   <p class="text-muted-foreground text-xs sm:text-sm">Version 1.0.0</p>
                   <p class="text-xs text-muted-foreground mt-2">AI-powered business planning platform</p>
                 </div>
               </div>
             </div>

             <!-- Submit Button -->
            <div class="pt-4 sm:pt-6 lg:pt-8">
               <button type="submit"
                                   class="w-full bg-gradient-to-r from-success to-info hover:from-success/90 hover:to-info/90 text-white font-bold py-4 lg:py-5 px-4 lg:px-8 rounded-xl transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98] shadow-lg hover:shadow-xl flex items-center justify-center space-x-2 lg:space-x-3 text-base lg:text-lg min-h-[48px]">
                 <span>{{t 'profile.complete_profile_setup'}}</span>
                 {{{icon 'trending-up' class="w-4 h-4 sm:w-5 sm:h-5"}}}
              </button>
            </div>
         </form>
       </div>
     </div>
   </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const container = document.querySelector('[data-placeholder]');
        const placeholder = container.getAttribute('data-placeholder');
        const toggle = document.getElementById('role-toggle');
        const accordion = document.getElementById('role-accordion');
        const selected = document.getElementById('role-selected');
        const arrow = document.getElementById('role-arrow');
        const radios = document.querySelectorAll('input[name="role"]');

        function updateSelected() {
          const checked = document.querySelector('input[name="role"]:checked');
          if (checked && checked.value) {
            // Find the label text
            const label = checked.closest('label').querySelector('span').textContent;
            selected.textContent = label;
            selected.classList.remove('text-muted-foreground');
          } else {
            selected.textContent = placeholder;
            selected.classList.add('text-muted-foreground');
          }
        }

        toggle.addEventListener('click', function(e) {
          e.preventDefault();
          const isHidden = accordion.classList.contains('hidden');
          if (isHidden) {
            accordion.classList.remove('hidden');
            arrow.style.transform = 'rotate(180deg)';
          } else {
            accordion.classList.add('hidden');
            arrow.style.transform = 'rotate(0deg)';
          }
        });

        radios.forEach(radio => {
          radio.addEventListener('change', function() {
            updateSelected();
            // Close accordion
            accordion.classList.add('hidden');
            arrow.style.transform = 'rotate(0deg)';
          });
        });

        // Initialize
        updateSelected();
      });

      // Avatar preview function
      function previewAvatar(input) {
        const file = input.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            document.getElementById('avatar-preview').src = e.target.result;
          };
          reader.readAsDataURL(file);
        }
      }

      // Theme toggle function
      function toggleTheme() {
        const statusEl = document.getElementById('theme-status');
        const lightIcon = document.getElementById('theme-icon-light');
        const darkIcon = document.getElementById('theme-icon-dark');

        const currentTheme = localStorage.getItem('theme') || 'light';
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';

        // Update UI immediately
        if (newTheme === 'dark') {
          statusEl.textContent = 'Dark mode';
          lightIcon.classList.add('hidden');
          darkIcon.classList.remove('hidden');
        } else {
          statusEl.textContent = 'Light mode';
          darkIcon.classList.add('hidden');
          lightIcon.classList.remove('hidden');
        }

        // Apply theme
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);

        // Save to server (optional for onboarding)
        fetch('/settings/theme', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ theme: newTheme })
        }).catch(err => {
          console.log('Theme saved locally only');
        });
      }

      // Language switch function
      function switchLanguage() {
        const langDisplay = document.getElementById('lang-display');
        const currentLang = langDisplay.textContent === 'English' ? 'en' : 'ar';
        const newLang = currentLang === 'en' ? 'ar' : 'en';

        // Update display
        langDisplay.textContent = newLang === 'ar' ? 'العربية' : 'English';

        // Save to server (optional for onboarding)
        fetch('/settings/language', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ language: newLang })
        }).catch(err => {
          console.log('Language saved locally only');
        });
      }

      // Initialize theme and language on load
      document.addEventListener('DOMContentLoaded', function() {
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);

        const savedLang = localStorage.getItem('language') || 'en';
        const langDisplay = document.getElementById('lang-display');
        if (langDisplay) {
          langDisplay.textContent = savedLang === 'ar' ? 'العربية' : 'English';
        }
      });
    </script>
 </div>