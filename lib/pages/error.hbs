<main class="min-h-screen bg-background flex items-center justify-center">
  <div class="max-w-md mx-auto text-center">
    <div class="mb-8">
      <svg class="mx-auto h-24 w-24 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
      </svg>
    </div>
    <h1 class="text-2xl font-bold text-foreground mb-4">{{title}}</h1>
    <p class="text-muted-foreground mb-8">{{message}}</p>
    <a href="/" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors">
      Go Home
    </a>
  </div>
</main>