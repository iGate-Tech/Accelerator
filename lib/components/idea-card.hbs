
<!-- Redesigned Idea Card Component - Modern, Clean, and Efficient -->
<div class="idea-card group relative w-full bg-card border border-border/40 rounded-2xl shadow-sm hover:shadow-lg hover:border-border transition-all duration-300 overflow-hidden"
     data-id="{{id}}"
     data-status="{{overall_status}}"
     data-category="{{category}}"
     data-favorite="{{is_favorite}}"
     data-rating="{{rating}}">

  <!-- Header Section -->
  <div class="p-5 pb-4">
    <!-- Header Row: Category and Quick Actions -->
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        {{#if category}}
        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
          {{{icon (cond category_icon category_icon 'tag') class='w-3.5 h-3.5 mr-1.5'}}}
          {{category}}
        </span>
        {{/if}}

        {{#if validation_threshold_met}}
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
          {{{icon 'shield-check' class='w-3 h-3 mr-1'}}}
          Validated
        </span>
        {{/if}}
      </div>

      <div class="flex items-center gap-1">
        {{#if user}}
        <button
          class="favorite-btn p-2 rounded-xl bg-muted/30 border border-border/50 hover:bg-red-50 dark:hover:bg-red-950/30 hover:border-red-200 dark:hover:border-red-800 transition-all duration-200 touch-manipulation active:scale-95"
          data-favorite-id="{{id}}"
          title="{{#if is_favorite}}Remove from favorites{{else}}Add to favorites{{/if}}"
          aria-label="{{#if is_favorite}}Remove from favorites{{else}}Add to favorites{{/if}}">
           {{{icon 'heart' class='w-5 h-5 {{#if isFavoritesPage}}fill-current text-red-500{{else}}{{#if is_favorite}}fill-current text-red-500{{else}}text-muted-foreground{{/if}}{{/if}} transition-all duration-200'}}}
        </button>
        {{/if}}

        <button
          class="expand-btn p-2 rounded-xl hover:bg-muted text-muted-foreground hover:text-foreground transition-all duration-200 touch-manipulation active:scale-95"
          onclick="toggleCardDetails(this.closest('.idea-card'))"
          title="Toggle Details"
          aria-label="Toggle card details">
          {{{icon 'chevron-down' class='w-5 h-5 transition-transform duration-300 ease-out'}}}
        </button>
      </div>
    </div>

    <!-- Title -->
    <h3 class="font-bold text-xl text-foreground leading-tight mb-3 hover:text-primary transition-colors cursor-pointer line-clamp-2"
        onclick="window.location.href='/idea/{{id}}'">
      {{title}}
    </h3>

    <!-- Author and Status Row -->
    <div class="flex items-center justify-between">
      {{#if profiles}}
      <div class="flex items-center gap-2">
        <img src="{{cond profiles.avatar_url profiles.avatar_url '/images/avatar.png'}}"
             alt="{{profiles.name}} avatar"
             class="w-7 h-7 rounded-full ring-2 ring-background/50">
        <span class="text-sm text-muted-foreground font-medium">by {{profiles.name}}</span>
      </div>
      {{/if}}

      {{#if overall_status}}
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
                   {{#if (eq overall_status 'draft')}}bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300{{/if}}
                   {{#if (eq overall_status 'in_progress')}}bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300{{/if}}
                   {{#if (eq overall_status 'completed')}}bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300{{/if}}
                   {{#if (eq overall_status 'reported')}}bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300{{/if}}
                   {{#if (eq overall_status 'archived')}}bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300{{/if}}">
        {{#if (eq overall_status 'draft')}}{{{icon 'file-text' class='w-3 h-3 mr-1'}}}{{/if}}
        {{#if (eq overall_status 'in_progress')}}{{{icon 'loader' class='w-3 h-3 mr-1'}}}{{/if}}
        {{#if (eq overall_status 'completed')}}{{{icon 'check-circle' class='w-3 h-3 mr-1'}}}{{/if}}
        {{#if (eq overall_status 'reported')}}{{{icon 'flag' class='w-3 h-3 mr-1'}}}{{/if}}
        {{#if (eq overall_status 'archived')}}{{{icon 'archive' class='w-3 h-3 mr-1'}}}{{/if}}
        {{overall_status}}
      </span>
      {{/if}}
    </div>
  </div>

   <!-- Rating Section -->
   <div class="px-5 pb-4">
     <div class="flex items-center justify-between">
       {{#if rating}}
       <div class="flex items-center gap-2">
         <div class="flex items-center gap-0.5">
           {{{icon 'star' class=(concat 'w-4 h-4 ' (cond (gte rating 1) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
           {{{icon 'star' class=(concat 'w-4 h-4 ' (cond (gte rating 2) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
           {{{icon 'star' class=(concat 'w-4 h-4 ' (cond (gte rating 3) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
           {{{icon 'star' class=(concat 'w-4 h-4 ' (cond (gte rating 4) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
           {{{icon 'star' class=(concat 'w-4 h-4 ' (cond (gte rating 5) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
         </div>
         <span class="text-sm font-semibold text-foreground">{{rating}}/5</span>
         {{#if vote_count}}
         <span class="text-xs text-muted-foreground">({{vote_count}} votes)</span>
         {{/if}}
       </div>
       {{else}}
       <div class="flex items-center gap-2">
         <span class="text-sm text-muted-foreground">Not rated yet</span>
       </div>
       {{/if}}

       {{#if (and user (not is_owner))}}
       <div class="star-rating flex items-center gap-0.5" data-idea-id="{{id}}">
         <button
           class="star-btn p-1 rounded hover:bg-amber-50 dark:hover:bg-amber-950/30 text-muted-foreground hover:text-amber-500 transition-all duration-200 touch-manipulation active:scale-110"
           data-rating="1"
           title="Rate 1 star"
           aria-label="Rate 1 star">
           {{{icon 'star' class='w-4 h-4'}}}
         </button>
         <button
           class="star-btn p-1 rounded hover:bg-amber-50 dark:hover:bg-amber-950/30 text-muted-foreground hover:text-amber-500 transition-all duration-200 touch-manipulation active:scale-110"
           data-rating="2"
           title="Rate 2 stars"
           aria-label="Rate 2 stars">
           {{{icon 'star' class='w-4 h-4'}}}
         </button>
         <button
           class="star-btn p-1 rounded hover:bg-amber-50 dark:hover:bg-amber-950/30 text-muted-foreground hover:text-amber-500 transition-all duration-200 touch-manipulation active:scale-110"
           data-rating="3"
           title="Rate 3 stars"
           aria-label="Rate 3 stars">
           {{{icon 'star' class='w-4 h-4'}}}
         </button>
         <button
           class="star-btn p-1 rounded hover:bg-amber-50 dark:hover:bg-amber-950/30 text-muted-foreground hover:text-amber-500 transition-all duration-200 touch-manipulation active:scale-110"
           data-rating="4"
           title="Rate 4 stars"
           aria-label="Rate 4 stars">
           {{{icon 'star' class='w-4 h-4'}}}
         </button>
         <button
           class="star-btn p-1 rounded hover:bg-amber-50 dark:hover:bg-amber-950/30 text-muted-foreground hover:text-amber-500 transition-all duration-200 touch-manipulation active:scale-110"
           data-rating="5"
           title="Rate 5 stars"
           aria-label="Rate 5 stars">
           {{{icon 'star' class='w-4 h-4'}}}
         </button>
       </div>
       {{/if}}
     </div>
   </div>

  <!-- Progress Bar (if applicable) -->
  {{#if completion_percentage}}
  <div class="px-5 pb-4">
    <div class="space-y-2">
      <div class="flex justify-between items-center">
        <span class="text-xs font-medium text-muted-foreground">Progress</span>
        <span class="text-xs font-semibold text-foreground">{{completion_percentage}}%</span>
      </div>
      <div class="w-full bg-muted rounded-full h-2">
        <div class="bg-gradient-to-r from-primary to-primary/80 h-full rounded-full transition-all duration-1000 ease-out"
             style="width: {{completion_percentage}}%"></div>
      </div>
    </div>
  </div>
  {{/if}}

  <!-- Expandable Content -->
  <div class="expandable-content max-h-0 overflow-hidden transition-all duration-500 ease-out border-t border-border/30">
    <div class="p-5 space-y-5">
      <!-- Description -->
      {{#if description}}
      <div class="space-y-2">
        <h4 class="text-sm font-semibold text-foreground flex items-center gap-2">
          {{{icon 'file-text' class='w-4 h-4'}}}
          Description
        </h4>
        <div class="prose prose-sm max-w-none text-muted-foreground leading-relaxed">
          {{markdown description}}
        </div>
      </div>
      {{/if}}

      <!-- Tags -->
      {{#if tags}}
      <div class="space-y-2">
        <h4 class="text-sm font-semibold text-foreground flex items-center gap-2">
          {{{icon 'hash' class='w-4 h-4'}}}
          Tags
        </h4>
        <div class="flex flex-wrap gap-2">
          {{#each tags}}
          <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors">
            {{{icon 'tag' class='w-3 h-3 mr-1'}}}
            {{this}}
          </span>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- Unlocked Models -->
      {{#if unlocked_models}}
      <div class="space-y-2">
        <h4 class="text-sm font-semibold text-foreground flex items-center gap-2">
          {{{icon 'layers' class='w-4 h-4'}}}
          Unlocked Models
        </h4>
        <div class="flex flex-wrap gap-2">
          {{#each unlocked_models}}
          <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
            {{#if (eq this 'idea')}}{{{icon 'lightbulb' class='w-3 h-3 mr-1'}}}{{/if}}
            {{#if (eq this 'business')}}{{{icon 'building-2' class='w-3 h-3 mr-1'}}}{{/if}}
            {{#if (eq this 'financial')}}{{{icon 'dollar-sign' class='w-3 h-3 mr-1'}}}{{/if}}
            {{#if (eq this 'funding')}}{{{icon 'trending-up' class='w-3 h-3 mr-1'}}}{{/if}}
            {{#if (eq this 'legal')}}{{{icon 'scale' class='w-3 h-3 mr-1'}}}{{/if}}
            {{#if (eq this 'marketing')}}{{{icon 'megaphone' class='w-3 h-3 mr-1'}}}{{/if}}
            {{#if (eq this 'team')}}{{{icon 'users' class='w-3 h-3 mr-1'}}}{{/if}}
            {{this}}
          </span>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- Metadata -->
      <div class="space-y-2">
        <h4 class="text-sm font-semibold text-foreground flex items-center gap-2">
          {{{icon 'info' class='w-4 h-4'}}}
          Details
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="flex items-center gap-2 text-muted-foreground">
            {{{icon 'calendar' class='w-3.5 h-3.5'}}}
            <span>Created: {{created_at_formatted}}</span>
          </div>
          {{#if updated_at_formatted}}
          <div class="flex items-center gap-2 text-muted-foreground">
            {{{icon 'refresh-cw' class='w-3.5 h-3.5'}}}
            <span>Updated: {{updated_at_formatted}}</span>
          </div>
          {{/if}}
          {{#if privacy}}
          <div class="flex items-center gap-2">
            {{#if (eq privacy 'public')}}{{{icon 'globe' class='w-3.5 h-3.5 text-emerald-600'}}}{{/if}}
            {{#if (eq privacy 'private')}}{{{icon 'lock' class='w-3.5 h-3.5 text-amber-600'}}}{{/if}}
            <span class="font-medium capitalize">{{privacy}}</span>
          </div>
          {{/if}}
          {{#if is_owner}}
          <div class="flex items-center gap-2">
            {{{icon 'crown' class='w-3.5 h-3.5 text-emerald-600'}}}
            <span class="font-medium text-emerald-700 dark:text-emerald-300">Owner</span>
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Quick Status Controls for Owner -->
      {{#if (and user is_owner)}}
      <div class="space-y-2">
        <h4 class="text-sm font-semibold text-foreground flex items-center gap-2">
          {{{icon 'settings' class='w-4 h-4'}}}
          Quick Actions
        </h4>
        <div class="flex flex-wrap gap-2">
          {{#if (ne overall_status 'draft')}}
          <button
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
            onclick="updateIdeaStatus(this, '{{id}}', 'draft')"
            title="Set to Draft">
            {{{icon 'file-text' class='w-3.5 h-3.5'}}}
            Draft
          </button>
          {{/if}}

          {{#if (ne overall_status 'in_progress')}}
          <button
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors"
            onclick="updateIdeaStatus(this, '{{id}}', 'in_progress')"
            title="Set to In Progress">
            {{{icon 'loader' class='w-3.5 h-3.5'}}}
            In Progress
          </button>
          {{/if}}

          {{#if (ne overall_status 'completed')}}
          <button
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300 hover:bg-green-200 dark:hover:bg-green-800 transition-colors"
            onclick="updateIdeaStatus(this, '{{id}}', 'completed')"
            title="Set to Completed">
            {{{icon 'check-circle' class='w-3.5 h-3.5'}}}
            Complete
          </button>
          {{/if}}
        </div>
      </div>
      {{/if}}
    </div>
  </div>

  <!-- Action Buttons Footer -->
  <div class="px-5 py-4 border-t border-border/30 bg-muted/20">
    <div class="flex items-center justify-between">
      <!-- Primary Actions -->
      <div class="flex items-center gap-3">
        <button
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary text-primary-foreground rounded-xl hover:bg-primary/90 transition-all duration-200 touch-manipulation active:scale-95 font-semibold text-sm shadow-sm"
          onclick="window.location.href='/idea/{{id}}'"
          aria-label="View full details">
          {{{icon 'eye' class='w-4 h-4'}}}
          <span class="hidden sm:inline">View Details</span>
        </button>

        {{#if user}}
        <button
          class="populate-btn inline-flex items-center gap-2 px-3 py-2.5 bg-secondary text-secondary-foreground rounded-xl hover:bg-secondary/80 transition-all duration-200 touch-manipulation active:scale-95 text-sm font-medium"
          data-populate-id="{{id}}"
          title="Use this idea as a template">
          {{{icon 'copy' class='w-4 h-4'}}}
          <span class="hidden sm:inline">Use Template</span>
        </button>
        {{/if}}
      </div>

      <!-- Secondary Actions -->
      <div class="flex items-center gap-1">
        {{#if user}}
        {{#if (eq privacy 'private')}}
        <button
          class="share-btn p-2.5 rounded-xl hover:bg-green-50 dark:hover:bg-green-950/30 text-muted-foreground hover:text-green-600 transition-all duration-200 touch-manipulation active:scale-95"
          onclick="shareIdea(this)"
          data-id="{{id}}"
          title="Share this private idea">
          {{{icon 'share-2' class='w-4 h-4'}}}
        </button>
        {{/if}}

        {{#if (eq user.package_type 'enterprise')}}
        <button
          class="team-btn p-2.5 rounded-xl hover:bg-blue-50 dark:hover:bg-blue-950/30 text-muted-foreground hover:text-blue-600 transition-all duration-200 touch-manipulation active:scale-95"
          onclick="openTeamModal(this)"
          data-id="{{id}}"
          title="Manage team access">
          {{{icon 'users' class='w-4 h-4'}}}
        </button>
        {{/if}}

        {{#if is_owner}}
        <button
          class="unpublish-btn p-2.5 rounded-xl hover:bg-orange-50 dark:hover:bg-orange-950/30 text-muted-foreground hover:text-orange-600 transition-all duration-200 touch-manipulation active:scale-95"
          onclick="updateIdeaPrivacy(this, '{{id}}', 'private')"
          title="Make this idea private">
          {{{icon 'eye-off' class='w-4 h-4'}}}
        </button>

        <button
          class="archive-btn p-2.5 rounded-xl hover:bg-purple-50 dark:hover:bg-purple-950/30 text-muted-foreground hover:text-purple-600 transition-all duration-200 touch-manipulation active:scale-95"
          onclick="updateIdeaStatus(this, '{{id}}', 'archived')"
          title="Archive this idea">
          {{{icon 'archive' class='w-4 h-4'}}}
        </button>

        <button
          class="delete-btn p-2.5 rounded-xl hover:bg-red-50 dark:hover:bg-red-950/30 text-muted-foreground hover:text-red-600 transition-all duration-200 touch-manipulation active:scale-95"
          hx-delete="/api/ideas/{{id}}"
          hx-confirm="Are you sure you want to permanently delete this idea? This action cannot be undone."
          hx-target="closest .idea-card"
          hx-swap="outerHTML"
          hx-on:htmx:response-error="showToast('Failed to delete idea. Please try again.', 'error')"
          title="Delete this idea permanently">
          {{{icon 'trash-2' class='w-4 h-4'}}}
        </button>
        {{/if}}
        {{/if}}
      </div>
    </div>
  </div>
</div>
