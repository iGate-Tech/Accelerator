{{!< main}}
    <div class="flex justify-between items-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-base-content">Admin: Edit Prompts</h1>
        <div class="flex gap-4">
            <a href="/admin/export/json?admin=1" class="btn btn-secondary btn-sm" download="prompts.json">Export JSON</a>
            <a href="/admin/export/csv?admin=1" class="btn btn-secondary btn-sm" download="prompts.csv">Export CSV</a>
            <a href="/" class="btn btn-outline btn-sm">Back to Ideas</a>
        </div>
    </div>

    <form action="/admin/prompts?admin=1" method="post" class="space-y-8">
        {{#each grouped}}
            <div class="bg-base-100 rounded-xl shadow-lg border border-base-200 p-8">
                <h2 class="text-3xl font-bold text-base-content mb-6">{{@key}}</h2>
                {{#each this}}
                    <div class="mb-8 last:mb-0">
                        <h3 class="text-2xl font-semibold text-base-content mb-4 border-b border-base-300 pb-2">{{@key}}</h3>
                         {{#each this}}
                             <div class="mb-6 last:mb-0 flex items-start gap-2">
                                 <div class="flex-1">
                                     <label class="block text-lg font-medium text-base-content mb-2">{{globalIndex}}. {{localIndex}}. {{question}}</label>
                                     <textarea name="prompt-{{id}}" class="textarea textarea-bordered w-full h-32 resize-none" placeholder="Enter prompt...">{{prompt}}</textarea>
                                 </div>
                                 <div class="flex flex-col gap-1 self-start">
                                     {{#unless @first}}
                                         <form action="/admin/move-question-up?admin=1" method="post" class="inline">
                                             <input type="hidden" name="id" value="{{id}}">
                                             <button type="submit" class="btn btn-outline btn-xs" title="Move Up">↑</button>
                                         </form>
                                     {{/unless}}
                                     {{#unless @last}}
                                         <form action="/admin/move-question-down?admin=1" method="post" class="inline">
                                             <input type="hidden" name="id" value="{{id}}">
                                             <button type="submit" class="btn btn-outline btn-xs" title="Move Down">↓</button>
                                         </form>
                                     {{/unless}}
                                     <form action="/admin/delete-question?admin=1" method="post" class="inline">
                                         <input type="hidden" name="id" value="{{id}}">
                                         <button type="submit" class="btn btn-error btn-xs" onclick="return confirm('Are you sure you want to delete this question?')" title="Remove">✕</button>
                                     </form>
                                 </div>
                             </div>
                         {{/each}}
                         <div class="mt-6 p-4 bg-base-200 rounded-lg">
                             <h4 class="text-lg font-semibold mb-2">Add New Question to "{{@key}}" in "{{@../key}}"</h4>
                             <form action="/admin/add-question?admin=1" method="post" class="space-y-3">
                                 <input type="hidden" name="model" value="{{@../key}}">
                                 <input type="hidden" name="section" value="{{@key}}">
                                 <input type="text" name="question" class="input input-bordered w-full" placeholder="Enter new question..." required>
                                 <textarea name="prompt" class="textarea textarea-bordered w-full h-24" placeholder="Enter prompt..." required></textarea>
                                 <button type="submit" class="btn btn-primary">Add Question</button>
                             </form>
                         </div>
                    </div>
                {{/each}}
            </div>
        {{/each}}

        <div class="flex justify-end">
            <button type="submit" class="btn btn-primary btn-sm">Save All Changes</button>
        </div>
    </form>