{
  "name": "Accelerator",
  "version": "1.0.0",
  "description": "AI-powered startup accelerator tool using SolidJS for state management and OpenAI for simulations",
  "repository": "https://github.com/iGate-Tech/Accelerator.git",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "bun run build && bun server.js",
    "dev": "concurrently \"bun --hot vite\" \"bun --hot server.js\"",
    "dev:vite": "bun --hot vite",
    "dev:server": "bun --hot server.js",
    "build": "bun run vite build",
    "build:exe": "bun build --compile server.js --outfile accelerator-server",
    "preview": "bun run vite preview",
    "push": "git add . && git commit -m 'Update' && git push origin local",
    "docker:dev": "docker compose -f docker/docker-compose.yml --env-file docker/.env.development up",
    "docker:dev:build": "docker compose -f docker/docker-compose.yml --env-file docker/.env.development up --build",
    "docker:staging": "docker compose -f docker/docker-compose.yml --env-file docker/.env.staging up",
    "docker:staging:build": "docker compose -f docker/docker-compose.yml --env-file docker/.env.staging up --build -d",
    "docker:prod": "docker compose -f docker/docker-compose.yml --env-file docker/.env.production up -d",
    "docker:prod:build": "docker compose -f docker/docker-compose.yml --env-file docker/.env.production up --build -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json}\" --ignore-path .prettierignore",
    "typecheck": "echo 'Typecheck skipped - project uses JavaScript'"
  },
  "keywords": [
    "bun",
    "ai",
    "startup",
    "accelerator",
    "solidjs"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@solidjs/router": "^0.15.4",
    "animate.css": "^4.1.1",
    "body-parser": "^2.2.1",
    "daisyui": "^5.5.14",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-sort": "^3.4.1",
    "html2canvas": "^1.4.1",
    "js-base64": "^3.7.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.0.0",
    "lucide-solid": "^0.563.0",
    "marked": "^17.0.1",
    "openai": "^6.15.0",
    "pg": "^8.16.3",
    "solid-js": "^1.9.10",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.10"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@eslint/eslintrc": "^3.3.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-solid": "^0.14.5",
    "postcss-preset-env": "^10.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.2.0"
  }
}
