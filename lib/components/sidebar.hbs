<div id="sidebar"
    class="hidden md:flex h-[calc(100vh-3.1rem)] overflow-y-auto bg-card border-r border-input shadow-xl pointer-events-auto flex flex-col"
    style="width: 350px;">
    <div class="flex-1">
        <nav class="px-3 py-3 text-sm flex flex-col h-full">
            <div class="space-y-4">
              <a href="/new-idea" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary">
                {{{icon 'plus' class="w-5 h-5"}}}
                <span>{{t 'sidebar.new_idea' lng=lng}}</span>
              </a>
              <a href="/favorites" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary">
                {{{icon 'heart' class="w-5 h-5"}}}
                <span>{{t 'sidebar.favorites' lng=lng}}</span>
              </a>
               <a href="/explore-idea" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary">
                 {{{icon 'search' class="w-5 h-5"}}}
                 <span>{{t 'sidebar.explore_ideas' lng=lng}}</span>
                </a>
              </div>
             <div class="mt-4">
               <button onclick="toggleSidebarPortfolio()" class="w-full flex items-center justify-between px-3 py-3 rounded-lg bg-muted/50 hover:bg-muted text-left">
                 <div class="flex items-center gap-3">
                   {{{icon 'folder' class='w-5 h-5 text-primary'}}}
                   <span class="font-medium text-foreground">{{t 'sidebar.projects' lng=lng}}</span>
                 </div>
                 <div class="flex items-center">
                    <span class="text-xs text-muted-foreground mr-2">{{t 'sidebar.project_count' count=projects.length lng=lng}}</span>
                   {{{icon 'chevron-down' class='w-4 h-4 transition-transform duration-200 sidebar-chevron'}}}
                 </div>
               </button>
               <div id="sidebar-portfolio-list-container" class="hidden mt-3 pl-4">
                 <div class="relative mb-3">
                    <input type="text" id="sidebar-project-search" placeholder="{{t 'sidebar.search_projects' lng=lng}}" class="w-full text-sm border border-input rounded-lg bg-card text-foreground pl-10 pr-10 py-2 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary/40">
                   <div class="absolute left-3 top-1/2 transform -translate-y-1/2">
                     {{{icon 'search' class='w-4 h-4 text-muted-foreground'}}}
                   </div>
                   <button type="button" id="sidebar-project-search-clear" class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground hover:text-foreground opacity-0 transition-opacity" onclick="clearSidebarProjectSearch()">
                     {{{icon 'x' class='w-4 h-4'}}}
                   </button>
                 </div>
                 <div id="sidebar-portfolio-list" class="space-y-2 flex-1 overflow-y-auto">
                   {{#each projects}}
                   <a href="/models/idea?ideaId={{id}}" class="flex items-center gap-3 px-3 py-3 rounded-lg bg-card border border-input hover:bg-primary/5 hover:border-primary/20 transition-colors block">
                     <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center">
                       {{{icon 'file-text' class='w-4 h-4 text-primary'}}}
                     </div>
                     <div class="flex-1 min-w-0">
                       <p class="text-sm font-medium text-foreground truncate">{{title}}</p>
                        <p class="text-xs text-muted-foreground">{{t 'sidebar.idea_label' lng=lng}}</p>
                     </div>
                     {{{icon 'chevron-right' class='w-4 h-4 text-muted-foreground'}}}
                   </a>
                   {{/each}}
      </div>
    </div>

    <script>
    function toggleSidebarPortfolio() {
      const container = document.getElementById('sidebar-portfolio-list-container');
      container.classList.toggle('hidden');
      const chevron = event.target.closest('button').querySelector('.sidebar-chevron');
      chevron.classList.toggle('rotate-180');
    }

    function clearSidebarProjectSearch() {
      const input = document.getElementById('sidebar-project-search');
      input.value = '';
      filterSidebarProjects('');
      const clearBtn = document.getElementById('sidebar-project-search-clear');
      clearBtn.style.opacity = '0';
    }

    function filterSidebarProjects(query) {
       const items = document.querySelectorAll('#sidebar-portfolio-list a');
       let visibleCount = 0;
       items.forEach(item => {
         const text = item.textContent.toLowerCase();
         if (text.includes(query.toLowerCase())) {
           item.style.display = 'block';
           visibleCount++;
         } else {
           item.style.display = 'none';
         }
       });
       // Update the count in the toggle button
       const countSpan = document.querySelector('#sidebar button span.text-xs');
       if (countSpan) {
          // Note: This JavaScript count update would need server-side translation
          // For now, keeping the English fallback
          countSpan.textContent = `${visibleCount} projects`;
       }
     }

    document.addEventListener('DOMContentLoaded', function() {
      const sidebarSearchInput = document.getElementById('sidebar-project-search');
      if (sidebarSearchInput) {
        sidebarSearchInput.addEventListener('input', function() {
          const query = this.value;
          filterSidebarProjects(query);
          const clearBtn = document.getElementById('sidebar-project-search-clear');
          if (query) {
            clearBtn.style.opacity = '1';
          } else {
            clearBtn.style.opacity = '0';
          }
        });
      }
    });
    </script>
             </div>
         </nav>
     </div>
</div>