<div class="flex flex-col ">
    <!-- Header -->
    <header class="w-full flex flex-col items-center gap-2 mb-2">
           <h1 class="text-2xl sm:text-3xl md:text-4xl font-sans font-light text-foreground mb-6 sm:mb-10 text-center">
               {{t 'new-idea.greeting' lng=lng}} <span class="text-primary">{{firstName user.profile.name}}</span>, {{t 'new-idea.question' lng=lng}}
           </h1>
    </header>

    <!-- Form / Input area -->
    <style>
