    <!-- User Menu -->
    <div class="relative self-center" id="admin-user-menu">
       <button onclick="toggleUserMenu()"
         class="flex items-center gap-3 h-10 px-3 rounded-md transition-all duration-200 hover:text-primary cursor-pointer border-0"
         id="admin-user-menu-button">
          <img src="{{cond user.profile.avatar_url user.profile.avatar_url '/images/avatar.png'}}" class="h-6 w-6 rounded-full object-cover shrink-0 user-avatar" alt="User Avatar">
          <span class="text-sm">{{cond user.profile.name user.profile.name 'User'}}</span>


      </button>

      <!-- User Dropdown -->
        <div
          class="fixed md:absolute {{#if (eq lng 'ar')}}left-0{{else}}right-0{{/if}} mt-0 md:mt-2 w-full md:w-64 bg-base-100 border border-input rounded-md shadow-lg z-30 transition-all duration-200 opacity-0 invisible hidden"
          id="admin-user-dropdown">
        <div class="p-2">

            <!-- User profile section -->
            <a href="/profile/{{user.id}}"
     class="w-full mb-2 relative flex cursor-default select-none items-center gap-3 rounded-sm px-3 py-3 text-sm text-left outline-none transition-colors bg-primary-50 hover:bg-primary-100 hover:text-primary-900">
      <img src="{{cond user.profile.avatar_url user.profile.avatar_url '/images/avatar.png'}}" class="h-8 w-8 rounded-full object-cover shrink-0" alt="User Avatar">
      <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-1">
               <span class="truncate user-name text-foreground">{{cond user.profile.name user.profile.name 'User'}}</span>
          </div>
          <div class="truncate text-xs text-muted-foreground user-email mb-1">{{user.email}}</div>
          <div class="text-xs text-muted-foreground">
               <span class="nav-current-plan-name">{{#if user.profile.packageName}}{{user.profile.packageName}} {{t 'nav.plan' lng=lng}}{{else}}{{cond user.profile.package_type (capitalize user.profile.package_type) 'Free'}} {{t 'nav.plan' lng=lng}}{{/if}}</span>
          </div>
     </div>
 </a>

            <!-- Settings -->
            <a href="/settings"
              class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900 mb-1">

             {{{icon "settings" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.settings' lng=lng}}
            </a>






          <!-- Upgrade Package -->
          <a href="/upgrade-package"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "arrow-up-circle" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.upgrade_package' lng=lng}}
          </a>

          <!-- Buy Credits -->
          <a href="/buy-credits"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "coins" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.buy_credits' lng=lng}}
           </a>

           <!-- Rewards Earn -->
           <a href="/rewards"
             class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

              {{{icon "gift" class="h-4 w-4 shrink-0"}}}

              Rewards Earn
           </a>

           <!-- Billing -->
           <a href="/billing"
             class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

              {{{icon "credit-card" class="h-4 w-4 shrink-0"}}}

              {{t 'nav.billing' lng=lng}}
           </a>

          <!-- Add Payment Method -->
          <a href="/add-payment-method"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "plus-circle" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.add_payment_method' lng=lng}}
            </a>

            <!-- User Activity -->
          <a href="/user-activity"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary-100 hover:text-primary-900">

             {{{icon "activity" class="h-4 w-4 shrink-0"}}}

             {{t 'nav.user_activity' lng=lng}}
          </a>

          <!-- Separator -->
          <div class="border-t border-input -mx-1 my-1"></div>




           <!-- Log out item -->
           <button onclick="showLogoutConfirm()"
             class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors text-error hover:bg-error/10">

  {{{icon 'log-out' class='h-4 w-4 shrink-0' size='16'}}}

              {{t 'nav.logout' lng=lng}}
           </button>


        </div>
      </div>
     </div>

    <!-- Mobile Menu -->
    <div id="mobile-nav-menu" class="fixed inset-0 bg-black bg-opacity-50 z-40 md:hidden hidden">
      <div class="fixed top-0 left-0 w-full h-full bg-card border-r border-input shadow-xl transform transition-transform duration-300 overflow-y-auto">
        <div class="flex items-center justify-between p-4 border-b border-input">
          <div class="flex items-center gap-2">
            <img src="/images/favicon.svg" alt="Accelerator logo" class="h-6 w-6"/>
            <span class="font-medium">Accelerator</span>
          </div>
          <button onclick="toggleMobileNav()" class="p-2 text-muted-foreground hover:text-foreground">
            {{{icon 'x' class="w-5 h-5"}}}
          </button>
        </div>
        <div class="flex-1 overflow-y-auto p-4">
           <!-- Mobile Nav Links -->
           <div class="space-y-4">
             <a href="/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary" onclick="toggleMobileNav()">
               {{{icon 'layout-dashboard' class="w-5 h-5"}}}
               <span>{{t 'nav.dashboard' lng=lng}}</span>
             </a>
             <a href="/new-idea" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary" onclick="toggleMobileNav()">
               {{{icon 'plus' class="w-5 h-5"}}}
               <span>{{t 'nav.new_idea' lng=lng}}</span>
             </a>
             <a href="/favorites" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary" onclick="toggleMobileNav()">
               {{{icon 'heart' class="w-5 h-5"}}}
               <span>{{t 'ideas.favorites.title'}}</span>
             </a>
             <a href="/explore-idea" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary" onclick="toggleMobileNav()">
               {{{icon 'search' class="w-5 h-5"}}}
               <span>{{t 'nav.explore_ideas' lng=lng}}</span>
             </a>
            {{#if (eq user.profile.package_type "enterprise")}}
             <a href="/portfolios" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary" onclick="toggleMobileNav()">
               {{{icon 'folder' class="w-5 h-5"}}}
               <span>{{t 'nav.portfolios' lng=lng}}</span>
             </a>
            {{/if}}
            <a href="/voting-reward" class="flex items-center gap-3 px-3 py-2 rounded-md text-muted-foreground hover:bg-primary/10 hover:text-primary" onclick="toggleMobileNav()">
               {{{icon 'star' class="w-5 h-5"}}}
               <span>{{t 'nav.voting_rewards' lng=lng}}</span>
             </a>
            </div>

            {{#if projects}}
            <div class="border-t border-input pt-4 mt-4">
              <button onclick="toggleMobilePortfolio(event)" class="w-full flex items-center justify-between px-3 py-3 rounded-lg bg-muted/50 hover:bg-muted text-left">
                 <div class="flex items-center gap-3">
                   {{{icon 'folder' class='w-5 h-5 text-primary'}}}
                   <span class="font-medium text-foreground">{{t 'nav.portfolios' lng=lng}}</span>
                 </div>
                <div class="flex items-center">
                  <span class="text-xs text-muted-foreground mr-2">{{projects.length}} projects</span>
                  {{{icon 'chevron-down' class='w-4 h-4 transition-transform duration-200 chevron'}}}
                </div>
              </button>
              <div id="mobile-portfolio-list-container" class="hidden mt-3 pl-4">
                <div class="relative mb-3">
                  <input type="text" id="mobile-project-search" placeholder="Search projects..." class="w-full text-sm border border-input rounded-lg bg-card text-foreground pl-10 pr-10 py-2 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary/40">
                  <div class="absolute left-3 top-1/2 transform -translate-y-1/2">
                    {{{icon 'search' class='w-4 h-4 text-muted-foreground'}}}
                  </div>
                  <button type="button" id="mobile-project-search-clear" class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground hover:text-foreground opacity-0 transition-opacity" onclick="clearMobileProjectSearch()">
                    {{{icon 'x' class='w-4 h-4'}}}
                  </button>
                </div>
                <div id="mobile-portfolio-list" class="space-y-2 flex-1 overflow-y-auto">
                  {{#each projects}}
                  <a href="/models/idea?ideaId={{id}}" class="flex items-center gap-3 px-3 py-3 rounded-lg bg-card border border-input hover:bg-primary/5 hover:border-primary/20 transition-colors block" onclick="toggleMobileNav()">
                    <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center">
                      {{{icon 'file-text' class='w-4 h-4 text-primary'}}}
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-foreground truncate">{{title}}</p>
                       <p class="text-xs text-muted-foreground">{{t 'sidebar.idea_label' lng=lng}}</p>
                    </div>
                    {{{icon 'chevron-right' class='w-4 h-4 text-muted-foreground'}}}
                  </a>
                  {{/each}}
                </div>
              </div>
            </div>
             {{/if}}
        </div>
      </div>
    </div>

    <!-- Logout Confirmation Modal -->
    <div id="logout-confirm-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
     <div class="bg-card border border-input rounded-lg shadow-lg p-6 max-w-sm w-full mx-4">
       <div class="flex items-center gap-3 mb-4">
         {{{icon 'alert-triangle' class='h-6 w-6 text-error'}}}
         <h3 class="text-lg font-semibold text-foreground">{{t 'nav.logout' lng=lng}}</h3>
       </div>
       <p class="text-muted-foreground mb-6">{{t 'nav.logout_confirm' lng=lng}}</p>
       <div class="flex gap-3 justify-end">
         <button onclick="hideLogoutConfirm()" class="px-4 py-2 text-sm font-medium text-muted-foreground hover:text-foreground border border-input rounded-md">
           {{t 'nav.cancel' lng=lng}}
         </button>
          <button onclick="logout()" class="px-4 py-2 text-sm font-medium bg-error text-error-foreground rounded-md hover:bg-error/90">
           {{t 'nav.logout' lng=lng}}
         </button>
       </div>
     </div>
   </div>
  </nav>

  <!-- Logout Loading Screen -->
  <div id="logout-loading-screen" class="fixed inset-0 bg-background flex items-center justify-center z-50 hidden">
    <div class="text-center">
      <svg class="animate-spin h-16 w-16 sm:h-20 sm:w-20 md:h-24 md:w-24 mx-auto" viewBox="0 0 24 24">
        <defs>
          <linearGradient id="spinner-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#9e28b5"/>
            <stop offset="25%" stop-color="#00a7e0"/>
            <stop offset="50%" stop-color="#6cd14d"/>
            <stop offset="75%" stop-color="#ffc600"/>
            <stop offset="100%" stop-color="#9e28b5"/>
          </linearGradient>
        </defs>
        <circle cx="12" cy="12" r="10" stroke="url(#spinner-gradient)" stroke-width="2" fill="none"/>
      </svg>
      <h2 class="text-xl font-semibold text-foreground mt-4 mb-2">{{t 'loading.logout_title' lng=lng}}</h2>
      <p class="text-muted-foreground">{{t 'loading.logout_description' lng=lng}}</p>
  </div>

</div>


