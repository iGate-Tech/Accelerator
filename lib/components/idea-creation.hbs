                    if (result.error) {
                        showToastMessage('AI error: ' + result.error, 'error');
                    } else {
                        waitForMarked(() => {
                            descriptionTextarea.dataset.originalContent = result.improved_description;
                            descriptionTextarea.value = result.improved_description;
                            const displayDivImprove = document.getElementById('assistant-prompt-display');
                            const processedContent = result.improved_description.replace(/\n/g, '\n\n');
                            displayDivImprove.innerHTML = marked.parse(processedContent, { breaks: true });
                            displayDivImprove.style.display = 'block';
                            descriptionTextarea.style.display = 'none';
                        });
                    updateCharCounter();
                        showToastMessage('Description improved successfully', 'success');
                        showToastMessage('10 credits deducted for AI usage', 'warning');
                        if (typeof window.loadNavCreditBalance === 'function') {
                            window.loadNavCreditBalance();
                        }
                    }
                } catch (error) {
                    console.error('Improve description error:', error);
                    showToastMessage('Network error. Please try again.', 'error');
                } finally {
                    setButtonLoading(improveBtn, false);
                }
            });
        }

        // Form submission
        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            // Client-side validation
            if (!descriptionTextarea.value.trim()) {
                if (typeof showToast !== 'undefined') {
                    showToast('Please enter a project description', 'warning');
                }
                return;
            }
            const descLength = descriptionTextarea.value.length;
            if (descLength < 100 || descLength > 2000) {
                if (typeof showToast !== 'undefined') {
                    showToast('Description must be between 100 and 2000 characters', 'warning');
                }
                return;
            }

            // Collect form data
            const title = titleSpan.textContent.trim() || 'Untitled';
            const category = categorySpan.textContent.trim() || 'Category';
            const description = descriptionTextarea.value;
            const tags = Array.from(document.querySelectorAll('.tag-lskjsdb span[contenteditable]')).map(span => span.textContent.trim()).filter(tag => tag);

            // Show loading state
            submitButton.disabled = true;
            submitButton.innerHTML = '<span>Creating...</span>';

            if (typeof showToast !== 'undefined') {
                showToast('Creating your idea...', 'info');
            }

            let success = false;

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        _csrf: document.querySelector('input[name="_csrf"]').value,
                        prompt: description,
                        title,
                        category,
                        tags: JSON.stringify(tags)
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    success = true;
                    if (typeof showToast !== 'undefined') {
                        showToast('Idea created successfully!', 'success');
                    }
                    // Success - redirect to idea detail page after a short delay to show toast
                    setTimeout(() => {
                        window.location.href = `/models/idea?ideaId=${data.idea_id}`;
                    }, 1000);
                } else {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Failed to create project');
                }
            } catch (error) {
                console.error('Submission error:', error);
                if (typeof showToast !== 'undefined') {
                    showToast('Network error. Please try again.', 'error');
                }
            } finally {
                // Reset loading state only if not already handled in success case
                if (!success) {
                    submitButton.disabled = false;
                    submitButton.innerHTML = `
                        {{{icon 'plus' class='w-4 h-4' size='16'}}}
                        <span class="hidden group-hover:inline transition-all duration-200">Create Project</span>
                    `;
                }
            }
        });
    });
}); // End waitForMarked
</script>