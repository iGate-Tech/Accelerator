<main id="add-payment-method-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="grid gap-1">
        <h1 class="font-heading text-3xl font-semibold text-foreground">
          {{t 'payments.add_method.title'}}
        </h1>
        <p class="text-lg text-muted-foreground">
          {{t 'payments.add_method.description'}}
        </p>
      </div>

      <!-- Payment Method Form -->
      <div class="bg-card rounded-lg border border-border p-6">
        <form id="payment-method-form" method="POST" action="/add-payment-method" class="space-y-6">
          <!-- Card Type Selection -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.payment_method_type'}}</label>
            <div class="grid grid-cols-3 gap-4">
              <label class="relative">
                <input type="radio" name="cardType" value="credit" class="sr-only peer" checked>
                <div class="p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                  <div class="flex items-center gap-3">
                    {{{icon 'credit-card' class='w-6 h-6 text-primary' size='24'}}}
                    <div>
                      <div class="font-medium text-foreground">{{t 'payments.add_method.credit_card'}}</div>
                      <div class="text-sm text-muted-foreground">{{t 'payments.add_method.visa_mastercard'}}</div>
                    </div>
                  </div>
                </div>
              </label>
              <label class="relative">
                <input type="radio" name="cardType" value="debit" class="sr-only peer">
                <div class="p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                  <div class="flex items-center gap-3">
                    {{{icon 'credit-card' class='w-6 h-6 text-primary' size='24'}}}
                    <div>
                      <div class="font-medium text-foreground">{{t 'payments.add_method.debit_card'}}</div>
                      <div class="text-sm text-muted-foreground">{{t 'payments.add_method.bank_debit_cards'}}</div>
                    </div>
                  </div>
                </div>
              </label>
              <label class="relative">
                <input type="radio" name="cardType" value="paypal" class="sr-only peer">
                <div class="p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                  <div class="flex items-center gap-3">
                    {{{icon 'wallet' class='w-6 h-6 text-primary' size='24'}}}
                    <div>
                      <div class="font-medium text-foreground">{{t 'payments.add_method.paypal'}}</div>
                      <div class="text-sm text-muted-foreground">{{t 'payments.add_method.paypal_account'}}</div>
                    </div>
                  </div>
                </div>
              </label>
            </div>
          </div>

          <!-- Card Details -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
              <label for="cardNumber" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.card_number'}}</label>
              <div class="relative">
                <input type="text" id="cardNumber" name="cardNumber" placeholder="{{t 'payments.add_method.card_number_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
                <div class="absolute right-3 top-1/2 transform -translate-y-1/2 flex gap-1">
                  <div class="w-6 h-4 bg-blue-600 rounded text-white text-xs flex items-center justify-center font-bold">V</div>
                  <div class="w-6 h-4 bg-red-600 rounded text-white text-xs flex items-center justify-center font-bold">M</div>
                  <div class="w-6 h-4 bg-blue-400 rounded text-white text-xs flex items-center justify-center font-bold">A</div>
                </div>
              </div>
            </div>

            <div>
              <label for="expiryDate" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.expiry_date'}}</label>
              <input type="text" id="expiryDate" name="expiryDate" placeholder="{{t 'payments.add_method.expiry_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
            </div>

            <div>
              <label for="cvv" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.cvv'}}</label>
              <input type="text" id="cvv" name="cvv" placeholder="{{t 'payments.add_method.cvv_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
            </div>
          </div>

          <!-- Cardholder Name -->
          <div>
            <label for="cardholderName" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.cardholder_name'}}</label>
            <input type="text" id="cardholderName" name="cardholderName" placeholder="{{t 'payments.add_method.cardholder_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
          </div>

          <!-- Billing Address -->
          <div>
            <h3 class="text-lg font-medium text-foreground mb-4">{{t 'payments.add_method.billing_address'}}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="md:col-span-2">
                <label for="address" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.street_address'}}</label>
                <input type="text" id="address" name="address" placeholder="{{t 'payments.add_method.street_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
              </div>

              <div>
                <label for="city" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.city'}}</label>
                <input type="text" id="city" name="city" placeholder="{{t 'payments.add_method.city_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
              </div>

              <div>
                <label for="zipCode" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.zip_code'}}</label>
                <input type="text" id="zipCode" name="zipCode" placeholder="{{t 'payments.add_method.zip_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
              </div>

              <div>
                <label for="country" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.country'}}</label>
                <select id="country" name="country" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
                  <option value="">{{t 'payments.add_method.select_country'}}</option>
                  <option value="US">United States</option>
                  <option value="CA">Canada</option>
                  <option value="UK">United Kingdom</option>
                  <option value="AU">Australia</option>
                  <option value="DE">Germany</option>
                  <option value="FR">France</option>
                  <option value="JP">Japan</option>
                  <option value="SA">Saudi Arabia</option>
                </select>
              </div>

              <div>
                <label for="state" class="block text-sm font-medium text-foreground mb-2">{{t 'payments.add_method.state_province'}}</label>
                <input type="text" id="state" name="state" placeholder="{{t 'payments.add_method.state_placeholder'}}" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
              </div>
            </div>
          </div>

          <!-- Security Notice -->
          <div class="bg-muted/50 rounded-lg p-4">
            <div class="flex items-start gap-3">
              {{{icon 'shield-check' class='w-5 h-5 text-success mt-0.5' size='20'}}}
              <div>
                <h4 class="font-medium text-foreground">{{t 'payments.add_method.secure_payment'}}</h4>
                <p class="text-sm text-muted-foreground">{{t 'payments.add_method.payment_secure'}}</p>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex gap-4 pt-4">
            <button type="submit" class="btn btn-primary flex-1">
              {{t 'payments.add_method.add_payment_method'}}
            </button>
            <button type="button" class="btn btn-outline" onclick="window.history.back()">
              {{t 'payments.add_method.cancel'}}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>