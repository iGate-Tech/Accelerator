          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-move-right-icon lucide-move-right mx-2 text-gray-300"
        ><path d="M18 8L22 12L18 16" /><path d="M2 12H22" /></svg>
        <div
          class="badge horizontal-badge group hover:badge-primary cursor-pointer"
