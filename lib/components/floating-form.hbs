<!-- Floating Idea Creation Form -->
<div class="fixed bottom-6 left-0 right-0  z-40  ">
    <div class="max-w-4xl mx-auto bg-card rounded-2xl">
        <div class="flex flex-col w-fit shiny-prompt p-[1px] rounded-lg">


            <form id="floating-new-project-form"
                class="flex max-w-[900px] rounded-lg min-w-[900px] flex-col gap-1 w-full bg-card " method="post"
                action="/projects/new">

                <!-- CSRF Token (Important for security) -->
                <input type="hidden" name="_csrf" value="">

                <div class="flex flex-col w-full">
                    <div class="">
                        <div
                            class="new-project-form flex flex-col gap-2 rounded-lg relative py-2 border border-border bg-background shadow-sm">
                            <!-- Step Pills -->
                            <div class="flex flex-wrap items-center gap-1 mx-2 justify-center">
                                {{#each steps}}
                                <span
                                    class="floating-step-pill px-3 py-1 {{#if @first}}bg-primary text-primary-foreground{{else}}bg-muted text-muted-foreground{{/if}} text-xs rounded-full"
                                    data-section="{{section}}">{{number}}.
                                    {{title}}</span>
                                {{#unless @last}}
                                <div class="h-0.5 bg-muted flex-1 min-w-2"></div>
                                {{/unless}}
                                {{/each}}
                            </div>


                            <!-- Description wrapper -->
                            <div class=" pl-4 pr-2 relative">
                                <label for="floating-assistant-prompt" class="sr-only">Describe your
                                    project requirements</label>
                                <textarea id="floating-assistant-prompt" name="prompt"
                                    placeholder="Describe your project requirements..."
                                    aria-label="Describe your project requirements"
                                    aria-describedby="floating-prompt-help floating-char-counter"
                                    class="flex w-full rounded-md border-0 bg-transparent p-0 pt-[1px] text-base placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0"
                                    required=""
                                    style="min-height: 2.5rem; resize: none; overflow: hidden; height: 49px;"></textarea>
                                <p id="floating-prompt-help" class="sr-only">Enter your project
                                    description or requirements</p>
                            </div>

                            <!-- Tags wrapper -->
                            <div class="pl-4 pr-2">
                                <div id="floating-tagslist" class="flex flex-wrap gap-1">



                                    <!-- Remove all -->
                                    <span id="floating-removeAllTags" class="inline-flex items-center gap-1 px-2 py-0.5
                      bg-destructive/10
                      text-destructive
                       border border-destructive/40
                     text-xs rounded-full cursor-pointer" style="display: none;">

{{{icon 'trash' class='w-3 h-3' size='12'}}}
                                        Remove all
                                    </span>

                                </div>
                            </div>


                            <!-- toolbar -->
                            <div class="px-3 flex gap-2 items-center">
                                <div class="flex gap-2 items-center flex-shrink-0">


                                    <!-- Improve with AI -->
                                    <button type="button" aria-label="Improve with AI" title="Improve with AI"
                                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'lightbulb' class='w-4 h-4' size='16'}}}

                                        <span class="hidden group-hover:inline transition-all duration-200">Improve
                                            Description with AI</span>
                                    </button>



                                    <!-- Auto fill with AI -->
                                    <button type="button" aria-label="Auto fill with AI" title="Auto fill with AI"
                                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'wand-sparkles' class='w-4 h-4' size='16'}}}

                                        <span class="hidden group-hover:inline transition-all duration-200">Auto
                                            Fill with AI</span>
                                    </button>



                                    <!-- Reset form -->
                                    <button type="button" aria-label="Reset form" title="Reset form"
                                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'rotate-ccw' class='w-4 h-4' size='16'}}}

                                        <span class="hidden group-hover:inline transition-all duration-200">Reset
                                            Form</span>
                                    </button>
                                </div>

                                <!-- Submit button on the right -->
                                <div class="min-w-0 flex gap-2 ml-auto flex-shrink items-center">
                                    <span id="floating-char-counter" class="text-xs text-red-500/60 mr-2"
                                        aria-live="polite">Characters:
                                        0 / 2000</span>
                                    <button type="submit" aria-label="Create project" title="Create project"
                                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'plus' class='w-4 h-4' size='16'}}}

                                        <span class="hidden group-hover:inline transition-all duration-200">Create
                                            Project</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Floating form script
    document.addEventListener('DOMContentLoaded', () => {
        // Initialize form elements
        const floatingForm = document.getElementById('floating-new-project-form');
        const floatingDescriptionTextarea = document.getElementById('floating-assistant-prompt');
        const floatingTagsContainer = document.getElementById('floating-tagslist');
        const floatingSubmitButton = floatingForm.querySelector('button[type="submit"]');

        // Auto-expand textarea
        function floatingAutoExpandTextarea() {
            floatingDescriptionTextarea.style.height = 'auto';
            floatingDescriptionTextarea.style.height = floatingDescriptionTextarea.scrollHeight + 'px';
        }

        // Character counter
        function floatingUpdateCharCounter() {
            const length = floatingDescriptionTextarea.value.length;
            const counter = document.getElementById('floating-char-counter');
            counter.textContent = `Characters: ${length} / 2000`;
            if (length < 100 || length > 2000) {
                counter.className = 'text-xs text-red-500/60 mr-2';
            } else {
                counter.className = 'text-xs text-green-500/60 mr-2';
            }
            floatingAutoExpandTextarea();
        }

        // Initialize textarea height
        floatingDescriptionTextarea.style.minHeight = '2.5rem';
        floatingDescriptionTextarea.style.resize = 'none';
        floatingDescriptionTextarea.style.overflow = 'hidden';

        floatingDescriptionTextarea.addEventListener('input', floatingUpdateCharCounter);
        floatingUpdateCharCounter();

        // Ensure textarea height is adjusted for pre-filled content
        setTimeout(() => {
            floatingAutoExpandTextarea();
        }, 0);



        const floatingRemoveAllTagsBtn = document.getElementById('floating-removeAllTags');
        floatingRemoveAllTagsBtn.style.display = 'none';

        function floatingUpdateRemoveAllVisibility() {
            const tagCount = document.querySelectorAll('.floating-tag-lskjsdb').length;
            floatingRemoveAllTagsBtn.style.display = tagCount > 1 ? 'inline-flex' : 'none';
        }

        floatingRemoveAllTagsBtn.addEventListener('click', function (e) {
            floatingRemoveAllTags();
        });

        // Tag management functions
        function floatingAddTag(tagText) {
            if (typeof tagText === 'object') {
                tagText = tagText.name || tagText.value || tagText.toString();
            }
            if (!tagText || !tagText.trim()) {
                return;
            }
            const tagSpan = document.createElement('span');
            tagSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-muted text-muted-foreground border border-muted text-xs rounded-full floating-tag-lskjsdb';
            tagSpan.innerHTML = `<span contenteditable="true">${tagText}</span> <button class="text-muted-foreground hover:text-destructive p-0">×</button>`;
            const addMoreBtn = floatingTagsContainer.querySelector('[class*="bg-success/5"]');
            if (addMoreBtn) {
                addMoreBtn.after(tagSpan);
            }
            tagSpan.querySelector('button').addEventListener('click', function () {
                tagSpan.remove();
                showToastMessage('Tag removed', 'success');
                floatingUpdateRemoveAllVisibility();
            });
            floatingUpdateRemoveAllVisibility();
        }

        function floatingAddTagsFromArray(tagsArray) {
            if (Array.isArray(tagsArray)) {
                tagsArray.forEach(tag => floatingAddTag(tag));
            }
        }

        function floatingRemoveAllTags() {
            const tagElements = document.querySelectorAll('.floating-tag-lskjsdb');
            const count = tagElements.length;
            if (count === 0) {
                showToastMessage('No tags to remove', 'warning');
            } else {
                tagElements.forEach(tag => tag.remove());
                showToastMessage(`${count} tags removed`, 'success');
                floatingUpdateRemoveAllVisibility();
            }
        }

        // AI button handlers
        async function floatingCallAIApi(endpoint, data) {
            try {
                const response = await fetch(`/api/ai/${endpoint}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                return await response.json();
            } catch (error) {
                return { error: 'Network error' };
            }
        }

        // Helper function to set button loading state
        function floatingSetButtonLoading(button, loading) {
            if (!button) return;

            const icon = button.querySelector('svg');
            const textSpan = button.querySelector('span');

            if (loading) {
                button.disabled = true;
                button.classList.add('cursor-not-allowed', 'bg-warning/20', 'border-warning/50');

                // Replace icon with loading spinner
                if (icon) {
                    icon.outerHTML = `
{{{icon 'loader' class='w-4 h-4 animate-spin text-warning' size='16'}}}
                    `;
                }

                // Show processing text
                if (textSpan) {
                    textSpan.textContent = 'Processing...';
                    textSpan.classList.remove('hidden', 'group-hover:inline');
                    textSpan.classList.add('inline', 'text-warning');
                }
            } else {
                button.disabled = false;
                button.classList.remove('cursor-not-allowed', 'bg-warning/20', 'border-warning/50');

                // Restore original icon
                const spinner = button.querySelector('.animate-spin');
                if (spinner) {
                    const ariaLabel = button.getAttribute('aria-label');
                    let originalIcon = '';

                    if (ariaLabel.includes('title')) {
                        originalIcon = `{{{icon 'type' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('category')) {
                        originalIcon = `{{{icon 'folder' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('Improve')) {
                        originalIcon = `{{{icon 'lightbulb' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('tags')) {
                        originalIcon = `{{{icon 'tag' class='w-4 h-4' size='24'}}}`;
                    } else if (ariaLabel.includes('Auto fill')) {
                        originalIcon = `{{{icon 'wand-sparkles' class='w-4 h-4' size='16'}}}`;
                    } else if (ariaLabel.includes('random')) {
                        originalIcon = `{{{icon 'shuffle' class='w-4 h-4' size='16'}}}`;
                    }

                    spinner.outerHTML = originalIcon;
                }

                // Reset text to original state and restore hover behavior
                if (textSpan) {
                    // Reset to original text based on button type
                    const ariaLabel = button.getAttribute('aria-label');
                    if (ariaLabel.includes('title')) {
                        textSpan.textContent = 'Generate Title with AI';
                    } else if (ariaLabel.includes('category')) {
                        textSpan.textContent = 'Add Category with AI';
                    } else if (ariaLabel.includes('Improve')) {
                        textSpan.textContent = 'Improve Description with AI';
                    } else if (ariaLabel.includes('tags')) {
                        textSpan.textContent = 'Add Tags with AI';
                    } else if (ariaLabel.includes('Auto fill')) {
                        textSpan.textContent = 'Auto Fill with AI';
                    } else if (ariaLabel.includes('random')) {
                        textSpan.textContent = 'Random Idea with AI';
                    }

                    // Restore original classes for hover behavior
                    textSpan.classList.remove('inline', 'text-warning');
                    textSpan.classList.add('hidden', 'group-hover:inline');
                }
            }
        }







        // Reset form
        const floatingResetFormBtn = floatingForm.querySelector('[aria-label="Reset form"]');
        if (floatingResetFormBtn) {
            floatingResetFormBtn.addEventListener('click', function (e) {
                floatingDescriptionTextarea.value = '';
                floatingRemoveAllTags();
                floatingUpdateCharCounter();
                showToastMessage('Form reset successfully', 'info');
            });
        }

        // Auto fill with AI
        const floatingAutoFillBtn = floatingForm.querySelector('[aria-label="Auto fill with AI"]');
        if (floatingAutoFillBtn) {
            floatingAutoFillBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const currentDescription = floatingDescriptionTextarea.value.trim();
                if (!currentDescription) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                floatingSetButtonLoading(floatingAutoFillBtn, true);
                try {
                    showToastMessage('Auto filling with AI...', 'info');
                    const result = await floatingCallAIApi('auto-fill', { description: currentDescription });
                    if (result.error) {
                        showToastMessage('AI error: ' + result.error, 'error');
                    } else {
                        const currentTags = Array.from(document.querySelectorAll('.floating-tag-lskjsdb span[contenteditable]')).map(span => span.textContent.trim()).filter(tag => tag);

                        let filledCount = 0;

                        // Fill description if too small or missing
                        if (!currentDescription || currentDescription.length < 100) {
                            floatingDescriptionTextarea.value = result.description || '';
                            floatingUpdateCharCounter();
                            filledCount++;
                        }

                        // Fill tags if none exist
                        if (currentTags.length === 0) {
                            if (result.tags && result.tags.length > 0) {
                                floatingAddTagsFromArray(result.tags);
                                filledCount++;
                            }
                        }

                        showToastMessage(`Auto filled ${filledCount} fields successfully`, 'success');
                        showToastMessage('10 credits deducted for AI usage', 'warning');
                        if (typeof window.loadNavCreditBalance === 'function') {
                            window.loadNavCreditBalance();
                        }
                    }
                } catch (error) {
                    showToastMessage('Network error. Please try again.', 'error');
                } finally {
                    floatingSetButtonLoading(floatingAutoFillBtn, false);
                }
            });
        }
    });

    // Pill text variations
    const pillFullTexts = [
        '1. Executive Summary',
        '2. Problem Analysis',
        '3. Solution Overview',
        '4. Market Analysis',
        '5. Product Concept',
        '6. Go-to-Market Strategy',
        '7. Brand Strategy',
        '8. Intellectual Property Protection'
    ];
    const pillNumbers = ['1.', '2.', '3.', '4.', '5.', '6.', '7.', '8.'];

function addHoverListeners() {
    document.querySelectorAll('.floating-step-pill').forEach((pill, index) => {
        pill.addEventListener('mouseenter', () => {
            if (!pill.classList.contains('bg-primary')) {
                pill.textContent = pillFullTexts[index];
            }
        });
        pill.addEventListener('mouseleave', () => {
            if (!pill.classList.contains('bg-primary')) {
                pill.textContent = pillNumbers[index];
            }
        });
    });
}

    // Handle pill clicks for scrolling and highlighting
    document.querySelectorAll('.floating-step-pill').forEach((pill, index) => {
        pill.addEventListener('click', () => {
            const sectionIds = [
                'executive-summary-section',
                'problem-analysis-section',
                'solution-overview-section',
                'market-analysis-section',
                'product-concept-section',
                'go-to-market-strategy-section',
                'brand-strategy-section',
                'intellectual-property-protection-section'
            ];
            const targetSection = document.getElementById(sectionIds[index]);
            if (targetSection) {
                // Get and parse primary color
                const primaryValue = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
                let primaryHSL;
                if (primaryValue && primaryValue.includes(' ')) {
                    const parts = primaryValue.split(' ');
                    primaryHSL = parts.join(', ');
                } else {
                    primaryHSL = '290, 64%, 43%';
                }

                // Collapse content for all sections
                document.querySelectorAll('[id$="-section"]').forEach(sec => {
                    const expandable = sec.querySelector('.expandable');
                    if (expandable) {
                        expandable.style.display = 'none';
                    }
                });
                // Expand content for target section
                const targetExpandable = targetSection.querySelector('.expandable');
                if (targetExpandable) {
                    targetExpandable.style.display = 'block';
                }

            // Update pill active states
            document.querySelectorAll('.floating-step-pill').forEach((p, i) => {
                if (i === index) {
                    p.classList.remove('bg-muted', 'text-muted-foreground');
                    p.classList.add('bg-primary', 'text-primary-foreground');
                    p.textContent = pillFullTexts[i];
                } else {
                    p.classList.remove('bg-primary', 'text-primary-foreground');
                    p.classList.add('bg-muted', 'text-muted-foreground');
                    p.textContent = pillNumbers[i];
                }
            });




            }
        });
    });

    // Initialize pill texts and shadow on load (first pill/section active)
    document.querySelectorAll('.floating-step-pill').forEach((p, i) => {
        if (i === 0) {
            p.textContent = pillFullTexts[i];
        } else {
            p.textContent = pillNumbers[i];
        }
    });

    addHoverListeners();

    // Initialize shadow and expand on first section (active by default)
    const firstSection = document.getElementById('executive-summary-section');
    if (firstSection) {
        const primaryValue = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
        let primaryHSL;
        if (primaryValue && primaryValue.includes(' ')) {
            const parts = primaryValue.split(' ');
            primaryHSL = parts.join(', ');
        } else {
            primaryHSL = '290, 64%, 43%';
        }
        const firstExpandable = firstSection.querySelector('.expandable');
        if (firstExpandable) {
            firstExpandable.style.display = 'block';
        }
    }

    // Collapse all sections except the first
    document.querySelectorAll('[id$="-section"]').forEach(sec => {
        if (sec !== firstSection) {
            const expandable = sec.querySelector('.expandable');
            if (expandable) {
                expandable.style.display = 'none';
            }
        }
    });

    // Handle edit button clicks
    document.querySelectorAll('.bg-card .flex.items-center.justify-between button').forEach((btn, index) => {
        btn.addEventListener('click', () => {
            const sectionIds = [
                'executive-summary-section',
                'problem-analysis-section',
                'solution-overview-section',
                'market-analysis-section',
                'product-concept-section',
                'go-to-market-strategy-section',
                'brand-strategy-section',
                'intellectual-property-protection-section'
            ];
            const targetSection = document.getElementById(sectionIds[index]);
            if (targetSection) {
                const primaryValue = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
                let primaryHSL;
                if (primaryValue && primaryValue.includes(' ')) {
                    const parts = primaryValue.split(' ');
                    primaryHSL = parts.join(', ');
                } else {
                    primaryHSL = '290, 64%, 43%';
                }

                document.querySelectorAll('[id$="-section"]').forEach(sec => {
                    const expandable = sec.querySelector('.expandable');
                    if (expandable) {
                        expandable.style.display = 'none';
                    }
                });
                const targetExpandable = targetSection.querySelector('.expandable');
                if (targetExpandable) {
                    targetExpandable.style.display = 'block';
                }

                document.querySelectorAll('.floating-step-pill').forEach((p, i) => {
                    if (i === index) {
                        p.classList.remove('bg-muted', 'text-muted-foreground');
                        p.classList.add('bg-primary', 'text-primary-foreground');
                        p.textContent = pillFullTexts[i];
                    } else {
                        p.classList.remove('bg-primary', 'text-primary-foreground');
                        p.classList.add('bg-muted', 'text-muted-foreground');
                        p.textContent = pillNumbers[i];
                    }
                });

                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });


            }
        });
    });
</script>