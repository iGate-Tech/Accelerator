<div class="flex h-[calc(100vh-4rem)]">
    {{> sidebar projects=projects lng=lng}}
    <main class="flex flex-col justify-center items-center p-4 sm:p-6 bg-background overflow-y-auto w-full md:ml-0">
         <div class="w-full max-w-6xl">
             <div id="alert-container" class="w-full max-w-md"></div>
              {{>idea-creation csrf=csrf}}

             <!-- Ideas Grid Section -->
             <div class="mt-8 sm:mt-12 mx-2 sm:mx-4">
                     <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 relative">
                         {{#each ideas}}
                         {{> idea-card .}}
                         {{/each}}
                     </div>
             </div>
         </div>
     </main>

      <!-- Loading Screen -->
      <div id="auth-loading-screen" class="fixed inset-0 bg-background flex items-center justify-center z-50 hidden">
        <div class="text-center">
          <svg class="animate-spin h-16 w-16 sm:h-20 sm:w-20 md:h-24 md:w-24 mx-auto" viewBox="0 0 24 24">
            <defs>
              <linearGradient id="spinner-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#9e28b5"/>
                <stop offset="25%" stop-color="#00a7e0"/>
                <stop offset="50%" stop-color="#6cd14d"/>
                <stop offset="75%" stop-color="#ffc600"/>
                <stop offset="100%" stop-color="#9e28b5"/>
              </linearGradient>
            </defs>
            <circle cx="12" cy="12" r="10" stroke="url(#spinner-gradient)" stroke-width="2" fill="none"/>
          </svg>
           <h2 class="text-xl font-semibold text-foreground mt-4 mb-2">{{t 'loading.create_idea_title'}}</h2>
           <p class="text-muted-foreground">{{t 'loading.create_idea_description'}}</p>
        </div>
      </div>

     <script>
    document.addEventListener('DOMContentLoaded', function() {
        const packageRadios = document.querySelectorAll('input[name="package"]');
        const packageLabels = document.querySelectorAll('.package-btn');

        function updateActive(radios, labels) {
            labels.forEach(label => {
                const input = label.querySelector('input');
                if (input.checked) {
                    label.classList.add('bg-primary', 'text-primary-foreground');
                    label.classList.remove('bg-muted', 'text-muted-foreground');
                } else {
                    label.classList.remove('bg-primary', 'text-primary-foreground');
                    label.classList.add('bg-muted', 'text-muted-foreground');
                }
            });
        }

        packageRadios.forEach(radio => {
            radio.addEventListener('change', () => updateActive(packageRadios, packageLabels));
        });

        updateActive(packageRadios, packageLabels); // Initial call
    });
    </script>

      <script>
     function togglePasswordVisibility() {
        const input = document.getElementById('password');
        const eyeIcon = document.getElementById('eye-icon');
        const eyeOffIcon = document.getElementById('eye-off-icon');
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        eyeIcon.classList.toggle('hidden', !isPassword);
        eyeOffIcon.classList.toggle('hidden', isPassword);
     }

     function clearAlerts() {
         const alerts = document.querySelectorAll('.alert');
         alerts.forEach(alert => alert.remove());
     }

     // Auto-hide alerts after 5 seconds
     function setupAlertAutoHide() {
         setTimeout(() => {
           const alerts = document.querySelectorAll('.alert-auto-hide');
           alerts.forEach(alert => alert.remove());
         }, 5000);
     }

       // Setup auto-hide for alerts added via HTMX
       document.addEventListener('htmx:afterSwap', (event) => {
         if (event.detail.target === document.body) {
           setupAlertAutoHide();
         }
       });

       function showLoading() {
         document.getElementById('auth-loading-screen').classList.remove('hidden');
       }

       function hideLoading() {
         document.getElementById('auth-loading-screen').classList.add('hidden');
       }
      </script>
</div>