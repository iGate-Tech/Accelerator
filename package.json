{
  "name": "accelerator-db",
  "version": "1.0.0",
  "description": "Database setup and management for Accelerator",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "export PATH=\"$HOME/.local/bin:$PATH\" && sqlfluff lint db/",
    "lint:fix": "export PATH=\"$HOME/.local/bin:$PATH\" && sqlfluff fix db/",
    "test": "vitest",
    "test:unit": "vitest unit",
    "test:integration": "vitest integration",
    "test:e2e": "vitest e2e",
    "test:coverage": "vitest --coverage",
    "test:db": "vitest --run integration",
    "db:install": "npm run db:reset && npm run db:setup && npm run db:seed",
    "db:reset": "node scripts/reset/reset.js",
    "db:reset:users": "node scripts/reset/reset-users.js",
    "db:reset:tables": "node scripts/reset/reset-tables.js",
    "db:reset:functions": "node scripts/reset/reset-functions.js",
    "db:reset:triggers": "node scripts/reset/reset-triggers.js",
    "db:reset:views": "node scripts/reset/reset-views.js",
    "db:setup": "node scripts/setup/setup.js",
    "db:setup:extensions": "node scripts/setup/extensions/setup-extensions.js",
    "db:setup:tables": "node scripts/setup/tables/setup-tables.js",
    "db:setup:indexes": "node scripts/setup/indexes/setup-indexes.js",
    "db:setup:policies": "node scripts/setup/policies/setup-policies.js",
    "db:setup:functions": "npm run db:setup:functions:core && npm run db:setup:functions:user && npm run db:setup:functions:credit && npm run db:setup:functions:idea && npm run db:setup:functions:voting && npm run db:setup:functions:model && npm run db:setup:functions:portfolio",
    "db:setup:functions:core": "node scripts/setup/functions/setup-functions-core.js",
    "db:setup:functions:user": "node scripts/setup/functions/setup-functions-user.js",
    "db:setup:functions:credit": "node scripts/setup/functions/setup-functions-credit.js",
    "db:setup:functions:idea": "node scripts/setup/functions/setup-functions-idea.js",
    "db:setup:functions:voting": "node scripts/setup/functions/setup-functions-voting.js",
    "db:setup:functions:model": "node scripts/setup/functions/setup-functions-model.js",
    "db:setup:functions:portfolio": "node scripts/setup/functions/setup-functions-portfolio.js",
    "db:setup:triggers": "node scripts/setup/triggers/setup-triggers.js",
    "db:setup:views": "node scripts/setup/views/setup-views.js",
    "db:seed": "node scripts/seeds/seed.js",
    "db:generate-seed-users": "node scripts/seeds/generate-seed-users.js",
    "db:create-users": "node scripts/seeds/create-users.js",
    "db:backup": "node scripts/backup.js",
    "db:migrate": "node scripts/migrate.js",
    "db:dev:setup": "NODE_ENV=development npm run db:install",
    "db:test:setup": "NODE_ENV=test npm run db:install",
    "db:prod:backup": "NODE_ENV=production npm run db:backup"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "supabase": "^2.70.5",
    "uuid": "^13.0.0",
    "vitest": "^4.0.16"
  }
}
