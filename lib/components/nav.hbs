<nav class="bg-base-100 text-foreground px-2 sm:px-4 border-b border-input flex items-center justify-between min-h-12">
<script>
  function toggleTheme() {
    const html = document.documentElement;
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeToggle(isDark);

    // If user is authenticated, sync with server
    if (document.body.dataset.loggedIn === 'true') {
      fetch('/settings/theme', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ theme: isDark ? 'dark' : 'light' })
      }).catch(err => console.warn('Failed to sync theme with server'));
    }
  }

 function updateThemeToggle(isDark) {
   const lightIcon = document.getElementById('theme-icon-light');
   const darkIcon = document.getElementById('theme-icon-dark');
   if (lightIcon && darkIcon) {
     if (isDark) {
       lightIcon.classList.add('hidden');
       darkIcon.classList.remove('hidden');
     } else {
       darkIcon.classList.add('hidden');
       lightIcon.classList.remove('hidden');
     }
   }
 }

 function normalizeLanguage(lang) {
   if (!lang) return 'en';
   const normalized = lang.toLowerCase().split('-')[0]; // Get primary language code
   return ['en', 'ar'].includes(normalized) ? normalized : 'en';
 }

  async function switchLanguage() {
    const currentLang = normalizeLanguage(localStorage.getItem('language') || 'en');
    const newLang = currentLang === 'en' ? 'ar' : 'en';
    localStorage.setItem('language', newLang);
    updateLangSwitcher(newLang);

    // If user is authenticated, sync with server
    if (document.body.dataset.loggedIn === 'true') {
      try {
        const response = await fetch('/settings/language', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ language: newLang }),
        });

      if (response.ok) {
      } else {
       console.warn('Failed to sync language with server');
     }
   } catch (error) {
     console.error('Error syncing language with server:', error);
   }

   // Reload the page with language query param to ensure it's applied
   window.location.href = `${window.location.pathname}?lng=${newLang}`;
 }
 }

 function updateLangSwitcher(lang) {
   const textSpan = document.getElementById('lang-text');
   if (textSpan) {
     textSpan.textContent = lang.toUpperCase();
   }
 }

   // Nav component functions (global scope)
   function clearMobileProjectSearch() {
     const input = document.getElementById('mobile-project-search');
     if (input) {
       input.value = '';
       filterMobileProjects('');
       const clearBtn = document.getElementById('mobile-project-search-clear');
       if (clearBtn) {
         clearBtn.style.opacity = '0';
       }
     }
   }

   function filterMobileProjects(query) {
     const items = document.querySelectorAll('#mobile-portfolio-list a');
     if (items.length > 0) {
       let visibleCount = 0;
       items.forEach(item => {
         const text = item.textContent.toLowerCase();
         if (text.includes(query.toLowerCase())) {
           item.style.display = 'block';
           visibleCount++;
         } else {
           item.style.display = 'none';
         }
       });
       // Update the count in the toggle button
       const countSpan = document.querySelector('#mobile-portfolio-list-container').querySelector('button span.text-xs');
       if (countSpan) {
         countSpan.textContent = `${visibleCount} projects`;
       }
     }
   }

   function clearProjectSearch() {
     const input = document.getElementById('project-search');
     if (input) {
       input.value = '';
       filterProjects('');
       const clearBtn = document.getElementById('project-search-clear');
       if (clearBtn) {
         clearBtn.style.display = 'none';
         clearBtn.style.opacity = '0';
       }
     }
   }

   function filterProjects(query) {
     const items = document.querySelectorAll('#sidebar ul li');
     if (items.length > 0) {
       items.forEach(item => {
         const text = item.textContent.toLowerCase();
         if (text.includes(query.toLowerCase())) {
           item.style.display = 'block';
         } else {
           item.style.display = 'none';
         }
       });
     }
   }

function toggleMobilePortfolio(event) {
 const container = document.getElementById('mobile-portfolio-list-container');
 if (container) {
   container.classList.toggle('hidden');
   const chevron = event.target.closest('button').querySelector('.chevron');
   if (chevron) {
     chevron.classList.toggle('rotate-180');
   }
 }
}

   // Initialize language and theme on page load
   document.addEventListener('DOMContentLoaded', function() {
    const serverLang = normalizeLanguage('{{lng}}');
    localStorage.setItem('language', serverLang);
    updateLangSwitcher(serverLang);

    // Initialize theme
    const savedTheme = localStorage.getItem('theme');
    const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
    const isDark = theme === 'dark';
    if (isDark) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    updateThemeToggle(isDark);
  });

 function toggleGridMenu() {
   const dropdown = document.getElementById('grid-dropdown');
   if (dropdown) {
     const isVisible = !dropdown.classList.contains('hidden');
     if (isVisible) {
       dropdown.classList.add('hidden');
       dropdown.classList.add('invisible');
       dropdown.classList.add('opacity-0');
     } else {
       dropdown.classList.remove('hidden');
       dropdown.classList.remove('invisible');
       dropdown.classList.remove('opacity-0');
     }
   }
 }

 function toggleUserMenu() {
   const dropdown = document.getElementById('admin-user-dropdown');
   if (dropdown) {
     const isVisible = !dropdown.classList.contains('hidden');
     if (isVisible) {
       dropdown.classList.add('hidden');
       dropdown.classList.add('invisible');
       dropdown.classList.add('opacity-0');
     } else {
       dropdown.classList.remove('hidden');
       dropdown.classList.remove('invisible');
       dropdown.classList.remove('opacity-0');
     }
   }
 }

  function toggleNotificationMenu() {
    const dropdown = document.getElementById('notification-dropdown');
    if (dropdown) {
      const isVisible = !dropdown.classList.contains('hidden');
      if (isVisible) {
        dropdown.classList.add('hidden');
        dropdown.classList.add('invisible');
        dropdown.classList.add('opacity-0');
      } else {
        dropdown.classList.remove('hidden');
        dropdown.classList.remove('invisible');
        dropdown.classList.remove('opacity-0');
      }
    }
  }

  function toggleMobileNav() {
    const menu = document.getElementById('mobile-nav-menu');
    if (menu) {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
      } else {
        menu.classList.remove('hidden');
      }
    }
  }

  function showLogoutConfirm() {
    const modal = document.getElementById('logout-confirm-modal');
    if (modal) {
      modal.classList.remove('hidden');
    }
  }

  function hideLogoutConfirm() {
    const modal = document.getElementById('logout-confirm-modal');
    if (modal) {
      modal.classList.add('hidden');
    }
  }

  async function markAsRead(notificationId) {
    try {
      const response = await fetch(`/api/notifications/${notificationId}/read`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
      });
if (response.ok) {
 // Refresh the dropdown
 if (typeof htmx !== 'undefined') {
   htmx.trigger('#notification-dropdown', 'revealed');
 }
} else {
        showToast('Failed to mark as read', 'error');
      }
    } catch (error) {
      console.error('Mark as read error:', error);
      showToast('Failed to mark as read', 'error');
    }
  }

  // Close mobile nav on outside click
  document.addEventListener('click', function(e) {
    const menu = document.getElementById('mobile-nav-menu');
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    if (menu && !menu.classList.contains('hidden') && !menu.contains(e.target) && (!toggleBtn || !toggleBtn.contains(e.target))) {
      toggleMobileNav();
    }
    });

  function logout() {
    hideLogoutConfirm();
    document.getElementById('logout-loading-screen').classList.remove('hidden');
    fetch('/auth/logout', { method: 'POST' }).then(() => {
      setTimeout(() => window.location.href = '/', 8000);
    });
  }

  // Close dropdowns when clicking outside
  document.addEventListener('click', function(event) {
    const notificationDropdown = document.getElementById('notification-dropdown');
    const notificationButton = document.getElementById('notification-menu').querySelector('button');
    if (!notificationDropdown.classList.contains('hidden') && !notificationDropdown.contains(event.target) && !notificationButton.contains(event.target)) {
      notificationDropdown.classList.add('opacity-0', 'invisible', 'hidden');
    }

    const gridDropdown = document.getElementById('grid-dropdown');
    const gridButton = document.getElementById('grid-menu').querySelector('button');
    if (!gridDropdown.classList.contains('hidden') && !gridDropdown.contains(event.target) && !gridButton.contains(event.target)) {
      gridDropdown.classList.add('opacity-0', 'invisible', 'hidden');
    }

    const userDropdown = document.getElementById('admin-user-dropdown');
    const userButton = document.getElementById('admin-user-menu-button');
    if (!userDropdown.classList.contains('hidden') && !userDropdown.contains(event.target) && !userButton.contains(event.target)) {
      userDropdown.classList.add('opacity-0', 'invisible', 'hidden');
    }
  });

  // Mobile portfolio search functions are now defined in main layout
  document.addEventListener('DOMContentLoaded', function() {
    const mobileSearchInput = document.getElementById('mobile-project-search');
    if (mobileSearchInput) {
      mobileSearchInput.addEventListener('input', function() {
        const query = this.value;
        filterMobileProjects(query);
        const clearBtn = document.getElementById('mobile-project-search-clear');
        if (query) {
          clearBtn.style.opacity = '1';
        } else {
          clearBtn.style.opacity = '0';
        }
      });
    }

    const desktopSearchInput = document.getElementById('project-search');
    if (desktopSearchInput) {
      desktopSearchInput.addEventListener('input', function() {
        const query = this.value;
        filterProjects(query);
        const clearBtn = document.getElementById('project-search-clear');
        if (query) {
          clearBtn.style.display = 'block';
          clearBtn.style.opacity = '1';
        } else {
          clearBtn.style.display = 'none';
          clearBtn.style.opacity = '0';
        }
      });
    }
  });
</script>

