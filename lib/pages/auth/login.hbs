   <button id="lang-toggle" class="absolute top-4 {{#if (eq lng 'ar')}}right-4{{else}}left-4{{/if}} text-foreground hover:text-muted-foreground transition-colors z-10 px-2 py-1 text-sm font-medium flex items-center">
     {{{icon 'languages' class='h-4 w-4 mr-1'}}}
     <span id="lang-text">EN</span>
   </button>
   <button id="theme-toggle" class="absolute top-4 {{#if (eq lng 'ar')}}left-4{{else}}right-4{{/if}} text-foreground hover:text-muted-foreground transition-colors z-10">
    {{{icon 'sun' class='h-6 w-6' id='sun-icon'}}}
    {{{icon 'moon' class='h-6 w-6 hidden' id='moon-icon'}}}
  </button>
   <div class="w-full min-h-screen flex flex-col items-center justify-center px-4" >
      <img src="/images/accelerator_logo.svg" alt="Accelerator Logo" class="w-32 sm:w-40 my-6 sm:my-10" />
      <div class="flex flex-col items-center justify-center h-full gap-6 w-full max-w-[400px] mx-auto bg-card shadow-primary rounded-lg p-4 sm:p-6 border border-input">
      <div class="grid gap-2 text-center">
         <h1 class="text-3xl font-bold text-foreground text-glow text-center">{{t 'auth.login.title'}}</h1>
         <p class="text-balance text-muted-foreground">
           {{t 'auth.login.description'}}
         </p>
      </div>

      <form action="/auth/login" method="post" class="grid gap-4 text-center">

        <div class="grid gap-2 text-left">
           <label
             class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
             for="email">
             {{t 'auth.login.email_label'}}
           </label>
           <input type="email" name="email"
             class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
             id="email" placeholder="{{t 'auth.login.email_placeholder'}}" required="" />
        </div>

        <div class="grid gap-2 text-left">
           <div class="flex items-center gap-6">
              <label
                class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
                for="password">
                {{t 'auth.login.password_label'}}
              </label>
              <a class="ml-auto inline-block text-sm underline text-muted-foreground hover:text-foreground focus:outline-none monotone-logo"
                href="/auth/forgot-password">
                {{t 'auth.login.forgot_password'}}
              </a>
           </div>
           <div class="relative">
             <input type="password" name="password"
               class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 pr-10 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
               id="password" placeholder="{{t 'auth.login.password_placeholder'}}" required="" />
             <button type="button" onclick="togglePasswordVisibility()"
               class="absolute right-2 top-1/2 transform -translate-y-1/2 text-muted-foreground hover:text-foreground">
               {{{icon 'eye' class='h-4 w-4' id='eye-icon'}}}
               {{{icon 'eye-off' class='h-4 w-4 hidden' id='eye-off-icon'}}}
             </button>
  </div>
</div>

<script>
function togglePasswordVisibility() {
  const input = document.getElementById('password');
  const eyeIcon = document.getElementById('eye-icon');
  const eyeOffIcon = document.getElementById('eye-off-icon');
  const isPassword = input.type === 'password';
  input.type = isPassword ? 'text' : 'password';
  eyeIcon.classList.toggle('hidden', !isPassword);
  eyeOffIcon.classList.toggle('hidden', isPassword);
}

function toggleTheme() {
  const html = document.documentElement;
  html.classList.toggle('dark');
  const isDark = html.classList.contains('dark');
  localStorage.setItem('theme', isDark ? 'dark' : 'light');
  updateThemeIcon();
}

function updateThemeIcon() {
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');
  const isDark = document.documentElement.classList.contains('dark');
  sunIcon.classList.toggle('hidden', isDark);
  moonIcon.classList.toggle('hidden', !isDark);
}

function toggleLanguage() {
  const currentLng = document.documentElement.lang || 'en';
  const newLng = currentLng === 'ar' ? 'en' : 'ar';
  document.cookie = `i18next=${newLng}; path=/; max-age=31536000`;
  window.location.reload();
}

function updateLangText() {
  const currentLng = document.documentElement.lang || 'en';
  document.getElementById('lang-text').textContent = currentLng.toUpperCase();
}

document.addEventListener('DOMContentLoaded', () => {
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  }
  updateThemeIcon();
  updateLangText();
  document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
  document.getElementById('lang-toggle').addEventListener('click', toggleLanguage);
});
</script>




