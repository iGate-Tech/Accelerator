
<div class="min-h-screen bg-base-100">
   <div class="relative overflow-hidden">
     <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
       <!-- Header -->
       <div class="text-center mb-8 sm:mb-12">
          <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-primary rounded-2xl mb-6 sm:mb-8">
  {{{icon 'credit-card' class="w-8 h-8 sm:w-10 sm:h-10 text-white"}}}
          </div>
           <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4 sm:mb-6">
             {{t 'upgrade.title'}}
           </h1>
           <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
             {{t 'upgrade.subtitle'}}
           </p>
        </div>

        <!-- Onboarding Progress -->
        <div class="flex justify-center mb-6 sm:mb-8 lg:mb-12">
          <div class="flex items-center space-x-1 sm:space-x-2 lg:space-x-4 overflow-x-auto px-4 sm:px-0">
            <div class="flex items-center flex-shrink-0">
               <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-primary rounded-full flex items-center justify-center text-primary-content font-bold text-xs sm:text-sm lg:text-base">1</div>
                <span class="ml-1 sm:ml-2 lg:ml-3 text-primary font-semibold text-xs sm:text-sm lg:text-base whitespace-nowrap">{{t 'onboarding.package.choose_plan'}}</span>
            </div>
             <div class="w-4 sm:w-8 lg:w-16 h-0.5 bg-muted flex-shrink-0"></div>
             <div class="flex items-center flex-shrink-0">
               <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-muted rounded-full flex items-center justify-center text-muted-foreground font-bold text-xs sm:text-sm lg:text-base">2</div>
                <span class="ml-1 sm:ml-2 lg:ml-3 text-muted-foreground text-xs sm:text-sm lg:text-base whitespace-nowrap">{{t 'onboarding.package.complete_profile'}}</span>
             </div>
             <div class="w-4 sm:w-8 lg:w-16 h-0.5 bg-muted flex-shrink-0"></div>
             <div class="flex items-center flex-shrink-0">
               <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-muted rounded-full flex items-center justify-center text-muted-foreground font-bold text-xs sm:text-sm lg:text-base">3</div>
                <span class="ml-1 sm:ml-2 lg:ml-3 text-muted-foreground text-xs sm:text-sm lg:text-base whitespace-nowrap">{{t 'onboarding.package.get_started'}}</span>
             </div>
          </div>
        </div>

        <!-- Onboarding Message -->
        <div class="bg-gradient-to-r from-primary/5 to-secondary/5 border border-primary/10 rounded-lg sm:rounded-xl p-4 sm:p-6 mb-6 sm:mb-8 lg:mb-10">
          <div class="flex items-start">
            <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-primary/10 rounded-lg sm:rounded-xl flex items-center justify-center mr-3 sm:mr-4 lg:mr-5 flex-shrink-0">
              {{{icon 'rocket' class="w-3 h-3 sm:w-4 sm:h-4 lg:w-5 lg:h-5 text-primary"}}}
            </div>
                  <div>
                    <h3 class="text-sm sm:text-base lg:text-lg font-semibold text-foreground mb-2">{{t 'onboarding.package.welcome_title'}}! 🚀</h3>
                    <p class="text-xs sm:text-sm lg:text-base text-muted-foreground leading-relaxed">
                     {{t 'onboarding.package.welcome_message'}}
                   </p>
                 </div>
          </div>
        </div>

       <!-- Current Balance Card -->
       <div class="bg-card rounded-2xl shadow-xl p-6 mb-8 sm:mb-12 border border-border">
                  <div class="text-center">
                <div class="text-sm text-muted-foreground mb-2">{{t 'billing.current_balance'}}</div>
            <div class="text-4xl sm:text-5xl font-bold text-primary">{{currentBalance}} {{t 'billing.credits'}}</div>
         </div>
       </div>

       <!-- Package Plans -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
          {{#each packages}}
          <div class="bg-card rounded-xl border border-border shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="p-4 sm:p-6 lg:p-8">
              <div class="text-center mb-6">
                <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-foreground mb-3">{{name}} {{t 'upgrade.plan'}}</h3>
                <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary mb-1">${{price_monthly}}</div>
                 <div class="text-sm text-muted-foreground mb-2">{{t 'upgrade.month'}}</div>
                <div class="text-xs sm:text-sm text-muted-foreground">{{credits_monthly}} {{t 'billing.credits'}} included</div>
              </div>

              <div class="space-y-3 mb-6">
                <div class="flex items-center space-x-3">
                  <div class="w-5 h-5 sm:w-6 sm:h-6 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                    {{{icon 'check' class="w-3 h-3 sm:w-4 sm:h-4 text-green-600 dark:text-green-400"}}}
                  </div>
                   <span class="text-xs sm:text-sm text-foreground">{{t 'buy-credits.instant_delivery'}}</span>
                </div>

                <div class="flex items-center space-x-3">
                  <div class="w-5 h-5 sm:w-6 sm:h-6 bg-blue-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                    {{{icon 'clock' class="w-3 h-3 sm:w-4 sm:h-4 text-blue-600 dark:text-blue-400"}}}
                  </div>
                  <span class="text-xs sm:text-sm text-foreground">{{t 'buy-credits.no_expiration'}}</span>
                </div>

                <div class="flex items-center space-x-3">
                  <div class="w-5 h-5 sm:w-6 sm:h-6 bg-amber-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                    {{{icon 'lightbulb' class="w-3 h-3 sm:w-4 sm:h-4 text-amber-600 dark:text-amber-400"}}}
                  </div>
                  <span class="text-xs sm:text-sm text-foreground">{{t 'landing.features.ai_powered_features'}}</span>
                </div>
              </div>

             <form method="POST" action="/onboarding/package">
               <input type="hidden" name="_csrf" value="{{csrf}}" />
               <input type="hidden" name="package_type" value="{{type}}" />
               <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-primary-foreground font-semibold py-3 px-4 sm:px-6 rounded-lg transition-colors duration-200 text-sm sm:text-base">
                  <span class="flex items-center justify-center space-x-2">
                    <span>{{t 'upgrade.upgrade_to'}} {{name}} {{t 'upgrade.plan'}}</span>
                    {{{icon 'arrow-right' class="w-4 h-4 sm:w-5 sm:h-5"}}}
                  </span>
               </button>
             </form>
           </div>
         </div>
         {{/each}}
        </div>

        <!-- Footer -->
        <div class="text-center mt-8 sm:mt-12">
          <p class="text-sm text-muted-foreground">{{t 'onboarding.package.footer'}}</p>
        </div>
      </div>
   </div>
 </div>