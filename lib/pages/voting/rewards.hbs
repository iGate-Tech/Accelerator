<main id="voting-rewards-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">

      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-foreground">{{t 'voting.title' lng=lng}}</h1>
        <p class="text-muted-foreground mt-2">{{t 'voting.subtitle' lng=lng}}</p>
      </div>

      <!-- Voting Data -->
      {{#if votingData}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold mb-4">{{t 'voting.your_votes' lng=lng}}</h2>
        <div class="space-y-4">
          {{#each votingData.votes}}
          <div class="flex items-center justify-between p-4 bg-muted/50 rounded-lg">
            <div>
              <p class="font-medium">{{idea_title}}</p>
              <p class="text-sm text-muted-foreground">{{t 'voting.rating' lng=lng}}: {{rating}}/5</p>
            </div>
            <span class="text-sm text-muted-foreground">{{formatDate created_at}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- Leaderboard -->
      {{#if leaderboard}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold mb-4">{{t 'voting.leaderboard' lng=lng}}</h2>
        <div class="space-y-2">
          {{#each leaderboard}}
          <div class="flex items-center justify-between p-3 bg-muted/30 rounded">
            <div class="flex items-center gap-3">
              <span class="font-bold text-primary">#{{@index}}</span>
              <span>{{name}}</span>
            </div>
            <span class="font-medium">{{score}} {{t 'voting.points' lng=lng}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- Recent Notifications -->
      {{#if notifications}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold mb-4">{{t 'nav.notifications' lng=lng}}</h2>
        <div class="space-y-3">
          {{#each notifications}}
          <div class="p-3 bg-muted/30 rounded-lg">
            <p class="text-sm">{{message}}</p>
            <p class="text-xs text-muted-foreground mt-1">{{formatDate created_at}}</p>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

    </div>
  </div>
</main>