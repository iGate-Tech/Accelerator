{{> progress-bar activeStep=activeStep ideaId=ideaId}}

{{> model-header title=pageTitle description="Comprehensive marketing strategy and execution overview"
ratingStars="★★★★★" ratingValue="5.0" voteCount="0 votes" category=ideaCategory tags=ideaTags}}

{{> model-progress data='[
  {
    "id": "customer-persona",
    "fullLabel": "1. Customer Persona",
    "shortLabel": "1.",
    "position": 0
  },
  {
    "id": "unique-value-proposition",
    "fullLabel": "2. Unique Value Proposition",
    "shortLabel": "2.",
    "position": 20
  },
  {
    "id": "marketing-objectives",
    "fullLabel": "3. Marketing Objectives",
    "shortLabel": "3.",
    "position": 40
  },
  {
    "id": "marketing-strategies",
    "fullLabel": "4. Marketing Strategies",
    "shortLabel": "4.",
    "position": 60
  },
  {
    "id": "marketing-budget",
    "fullLabel": "5. Marketing Budget",
    "shortLabel": "5.",
    "position": 80
  },
  {
    "id": "marketing-kpis",
    "fullLabel": "6. Marketing KPIs",
    "shortLabel": "6.",
    "position": 100
  }
]'}}

<main class="flex flex-col mx-auto items-center justify-center">
    <div class="sections-container">
        <!-- Customer Persona Section -->
        <div id="customer-persona" class="section mb-6">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Customer Persona</h2>
            <p class="text-muted-foreground mb-6">Define your ideal customer.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="customer-persona-q1" step="1" question="Define your customer persona." placeholder="This section defines your customer persona. Provide demographic profile with AI suggestions if needed. Use this section for customer understanding. Chat with AI to develop detailed personas or learn persona creation."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="customer-persona-q2" step="2" question="What is the age range of your customers?" placeholder="This section specifies customer age range. Typical ranges provided for KSA professionals. AI can help analyze demographics. Use this section for targeting precision. Chat with AI to understand demographic impacts or get analysis help."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
                     <div class="flex-1">
                          {{> question-block id="customer-persona-q3" step="3" question="Where are your customers located?" placeholder="This section identifies customer locations. Specify geographic areas for targeted marketing. AI can help with location-based strategies. Use this section for regional planning. Chat with AI to learn geographic targeting or get location strategy advice."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">4</div>
                     <div class="flex-1">
                          {{> question-block id="customer-persona-q4" step="4" question="What is your customer's income range?" placeholder="This section defines customer income ranges. Typical ranges provided for KSA professionals. AI can help with socioeconomic analysis. Use this section for pricing strategy. Chat with AI to understand income impacts or get segmentation help."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">5</div>
                     <div class="flex-1">
                          {{> question-block id="customer-persona-q5" step="5" question="Is your product gender-specific?" placeholder="This section assesses gender specificity. Determine if product appeals to specific genders. AI can help analyze market fit. Use this section for inclusive marketing. Chat with AI to understand gender targeting or get market fit analysis."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">6</div>
                     <div class="flex-1">
                          {{> question-block id="customer-persona-q6" step="6" question="What are your customers' pain points?" placeholder="This section identifies customer pain points. List frustrations like slow service, high costs, poor quality. AI can help identify additional pains. Use this section for problem-solution messaging. Chat with AI to discover pain points or learn customer research."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">7</div>
                     <div class="flex-1">
                          {{> question-block id="customer-persona-q7" step="7" question="Describe the ideal customer experience." placeholder="This section describes ideal experience. Specify fast, automated, personalized, affordable, high-quality experiences. AI can help define experience goals. Use this section for customer journey planning. Chat with AI to understand customer experience or get experience design help."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed this section of the marketing model." buttonText="Move to Next Section"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Unique Value Proposition Section -->
        <div id="unique-value-proposition" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Unique Value Proposition</h2>
            <p class="text-muted-foreground mb-6">Highlight what makes you unique.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="unique-value-proposition-q1" step="8" question="What differentiates your product?" placeholder="This section identifies product differentiation. List faster delivery, lower costs, better quality, unique features. AI can suggest differentiation points. Use this section for competitive positioning. Chat with AI to find differentiation opportunities or get competitive analysis."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="unique-value-proposition-q2" step="9" question="What is your main marketing message?" placeholder="This section defines main marketing message. Create memorable message like 'Smart. Fast. Reliable.' AI can help craft compelling messages. Use this section for brand communication. Chat with AI to generate marketing messages or learn messaging strategies."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed this section of the marketing model." buttonText="Move to Next Section"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Marketing Objectives Section -->
        <div id="marketing-objectives" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Marketing Objectives</h2>
            <p class="text-muted-foreground mb-6">Set your marketing goals.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-objectives-q1" step="10" question="Do you want to increase brand awareness?" placeholder="This section sets marketing objectives. Focus on brand awareness, lead generation, acquisition targets, market expansion, retention. AI can help prioritize objectives. Use this section for goal setting. Chat with AI to understand marketing objectives or get prioritization help."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-objectives-q2" step="11" question="Is lead generation a priority?" placeholder="This section assesses lead generation priority. Determine focus on generating qualified leads. AI can help with lead strategies. Use this section for sales funnel planning. Chat with AI to learn lead generation or get strategy recommendations."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-objectives-q3" step="12" question="What are your customer acquisition targets?" placeholder="This section sets acquisition targets. Specify user numbers over time periods with examples. AI can help set realistic targets. Use this section for growth planning. Chat with AI to understand acquisition targets or get benchmarking help."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">4</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-objectives-q4" step="13" question="Do you aim to expand into new markets?" placeholder="This section considers market expansion. Determine goals for entering new geographic or demographic markets. AI can help with expansion strategies. Use this section for scaling planning. Chat with AI to learn market expansion or get entry strategy advice."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">5</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-objectives-q5" step="14" question="Is customer retention a priority?" placeholder="This section evaluates retention priority. Focus on keeping existing customers engaged. AI can help with retention strategies. Use this section for loyalty planning. Chat with AI to understand retention importance or get retention tactic ideas."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed this section of the marketing model." buttonText="Move to Next Section"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Marketing Strategies Section -->
        <div id="marketing-strategies" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Marketing Strategies</h2>
            <p class="text-muted-foreground mb-6">Plan your marketing approach.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-strategies-q1" step="15" question="Which digital channels will you use?" placeholder="This section selects digital channels. Choose SEO, Google Ads, social media, email, content marketing, influencer partnerships. AI can recommend based on audience. Use this section for channel strategy. Chat with AI to learn digital channels or get recommendation help."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-strategies-q2" step="16" question="Will you use offline channels?" placeholder="This section considers offline channels. Include events, conferences, trade shows, flyers, billboards, print ads. AI can help with offline strategy. Use this section for omnichannel planning. Chat with AI to understand offline marketing or get channel mix advice."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed this section of the marketing model." buttonText="Move to Next Section"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Marketing Budget Section -->
        <div id="marketing-budget" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Marketing Budget</h2>
            <p class="text-muted-foreground mb-6">Allocate resources for marketing.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-budget-q1" step="17" question="What is your marketing budget?" placeholder="This section allocates marketing budget. Standard recommendations: 10-15% of revenue for early-stage, 15-25% for growth. AI can help with budget planning. Use this section for resource allocation. Chat with AI to learn budget allocation or get industry benchmarks."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed this section of the marketing model." buttonText="Move to Next Section"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Marketing KPIs Section -->
        <div id="marketing-kpis" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">Marketing KPIs</h2>
            <p class="text-muted-foreground mb-6">Track marketing performance.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q1" step="18" question="Do you track website traffic?" placeholder="This section tracks website traffic. Monitor monthly visits with benchmarks for early startups. AI can help set up tracking. Use this section for performance monitoring. Chat with AI to learn traffic tracking or get benchmark guidance."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q2" step="19" question="Which channels bring most traffic?" placeholder="This section analyzes traffic sources. Identify organic search, direct, social media, paid ads, referral, email channels. AI can help optimize channels. Use this section for channel effectiveness. Chat with AI to understand traffic analysis or get optimization tips."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q3" step="20" question="What is your average session duration?" placeholder="This section measures session duration. Benchmarks: 30-60 seconds poor, 1-2 minutes good, 2-4 minutes excellent. AI can help improve engagement. Use this section for content optimization. Chat with AI to learn session duration or get improvement strategies."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">4</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q4" step="21" question="What is your conversion rate?" placeholder="This section tracks conversion rates. SaaS benchmarks: 1.5-3.0%, E-commerce: 1-2%. AI can help optimize conversions. Use this section for funnel analysis. Chat with AI to understand conversion rates or get optimization advice."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">5</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q5" step="22" question="What is your customer acquisition cost?" placeholder="This section calculates CAC. Ranges: 30-80 SAR low, 80-150 medium, 150-300 high. AI can help reduce costs. Use this section for efficiency analysis. Chat with AI to learn CAC calculation or get cost reduction strategies."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">6</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q6" step="23" question="What is your NPS target?" placeholder="This section sets NPS targets. Suggested: 30+ good, 50+ excellent, 60+ outstanding. AI can help improve scores. Use this section for satisfaction tracking. Chat with AI to understand NPS or get improvement recommendations."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">7</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q7" step="24" question="What is your customer lifetime value?" placeholder="This section calculates LTV. Formula: ARPU × Gross Margin × Retention. AI can compute automatically. Use this section for profitability analysis. Chat with AI to learn LTV calculation or get computation help."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">8</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q8" step="25" question="What retention rate do you want?" placeholder="This section targets retention rates. Benchmarks: 60-70% early SaaS, 70-85% mature. AI can help improve retention. Use this section for loyalty planning. Chat with AI to understand retention rates or get improvement strategies."}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">9</div>
                     <div class="flex-1">
                          {{> question-block id="marketing-kpis-q9" step="26" question="What is your revenue growth target?" placeholder="This section sets growth targets. Options: 20-30%, 30-50%, 50-100%, 100%+ hypergrowth. AI can help set achievable targets. Use this section for scaling planning. Chat with AI to understand growth targets or get benchmarking help."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}}</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed the entire marketing model." buttonText="Complete Marketing Model"}}
                    </div>
                </div>
            </div>
        </div>
     </div>
</main>

<div class=" h-[300px]"></div>

