<!-- Stages Progress Bar -->
    <div id="progress-bar" class="progress-bar w-[900px] mx-auto mt-6 mb-6 overflow-hidden">
    <div class="relative ">
        <!-- Progress Bar Background -->
        <div class="absolute top-1/5 left-0 right-0 h-1 bg-muted rounded-full transform -translate-y-1/2"></div>
        <!-- Progress Bar Fill -->
        <div id="steps-progress-fill"
            class="absolute top-1/5 left-0 h-1 bg-primary rounded-full transform -translate-y-1/2 transition-all duration-300"
            style="width: {{#if (eq activeStep 'idea')}}0%{{else}}{{#if (eq activeStep 'business')}}16.67%{{else}}{{#if (eq activeStep 'financial')}}33.33%{{else}}{{#if (eq activeStep 'funding')}}50%{{else}}{{#if (eq activeStep 'marketing')}}66.67%{{else}}{{#if (eq activeStep 'team')}}83.33%{{else}}100%{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"></div>

        <!-- Steps Overlay -->
        <div class="relative flex items-center justify-between w-full">
            <!-- Step 1: Idea -->
            <a href="/models/idea{{#if ideaId}}?ideaId={{ideaId}}{{/if}}" class="group flex flex-col items-left z-10">
                <div
                    class="w-4 h-4 rounded-full {{#if (eq activeStep 'idea')}}bg-primary{{else}}{{#if (eq activeStep 'business')}}bg-primary{{else}}{{#if (eq activeStep 'financial')}}bg-primary{{else}}{{#if (eq activeStep 'funding')}}bg-primary{{else}}{{#if (eq activeStep 'marketing')}}bg-primary{{else}}{{#if (eq activeStep 'team')}}bg-primary{{else}}{{#if (eq activeStep 'legal')}}bg-primary{{else}}bg-muted{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}} group-hover:bg-primary">
                </div>
            <span
                class="{{#if (eq activeStep 'idea')}}text-primary{{else}}text-muted-foreground{{/if}} text-xs mt-2 group-hover:text-primary">Idea</span>
            </a>
            <!-- Step 2: Business -->
            <a href="/models/business{{#if ideaId}}?ideaId={{ideaId}}{{/if}}" class="group flex flex-col items-center z-10">
                <div
                    class="w-4 h-4 rounded-full {{#if (eq activeStep 'business')}}bg-primary{{else}}{{#if (eq activeStep 'financial')}}bg-primary{{else}}{{#if (eq activeStep 'funding')}}bg-primary{{else}}{{#if (eq activeStep 'marketing')}}bg-primary{{else}}{{#if (eq activeStep 'team')}}bg-primary{{else}}{{#if (eq activeStep 'legal')}}bg-primary{{else}}bg-muted{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}} group-hover:bg-primary">
                </div>
                <span
                    class="{{#if (eq activeStep 'business')}}text-primary{{else}}text-muted-foreground{{/if}} text-xs mt-2 group-hover:text-primary">Business</span>
            </a>
            <!-- Step 3: Financial -->
            <a href="/models/financial{{#if ideaId}}?ideaId={{ideaId}}{{/if}}" class="group flex flex-col items-center z-10">
                <div
                    class="w-4 h-4 rounded-full {{#if (eq activeStep 'financial')}}bg-primary{{else}}{{#if (eq activeStep 'funding')}}bg-primary{{else}}{{#if (eq activeStep 'marketing')}}bg-primary{{else}}{{#if (eq activeStep 'team')}}bg-primary{{else}}{{#if (eq activeStep 'legal')}}bg-primary{{else}}bg-muted{{/if}}{{/if}}{{/if}}{{/if}}{{/if}} group-hover:bg-primary">
                </div>
                <span
                    class="{{#if (eq activeStep 'financial')}}text-primary{{else}}text-muted-foreground{{/if}} text-xs mt-2 group-hover:text-primary">Financial</span>
            </a>
            <!-- Step 4: Funding -->
            <a href="/models/funding{{#if ideaId}}?ideaId={{ideaId}}{{/if}}" class="group flex flex-col items-center z-10">
                <div
                    class="w-4 h-4 rounded-full {{#if (eq activeStep 'funding')}}bg-primary{{else}}{{#if (eq activeStep 'marketing')}}bg-primary{{else}}{{#if (eq activeStep 'team')}}bg-primary{{else}}{{#if (eq activeStep 'legal')}}bg-primary{{else}}bg-muted{{/if}}{{/if}}{{/if}}{{/if}} group-hover:bg-primary">
                </div>
                <span
                    class="{{#if (eq activeStep 'funding')}}text-primary{{else}}text-muted-foreground{{/if}} text-xs mt-2 group-hover:text-primary">Funding</span>
            </a>
            <!-- Step 5: Marketing -->
            <a href="/models/marketing{{#if ideaId}}?ideaId={{ideaId}}{{/if}}" class="group flex flex-col items-center z-10">
                <div
                    class="w-4 h-4 rounded-full {{#if (eq activeStep 'marketing')}}bg-primary{{else}}{{#if (eq activeStep 'team')}}bg-primary{{else}}{{#if (eq activeStep 'legal')}}bg-primary{{else}}bg-muted{{/if}}{{/if}}{{/if}} group-hover:bg-primary">
                </div>
                <span
                    class="{{#if (eq activeStep 'marketing')}}text-primary{{else}}text-muted-foreground{{/if}} text-xs mt-2 group-hover:text-primary">Marketing</span>
            </a>
            <!-- Step 6: Team -->
            <a href="/models/team{{#if ideaId}}?ideaId={{ideaId}}{{/if}}" class="group flex flex-col items-center z-10">
                <div
                    class="w-4 h-4 rounded-full {{#if (eq activeStep 'team')}}bg-primary{{else}}{{#if (eq activeStep 'legal')}}bg-primary{{else}}bg-muted{{/if}}{{/if}} group-hover:bg-primary">
                </div>
                <span
                    class="{{#if (eq activeStep 'team')}}text-primary{{else}}text-muted-foreground{{/if}} text-xs mt-2 group-hover:text-primary">Team</span>
            </a>
            <!-- Step 7: Legal -->
            <a href="/models/legal{{#if ideaId}}?ideaId={{ideaId}}{{/if}}" class="group flex flex-col items-center z-10">
                <div
                    class="w-4 h-4 rounded-full {{#if (eq activeStep 'legal')}}bg-primary{{else}}bg-muted{{/if}} group-hover:bg-primary" style="align-self: flex-end;">
                </div>
            <span
                class="{{#if (eq activeStep 'legal')}}text-primary{{else}}text-muted-foreground{{/if}} text-xs mt-2 group-hover:text-primary">Legal</span>
            </a>
        </div>
    </div>
</div>