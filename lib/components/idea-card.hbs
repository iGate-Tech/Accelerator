
<!-- Simplified Idea Card Component - Similar to Profile View -->
<div class="bg-muted/50 rounded-lg p-4 border border-border hover:border-primary/50 transition-colors"
     data-id="{{id}}"
     data-status="{{overall_status}}"
     data-category="{{category}}"
     data-favorite="{{is_favorite}}"
     data-rating="{{rating}}">
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
      <h3 class="font-medium text-foreground truncate mb-2 cursor-pointer hover:text-primary transition-colors"
          onclick="window.location.href='/idea/{{id}}'">
        {{title}}
      </h3>

    </div>
    <div class="flex items-center gap-1">
      {{#if user}}
      <button
        class="favorite-btn p-1 rounded hover:bg-red-50 dark:hover:bg-red-950/30 text-muted-foreground hover:text-red-500 transition-all duration-200 touch-manipulation active:scale-95"
        data-favorite-id="{{id}}"
        title="{{#if is_favorite}}Remove from favorites{{else}}Add to favorites{{/if}}"
        aria-label="{{#if is_favorite}}Remove from favorites{{else}}Add to favorites{{/if}}">
        {{{icon 'heart' class='w-4 h-4 {{#if is_favorite}}fill-current text-red-500{{/if}} transition-all duration-200'}}}
      </button>
      {{/if}}
      <a href="/idea/{{id}}" class="btn btn-ghost btn-sm p-2">
        {{{icon 'arrow-right' class='w-4 h-4'}}}
      </a>
    </div>
  </div>
<div>
      {{#if description}}
      <p class="text-sm text-muted-foreground mb-3 w-full">{{description}}</p>
      {{/if}}
       {{#if profiles}}
       <div class="flex items-center gap-2 mb-2">
         <a href="/profile/{{profiles.user_id}}" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
           <img src="{{cond profiles.avatar_url profiles.avatar_url '/images/avatar.png'}}"
                alt="{{profiles.name}} avatar"
                class="w-6 h-6 rounded-full ring-2 ring-background/50">
           <span class="text-sm text-muted-foreground font-medium">by {{profiles.name}}</span>
         </a>
       </div>
       {{/if}}
      <div class="flex flex-col gap-2 text-xs text-muted-foreground">
        <div class="flex items-center jutify-between gap-4">
          {{#if category}}
          <span class="bg-primary/10 text-primary px-2 py-1 rounded">{{category}}</span>
          {{/if}}
          <span>{{formatDate created_at}}</span>
        </div>
        {{#if rating}}
        <div class="flex items-right gap-1">
          {{{icon 'star' class=(concat 'w-3 h-3 ' (cond (gte rating 1) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
          {{{icon 'star' class=(concat 'w-3 h-3 ' (cond (gte rating 2) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
          {{{icon 'star' class=(concat 'w-3 h-3 ' (cond (gte rating 3) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
          {{{icon 'star' class=(concat 'w-3 h-3 ' (cond (gte rating 4) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
          {{{icon 'star' class=(concat 'w-3 h-3 ' (cond (gte rating 5) 'fill-amber-400 text-amber-400' 'text-muted-foreground/40'))}}}
          <span class="font-semibold text-foreground">{{rating}}/5</span>
          {{#if vote_count}}
          <span class="text-muted-foreground">({{vote_count}})</span>
          {{/if}}
        </div>
        {{else}}
        <span class="text-muted-foreground">Not rated yet</span>
        {{/if}}
      </div>
</div>
</div>
