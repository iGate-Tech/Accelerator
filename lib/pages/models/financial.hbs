<main class="flex flex-col mx-auto items-center justify-center">
    <div class="sections-container">
        <!-- KPI Collection Section -->
        <div id="kpi-collection" class="section mb-6">
            <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "financial.kpi_collection"}}</h2>
            <p class="text-muted-foreground mb-6">{{t "financial.kpi_description"}}</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="kpi-collection-q1" step="1" question=(t "models.financial.track_kpis") placeholder=(t "models.financial.track_kpis_help")
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.financial.section_completed") buttonText=(t "models.financial.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Assumptions Section -->
        <div id="revenue-assumptions" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "financial.revenue_assumptions"}}</h2>
            <p class="text-muted-foreground mb-6">{{t "financial.revenue_description"}}</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="revenue-assumptions-q1" step="2" question="What are your revenue expectations?" placeholder="This section defines your revenue expectations. Provide monthly or yearly revenue estimates, with ranges for different stages. AI can propose ranges based on similar startups. Use this section for revenue planning. Chat with AI to understand revenue expectations or get benchmarking help."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.financial.section_completed") buttonText=(t "models.financial.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Streams Section -->
        <div id="revenue-streams" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "financial.revenue_streams"}}</h2>
            <p class="text-muted-foreground mb-6">{{t "financial.revenue_streams_description"}}</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="revenue-streams-q1" step="3" question="List your revenue streams." placeholder="This section lists your revenue streams. Include subscription, transaction fees, licensing, professional services, hardware sales, API usage. AI can suggest additional revenue streams. Use this section for monetization strategy. Chat with AI to explore revenue models or get diversification ideas."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.financial.section_completed") buttonText=(t "models.financial.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- COGS Section -->
        <div id="cogs" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "financial.cogs"}}</h2>
            <p class="text-muted-foreground mb-6">{{t "financial.cogs_description"}}</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="cogs-q1" step="4" question="What are your monthly COGS?" placeholder="This section identifies your Cost of Goods Sold. Include cloud hosting, delivery costs, support staff, payment gateway fees, software licenses. AI can help calculate typical COGS ranges. Use this section for cost analysis. Chat with AI to learn about COGS calculation or get industry benchmarks."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.financial.section_completed") buttonText=(t "models.financial.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Opex Section -->
        <div id="opex" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "financial.opex"}}</h2>
            <p class="text-muted-foreground mb-6">{{t "financial.opex_description"}}</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="opex-q1" step="5" question="What are your Opex categories?" placeholder="This section captures your Operating Expenses. Include salaries, marketing, office rent, software subscriptions, legal, travel, R&D. AI can recommend standard benchmarks. Use this section for expense planning. Chat with AI to understand Opex categories or get cost optimization tips."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.financial.section_completed") buttonText=(t "models.financial.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Capex Section -->
        <div id="capex" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "financial.capex"}}</h2>
            <p class="text-muted-foreground mb-6">{{t "financial.capex_description"}}</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="capex-q1" step="6" question="What are your capital expenditures?" placeholder="This section identifies capital expenditures. Include equipment, servers, vehicles, machinery, or one-time system builds. AI can suggest Capex options. Use this section for investment planning. Chat with AI to learn about Capex vs Opex or get investment planning help."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.financial.section_completed") buttonText=(t "models.financial.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Statements Section -->
        <div id="financial-statements" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "financial.financial_statements"}}</h2>
            <p class="text-muted-foreground mb-6">{{t "financial.financial_description"}}</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="financial-statements-q1" step="7" question="What formatting do you want for financial statements?" placeholder="This section generates your financial statements. Choose monthly, quarterly, yearly, or 3-5 year projections. AI will compute based on your inputs. Use this section for financial reporting. Chat with AI to understand financial statements or get formatting recommendations."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.financial.section_completed") buttonText=(t "models.financial.move_next")}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Ratios Section -->
        <div id="financial-ratios" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "financial.financial_ratios"}}</h2>
            <p class="text-muted-foreground mb-6">{{t "financial.ratios_description"}}</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="financial-ratios-q1" step="8" question="Which financial ratios do you want calculated?" placeholder="This section calculates major financial ratios. Includes profitability, efficiency, liquidity, and growth ratios. AI will compute all major ratios. Use this section for financial analysis. Chat with AI to learn about financial ratios or get interpretation help."}}
                     </div>
                 </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">{{{icon 'check-circle' class='w-8 h-8 text-success' size='32'}}</div>
                    <div class="flex-1">
                        {{> move-next-block message=(t "models.financial.complete_financial") buttonText=(t "models.financial.complete_financial_button")}}
                    </div>
                </div>
            </div>
        </div>
     </div>
</main>

<div class=" h-[300px]"></div>

