<!-- Main Content -->
<main id="hero"
    class="container lg:px-12 lg:pt-0 min-h-[900px] flex flex-col lg:flex-row z-10 mr-auto ml-auto pt-0 pr-6 pl-6 relative items-center">
  <!-- Left Column: Copy -->
  <div class="lg:w-1/2 flex flex-col lg:py-0 lg:mt-0 w-full mt-20 pt-12 pb-20 justify-center">
    <h4 class="text-xs font-mono tracking-[0.2em] text-white/40 uppercase mb-8 flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-purple opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-purple"></span>
      </span>
      AI-Powered Platform
    </h4>

    <h1 class="lg:text-7xl leading-[1.1] text-brand-purple text-glow text-5xl italic tracking-tight font-serif mb-8">
      Build Your Startup <br />
      <span class="text-white opacity-90">with AI Precision.</span>
    </h1>

    <p class="font-sans text-xl lg:text-2xl font-light text-white/70 leading-relaxed tracking-tight max-w-xl mb-10">
      Complete AI-powered platform designed to help individuals, startups,
      and organizations create, model, and launch new business ideas. Guides users through the entire startup-building lifecycle: AI Idea Creation, Idea Modeling, Business Model Generation, Financial Modeling, Legal/Marketing/Team Models, and Pitch Deck Creation. Includes a credit-based creator economy where users buy credits to generate AI models, publish ideas, and earn from community votes.
    </p>

    <div class="flex flex-col sm:flex-row gap-6 gap-x-6 gap-y-6 items-start sm:items-center">
      <!-- Animated Shiny CTA Button -->
      <button class="shiny-cta focus:outline-none text-base">
        <span>Start Building</span>
      </button>

      <!-- Gradient Pill Button with Icon (Dark Gray) -->
      <button
        class="hover:bg-white/10 hover:text-white transition-all flex text-sm font-medium text-slate-300 bg-white/5 rounded-full pt-3 pr-6 pb-3 pl-6 gap-x-3 gap-y-2 items-center group"
        style="
              box-shadow:
                0 4px 20px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(255, 255, 255, 0.05);
              position: relative;
              --border-gradient: linear-gradient(
                180deg,
                rgba(255, 255, 255, 0.15),
                rgba(255, 255, 255, 0.05),
                rgba(255, 255, 255, 0.15)
              );
              --border-radius-before: 9999px;
            ">
        <span class="text-sm font-medium tracking-tight">
          View Ecosystem
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          class="opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Right Column: Abstract UI Visualization with Sonar -->
  <div class="lg:w-1/2 lg:h-[800px] flex w-full h-[500px] relative perspective-1000 items-center justify-center">
    <svg class="absolute inset-0 w-full h-full pointer-events-none z-10 overflow-visible" viewBox="0 0 600 600">
      <defs>
         <linearGradient id="beam-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
           <stop offset="0%" stop-color="hsl(var(--color-brand-purple))" />
           <stop offset="50%" stop-color="hsl(var(--color-brand-purple))" />
           <stop offset="100%" stop-color="hsl(var(--color-brand-purple))" />
         </linearGradient>
         <radialGradient id="center-glow" cx="50%" cy="50%" r="50%">
           <stop offset="0%" stop-color="hsl(var(--color-brand-purple) / 0.3)" />
           <stop offset="100%" stop-color="hsl(var(--color-brand-purple) / 0.05)" />
         </radialGradient>
       </defs>

      <!-- Connecting Beams -->
      <!-- Group 1 -->
      <g>
        <path d="M -50 150 C 100 150, 100 300, 300 300" fill="none" stroke="white" stroke-width="1"
          class="opacity-[0.08]"></path>
        <path d="M -50 150 C 100 150, 100 300, 300 300" fill="none" stroke="url(#beam-gradient)" stroke-width="1.5"
          class="beam-line animate-beam opacity-60"></path>
      </g>
      <!-- Group 2 -->
      <g>
        <path d="M -50 450 C 100 450, 100 300, 300 300" fill="none" stroke="white" stroke-width="1"
          class="opacity-[0.08]"></path>
        <path d="M -50 450 C 100 450, 100 300, 300 300" fill="none" stroke="url(#beam-gradient)" stroke-width="1.5"
          class="beam-line animate-beam opacity-60" style="animation-delay: -1s"></path>
      </g>
      <!-- Group 3 -->
      <g>
        <path d="M 650 100 C 500 100, 500 300, 300 300" fill="none" stroke="white" stroke-width="1"
          class="opacity-[0.08]"></path>
        <path d="M 650 100 C 500 100, 500 300, 300 300" fill="none" stroke="url(#beam-gradient)" stroke-width="1.5"
          class="beam-line animate-beam opacity-60" style="animation-delay: -2s"></path>
      </g>
      <!-- Group 4 -->
      <g>
        <path d="M 650 500 C 500 500, 500 300, 300 300" fill="none" stroke="white" stroke-width="1"
          class="opacity-[0.08]"></path>
        <path d="M 650 500 C 500 500, 500 300, 300 300" fill="none" stroke="url(#beam-gradient)" stroke-width="1.5"
          class="beam-line animate-beam opacity-60" style="animation-delay: -1.5s"></path>
      </g>

      <!-- CENTRAL NODE DETAIL -->
      <g transform="translate(300, 300)">
        <!-- Ambient Glow -->
        <circle r="120" fill="url(#center-glow)" class="animate-pulse"></circle>

        <!-- Sonar Waves -->
        <circle r="20" fill="none" stroke="url(#beam-gradient)" stroke-width="1" opacity="0.5" class="animate-sonar"></circle>
        <circle r="20" fill="none" stroke="url(#beam-gradient)" stroke-width="1" opacity="0.5" class="animate-sonar delay-1000">
        </circle>
        <circle r="20" fill="none" stroke="url(#beam-gradient)" stroke-width="1" opacity="0.5" class="animate-sonar delay-2000">
        </circle>

        <!-- Technical Rings -->
        <!-- Outer Dashed Ring Slow -->
        <circle r="65" fill="none" stroke="white" stroke-opacity="0.1" stroke-width="1" stroke-dasharray="10 20"
          class="animate-spin-slow"></circle>

        <!-- Inner Dashed Ring Reverse -->
        <circle r="45" fill="none" stroke="url(#beam-gradient)" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="4 6"
          class="animate-spin-slow-reverse"></circle>

        <!-- Crosshair Markers -->
        <g class="animate-spin-slow" style="animation-duration: 20s">
          <path d="M -80 0 L -70 0" stroke="white" stroke-opacity="0.2"></path>
          <path d="M 80 0 L 70 0" stroke="white" stroke-opacity="0.2"></path>
          <path d="M 0 -80 L 0 -70" stroke="white" stroke-opacity="0.2"></path>
          <path d="M 0 80 L 0 70" stroke="white" stroke-opacity="0.2"></path>
        </g>

        <!-- Core -->
        <circle r="8" fill="black" stroke="url(#beam-gradient)" stroke-width="2"></circle>
        <circle r="4" fill="url(#beam-gradient)" class="animate-pulse-fast"></circle>
      </g>
    </svg>

    <!-- Floating Labels -->
    <div class="absolute top-[20%] lg:top-[25%] left-[10%] lg:left-[15%] flex flex-col items-end">
      <span class="text-xs font-mono text-brand-purple tracking-widest mb-1 opacity-80">RAPID GENERATION</span>
      <div class="h-[1px] w-12 bg-gradient-to-l from-brand-purple to-transparent"></div>
    </div>

    <div class="absolute bottom-[20%] lg:bottom-[25%] right-[10%] lg:right-[15%] flex flex-col items-start">
      <span class="text-xs font-mono text-brand-purple tracking-widest mb-1 opacity-80">AI POWERED</span>
      <div class="h-[1px] w-12 bg-gradient-to-r from-brand-purple to-transparent"></div>
    </div>

    <!-- Extra Data Decoration (New) -->
    <div class="absolute top-[50%] right-[15%] hidden lg:flex flex-col gap-1">
      <div class="flex gap-1">
        <div class="w-1 h-1 bg-white/20"></div>
        <div class="w-1 h-1 bg-white/20"></div>
        <div class="w-1 h-1 bg-brand-purple animate-pulse"></div>
      </div>
    </div>
  </div>
