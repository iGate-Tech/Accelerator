{{#if (ne showThemeLang false)}}
{{!-- Theme and Language Switch Component --}}
<div class="flex justify-between items-center w-full">
  {{!-- Language Toggle --}}
  <button id="lang-toggle" class="flex items-center justify-center w-16 h-8 sm:w-10 sm:h-10 rounded-lg hover:bg-muted transition-colors" title="Switch Language">
    {{{icon 'languages' class='h-4 w-4 mr-1'}}}
    <span id="lang-text" class="text-sm font-medium">EN</span>
  </button>

  {{!-- Theme Toggle --}}
  <button id="theme-toggle" class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-lg hover:bg-muted transition-colors" title="Toggle Theme">
    {{{icon 'sun' class='w-4 h-4 sm:w-5 sm:h-5 text-yellow-500' id='sun-icon'}}}
    {{{icon 'moon' class='w-4 h-4 sm:w-5 sm:h-5 text-blue-500 hidden' id='moon-icon'}}}
  </button>
</div>

<script>
(function() {
document.addEventListener('DOMContentLoaded', function() {
   const langToggle = document.getElementById('lang-toggle');
   const themeToggle = document.getElementById('theme-toggle');
   const sunIcon = document.getElementById('sun-icon');
   const moonIcon = document.getElementById('moon-icon');
   const langText = document.getElementById('lang-text');

    // Language Toggle
    langToggle.addEventListener('click', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const currentLang = urlParams.get('lng') || 'en';
      const newLang = currentLang === 'ar' ? 'en' : 'ar';

      // Save to localStorage
      localStorage.setItem('language', newLang);

      // If user is authenticated, sync with server
      if (document.body.dataset.loggedIn === 'true') {
        fetch('/settings/language', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ language: newLang })
        }).catch(err => console.warn('Failed to sync language with server'));
      }

      // Reload page with new language
      const newUrl = new URL(window.location);
      newUrl.searchParams.set('lng', newLang);
      window.location.href = newUrl.toString();
    });

    // Initialize language display
    const urlParams = new URLSearchParams(window.location.search);
    const currentLang = urlParams.get('lng') || 'en';
    langText.textContent = currentLang.toUpperCase();

    // Theme Toggle
    let isDark = localStorage.getItem('theme') === 'dark' ||
                 (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);

    function updateTheme() {
      document.documentElement.classList.toggle('dark', isDark);
      if (sunIcon) sunIcon.classList.toggle('hidden', isDark);
      if (moonIcon) moonIcon.classList.toggle('hidden', !isDark);
      localStorage.setItem('theme', isDark ? 'dark' : 'light');

      // If user is authenticated, sync with server
      if (document.body.dataset.loggedIn === 'true') {
        fetch('/settings/theme', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ theme: isDark ? 'dark' : 'light' })
        }).catch(err => console.warn('Failed to sync theme with server'));
      }
    }

    themeToggle.addEventListener('click', function() {
      isDark = !isDark;
      updateTheme();
    });

   // Initialize theme
   updateTheme();
 });
})();
</script>
{{/if}}