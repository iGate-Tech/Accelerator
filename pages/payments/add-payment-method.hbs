<main id="add-payment-method-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="grid gap-1">
        <h1 class="font-heading text-3xl font-semibold text-foreground">
          Add Payment Method
        </h1>
        <p class="text-lg text-muted-foreground">
          Securely add a payment method to your account
        </p>
      </div>

      <!-- Payment Method Form -->
      <div class="bg-card rounded-lg border border-border p-6">
        <form id="payment-method-form" method="POST" action="/add-payment-method" class="space-y-6">
          <!-- Card Type Selection -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-2">Payment Method Type</label>
            <div class="grid grid-cols-3 gap-4">
              <label class="relative">
                <input type="radio" name="cardType" value="credit" class="sr-only peer" checked>
                <div class="p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                  <div class="flex items-center gap-3">
                    {{{icon 'credit-card' class='w-6 h-6 text-primary' size='24'}}}
                    <div>
                      <div class="font-medium text-foreground">Credit Card</div>
                      <div class="text-sm text-muted-foreground">Visa, Mastercard, etc.</div>
                    </div>
                  </div>
                </div>
              </label>
              <label class="relative">
                <input type="radio" name="cardType" value="debit" class="sr-only peer">
                <div class="p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                  <div class="flex items-center gap-3">
                    {{{icon 'credit-card' class='w-6 h-6 text-primary' size='24'}}}
                    <div>
                      <div class="font-medium text-foreground">Debit Card</div>
                      <div class="text-sm text-muted-foreground">Bank debit cards</div>
                    </div>
                  </div>
                </div>
              </label>
              <label class="relative">
                <input type="radio" name="cardType" value="paypal" class="sr-only peer">
                <div class="p-4 border-2 border-border rounded-lg cursor-pointer peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-colors">
                  <div class="flex items-center gap-3">
                    {{{icon 'wallet' class='w-6 h-6 text-primary' size='24'}}}
                    <div>
                      <div class="font-medium text-foreground">PayPal</div>
                      <div class="text-sm text-muted-foreground">PayPal account</div>
                    </div>
                  </div>
                </div>
              </label>
            </div>
          </div>

          <!-- Card Details -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
              <label for="cardNumber" class="block text-sm font-medium text-foreground mb-2">Card Number</label>
              <div class="relative">
                <input type="text" id="cardNumber" name="cardNumber" placeholder="1234 5678 9012 3456" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
                <div class="absolute right-3 top-1/2 transform -translate-y-1/2 flex gap-1">
                  <div class="w-6 h-4 bg-blue-600 rounded text-white text-xs flex items-center justify-center font-bold">V</div>
                  <div class="w-6 h-4 bg-red-600 rounded text-white text-xs flex items-center justify-center font-bold">M</div>
                  <div class="w-6 h-4 bg-blue-400 rounded text-white text-xs flex items-center justify-center font-bold">A</div>
                </div>
              </div>
            </div>

            <div>
              <label for="expiryDate" class="block text-sm font-medium text-foreground mb-2">Expiry Date</label>
              <input type="text" id="expiryDate" name="expiryDate" placeholder="MM/YY" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
            </div>

            <div>
              <label for="cvv" class="block text-sm font-medium text-foreground mb-2">CVV</label>
              <input type="text" id="cvv" name="cvv" placeholder="123" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
            </div>
          </div>

          <!-- Cardholder Name -->
          <div>
            <label for="cardholderName" class="block text-sm font-medium text-foreground mb-2">Cardholder Name</label>
            <input type="text" id="cardholderName" name="cardholderName" placeholder="John Doe" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
          </div>

          <!-- Billing Address -->
          <div>
            <h3 class="text-lg font-medium text-foreground mb-4">Billing Address</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="md:col-span-2">
                <label for="address" class="block text-sm font-medium text-foreground mb-2">Street Address</label>
                <input type="text" id="address" name="address" placeholder="123 Main Street" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
              </div>

              <div>
                <label for="city" class="block text-sm font-medium text-foreground mb-2">City</label>
                <input type="text" id="city" name="city" placeholder="New York" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
              </div>

              <div>
                <label for="zipCode" class="block text-sm font-medium text-foreground mb-2">ZIP Code</label>
                <input type="text" id="zipCode" name="zipCode" placeholder="10001" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
              </div>

              <div>
                <label for="country" class="block text-sm font-medium text-foreground mb-2">Country</label>
                <select id="country" name="country" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
                  <option value="">Select Country</option>
                  <option value="US">United States</option>
                  <option value="CA">Canada</option>
                  <option value="UK">United Kingdom</option>
                  <option value="AU">Australia</option>
                  <option value="DE">Germany</option>
                  <option value="FR">France</option>
                  <option value="JP">Japan</option>
                  <option value="SA">Saudi Arabia</option>
                </select>
              </div>

              <div>
                <label for="state" class="block text-sm font-medium text-foreground mb-2">State/Province</label>
                <input type="text" id="state" name="state" placeholder="NY" class="w-full px-3 py-2 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required>
              </div>
            </div>
          </div>

          <!-- Security Notice -->
          <div class="bg-muted/50 rounded-lg p-4">
            <div class="flex items-start gap-3">
              {{{icon 'shield-check' class='w-5 h-5 text-success mt-0.5' size='20'}}}
              <div>
                <h4 class="font-medium text-foreground">Secure Payment</h4>
                <p class="text-sm text-muted-foreground">Your payment information is encrypted and secure. We use industry-standard security measures to protect your data.</p>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex gap-4 pt-4">
            <button type="submit" class="btn btn-primary flex-1">
              Add Payment Method
            </button>
            <button type="button" class="btn btn-outline" onclick="window.history.back()">
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>