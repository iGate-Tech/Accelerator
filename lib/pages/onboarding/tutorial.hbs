        progressBar.style.width = progressPercent + '%';
        currentStepSpan.textContent = currentStep;
        progressText.textContent = `${currentStep} of ${totalSteps} steps`;

        // Update step indicators
        stepIndicators.forEach((indicator, index) => {
          if (index + 1 === currentStep) {
            indicator.classList.remove('bg-muted');
            indicator.classList.add('bg-primary');
          } else {
            indicator.classList.remove('bg-primary');
            indicator.classList.add('bg-muted');
          }
        });

        // Update navigation buttons
        prevButton.disabled = currentStep === 1;
        if (currentStep === totalSteps) {
          nextButton.innerHTML = `
            Complete Tutorial
            <svg class="w-4 h-4 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          `;
        } else {
          nextButton.innerHTML = `
            Next
            <svg class="w-4 h-4 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          `;
        }

        // Load step content
        tutorialStep.innerHTML = steps[currentStep - 1].content;
      }

      function nextStep() {
        if (currentStep < totalSteps) {
          currentStep++;
          updateStep();
        } else {
          // Complete tutorial
          tutorialStep.classList.add('hidden');
          document.querySelector('.flex.justify-between.items-center').classList.add('hidden');
          tutorialComplete.classList.remove('hidden');
        }
      }

      function prevStep() {
        if (currentStep > 1) {
          currentStep--;
          updateStep();
        }
      }

      // Event listeners
      nextButton.addEventListener('click', nextStep);
      prevButton.addEventListener('click', prevStep);

      // Initialize first step
      updateStep();
    });
  </script>
</div>