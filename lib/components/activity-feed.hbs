{{!-- Activity Feed Component --}}
<div class="rounded-lg bg-card p-6 text-card-foreground shadow-sm border border-border">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold">{{../t 'dashboard-dashboard.recent_activity' lng=../lng}}</h3>
    <a href="#" class="text-sm text-primary hover:underline">{{../t 'dashboard-dashboard.view_all' lng=../lng}}</a>
  </div>
  <div class="space-y-4">
    {{#each activity}}
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
        {{{icon 'activity' class='w-4 h-4 text-primary' size='16'}}}
      </div>
      <div class="flex-1">
        <p class="text-sm text-muted-foreground">
          {{#if idea_title}}
            {{../t 'dashboard-dashboard.activity_created_idea' lng=../lng title=idea_title}}
          {{else}}
            {{action_type}}
          {{/if}}
        </p>
        <p class="text-xs text-muted-foreground">{{formatDate created_at}}</p>
      </div>
    </div>
    {{/each}}
    {{#unless activity}}
    <p class="text-sm text-muted-foreground">{{../t 'dashboard-dashboard.no_recent_activity' lng=../lng}}</p>
    {{/unless}}
  </div>
</div>