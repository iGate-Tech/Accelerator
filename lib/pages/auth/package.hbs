
<div class="min-h-screen bg-base-100">
   <div class="relative overflow-hidden">
     <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
       <!-- Header -->
       <div class="text-center mb-8 sm:mb-12">
         <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-primary rounded-2xl mb-6 sm:mb-8">
 {{{icon 'credit-card' class="w-8 h-8 sm:w-10 sm:h-10 text-white"}}}
         </div>
         <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4 sm:mb-6">
           {{t 'dashboard.payments.upgrade.title'}}
         </h1>
         <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
           {{t 'dashboard.payments.upgrade.subtitle'}}
         </p>
       </div>

      <!-- Current Balance Card -->
      <div class="bg-card rounded-2xl shadow-xl p-6 mb-8 sm:mb-12 border border-border">
                 <div class="text-center">
          <div class="text-sm text-muted-foreground mb-2">{{t 'dashboard.payments.billing.current_balance'}}</div>
          <div class="text-4xl sm:text-5xl font-bold text-primary">{{currentBalance}} {{t 'dashboard.payments.billing.credits'}}</div>
        </div>
      </div>

      <!-- Package Plans -->
       <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
         {{#each packages}}
         <div class="bg-white rounded-lg border border-gray-300">
           <div class="p-6 sm:p-8">
            <div class="text-center">
              <h3 class="text-xl sm:text-2xl font-bold text-foreground mb-2">{{name}} Plan</h3>
              <div class="text-3xl sm:text-4xl font-extrabold text-primary mb-1">${{price_monthly}}</div>
              <div class="text-sm text-muted-foreground mb-4">{{t 'dashboard.payments.upgrade.month'}}</div>
              <div class="text-sm text-muted-foreground">{{credits_monthly}} {{t 'dashboard.payments.billing.credits'}} included</div>
            </div>
          </div>

          <div class="p-6 sm:p-8">
            <div class="space-y-4 mb-6">
              <div class="flex items-center space-x-3">
                <div class="w-6 h-6 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0">
{{{icon 'check' class="w-4 h-4 text-green-600 dark:text-green-400"}}}
                </div>
                <span class="text-sm text-foreground">{{t 'dashboard.payments.buy_credits.instant_delivery'}}</span>
              </div>

              <div class="flex items-center space-x-3">
                <div class="w-6 h-6 bg-blue-500/10 rounded-full flex items-center justify-center flex-shrink-0">
{{{icon 'clock' class="w-4 h-4 text-blue-600 dark:text-blue-400"}}}
                </div>
                <span class="text-sm text-foreground">{{t 'dashboard.payments.buy_credits.no_expiration'}}</span>
              </div>

              <div class="flex items-center space-x-3">
                <div class="w-6 h-6 bg-amber-500/10 rounded-full flex items-center justify-center flex-shrink-0">
{{{icon 'lightbulb' class="w-4 h-4 text-amber-600 dark:text-amber-400"}}}
                </div>
                <span class="text-sm text-foreground">{{t 'dashboard.payments.upgrade.ai_powered_features'}}</span>
              </div>
            </div>

            <form method="POST" action="/onboarding/package">
              <input type="hidden" name="_csrf" value="{{csrf}}" />
              <input type="hidden" name="package_type" value="{{type}}" />
             <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-3 px-6 rounded-lg flex items-center justify-center space-x-2">
                 <span>{{t 'dashboard.payments.upgrade.upgrade_to'}} {{name}} {{t 'dashboard.payments.upgrade.plan'}}</span>
 {{{icon 'arrow-right' class="w-5 h-5"}}}
               </button>
            </form>
          </div>
        </div>
        {{/each}}
      </div>

       <!-- Footer -->
       <div class="mt-12 sm:mt-16 text-center">
         <div class="bg-white rounded-lg p-6 border border-gray-300">
           <p class="text-muted-foreground">{{t 'onboarding.package.footer'}}</p>
        </div>
      </div>
    </div>
  </div>
</div>