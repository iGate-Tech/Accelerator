
<div class="flex relative w-full h-fit flex-col gap-1 items-start p-3 sm:p-4 mb-4 cursor-pointer group-item-btns overflow-hidden border rounded-md border-border bg-card hover:shadow-lg dark:hover:shadow-primary focus:outline-none"
    onclick="toggleCardDetails(this)"
    data-id="{{id}}" data-status="{{overall_status}}" data-type="{{category}}"
    data-favorite="{{is_favorite}}" data-created-at="{{created_at}}" data-updated-at="{{updated_at}}"
    data-rating="{{rating}}">
      <button data-favorite-id="{{id}}"
          class="absolute top-2 right-2 text-muted-foreground hover:text-red-500 cursor-pointer favorite-btn {{#if is_favorite}}text-red-500{{/if}}"
          title="Toggle Favorite">

          {{{icon 'heart' class='w-4 h-4 {{#if is_favorite}}fill-current{{/if}}'}}}

      </button>

      <button data-populate-id="{{id}}"
          class="absolute top-2 right-10 text-muted-foreground hover:text-primary cursor-pointer">

          {{{icon 'copy' class='w-4 h-4'}}}

      </button>

      <button onclick="window.location.href='/idea/{{id}}'"
          class="absolute top-2 right-20 px-2 py-0.5 bg-secondary/10 text-foreground text-xs rounded-md border border-secondary/40 cursor-pointer hover:bg-secondary/20"
          title="View Full Details">

          Full Screen

      </button>
    <div class="w-full">
        <span
            class="text-ellipsis break-words line-clamp-2 text-sm text-foreground">{{title}}</span>
        {{#if profiles}}
        <div class="text-xs text-muted-foreground mt-1 flex items-center gap-2">
            by <img src="{{cond profiles.avatar_url profiles.avatar_url '/images/avatar.png'}}" alt="Avatar" class="w-4 h-4 rounded-full"> {{profiles.name}}
        </div>
        {{/if}}
    </div>

    <div class="flex items-center gap-1.5 mb-1">
        <div class="text-muted-foreground text-[13px] leading-[18px] truncate">
        </div>
    </div>

    <div class="card-details" style="display: none;">
         <div class="text-xs text-foreground dark:text-muted-foreground mb-2">
             {{markdown description}}
         </div>



        <div class="flex flex-wrap gap-1 mb-2">
            {{#each tags}}
            <span
                class="px-2 py-0.5 bg-secondary/10 text-foreground text-xs rounded-md border border-secondary/40">{{this}}</span>
            {{/each}}
        </div>

         <div class="text-xs text-muted-foreground mb-2 flex items-center gap-2">
             {{#if overall_status}}
             <span class="px-2 py-1 rounded-full text-xs {{statusClass overall_status}}">
                 {{overall_status}}
             </span>
             {{/if}}
             {{#if privacy}}
             <span class="px-2 py-1 rounded-full text-xs {{cond (eq privacy 'public') 'bg-green-100 text-green-800' 'bg-gray-100 text-gray-800'}}">
                 {{cond (eq privacy 'public') 'Public' 'Private'}}
             </span>
             {{/if}}
             <span>{{created_at_formatted}} | {{updated_at_formatted}}</span>
         </div>

        {{#if completion_percentage}}
        <div class="text-xs text-muted-foreground mb-2">
            <div class="flex items-center gap-2">
                <span>Progress: {{completion_percentage}}%</span>
                <div class="flex-1 bg-muted rounded-full h-1">
                    <div class="bg-primary h-1 rounded-full" style="width: {{completion_percentage}}%"></div>
                </div>
            </div>
        </div>
        {{/if}}
    </div>


    <div
        class="flex items-center justify-between w-full mt-auto pt-2 border-t border-border">
        <div class="flex items-center">

            <div class="flex">

                 {{{icon 'star' class=(concat 'w-3.5 h-3.5 ' (cond (gt rating 0) 'fill-yellow-400 text-yellow-400' 'text-muted-foreground')) fill=(cond (gt rating 0) 'currentColor' 'none') stroke='currentColor'}}}


                 {{{icon 'star' class=(concat 'w-3.5 h-3.5 ' (cond (gt rating 1) 'fill-yellow-400 text-yellow-400' 'text-muted-foreground')) fill=(cond (gt rating 1) 'currentColor' 'none') stroke='currentColor'}}}


                 {{{icon 'star' class=(concat 'w-3.5 h-3.5 ' (cond (gt rating 2) 'fill-yellow-400 text-yellow-400' 'text-muted-foreground')) fill=(cond (gt rating 2) 'currentColor' 'none') stroke='currentColor'}}}


                 {{{icon 'star' class=(concat 'w-3.5 h-3.5 ' (cond (gt rating 3) 'fill-yellow-400 text-yellow-400' 'text-muted-foreground')) fill=(cond (gt rating 3) 'currentColor' 'none') stroke='currentColor'}}}


                 {{{icon 'star' class=(concat 'w-3.5 h-3.5 ' (cond (gt rating 4) 'fill-yellow-400 text-yellow-400' 'text-muted-foreground')) fill=(cond (gt rating 4) 'currentColor' 'none') stroke='currentColor'}}}

            </div>

            {{#if ../user}}
            <div class="ml-2 flex items-center">
                <div class="star-rating flex" data-idea-id="{{id}}">
                    {{#each (range 1 6)}}
                    <button
                        class="star-btn text-muted-foreground hover:text-yellow-400 w-4 h-4"
                        data-rating="{{this}}"
                        title="Rate {{this}} star{{#if (gt this 1)}}s{{/if}}">
                        {{{icon 'star' class='w-3 h-3' fill='none' stroke='currentColor'}}}
                    </button>
                    {{/each}}
                </div>
            </div>
            {{/if}}

        </div>

        <div class="flex space-x-2">
            {{#if (eq ../user.package_type 'enterprise')}}
             <button onclick="openTeamModal(this)"
                 data-id="{{id}}"
                 class="text-muted-foreground hover:text-blue-500 rounded-full hover:bg-primary-100 hover:text-primary-900"
                 title="Manage Team">

                  {{{icon 'users' class='w-4 h-4'}}}

             </button>
            {{/if}}

            <button
                class="text-muted-foreground hover:text-orange-500 rounded-full hover:bg-primary-100 hover:text-primary-900 unpublish-btn">

                 {{{icon 'eye-off' class='w-4 h-4'}}}

            </button>

            <button
                class="text-muted-foreground rounded-full hover:text-green-500 {{#if is_favorite}}fill-red-500 text-red-500{{else}}{{/if}}">

                 {{{icon 'heart' class='w-4 h-4' fill=(cond is_favorite 'currentColor' 'none') stroke='currentColor'}}}

            </button>
            {{#if (eq privacy 'private')}}
             <button onclick="shareIdea(this)"
                 data-id="{{id}}"
                 class="text-muted-foreground hover:text-green-500 rounded-full hover:bg-primary-100 hover:text-primary-900"
                 title="Share Private Idea">

                  {{{icon 'share' class='w-4 h-4'}}}

             </button>
            {{/if}}

       <button onclick="goToIdea(this)"
           data-id="{{id}}"
           class="absolute top-2 right-20 px-2 py-0.5 bg-secondary/10 text-foreground text-xs rounded-md border border-secondary/40 cursor-pointer hover:bg-secondary/20"
           title="View Full Details">

           Full Screen

       </button>

             <button
                 class="text-muted-foreground hover:text-red-500 rounded-full hover:bg-primary-100 hover:text-primary-900 archive-btn">

                  {{{icon 'archive' class='w-4 h-4'}}}

             </button>
        </div>
    </div>
</div>
