<html lang="{{lng}}" dir="{{#if (eq lng 'ar')}}rtl{{else}}ltr{{/if}}">

<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>
  <link rel="icon" href="/images/favicon.svg"/>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <link rel="stylesheet" href="/css/output.css"/>
  <style>
    .htmx-request {
      opacity: 0.8;
    }

    .htmx-request .loading {
      display: inline;
    }

    .loading {
      display: none;
    }

    .htmx-settling {
      opacity: 1;
    }

    #login-spinner {
      display: none;
    }

    #global-loading {
      display: none;
    }

    .htmx-request #global-loading {
      display: block;
    }

    .logo-path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: move-360 1s linear infinite;
    }

    @keyframes move-360 {
      to {
        stroke-dashoffset: -500;
      }
    }
  </style>
  {{#if styles}}{{styles}}{{/if}}
</head>

   <body class="{{bodyClass}}
      bg-background pb-8" data-logged-in="false">

  <!-- Language and Theme Switchers -->
  <div class="fixed top-4 left-4 right-4 z-50">
    {{> theme-lang-switch lng=lng showThemeLang=showThemeLang}}
  </div>

  {{{body}}}

   {{#if scripts}}{{scripts}}{{/if}}
   <script>
     // Set document direction based on language
     const urlParams = new URLSearchParams(window.location.search);
     const lang = urlParams.get('lng') || 'en';
     document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
     document.documentElement.lang = lang;
   </script>
   {{#if scripts}}{{scripts}}{{/if}}
     <script>
       function showLoadingFor8Seconds() {
         const loading = document.getElementById('global-loading');
         loading.style.display = 'block';
         setTimeout(() => {
           loading.style.display = 'none';
         }, 8000);
       }
     </script>



   <div id="global-loading">
     {{> loading}}
   </div>
</body>
</html>