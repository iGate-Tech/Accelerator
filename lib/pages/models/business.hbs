{{> progress-bar activeStep=activeStep ideaId=ideaId}}

{{> model-header title=pageTitle description=(t "business.overview")
ratingStars="★★★★★" ratingValue="5.0" voteCount="0 votes" category=ideaCategory tags=ideaTags}}

{{> model-progress data='[
  {
    "id": "product-section",
    "fullLabel": "1. {{t \"business.product_section\"}}",
    "shortLabel": "1.",
    "position": 0
  }},
  {
    "id": "market-section",
    "fullLabel": "2. {{t \"business.market_section\"}}",
    "shortLabel": "2.",
    "position": 16.67
  }},
  {
    "id": "competition-analysis",
    "fullLabel": "3. {{t \"business.competition_analysis\"}}",
    "shortLabel": "3.",
    "position": 33.33
  }},
  {
    "id": "risk-register",
    "fullLabel": "4. {{t \"business.risk_register\"}}",
    "shortLabel": "4.",
    "position": 50
  }},
  {
    "id": "value-proposition",
    "fullLabel": "5. {{t \"business.value_proposition\"}}",
    "shortLabel": "5.",
    "position": 66.67
  }},
  {
    "id": "cost-revenue",
    "fullLabel": "6. {{t \"business.cost_revenue\"}}",
    "shortLabel": "6.",
    "position": 83.33
  }},
  {
    "id": "exit-strategy",
    "fullLabel": "7. {{t \"business.exit_strategy\"}}",
    "shortLabel": "7.",
    "position": 100
  }}
]'}} 

 <main class="flex flex-col mx-auto items-center justify-center">
     <div class="sections-container">

         <!-- Product Section -->
         <div id="product-section" class="section mb-6">
              <h2 class="text-xl font-semibold mb-4 text-foreground">{{t "business.product_section"}}</h2>
              <p class="text-muted-foreground mb-6">{{t "business.product_description"}}</p>
             <div class="relative">
                 <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                       <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                       <div class="flex-1">
                            {{> question-block id="product-section-q1" step="1" question=(t "business.core_function") placeholder=(t "business.core_function_help")
                       </div>
                   </div>
                 <div class="flex items-start gap-4 mb-6">
                       <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                       <div class="flex-1">
                            {{> question-block id="product-section-q2" step="2" question=(t "business.key_activities") placeholder=(t "business.key_activities_help")
                       </div>
                   </div>
                <div class="flex items-start gap-4 mb-6">
