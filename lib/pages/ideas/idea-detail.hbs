<div class="min-h-screen bg-gradient-to-br from-muted/50 to-background py-8 sm:py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">

    <!-- Back Navigation -->
    <div class="mb-4 sm:mb-6">
      <a href="/explore-idea" class="inline-flex items-center text-primary hover:text-primary/80 transition-colors text-sm sm:text-base">
 {{{icon 'arrow-left' class='w-4 h-4 sm:w-5 sm:h-5 mr-2' size='24'}}}
         {{t 'idea-detail.back_to_explore'}}
       </a>
    </div>

    <!-- Idea Header -->
    <div class="bg-card rounded-2xl shadow-xl p-4 sm:p-6 md:p-8 mb-4 sm:mb-6 md:mb-8 border border-border">
      <!-- Mobile: Title and description first -->
      <div class="text-center mb-6">
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-foreground mb-3 sm:mb-4 leading-tight">{{idea.title}}</h1>
        <p class="text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed">{{{markdown idea.description}}}</p>
      </div>

      <!-- Mobile: Creator and rating in a row -->
      <div class="flex items-center justify-between mb-6 px-2">
        <div class="flex items-center space-x-3">
          <img src="{{cond idea.profiles.avatar_url idea.profiles.avatar_url '/images/avatar.png'}}" alt="Creator" class="w-8 h-8 sm:w-10 sm:h-10 rounded-full border border-border">
          <div>
            <p class="text-xs sm:text-sm text-muted-foreground">{{t 'idea-detail.created_by'}}</p>
            <p class="font-semibold text-foreground text-sm sm:text-base">{{idea.profiles.name}}</p>
          </div>
        </div>
        <div class="text-right">
          <div class="flex items-center space-x-1 mb-1">
            {{#each (range 1 5)}}
{{{icon 'star' class='w-4 h-4 sm:w-5 sm:h-5 {{#if (gte ../idea.rating this)}}text-yellow-400{{else}}text-muted-foreground{{/if}}' }}}
            {{/each}}
          </div>
          <span class="text-sm sm:text-base font-semibold text-foreground block">{{idea.rating}}</span>
          <span class="text-xs text-muted-foreground">({{idea.voteStats.total}})</span>
        </div>
      </div>

      <!-- Idea Metadata - Mobile: Single column -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-4 sm:mb-6">
           {{#if idea.category}}
           <div class="flex justify-between items-center p-3 bg-muted/30 rounded-lg">
             <span class="text-xs sm:text-sm text-muted-foreground">{{t 'idea-detail.category'}}</span>
             <span class="font-semibold text-foreground text-sm sm:text-base">{{idea.category}}</span>
           </div>
           {{/if}}
           <div class="flex justify-between items-center p-3 bg-muted/30 rounded-lg">
             <span class="text-xs sm:text-sm text-muted-foreground">{{t 'idea-detail.status'}}</span>
             <span class="px-2 py-1 rounded-full text-xs {{#if (eq idea.overall_status 'completed')}}bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300{{else if (eq idea.overall_status 'in_progress')}}bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300{{else}}bg-muted text-muted-foreground{{/if}}">
               {{idea.overall_status}}
             </span>
           </div>
           {{#if idea.completion_percentage}}
           <div class="flex justify-between items-center p-3 bg-muted/30 rounded-lg">
             <span class="text-xs sm:text-sm text-muted-foreground">{{t 'idea-detail.progress'}}</span>
             <span class="font-semibold text-foreground text-sm sm:text-base">{{idea.completion_percentage}}%</span>
           </div>
           {{/if}}
           <div class="flex justify-between items-center p-3 bg-muted/30 rounded-lg">
             <span class="text-xs sm:text-sm text-muted-foreground">{{t 'idea-detail.created'}}</span>
             <span class="font-semibold text-foreground text-sm sm:text-base">{{idea.created_at_formatted}}</span>
           </div>
        </div>

        <!-- Tags -->
        {{#if idea.tags}}
        <div class="mb-4 sm:mb-6">
          <div class="flex flex-wrap justify-center gap-2">
            {{#each idea.tags}}
            <span class="px-2 sm:px-3 py-1 bg-primary/10 text-primary rounded-full text-xs sm:text-sm border border-primary/20">{{this}}</span>
            {{/each}}
          </div>
        </div>
        {{/if}}

        {{#if (eq idea.user_id user.id)}}
        <div class="mb-4 sm:mb-6">
           <a href="/models/idea?ideaId={{idea.id}}" class="w-full inline-flex items-center justify-center px-4 sm:px-6 py-3 sm:py-4 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors text-sm sm:text-base font-medium">
 {{{icon 'edit' class='w-4 h-4 mr-2'}}}
             {{t 'idea-detail.continue_editing'}}
           </a>
        </div>
        <div class="mb-4 sm:mb-6">
           <button
             hx-delete="/api/ideas/{{idea.id}}"
             hx-confirm="Are you sure you want to delete this idea? This action cannot be undone."
             hx-swap="none"
             hx-on:htmx:after-request="window.location.href='/explore-idea'"
             hx-on:htmx:response-error="showToast('Failed to delete idea. Please try again.', 'error')"
             class="w-full inline-flex items-center justify-center px-4 sm:px-6 py-3 sm:py-4 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors text-sm sm:text-base font-medium">
 {{{icon 'trash' class='w-4 h-4 mr-2'}}}
             Delete Idea
           </button>
        </div>
        {{else}}
         <div class="bg-primary/5 border border-primary/20 rounded-lg p-3 sm:p-4 mb-4 sm:mb-6">
           <p class="text-primary dark:text-primary text-sm sm:text-base">
             {{t 'idea-detail.public_idea'}}
           </p>
         </div>
        {{/if}}

        {{#if (not user)}}
         <div class="bg-green-50 border border-green-200 rounded-lg p-3 sm:p-4 mb-4 sm:mb-6">
           <p class="text-green-800 text-sm sm:text-base">
             {{t 'idea-detail.join_community'}}
           </p>
         </div>
        {{/if}}

        {{#if (and user (not (eq idea.user_id user.id)))}}

        {{else if (not user)}}
         <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
           <p class="text-green-800">
             {{t 'idea-detail.join_community'}}
           </p>
         </div>
        {{/if}}
      </div>
    </div>

    <!-- Vote Statistics -->
    {{#if (gt idea.voteStats.total 0)}}
    <div class="bg-card rounded-2xl shadow-xl p-4 sm:p-6 md:p-8 mb-4 sm:mb-6 md:mb-8 border border-border">
       <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-foreground mb-4 sm:mb-6 text-center">{{t 'idea-detail.vote_distribution'}}</h2>
      <div class="space-y-3 sm:space-y-4">
        {{#each (range 1 6)}}
        {{#if (lt this 6)}}
         <div class="flex items-center space-x-3">
           <div class="text-sm sm:text-base font-bold text-yellow-500 w-8 text-center">{{this}}★</div>
           <div class="flex-1">
             <div class="w-full bg-muted rounded-full h-2 sm:h-3">
               <div class="bg-yellow-400 h-2 sm:h-3 rounded-full transition-all duration-300" style="width: {{#if (gt ../idea.voteStats.total 0)}}{{multiply (divide (lookup ../idea.voteStats.distribution this) ../idea.voteStats.total) 100}}%{{else}}0%{{/if}}"></div>
             </div>
           </div>
           <div class="text-xs sm:text-sm text-muted-foreground w-12 text-right">{{lookup ../idea.voteStats.distribution this}}</div>
         </div>
        {{/if}}
        {{/each}}
      </div>
    </div>
    {{/if}}

    <!-- Voting Section -->
    {{#if (not (eq idea.user_id user.id))}}
    <div class="bg-card rounded-2xl shadow-xl p-4 sm:p-6 md:p-8 border border-border">
       <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-foreground mb-4 sm:mb-6 text-center">{{t 'idea-detail.share_feedback'}}</h2>

      <form id="vote-form" class="space-y-4 sm:space-y-6" method="post" action="/api/votes">
        <input type="hidden" name="ideaId" value="{{idea.id}}" />

        <div>
           <label class="block text-sm font-medium text-foreground mb-4 text-center">
             {{t 'idea-detail.rating_question'}}
           </label>
          <div class="grid grid-cols-5 gap-2 sm:gap-3 mb-4">
            {{#each (range 1 5)}}
            <label class="cursor-pointer">
              <input type="radio" name="rating" value="{{this}}" class="sr-only peer" />
              <div class="aspect-square rounded-full border-2 border-border peer-checked:border-yellow-400 peer-checked:bg-yellow-50 dark:peer-checked:bg-yellow-900/20 flex items-center justify-center hover:border-yellow-300 transition-colors">
                <span class="text-sm sm:text-base font-semibold text-foreground peer-checked:text-yellow-600">{{this}}</span>
              </div>
            </label>
            {{/each}}
          </div>
           <div class="flex justify-between text-xs sm:text-sm text-muted-foreground px-1">
             <span>{{t 'idea-detail.poor'}}</span>
             <span>{{t 'idea-detail.excellent'}}</span>
           </div>
        </div>

        <button type="submit" id="submit-vote-btn"
          class="w-full bg-primary hover:bg-primary/90 text-primary-foreground font-semibold py-3 sm:py-4 px-4 sm:px-6 rounded-lg transition-all duration-300 flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed text-sm sm:text-base">
           <span>{{t 'idea-detail.submit_vote'}}</span>
{{{icon 'check' class='w-4 h-4 sm:w-5 sm:h-5'}}}
        </button>
      </form>

        <div id="vote-result" class="mt-4 sm:mt-6 text-center hidden">
          <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-3 sm:p-4">
{{{icon 'check-circle' class='w-6 h-6 sm:w-8 sm:h-8 text-green-600 dark:text-green-400 mx-auto mb-2'}}}
             <h3 class="text-base sm:text-lg font-semibold text-green-900 dark:text-green-100 mb-1">{{t 'idea-detail.vote_submitted'}}</h3>
             <p class="text-sm sm:text-base text-green-800 dark:text-green-200">{{t 'idea-detail.thank_you_feedback'}}</p>
          </div>
        </div>
    </div>
    {{else}}
    <!-- Owner view - no voting -->
    <div class="bg-card rounded-2xl shadow-xl p-4 sm:p-6 md:p-8 border border-border">
      <div class="text-center">
         <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-foreground mb-4">{{t 'idea-detail.your_idea'}}</h2>
         <p class="text-muted-foreground mb-4 text-sm sm:text-base">{{t 'idea-detail.own_idea_message'}}</p>
         <a href="/portfolios" class="w-full inline-flex items-center justify-center px-4 sm:px-6 py-3 sm:py-4 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors text-sm sm:text-base font-medium">
           {{t 'idea-detail.go_to_portfolios'}}
         </a>
      </div>
    </div>
    {{/if}}

  </div>
</div>

