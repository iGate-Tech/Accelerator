<div class="flex flex-col border border-border rounded-full bg-card question-card" id="{{id}}-question-card" data-expanded="true">


    <form id="{{id}}-new-project-form" class="flex m-auto max-w-[900px] min-w-[900px] flex-col gap-1 w-full" method="post"
        action="/projects/new">
        <!-- CSRF Token (Important for security) -->
        <input type="hidden" name="_csrf" value="">

        <div class="flex flex-col w-full">
            <div class="">
                <div class=" flex flex-col gap-2 rounded-2xl relative py-2  ">
                      <!-- Question and credit estimate wrapper -->
                      <div class="pl-4 pr-2 flex justify-between items-center cursor-pointer question-toggle" data-expanded="false">
                           <span
                               class="inline-flex items-center gap-2 px-2 py-1 bg-primary/5 text-primary border border-primary/20 text-xs rounded-full hover:bg-primary/10 transition-colors">
{{{icon 'chevron-right' class='w-3 h-3 text-primary transition-transform duration-200' size='24'}}}
                                <span class="text-primary">{{step}}. {{question}}</span>
                           </span>
                            <span id="{{id}}-credit-estimate" class="inline-flex items-center px-2 py-1 bg-warning/5 text-warning border border-warning/20 text-xs rounded-full">Estimated credits: 10</span>
                      </div>

                        <!-- Expandable Content -->
                        <div id="{{id}}-expandable-content" class="expandable-content overflow-hidden flex flex-col" style="display: none;">
                           <!-- Description wrapper -->
                           <div class=" pl-4 pr-2 relative mt-4">
                               <label for="assistant-prompt" class="sr-only">Describe your
                                   project requirements</label>
                                 <div id="{{id}}-assistant-prompt-display" class="w-full rounded-md border border-input bg-background px-3 py-2 text-base text-foreground min-h-[6rem] cursor-pointer overflow-hidden markdown-content" style="display: none; word-wrap: break-word;"></div>
                                  <textarea id="{{id}}-assistant-prompt" name="prompt"
                                       placeholder="{{placeholder}}"
                                       aria-label="Describe your project requirements" aria-describedby="prompt-help char-counter"
                                      class="flex w-full rounded-md border-0 bg-transparent p-3 pt-[1px] text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0 font-mono leading-relaxed"
                                      required=""
                                      style="min-height: 6rem; resize: vertical; overflow: auto; height: auto; line-height: 1.6;">{{description}}</textarea>
                               <p id="prompt-help" class="sr-only">Enter your project
                                   description or requirements</p>
                           </div>

                         <!-- toolbar -->
                         <div class="px-3 flex gap-2 items-center mt-4">
                         <div class="flex gap-2 items-center flex-shrink-0">
                              <!-- Chat with AI about Requirements -->
                              <button type="button" aria-label="Chat with AI about Requirements"
                                  title="Chat with AI about Requirements"
                                  class="shiny-button rounded-full inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'message-circle' class='w-4 h-4' size='16'}}}

                                 <span class="inline transition-all duration-200">Chat
                                     with AI</span>
                             </button>

                              <!-- Auto Fill with AI -->
                               <button type="button" aria-label="Auto Fill with AI" title="Auto Fill with AI" data-question="{{question}}" data-section="{{section}}"
                                   class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'sparkles' class='w-4 h-4' size='16'}}}

                                  <span class="hidden group-hover:inline transition-all duration-200">Auto Fill
                                      with AI</span>
                               </button>

                              <!-- Improve with AI -->
                               <button type="button" aria-label="Improve with AI" title="Improve with AI" data-section="{{section}}"
                                   class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'wand-sparkles' class='w-4 h-4' size='16'}}}

                                  <span class="hidden group-hover:inline transition-all duration-200">Improve
                                      Description with AI</span>
                               </button>

                             <!-- Reset form -->
                             <button type="button" aria-label="Reset form" title="Reset form"
                                 class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'rotate-ccw' class='w-4 h-4' size='16'}}}

                                 <span class="hidden group-hover:inline transition-all duration-200">Reset
                                     Form</span>
                             </button>
                         </div>

                        <!-- Submit button on the right -->
                        <div class="min-w-0 flex gap-2 ml-auto flex-shrink items-center">
                             <span id="{{id}}-char-counter" class="text-xs text-red-500/60 mr-2" aria-live="polite">Characters:
                                0 / 2000</span>
                             <button type="submit" aria-label="Save" title="Save"
                                 class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">

{{{icon 'save' class='w-4 h-4' size='16'}}}

                                 <span class="inline transition-all duration-200">Save</span>
                             </button>
             </div>
         </div>
     </div>
     </div> <!-- End expandable-content -->
 </div>
         </div>

         <!-- Chat Interface (appears below toolbar when Chat button is clicked) -->
         <div id="{{id}}-chat-container"
             class="hidden border-t border-border bg-card rounded-md overflow-hidden max-w-[900px] mt-4"
             role="log" aria-live="polite" aria-label="AI chat conversation">
        <!-- Chat Messages -->
        <div id="{{id}}-chat-messages" class="max-h-96 overflow-y-auto p-6 space-y-4" role="log" aria-live="polite">
            <div class="text-center text-muted-foreground text-sm py-8 px-4 bg-muted/30 rounded-lg border border-dashed border-border">
                💬 Start a conversation about your project requirements. The AI will help you refine and improve them.
            </div>
        </div>

        <!-- Chat Input -->
        <div class="border-t border-border bg-muted/20 p-4">
             <div class="flex gap-3 items-end">
                 <div class="flex-1 relative">
                     <textarea id="{{id}}-chat-input"
                         placeholder="Ask about your requirements, suggest improvements, or get advice..."
                         class="w-full min-h-[44px] max-h-32 resize-none rounded-lg border border-border bg-background px-4 py-3 text-sm placeholder:text-muted-foreground focus-visible:border-primary focus-visible:ring-2 focus-visible:ring-primary/20 focus-visible:outline-none transition-all duration-200"
                         rows="1" style="overflow: hidden;"></textarea>
                 </div>
             </div>
              <div class="flex justify-between items-center mt-3">
                  <span id="{{id}}-chat-char-counter" class="text-xs text-muted-foreground bg-muted px-2 py-1 rounded">0 / 1000</span>
              </div>
        </div>
    </div>
</div>

    </form>

  <style>
      /* Collapsible functionality */
      .question-toggle {
          transition: background-color 0.2s ease;
      }

      .question-toggle:hover {
          background-color: rgba(0, 0, 0, 0.02);
      }



      #{{id}}-expand-icon {
          transition: transform 0.3s ease;
      }

      /* Chat message styling */
     .message {
         word-wrap: break-word;
         line-height: 1.5;
     }

     .message--user {
         align-self: flex-end;
     }

     .message--ai {
         align-self: flex-start;
     }

     .message-group {
         animation: fadeIn 0.3s ease-in;
     }

     @keyframes fadeIn {
         from { opacity: 0; transform: translateY(10px); }
         to { opacity: 1; transform: translateY(0); }
     }

     /* Typing indicator animation */
     .typing-indicator .typing-dot {
         animation: typing 1.4s infinite ease-in-out;
     }

     .typing-indicator .typing-dot:nth-child(2) {
         animation-delay: 0.2s;
     }

     .typing-indicator .typing-dot:nth-child(3) {
         animation-delay: 0.4s;
     }

     @keyframes typing {
         0%, 60%, 100% {
             transform: translateY(0);
             opacity: 0.4;
         }
         30% {
             transform: translateY(-10px);
             opacity: 1;
         }
     }

     /* Spinning conic gradient border for chat button (like sidebar search) */
      .shiny-button {
          --gradient-angle: 0deg;
          --gradient-angle-offset: 0deg;
          --gradient-percent: 20%;
          --gradient-shine: #9e28b5;
          --shadow-size: 2px;
          position: relative;
          overflow: hidden;
          border: 2px solid transparent;
          background:
              linear-gradient(#ffffff, #ffffff) padding-box,
              conic-gradient(
                  from calc(var(--gradient-angle) - var(--gradient-angle-offset)),
                  transparent 0deg,
                  #ffc600 18deg,
                  #9e28b5 54deg,
                  #6cd14d 90deg,
                  #00a7e0 126deg,
                  transparent 162deg,
                  transparent 360deg
              )
              border-box;
          box-shadow: inset 0 0 0 1px #dedede;
          outline: none;
          transition:
              --gradient-angle-offset 800ms cubic-bezier(0.25, 1, 0.5, 1),
              --gradient-percent 800ms cubic-bezier(0.25, 1, 0.5, 1),
              --gradient-shine 800ms cubic-bezier(0.25, 1, 0.5, 1);
          isolation: isolate;
          outline-offset: 4px;
          z-index: 0;
          animation: border-spin 2.5s linear infinite;
      }

      .dark .shiny-button {
          background:
              linear-gradient(#030303, #030303) padding-box,
              conic-gradient(
                  from calc(var(--gradient-angle) - var(--gradient-angle-offset)),
                  transparent 0deg,
                  #ffc600 18deg,
                  #9e28b5 54deg,
                  #6cd14d 90deg,
                  #00a7e0 126deg,
                  transparent 162deg,
                  transparent 360deg
              )
              border-box;
          box-shadow: inset 0 0 0 1px #1a1818;
      }

      .shiny-button:focus {
          --gradient-percent: 100%;
          --gradient-angle-offset: 180deg;
      }

       @keyframes border-spin {
           to {
               --gradient-angle: 360deg;
           }
       }

       /* Markdown content styling */
       .markdown-content p {
           margin-bottom: 1rem;
           line-height: 1.6;
       }
       .markdown-content h1, .markdown-content h2, .markdown-content h3 {
           font-weight: bold;
           margin-bottom: 0.5rem;
           line-height: 1.4;
       }
       .markdown-content h1 { font-size: 1.5em; }
       .markdown-content h2 { font-size: 1.25em; }
       .markdown-content h3 { font-size: 1.1em; }
       .markdown-content ul, .markdown-content ol {
           margin-bottom: 1rem;
           padding-left: 1.5rem;
       }
       .markdown-content li {
           margin-bottom: 0.25rem;
       }
       .markdown-content blockquote {
           border-left: 4px solid #ccc;
           padding-left: 1rem;
           margin-bottom: 1rem;
           font-style: italic;
       }
       .markdown-content code {
           background-color: #f4f4f4;
           padding: 0.2em 0.4em;
           border-radius: 3px;
           font-family: monospace;
       }
       .markdown-content pre {
           background-color: #f4f4f4;
           padding: 1rem;
           border-radius: 3px;
           overflow-x: auto;
           margin-bottom: 1rem;
       }
       .markdown-content pre code {
           background-color: transparent;
           padding: 0;
       }
  </style>



<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
