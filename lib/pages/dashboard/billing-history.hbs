<div class="flex h-[calc(100vh-4rem)]">
  {{> sidebar projects=projects lng=lng}}
  <main class="flex-1 overflow-y-auto bg-background">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8">
      <div class="space-y-8">

        <!-- Header -->
        <div class="text-center sm:text-left">
          <h1 class="text-3xl font-bold text-foreground">Billing History</h1>
          <p class="text-muted-foreground mt-2">View your past payments and transactions</p>
        </div>

        <!-- Billing History Table -->
        <div class="bg-card rounded-lg border border-border shadow-sm">
          <div class="p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-foreground mb-3 sm:mb-4">Transaction History</h2>
            {{#if billingHistory.length}}
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-border">
                      <th class="text-left py-2 px-4 font-medium text-foreground">Date</th>
                      <th class="text-left py-2 px-4 font-medium text-foreground">Amount</th>
                      <th class="text-left py-2 px-4 font-medium text-foreground">Currency</th>
                      <th class="text-left py-2 px-4 font-medium text-foreground">Status</th>
                      <th class="text-left py-2 px-4 font-medium text-foreground">Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each billingHistory}}
                      <tr class="border-b border-border/50">
                        <td class="py-3 px-4 text-foreground">{{formatDate created_at}}</td>
                        <td class="py-3 px-4 text-foreground">${{amount}}</td>
                        <td class="py-3 px-4 text-foreground">{{currency}}</td>
                        <td class="py-3 px-4">
                          <span class="px-2 py-1 rounded-full text-xs font-medium {{#if (eq status 'completed')}}bg-green-100 text-green-800{{else if (eq status 'pending')}}bg-yellow-100 text-yellow-800{{else}}bg-red-100 text-red-800{{/if}}">
                            {{status}}
                          </span>
                        </td>
                        <td class="py-3 px-4 text-muted-foreground">Payment for services</td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            {{else}}
              <p class="text-muted-foreground text-center py-8">No billing history found.</p>
            {{/if}}
          </div>
        </div>

      </div>
    </div>
  </main>
</div>