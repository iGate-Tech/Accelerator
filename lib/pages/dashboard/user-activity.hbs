<main id="user-activity-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            User Activity
          </h1>
          <p class="text-lg text-muted-foreground">
            Track your recent actions and account activity
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
            Export Activity
          </button>
        </div>
      </div>

      <!-- Activity Filters -->
      <div class="flex flex-wrap gap-2" id="activity-filters">
        <button class="filter-btn btn btn-primary active rounded-full" data-filter="all">All</button>
        <button class="filter-btn btn btn-outline btn-primary rounded-full" data-filter="login">Logins</button>
        <button class="filter-btn btn btn-outline btn-primary rounded-full" data-filter="idea_created">Ideas</button>
        <button class="filter-btn btn btn-outline btn-primary rounded-full" data-filter="profile_completed">Profile</button>
        <button class="filter-btn btn btn-outline btn-primary rounded-full" data-filter="create">Account</button>
      </div>

      <!-- Activity Timeline -->
      <div class="relative" id="activity-timeline">
        {{#if activities}}
        <!-- Timeline line -->
        <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-border"></div>

        {{#each groupedActivities}}
        <div class="mb-8">
          <div class="flex items-center gap-4 mb-4">
            {{{icon "clock" class="w-5 h-5 text-primary z-10"}}}
            <h2 class="text-lg font-semibold text-foreground">{{@key}}</h2>
          </div>

          <div class="ml-12 space-y-4">
            {{#each this}}
             <div class="activity-item bg-card rounded-full border border-border p-4" data-action-type="{{action_type}}">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                   <div class="w-10 h-10 {{#if (eq action_type "login"}}bg-primary/20{{else if (eq action_type "create"}}bg-success/20{{else if (eq action_type "idea_created"}}bg-accent/20{{else if (eq action_type "profile_completed"}}bg-secondary/20{{else}}bg-neutral/20{{/if}} rounded-full flex items-center justify-center">
                     {{#if (eq action_type "login"}}
                       {{{icon "log-in" class="text-primary"}}}
                     {{else if (eq action_type "create"}}
                       {{{icon "plus" class="text-success"}}}
                     {{else if (eq action_type "idea_created"}}
                       {{{icon "lightbulb" class="text-accent"}}}
                     {{else if (eq action_type "profile_completed"}}
                       {{{icon "user" class="text-secondary"}}}
                     {{else}}
                       {{{icon "activity" class="text-neutral"}}}
                     {{/if}}
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between">
                    <h3 class="text-sm font-medium text-foreground">
                      {{#if (eq action_type "login"}}
                        Logged in to account
                      {{else if (eq action_type "create"}}
                        {{#if (eq entity_type "account"}}Account created{{else}}Created {{entity_type}}{{/if}}
                      {{else if (eq action_type "idea_created"}}
                        Created new idea
                      {{else if (eq action_type "profile_completed"}}
                        Completed profile setup
                      {{else}}
                        {{action_type}} {{entity_type}}
                      {{/if}}
                    </h3>
                    <span class="text-xs text-muted-foreground">{{formatDate created_at "time"}}</span>
                  </div>
                  {{#if details}}
                  <p class="text-sm text-muted-foreground mt-1">
                    {{#if (eq action_type "login"}}
                      {{#if details.description}}{{details.description}}{{else}}Successful login{{/if}}
                    {{else if (eq action_type "idea_created"}}
                      {{#if details.title}}"{{details.title}}"{{/if}}
                    {{else if details.description}}
                      {{details.description}}
                    {{else}}
                      Activity details
                    {{/if}}
                  </p>
                  {{/if}}
                </div>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
        {{/each}}

        {{else}}
        <!-- No activity message -->
        <div class="text-center py-12">
          <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
            {{{icon "activity" class="w-8 h-8 text-muted-foreground"}}}
          </div>
          <h3 class="text-lg font-medium text-foreground mb-2">No activity yet</h3>
          <p class="text-muted-foreground">Your activity log will appear here as you use the platform.</p>
        </div>
        {{/if}}
      </div>

      <!-- Load More -->
      <div class="text-center py-4">
        <button class="btn btn-outline btn-primary px-3 py-1.5 rounded-full">
          Load More Activity
        </button>
      </div>
    </div>
  </div>

</main>