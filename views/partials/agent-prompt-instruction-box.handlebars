<!-- Agent Prompt Instruction Box -->
<div class="w-4xl m-auto gap-0 ">
    <div class="text-center py-4">
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-sans font-light text-foreground mb-2 sm:mb-2">
        Hi <span class='text-primary'>Ahmed</span>, what's your next big idea?
    </h1>
</div>
    <div
        class="card-q gap-0 card bg-base-100 border border-base-200 shadow-2xl shadow-primary drop-shadow-md rounded-box"
    >
        <div class="card-body relative p-4 !gap-0">
            <div class="collapse collapse-arrow bg-base-100 py-0">
                <input
                    type="checkbox"
                    class="p-0"
                    name="ai-tasks-accordion"
                />
                <div
                    class="collapse-title font-semibold text-primary flex items-center gap-4 !p-0"
                >
                     <span
                         class="loading loading-spinner loading-primary loading-sm"
                     ></span>
                     AI Task Progress
                     <span id="agent-status-badge" class="badge badge-primary badge-xs animate-pulse"
                         >Active</span
                     >
                </div>
                <div class="collapse-content p-0">
                    <!-- Task Stats -->
                    <div class="flex flex-wrap gap-2 mt-4">
                        <div
                            class="bg-primary/10 text-primary px-3 py-1 rounded-full flex items-center gap-1 text-xs"
                        >
                            <i data-lucide="list" class="w-3 h-3"></i>
                            Total Tasks: 5
                        </div>
                        <div
                            class="bg-success/10 text-success px-3 py-1 rounded-full flex items-center gap-1 text-xs"
                        >
                            <i
                                data-lucide="check-circle"
                                class="w-3 h-3"
                            ></i>
                            Completed: 0
                        </div>
                        <div
                            class="bg-accent/10 text-accent px-3 py-1 rounded-full flex items-center gap-1 text-xs"
                        >
                            <i data-lucide="activity" class="w-3 h-3"></i>
                            In Progress: 1
                        </div>
                        <div
                            class="bg-info/10 text-info px-3 py-1 rounded-full flex items-center gap-1 text-xs"
                        >
                            <i data-lucide="clock" class="w-3 h-3"></i>
                            Est. Time: 2.5h
                        </div>
                        <div
                            class="bg-warning/10 text-warning px-3 py-1 rounded-full flex items-center gap-1 text-xs"
                        >
                            <i
                                data-lucide="dollar-sign"
                                class="w-3 h-3"
                            ></i>
                            Credits: 125
                        </div>
                        <div
                            class="bg-secondary/10 text-secondary px-3 py-1 rounded-full flex items-center gap-1 text-xs"
                        >
                            <i
                                data-lucide="trending-up"
                                class="w-3 h-3"
                            ></i>
                            Est. Credits: 50
                        </div>
                    </div>
                    <div class="space-y-4">
                        <!-- Database Setup -->
                        <div class="card">
                            <div class="card-body p-1">
                                <fieldset
                                    class="fieldset bg-base-100 border border-base-300 rounded-box p-4 mt-0"
                                >
                                    <legend
                                        class="fieldset-legend text-primary"
                                    >
                                        Task Steps
                                    </legend>
                                    <div class="grid grid-cols-2 gap-2">
                                        <label class="label cursor-pointer">
                                            <input
                                                type="checkbox"
                                                checked="checked"
                                                class="checkbox checkbox-xs checkbox-primary"
                                            />
                                            <span class="label-text"
                                                >Planning - Reviewing
                                                database schemas</span
                                            >
                                        </label>
                                        <label class="label cursor-pointer">
                                            <input
                                                type="checkbox"
                                                checked="checked"
                                                class="checkbox checkbox-xs checkbox-primary"
                                            />
                                            <span class="label-text"
                                                >Design - Creating data
                                                models</span
                                            >
                                        </label>
                                        <label class="label cursor-pointer">
                                            <input
                                                type="checkbox"
                                                checked="checked"
                                                class="checkbox checkbox-xs checkbox-primary"
                                            />
                                            <span class="label-text"
                                                >Implementation - Coding the
                                                database setup</span
                                            >
                                        </label>
                                        <label class="label cursor-pointer">
                                            <input
                                                type="checkbox"
                                                class="checkbox checkbox-xs checkbox-neutral"
                                            />
                                            <span class="label-text"
                                                >Testing - Verifying
                                                database functionality</span
                                            >
                                        </label>
                                    </div>
                                </fieldset>
                                <div class="mt-1 flex items-center gap-2">
                                     <progress
                                         id="agent-progress"
                                         class="progress progress-primary flex-1 h-2"
                                         value="0"
                                         max="100"
                                     ></progress>
                                     <span
                                         class="badge badge-primary badge-xs"
                                         >75% Complete</span
                                     >
                                 </div>
                                 <div id="agent-message" class="alert alert-info mt-2 text-sm">
                                     Ready to start
                                 </div>
                            </div>
                        </div>
                        <!-- Add other tasks similarly -->
                    </div>
                </div>
             </div>
              {{> instruction-input}}
         </div>
    </div>
</div>